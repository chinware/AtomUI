<Project>
    <PropertyGroup>
        <AtomUILinkedPublish Condition="'$(AtomUILinkedPublish)' == '' and '$(PublishTrimmed)' == 'true'">true</AtomUILinkedPublish>
        <AtomUILinkedPublish Condition="'$(AtomUILinkedPublish)' == '' and '$(PublishAot)' == 'true'">true</AtomUILinkedPublish>
        <AtomUILinkedPublish Condition="'$(AtomUILinkedPublish)' == '' and '$(RunAOTCompilation)' == 'true'">true</AtomUILinkedPublish>
        <AtomUILinkedPublish Condition="'$(AtomUILinkedPublish)' == '' and '$(AtomUIRegistrationStrict)' == 'true'">true</AtomUILinkedPublish>
        <AtomUILinkedPublish Condition="'$(AtomUILinkedPublish)' == ''">false</AtomUILinkedPublish>
        <AtomUIRegistrationPlanOwner
            Condition="'$(AtomUIRegistrationPlanOwner)' == '' and ('$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe')">true</AtomUIRegistrationPlanOwner>
        <AtomUIRegistrationPlanOwner Condition="'$(AtomUIRegistrationPlanOwner)' == ''">false</AtomUIRegistrationPlanOwner>
        <_AtomUICollectAxamlUsage
            Condition="'$(MSBuildProjectName)' != 'AtomUI.Build.Tasks' and ('$(AtomUILinkedPublish)' == 'true' or '$(AtomUIEmitLinkedManifest)' == 'true')">true</_AtomUICollectAxamlUsage>
        <_AtomUICollectAxamlUsage Condition="'$(_AtomUICollectAxamlUsage)' == ''">false</_AtomUICollectAxamlUsage>
        <AtomUIAxamlUsageOutputPath
            Condition="'$(AtomUIAxamlUsageOutputPath)' == ''">$(IntermediateOutputPath)AtomUIAxamlUsage.xml</AtomUIAxamlUsageOutputPath>
        <AtomUILinkedSidecarOutputPath
            Condition="'$(AtomUILinkedSidecarOutputPath)' == ''">$(TargetPath).atomui-link.json</AtomUILinkedSidecarOutputPath>
    </PropertyGroup>

    <ItemGroup>
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="AtomUIAxamlUsage" />
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="AtomUILinkedSidecar" />
    </ItemGroup>

    <UsingTask TaskName="AtomUI.Build.Tasks.CollectAxamlUsageTask"
               AssemblyFile="$(AtomUIBuildTasksAssembly)" />
    <UsingTask TaskName="AtomUI.Build.Tasks.ValidateAssemblyMetadataMarkerTask"
               AssemblyFile="$(AtomUIBuildTasksAssembly)" />
    <UsingTask TaskName="AtomUI.Build.Tasks.GenerateLinkedRegistrationSidecarTask"
               AssemblyFile="$(AtomUIBuildTasksAssembly)" />

    <Target Name="CollectAtomUIProjectReferenceSidecars"
            BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun;CoreCompile"
            DependsOnTargets="ResolveReferences"
            Condition="'$(AtomUILinkedPublish)' == 'true' and '@(ReferencePath)' != '' and '$(IsRoslynComponent)' != 'true' and '$(MSBuildProjectName)' != 'AtomUI.Build.Tasks'">
        <ItemGroup>
            <_AtomUILinkedReferenceSidecarCandidate
                Include="@(ReferencePath->'%(FullPath).atomui-link.json')" />
            <_AtomUIProjectReferenceSidecar
                Include="@(_AtomUILinkedReferenceSidecarCandidate)"
                Condition="Exists('%(Identity)')" />
        </ItemGroup>
        <RemoveDuplicates Inputs="@(_AtomUIProjectReferenceSidecar)">
            <Output TaskParameter="Filtered"
                    ItemName="_AtomUIDistinctProjectReferenceSidecar" />
        </RemoveDuplicates>
        <ItemGroup>
            <AdditionalFiles Include="@(_AtomUIDistinctProjectReferenceSidecar)"
                             AtomUILinkedSidecar="true"
                             Visible="false" />
        </ItemGroup>
        <!--
            ProjectReference builds do not emit the Sidecar next to the referenced assembly
            (linked analysis stays off for library builds), but the registration manifest is
            always compiled into AtomUI assemblies as assembly metadata. Extract it here so
            ProjectReference consumption resolves the same Registration Units as the
            NuGet-delivered Sidecar without any library-side opt-in.
        -->
        <ItemGroup>
            <_AtomUILinkedExtractableReference
                Include="@(ReferencePath)"
                Condition="'%(ReferencePath.FileName)' != '' and
                           $([System.String]::Copy('%(ReferencePath.FileName)').StartsWith('AtomUI.', System.StringComparison.Ordinal)) and
                           !Exists('%(ReferencePath.FullPath).atomui-link.json')" />
        </ItemGroup>
        <AtomUI.Build.Tasks.GenerateLinkedRegistrationSidecarTask
            AssemblyPath="%(_AtomUILinkedExtractableReference.FullPath)"
            OutputPath="$(IntermediateOutputPath)AtomUIExtractedSidecars/%(_AtomUILinkedExtractableReference.FileName).atomui-link.json"
            TargetFramework="$(TargetFramework)"
            ExtractedFallback="true"
            Condition="'@(_AtomUILinkedExtractableReference)' != '' and Exists('$(AtomUIBuildTasksAssembly)')"
            ContinueOnError="WarnAndContinue">
            <Output TaskParameter="SidecarPath"
                    ItemName="_AtomUIExtractedLinkedSidecar" />
        </AtomUI.Build.Tasks.GenerateLinkedRegistrationSidecarTask>
        <ItemGroup>
            <AdditionalFiles Include="@(_AtomUIExtractedLinkedSidecar)"
                             AtomUILinkedSidecar="true"
                             Visible="false" />
            <FileWrites Include="@(_AtomUIExtractedLinkedSidecar)" />
        </ItemGroup>
    </Target>

    <Target Name="CollectAtomUIAxamlUsage"
            BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun;CoreCompile"
            Condition="'$(_AtomUICollectAxamlUsage)' == 'true'">
        <PropertyGroup>
            <_AtomUIHasAxamlUsageInput
                Condition="'@(AvaloniaXaml)' != '' or '@(AtomUIRegistrationUnitRoot)' != '' or '@(AtomUIPackageRoot)' != ''">true</_AtomUIHasAxamlUsageInput>
        </PropertyGroup>
        <Error Condition="'$(_AtomUICollectAxamlUsage)' == 'true' and '$(_AtomUIHasAxamlUsageInput)' == 'true' and !Exists('$(AtomUIBuildTasksAssembly)')"
               Text="AtomUI.Build.Tasks could not be found at '$(AtomUIBuildTasksAssembly)'." />
        <AtomUI.Build.Tasks.CollectAxamlUsageTask AxamlFiles="@(AvaloniaXaml)"
                                                        ProjectDirectory="$(MSBuildProjectDirectory)"
                                                        OutputPath="$(AtomUIAxamlUsageOutputPath)"
                                                        UnitRoots="@(AtomUIRegistrationUnitRoot)"
                                                        PackageRoots="@(AtomUIPackageRoot)"
                                                        ProjectPackageId="$(AtomUIRegistrationPackageId)"
                                                        Condition="'$(_AtomUICollectAxamlUsage)' == 'true' and '$(_AtomUIHasAxamlUsageInput)' == 'true'">
            <Output TaskParameter="UsageCandidates" ItemName="_AtomUIAxamlUsageCandidate" />
            <Output TaskParameter="Uncertainties" ItemName="_AtomUIAxamlUsageUncertainty" />
        </AtomUI.Build.Tasks.CollectAxamlUsageTask>
        <ItemGroup Condition="'$(_AtomUICollectAxamlUsage)' == 'true' and '$(_AtomUIHasAxamlUsageInput)' == 'true'">
            <AdditionalFiles Remove="$(AtomUIAxamlUsageOutputPath)" />
            <AdditionalFiles Include="$(AtomUIAxamlUsageOutputPath)"
                             AtomUIAxamlUsage="true"
                             Visible="false" />
            <FileWrites Include="$(AtomUIAxamlUsageOutputPath)" />
        </ItemGroup>
    </Target>

    <Target Name="EmitAtomUILinkedRegistrationSidecar"
            AfterTargets="CopyFilesToOutputDirectory"
            Condition="('$(AtomUILinkedPublish)' == 'true' or '$(AtomUIEmitLinkedManifest)' == 'true') and '$(DesignTimeBuild)' != 'true' and '$(IsRoslynComponent)' != 'true' and '$(MSBuildProjectName)' != 'AtomUI.Build.Tasks' and Exists('$(TargetPath)')">
        <Error Condition="!Exists('$(AtomUIBuildTasksAssembly)')"
               Text="AtomUI.Build.Tasks could not be found at '$(AtomUIBuildTasksAssembly)'." />
        <AtomUI.Build.Tasks.GenerateLinkedRegistrationSidecarTask
            AssemblyPath="$(TargetPath)"
            OutputPath="$(AtomUILinkedSidecarOutputPath)"
            TargetFramework="$(TargetFramework)">
            <Output TaskParameter="SidecarPath"
                    ItemName="_AtomUIEmittedLinkedSidecar" />
        </AtomUI.Build.Tasks.GenerateLinkedRegistrationSidecarTask>
        <ItemGroup>
            <FileWrites Include="@(_AtomUIEmittedLinkedSidecar)" />
        </ItemGroup>
    </Target>

    <Target Name="GetAtomUILinkedRegistrationSidecar"
            Returns="@(_AtomUILinkedRegistrationSidecarTargetOutput)">
        <ItemGroup>
            <_AtomUILinkedRegistrationSidecarTargetOutput
                Include="$(AtomUILinkedSidecarOutputPath)"
                Condition="Exists('$(AtomUILinkedSidecarOutputPath)')" />
            <_AtomUILinkedRegistrationSidecarTargetOutput
                Remove="@(_AtomUILinkedRegistrationSidecarTargetOutput)"
                Condition="!Exists('%(Identity)')" />
        </ItemGroup>
        <Error Condition="('$(AtomUILinkedPublish)' == 'true' or '$(AtomUIEmitLinkedManifest)' == 'true') and '@(_AtomUILinkedRegistrationSidecarTargetOutput)' == ''"
               Text="ATOMUILINK006: Linked-registration Sidecar was not generated for '$(MSBuildProjectFullPath)'." />
    </Target>

    <Target Name="AtomUIPrepareLinkedRegistrationSidecarForPack"
            BeforeTargets="_GetPackageFiles"
            Condition="'$(IsPackable)' == 'true' and '$(AtomUIRegistrationPackageId)' != '' and '$(IsInnerBuild)' != 'true' and '$(AtomUIPackSidecarInnerBuild)' != 'true' and '$(DesignTimeBuild)' != 'true'">
        <PropertyGroup>
            <_AtomUIPackSidecarTargetFramework Condition="'$(TargetFramework)' != ''">$(TargetFramework)</_AtomUIPackSidecarTargetFramework>
            <_AtomUIPackSidecarTargetFramework Condition="'$(_AtomUIPackSidecarTargetFramework)' == '' and '$(TargetFrameworks)' != ''">$([System.String]::Copy('$(TargetFrameworks)').Split(';').GetValue(0))</_AtomUIPackSidecarTargetFramework>
        </PropertyGroup>
        <MSBuild Projects="$(MSBuildProjectFullPath)"
                 Targets="Build;GetAtomUILinkedRegistrationSidecar"
                 BuildInParallel="false"
                 Properties="Configuration=$(Configuration); TargetFramework=$(_AtomUIPackSidecarTargetFramework); AtomUIEmitLinkedManifest=true; AtomUILinkedPublish=true; AtomUIRegistrationPlanOwner=false; AtomUIPackSidecarInnerBuild=true"
                 RemoveProperties="PublishAot;PublishTrimmed;RunAOTCompilation;NoBuild">
            <Output TaskParameter="TargetOutputs"
                    ItemName="_AtomUIPackLinkedSidecar" />
        </MSBuild>
        <ItemGroup>
            <None Include="@(_AtomUIPackLinkedSidecar)"
                  Pack="true"
                  PackagePath="buildTransitive/AtomUI.LinkedRegistration/%(Filename)%(Extension)"
                  CopyToOutputDirectory="Never"
                  CopyToPublishDirectory="Never"
                  Visible="false" />
            <None Include="$(MSBuildThisFileDirectory)AtomUI.LinkedRegistration.SidecarConsumer.targets"
                  Pack="true"
                  PackagePath="buildTransitive/$(PackageId).targets"
                  Visible="false"
                  Condition="'$(AtomUIRepositoryBuild)' != 'true' and '$(PackageId)' != ''" />
        </ItemGroup>
    </Target>

    <ItemGroup Condition="'$(AtomUILinkedPublish)' == 'true' and '$(AtomUIRegistrationPlanOwner)' == 'true'">
        <RuntimeHostConfigurationOption Include="AtomUI.AotTrimRegistration.Enabled"
                                        Value="true"
                                        Trim="true"
                                        Condition="'$(AtomUILinkedPublish)' == 'true' and '$(AtomUIRegistrationPlanOwner)' == 'true'" />
    </ItemGroup>

    <Target Name="ValidateAtomUIApplicationRegistrationPlan"
            BeforeTargets="PrepareForILLink;PrepareForAotCompilation"
            Condition="'$(AtomUILinkedPublish)' == 'true' and '$(AtomUIRegistrationPlanOwner)' == 'true'">
        <Error Condition="!Exists('$(AtomUIBuildTasksAssembly)')"
               Text="AtomUI.Build.Tasks could not be found at '$(AtomUIBuildTasksAssembly)'." />
        <AtomUI.Build.Tasks.ValidateAssemblyMetadataMarkerTask
            AssemblyPath="$(TargetPath)"
            MarkerKey="AtomUI.Linked.Plan.v1">
            <Output TaskParameter="MarkerCount"
                    PropertyName="_AtomUIApplicationPlanMarkerCount" />
        </AtomUI.Build.Tasks.ValidateAssemblyMetadataMarkerTask>
        <Error Condition="'$(_AtomUIApplicationPlanMarkerCount)' != '1'"
               Text="ATOMUILINK001: Linked registration requires exactly one generated Application Plan owner marker." />
    </Target>
</Project>
