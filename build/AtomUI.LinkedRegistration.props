<Project>
    <PropertyGroup>
        <AtomUIRegistrationStrict Condition="'$(AtomUIRegistrationStrict)' == ''">false</AtomUIRegistrationStrict>
    </PropertyGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="AtomUILinkedPublish" />
        <CompilerVisibleProperty Include="AtomUIRegistrationStrict" />
        <CompilerVisibleProperty Include="AtomUIRegistrationPlanOwner" />
        <CompilerVisibleProperty Include="AtomUIRegistrationPackageId" />
    </ItemGroup>
</Project>
