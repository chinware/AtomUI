<Project>
    <PropertyGroup>
        <AtomUIRegistrationStrict Condition="'$(AtomUIRegistrationStrict)' == ''">false</AtomUIRegistrationStrict>
        <AtomUIEmitLinkedManifest Condition="'$(AtomUIEmitLinkedManifest)' == ''">false</AtomUIEmitLinkedManifest>
        <AtomUIRegistrationGranularity
            Condition="'$(AtomUIRegistrationGranularity)' == ''">Package</AtomUIRegistrationGranularity>
    </PropertyGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="AtomUILinkedPublish" />
        <CompilerVisibleProperty Include="AtomUIRegistrationStrict" />
        <CompilerVisibleProperty Include="AtomUIRegistrationPlanOwner" />
        <CompilerVisibleProperty Include="AtomUIRegistrationPackageId" />
        <CompilerVisibleProperty Include="AtomUIRegistrationGranularity" />
        <CompilerVisibleProperty Include="AtomUIEmitLinkedManifest" />
    </ItemGroup>
</Project>
