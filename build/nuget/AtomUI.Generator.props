<Project>
    <Import Project="$(MSBuildThisFileDirectory)linked-registration/LinkedRegistration.props"
            Condition="'$(AtomUIGeneratorPropsImported)' != 'true'" />
    <Import Project="$(MSBuildThisFileDirectory)localization/Localization.props"
            Condition="'$(AtomUIGeneratorPropsImported)' != 'true'" />
    <PropertyGroup Condition="'$(AtomUIGeneratorPropsImported)' != 'true'">
        <AtomUIGeneratorPropsImported>true</AtomUIGeneratorPropsImported>
    </PropertyGroup>
</Project>
