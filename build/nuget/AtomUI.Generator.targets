<Project>
    <Import Project="$(MSBuildThisFileDirectory)linked-registration/LinkedRegistration.targets"
            Condition="'$(AtomUIGeneratorTargetsImported)' != 'true'" />
    <Import Project="$(MSBuildThisFileDirectory)localization/Localization.targets"
            Condition="'$(AtomUIGeneratorTargetsImported)' != 'true'" />
    <Import Project="$(MSBuildThisFileDirectory)theme/ThemeAssets.targets"
            Condition="'$(AtomUIGeneratorTargetsImported)' != 'true'" />
    <PropertyGroup Condition="'$(AtomUIGeneratorTargetsImported)' != 'true'">
        <AtomUIGeneratorTargetsImported>true</AtomUIGeneratorTargetsImported>
    </PropertyGroup>
</Project>
