<Project>
    <PropertyGroup>
        <AtomUIBuildTasksAssembly Condition="'$(AtomUIBuildTasksAssembly)' == ''">$(MSBuildThisFileDirectory)../tools/net10.0/AtomUI.Build.Tasks.dll</AtomUIBuildTasksAssembly>
        <AtomUILinkedPublishGeneratorAssembly Condition="'$(AtomUILinkedPublishGeneratorAssembly)' == ''">$(MSBuildThisFileDirectory)../tools/netstandard2.0/AtomUI.Generator.LinkedPublish.dll</AtomUILinkedPublishGeneratorAssembly>
    </PropertyGroup>

    <Import Project="$(MSBuildThisFileDirectory)AtomUI.LinkedRegistration.props"
            Condition="'$(AtomUIGeneratorPropsImported)' != 'true'" />
    <Import Project="$(MSBuildThisFileDirectory)AtomUI.Localization.props"
            Condition="'$(AtomUIGeneratorPropsImported)' != 'true'" />
    <PropertyGroup Condition="'$(AtomUIGeneratorPropsImported)' != 'true'">
        <AtomUIGeneratorPropsImported>true</AtomUIGeneratorPropsImported>
    </PropertyGroup>
</Project>
