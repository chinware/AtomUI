<Project>
    <PropertyGroup>
        <_AtomUILanguageFileExcludes>
            $(MSBuildProjectDirectory)/bin/**/*.xlf;
            $(MSBuildProjectDirectory)/obj/**/*.xlf;
            $(MSBuildProjectDirectory)/**/GeneratedFiles/**/*.xlf
        </_AtomUILanguageFileExcludes>
        <_AtomUILanguageFileExcludes Condition="'$(BaseOutputPath)' != ''">$(_AtomUILanguageFileExcludes);$(BaseOutputPath)**/*.xlf</_AtomUILanguageFileExcludes>
        <_AtomUILanguageFileExcludes Condition="'$(BaseIntermediateOutputPath)' != ''">$(_AtomUILanguageFileExcludes);$(BaseIntermediateOutputPath)**/*.xlf</_AtomUILanguageFileExcludes>
    </PropertyGroup>

    <ItemGroup Condition="'$(AtomUIDisableLocalizationBuildIntegration)' != 'true'">
        <AtomUILanguageOverride Include="$(MSBuildProjectDirectory)/Localization/Overrides/**/*.xlf"
                                Exclude="$(_AtomUILanguageFileExcludes);@(AtomUILanguageOverride)">
            <AtomUILanguagePackagePath>%(RecursiveDir)%(Filename)%(Extension)</AtomUILanguagePackagePath>
            <AtomUILanguageContractVersion Condition="'%(AtomUILanguageContractVersion)' == ''">$(AtomUILanguageContractVersion)</AtomUILanguageContractVersion>
        </AtomUILanguageOverride>
        <AtomUILanguage Include="$(MSBuildProjectDirectory)/**/Localization/**/*.xlf"
                        Exclude="$(_AtomUILanguageFileExcludes);@(AtomUILanguage);@(AtomUILanguageOverride)"
                        Condition="'$(AtomUIBuildLanguagePackage)' != 'true'">
            <AtomUILanguagePackagePath>%(RecursiveDir)%(Filename)%(Extension)</AtomUILanguagePackagePath>
            <AtomUILanguageContractVersion Condition="'%(AtomUILanguageContractVersion)' == ''">$(AtomUILanguageContractVersion)</AtomUILanguageContractVersion>
        </AtomUILanguage>
        <AtomUILanguage Include="$(MSBuildProjectDirectory)/Localization/**/*.xlf"
                        Exclude="$(_AtomUILanguageFileExcludes);@(AtomUILanguage);@(AtomUILanguageOverride)"
                        Condition="'$(AtomUIBuildLanguagePackage)' == 'true'">
            <AtomUILanguageSourceKind>StaticLanguagePack</AtomUILanguageSourceKind>
            <AtomUILanguageSourceIdentity>$(PackageId)</AtomUILanguageSourceIdentity>
            <AtomUILanguageModuleId>$(AtomUILanguageModuleId)</AtomUILanguageModuleId>
            <AtomUILanguagePackagePath>%(RecursiveDir)%(Filename)%(Extension)</AtomUILanguagePackagePath>
        </AtomUILanguage>

        <AdditionalFiles Remove="@(AtomUILanguage);@(AtomUILanguageOverride)" />
        <AdditionalFiles Include="@(AtomUILanguage)"
                         AtomUILanguage="true"
                         AtomUILanguageSourceKind="%(AtomUILanguageSourceKind)"
                         AtomUILanguageSourceIdentity="%(AtomUILanguageSourceIdentity)"
                         AtomUILanguageModuleId="%(AtomUILanguageModuleId)"
                         AtomUILanguageContractValidation="%(AtomUILanguageContractValidation)"
                         AtomUILanguageContractVersion="%(AtomUILanguageContractVersion)"
                         AtomUILanguageSourceFingerprint="%(AtomUILanguageSourceFingerprint)"
                         Visible="false" />
        <AdditionalFiles Include="@(AtomUILanguageOverride)"
                         AtomUILanguage="true"
                         AtomUILanguageSourceKind="%(AtomUILanguageSourceKind)"
                         AtomUILanguageSourceIdentity="%(AtomUILanguageSourceIdentity)"
                         AtomUILanguageModuleId="%(AtomUILanguageModuleId)"
                         AtomUILanguageContractValidation="%(AtomUILanguageContractValidation)"
                         AtomUILanguageContractVersion="%(AtomUILanguageContractVersion)"
                         AtomUILanguageSourceFingerprint="%(AtomUILanguageSourceFingerprint)"
                         Visible="false" />

        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="AtomUILanguage" />
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="AtomUILanguageSourceKind" />
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="AtomUILanguageSourceIdentity" />
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="AtomUILanguageModuleId" />
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="AtomUILanguageContractValidation" />
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="AtomUILanguageContractVersion" />
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="AtomUILanguageSourceFingerprint" />
        <CompilerVisibleProperty Include="PackageId" />
        <CompilerVisibleProperty Include="AssemblyName" />
        <CompilerVisibleProperty Include="RootNamespace" />
        <CompilerVisibleProperty Include="AtomUIBuildLanguagePackage" />
    </ItemGroup>

    <PropertyGroup>
        <AtomUILocalizationBuildTasksAssembly Condition="'$(AtomUILocalizationBuildTasksAssembly)' == '' and Exists('$(MSBuildThisFileDirectory)../src/AtomUI.Build.Tasks/AtomUI.Build.Tasks.csproj')">$(MSBuildThisFileDirectory)../output/bin/$(Configuration)/netstandard2.0/AtomUI.Build.Tasks.dll</AtomUILocalizationBuildTasksAssembly>
        <AtomUILocalizationBuildTasksAssembly Condition="'$(AtomUILocalizationBuildTasksAssembly)' == ''">$(MSBuildThisFileDirectory)../tools/netstandard2.0/AtomUI.Build.Tasks.dll</AtomUILocalizationBuildTasksAssembly>
        <AtomUILanguagePackageManifestPath Condition="'$(AtomUILanguagePackageManifestPath)' == ''">$(IntermediateOutputPath)AtomUI.LanguagePack.xml</AtomUILanguagePackageManifestPath>
        <AtomUILanguagePackagePropsPath Condition="'$(AtomUILanguagePackagePropsPath)' == ''">$(IntermediateOutputPath)$(PackageId).props</AtomUILanguagePackagePropsPath>
        <AtomUILanguageTemplateOutputRootDirectory Condition="'$(AtomUILanguageTemplateOutputRootDirectory)' == ''">$(MSBuildProjectDirectory)/Localization</AtomUILanguageTemplateOutputRootDirectory>
    </PropertyGroup>

    <UsingTask TaskName="AtomUI.Build.Tasks.CollectLanguageCatalogsTask"
               AssemblyFile="$(AtomUILocalizationBuildTasksAssembly)" />
    <UsingTask TaskName="AtomUI.Build.Tasks.ValidateLanguageFilesTask"
               AssemblyFile="$(AtomUILocalizationBuildTasksAssembly)" />
    <UsingTask TaskName="AtomUI.Build.Tasks.ExportLanguageTemplatesTask"
               AssemblyFile="$(AtomUILocalizationBuildTasksAssembly)" />
    <UsingTask TaskName="AtomUI.Build.Tasks.PrepareLanguagePackageTask"
               AssemblyFile="$(AtomUILocalizationBuildTasksAssembly)" />
    <UsingTask TaskName="AtomUI.Build.Tasks.GenerateLanguagePackagePropsTask"
               AssemblyFile="$(AtomUILocalizationBuildTasksAssembly)" />

    <Target Name="AtomUIGetLanguageModuleSourceAssets"
            Returns="@(_AtomUILanguageModuleSourceAsset)"
            Condition="'$(AtomUIBuildLanguagePackage)' != 'true'">
        <ItemGroup>
            <_AtomUILanguageModuleSourceFile Include="@(AtomUILanguage)"
                                             Condition="'%(AtomUILanguageSourceKind)' == 'ModuleBuiltIn' and '%(Filename)%(Extension)' == 'en-US.xlf'" />
            <_AtomUILanguageModuleSourceAsset Include="%(_AtomUILanguageModuleSourceFile.FullPath)">
                <AtomUILanguageSourceKind>%(_AtomUILanguageModuleSourceFile.AtomUILanguageSourceKind)</AtomUILanguageSourceKind>
                <AtomUILanguageSourceIdentity>%(_AtomUILanguageModuleSourceFile.AtomUILanguageSourceIdentity)</AtomUILanguageSourceIdentity>
                <AtomUILanguageModuleId>%(_AtomUILanguageModuleSourceFile.AtomUILanguageModuleId)</AtomUILanguageModuleId>
                <AtomUILanguageContractValidation>%(_AtomUILanguageModuleSourceFile.AtomUILanguageContractValidation)</AtomUILanguageContractValidation>
                <AtomUILanguageContractVersion>%(_AtomUILanguageModuleSourceFile.AtomUILanguageContractVersion)</AtomUILanguageContractVersion>
                <AtomUILanguagePackagePath>%(_AtomUILanguageModuleSourceFile.AtomUILanguagePackagePath)</AtomUILanguagePackagePath>
                <AtomUILanguageSourceFingerprint>%(_AtomUILanguageModuleSourceFile.AtomUILanguageSourceFingerprint)</AtomUILanguageSourceFingerprint>
            </_AtomUILanguageModuleSourceAsset>
        </ItemGroup>
    </Target>

    <Target Name="AtomUIResolveLanguageContractProjectReferences"
            Condition="'$(AtomUIBuildLanguagePackage)' == 'true' and '@(ProjectReference)' != ''">
        <MSBuild Projects="@(ProjectReference)"
                 Targets="AtomUIGetLanguageModuleSourceAssets"
                 SkipNonexistentTargets="true">
            <Output TaskParameter="TargetOutputs"
                    ItemName="_AtomUIResolvedLanguageContractAsset" />
        </MSBuild>
        <ItemGroup>
            <AtomUILanguage Include="@(_AtomUIResolvedLanguageContractAsset)">
                <AtomUILanguageSourceKind>%(_AtomUIResolvedLanguageContractAsset.AtomUILanguageSourceKind)</AtomUILanguageSourceKind>
                <AtomUILanguageSourceIdentity>%(_AtomUIResolvedLanguageContractAsset.AtomUILanguageSourceIdentity)</AtomUILanguageSourceIdentity>
                <AtomUILanguageModuleId>%(_AtomUIResolvedLanguageContractAsset.AtomUILanguageModuleId)</AtomUILanguageModuleId>
                <AtomUILanguageContractValidation>%(_AtomUIResolvedLanguageContractAsset.AtomUILanguageContractValidation)</AtomUILanguageContractValidation>
                <AtomUILanguageContractVersion>%(_AtomUIResolvedLanguageContractAsset.AtomUILanguageContractVersion)</AtomUILanguageContractVersion>
                <AtomUILanguagePackagePath>%(_AtomUIResolvedLanguageContractAsset.AtomUILanguagePackagePath)</AtomUILanguagePackagePath>
                <AtomUILanguageSourceFingerprint>%(_AtomUIResolvedLanguageContractAsset.AtomUILanguageSourceFingerprint)</AtomUILanguageSourceFingerprint>
            </AtomUILanguage>
        </ItemGroup>
    </Target>

    <Target Name="AtomUICollectLanguageCatalogs"
            Condition="Exists('$(AtomUILocalizationBuildTasksAssembly)') and '@(AtomUILanguageCatalog)' != ''">
        <AtomUI.Build.Tasks.CollectLanguageCatalogsTask CatalogFiles="@(AtomUILanguageCatalog)">
            <Output TaskParameter="Catalogs" ItemName="_AtomUICollectedLanguageCatalog" />
        </AtomUI.Build.Tasks.CollectLanguageCatalogsTask>
    </Target>

    <Target Name="AtomUIValidateLanguageFiles"
            DependsOnTargets="AtomUIResolveLanguageContractProjectReferences;AtomUIResolveLanguagePackProjectReferences"
            BeforeTargets="CoreCompile"
            Condition="Exists('$(AtomUILocalizationBuildTasksAssembly)') and ('@(AtomUILanguage)' != '' or '@(AtomUILanguageOverride)' != '')">
        <ItemGroup>
            <_AtomUILanguageFileForValidation Include="@(AdditionalFiles)"
                                              Condition="'%(AdditionalFiles.AtomUILanguage)' == 'true'" />
        </ItemGroup>
        <AtomUI.Build.Tasks.ValidateLanguageFilesTask LanguageFiles="@(_AtomUILanguageFileForValidation)"
                                                       MinimumTargetState="$(AtomUILanguageMinimumState)" />
    </Target>

    <Target Name="AtomUIGetLanguagePackProjectAssets"
            DependsOnTargets="AtomUIResolveLanguageContractProjectReferences"
            Returns="@(_AtomUILanguagePackProjectAsset)"
            Condition="'$(AtomUIBuildLanguagePackage)' == 'true'">
        <Error Condition="!Exists('$(AtomUILocalizationBuildTasksAssembly)')"
               Text="AtomUI.Build.Tasks could not be found at '$(AtomUILocalizationBuildTasksAssembly)'." />
        <ItemGroup>
            <_AtomUILanguagePackProjectSourceFile Include="@(AtomUILanguage)"
                                                  Condition="'%(AtomUILanguageSourceKind)' == 'ModuleBuiltIn' and '%(Filename)%(Extension)' == 'en-US.xlf'" />
            <_AtomUILanguagePackProjectTargetFile Include="@(AtomUILanguage)"
                                                  Condition="'%(AtomUILanguageSourceKind)' == 'StaticLanguagePack'" />
            <_AtomUILanguagePackProjectPackageFile Include="@(Compile);@(Content);@(None)"
                                                   Exclude="$(IntermediateOutputPath)**/*;$(BaseIntermediateOutputPath)**/*;$(BaseOutputPath)**/*" />
        </ItemGroup>
        <Error Condition="'@(_AtomUILanguagePackProjectTargetFile)' == ''"
               Text="No static language XLIFF files were found for project-reference consumption." />
        <AtomUI.Build.Tasks.PrepareLanguagePackageTask PackageId="$(PackageId)"
                                                       ExpectedLanguage="$(AtomUILanguageTag)"
                                                       MinimumTargetState="$(AtomUILanguageMinimumState)"
                                                       SourceLanguageFiles="@(_AtomUILanguagePackProjectSourceFile)"
                                                       RequireVerifiedContract="$(AtomUIRequireVerifiedLanguageContract)"
                                                       LanguageFiles="@(_AtomUILanguagePackProjectTargetFile)"
                                                       PackageFiles="@(_AtomUILanguagePackProjectPackageFile)"
                                                       OutputManifestPath="$(IntermediateOutputPath)AtomUI.LanguagePack.ProjectReference.xml">
            <Output TaskParameter="PreparedLanguageFiles"
                    ItemName="_AtomUIPreparedLanguagePackProjectTargetFile" />
        </AtomUI.Build.Tasks.PrepareLanguagePackageTask>
        <ItemGroup>
            <_AtomUILanguagePackProjectAsset Include="%(_AtomUILanguagePackProjectSourceFile.FullPath)">
                <AtomUILanguageSourceKind>%(_AtomUILanguagePackProjectSourceFile.AtomUILanguageSourceKind)</AtomUILanguageSourceKind>
                <AtomUILanguageSourceIdentity>%(_AtomUILanguagePackProjectSourceFile.AtomUILanguageSourceIdentity)</AtomUILanguageSourceIdentity>
                <AtomUILanguageModuleId>%(_AtomUILanguagePackProjectSourceFile.AtomUILanguageModuleId)</AtomUILanguageModuleId>
                <AtomUILanguageContractValidation>%(_AtomUILanguagePackProjectSourceFile.AtomUILanguageContractValidation)</AtomUILanguageContractValidation>
                <AtomUILanguageContractVersion>%(_AtomUILanguagePackProjectSourceFile.AtomUILanguageContractVersion)</AtomUILanguageContractVersion>
                <AtomUILanguagePackagePath>%(_AtomUILanguagePackProjectSourceFile.AtomUILanguagePackagePath)</AtomUILanguagePackagePath>
                <AtomUILanguageSourceFingerprint>%(_AtomUILanguagePackProjectSourceFile.AtomUILanguageSourceFingerprint)</AtomUILanguageSourceFingerprint>
            </_AtomUILanguagePackProjectAsset>
            <_AtomUILanguagePackProjectAsset Include="%(_AtomUIPreparedLanguagePackProjectTargetFile.FullPath)">
                <AtomUILanguageSourceKind>%(_AtomUIPreparedLanguagePackProjectTargetFile.AtomUILanguageSourceKind)</AtomUILanguageSourceKind>
                <AtomUILanguageSourceIdentity>%(_AtomUIPreparedLanguagePackProjectTargetFile.AtomUILanguageSourceIdentity)</AtomUILanguageSourceIdentity>
                <AtomUILanguageModuleId>%(_AtomUIPreparedLanguagePackProjectTargetFile.AtomUILanguageModuleId)</AtomUILanguageModuleId>
                <AtomUILanguageContractValidation>%(_AtomUIPreparedLanguagePackProjectTargetFile.AtomUILanguageContractValidation)</AtomUILanguageContractValidation>
                <AtomUILanguageContractVersion>%(_AtomUIPreparedLanguagePackProjectTargetFile.AtomUILanguageContractVersion)</AtomUILanguageContractVersion>
                <AtomUILanguagePackagePath>%(_AtomUIPreparedLanguagePackProjectTargetFile.AtomUILanguagePackagePath)</AtomUILanguagePackagePath>
                <AtomUILanguageSourceFingerprint>%(_AtomUIPreparedLanguagePackProjectTargetFile.AtomUILanguageSourceFingerprint)</AtomUILanguageSourceFingerprint>
            </_AtomUILanguagePackProjectAsset>
        </ItemGroup>
    </Target>

    <Target Name="AtomUIResolveLanguagePackProjectReferences"
            BeforeTargets="GenerateMSBuildEditorConfigFileShouldRun;AtomUIValidateLanguageFiles;CoreCompile"
            Condition="'@(AtomUILanguagePackProjectReference)' != ''">
        <MSBuild Projects="@(AtomUILanguagePackProjectReference)"
                 Targets="AtomUIGetLanguagePackProjectAssets">
            <Output TaskParameter="TargetOutputs"
                    ItemName="_AtomUIResolvedLanguagePackProjectAsset" />
        </MSBuild>
        <ItemGroup>
            <AdditionalFiles Include="@(_AtomUIResolvedLanguagePackProjectAsset)"
                             AtomUILanguage="true"
                             AtomUILanguageSourceKind="%(_AtomUIResolvedLanguagePackProjectAsset.AtomUILanguageSourceKind)"
                             AtomUILanguageSourceIdentity="%(_AtomUIResolvedLanguagePackProjectAsset.AtomUILanguageSourceIdentity)"
                             AtomUILanguageModuleId="%(_AtomUIResolvedLanguagePackProjectAsset.AtomUILanguageModuleId)"
                             AtomUILanguageContractValidation="%(_AtomUIResolvedLanguagePackProjectAsset.AtomUILanguageContractValidation)"
                             AtomUILanguageContractVersion="%(_AtomUIResolvedLanguagePackProjectAsset.AtomUILanguageContractVersion)"
                             AtomUILanguageSourceFingerprint="%(_AtomUIResolvedLanguagePackProjectAsset.AtomUILanguageSourceFingerprint)"
                             Visible="false" />
        </ItemGroup>
    </Target>

    <Target Name="AtomUIExportLanguageTemplates"
            DependsOnTargets="AtomUIResolveLanguageContractProjectReferences;AtomUICollectLanguageCatalogs">
        <Error Condition="'$(AtomUITargetLanguage)' == ''"
               Text="AtomUITargetLanguage is required, for example -p:AtomUITargetLanguage=ja-JP." />
        <Error Condition="!Exists('$(AtomUILocalizationBuildTasksAssembly)')"
               Text="AtomUI.Build.Tasks could not be found at '$(AtomUILocalizationBuildTasksAssembly)'." />
        <ItemGroup>
            <_AtomUILanguageTemplateSource Include="@(AtomUILanguage)"
                                           Condition="'%(AtomUILanguage.Filename)%(AtomUILanguage.Extension)' == 'en-US.xlf'" />
        </ItemGroup>
        <Error Condition="'@(_AtomUILanguageTemplateSource)' == ''"
               Text="No authoritative en-US language contract was found. Add an authoring-only component PackageReference with PrivateAssets=all before exporting templates." />
        <AtomUI.Build.Tasks.ExportLanguageTemplatesTask SourceFiles="@(_AtomUILanguageTemplateSource)"
                                                        OutputRootDirectory="$(AtomUILanguageTemplateOutputRootDirectory)"
                                                        TargetLanguage="$(AtomUITargetLanguage)">
            <Output TaskParameter="ExportedFiles" ItemName="AtomUIExportedLanguageTemplate" />
        </AtomUI.Build.Tasks.ExportLanguageTemplatesTask>
    </Target>

    <Target Name="AtomUIPrepareLanguagePackage"
            DependsOnTargets="AtomUIResolveLanguageContractProjectReferences"
            BeforeTargets="_GetPackageFiles"
            Condition="'$(AtomUIBuildLanguagePackage)' == 'true'">
        <Error Condition="!Exists('$(AtomUILocalizationBuildTasksAssembly)')"
               Text="AtomUI.Build.Tasks could not be found at '$(AtomUILocalizationBuildTasksAssembly)'." />
        <ItemGroup>
            <_AtomUILanguagePackageSourceFile Include="@(AtomUILanguage)"
                                               Condition="'%(AtomUILanguageSourceKind)' == 'ModuleBuiltIn' and '%(Filename)%(Extension)' == 'en-US.xlf'" />
            <_AtomUILanguagePackageFile Include="@(AtomUILanguage)"
                                         Condition="'%(AtomUILanguageSourceKind)' == 'StaticLanguagePack'" />
            <_AtomUILanguagePackageValidationFile Include="@(Compile);@(Content);@(None)"
                                                  Exclude="$(IntermediateOutputPath)**/*;$(BaseIntermediateOutputPath)**/*;$(BaseOutputPath)**/*" />
        </ItemGroup>
        <Error Condition="'@(_AtomUILanguagePackageFile)' == ''"
               Text="No static language XLIFF files were found. Add target-language files under Localization/." />
        <AtomUI.Build.Tasks.PrepareLanguagePackageTask PackageId="$(PackageId)"
                                                       ExpectedLanguage="$(AtomUILanguageTag)"
                                                       MinimumTargetState="$(AtomUILanguageMinimumState)"
                                                       SourceLanguageFiles="@(_AtomUILanguagePackageSourceFile)"
                                                       RequireVerifiedContract="$(AtomUIRequireVerifiedLanguageContract)"
                                                       LanguageFiles="@(_AtomUILanguagePackageFile)"
                                                       PackageFiles="@(_AtomUILanguagePackageValidationFile)"
                                                       OutputManifestPath="$(AtomUILanguagePackageManifestPath)">
            <Output TaskParameter="PreparedLanguageFiles" ItemName="_AtomUIPreparedLanguageFile" />
        </AtomUI.Build.Tasks.PrepareLanguagePackageTask>
        <AtomUI.Build.Tasks.GenerateLanguagePackagePropsTask PackageId="$(PackageId)"
                                                            LanguageFiles="@(_AtomUIPreparedLanguageFile)"
                                                            OutputPath="$(AtomUILanguagePackagePropsPath)" />
        <ItemGroup>
            <None Include="@(_AtomUIPreparedLanguageFile)"
                  Pack="true"
                  PackagePath="contentFiles/any/any/%(_AtomUIPreparedLanguageFile.AtomUILanguagePackagePath)" />
            <None Include="$(AtomUILanguagePackageManifestPath)"
                  Pack="true"
                  PackagePath="contentFiles/any/any/AtomUI.LanguagePack.xml" />
            <None Include="$(AtomUILanguagePackagePropsPath)"
                  Pack="true"
                  PackagePath="buildTransitive/$(PackageId).props" />
        </ItemGroup>
    </Target>

    <PropertyGroup>
        <AtomUILanguageModulePropsPath Condition="'$(AtomUILanguageModulePropsPath)' == ''">$(IntermediateOutputPath)$(PackageId).props</AtomUILanguageModulePropsPath>
    </PropertyGroup>

    <Target Name="AtomUIPrepareLanguageModuleAssets"
            BeforeTargets="_GetPackageFiles"
            Condition="'$(IsPackable)' == 'true' and '$(AtomUIBuildLanguagePackage)' != 'true' and '@(AtomUILanguage)' != ''">
        <ItemGroup>
            <_AtomUIModuleLanguageFile Include="@(AtomUILanguage)"
                                       Condition="'%(AtomUILanguageSourceKind)' == 'ModuleBuiltIn' and '%(Filename)%(Extension)' == 'en-US.xlf'" />
        </ItemGroup>
        <AtomUI.Build.Tasks.GenerateLanguagePackagePropsTask PackageId="$(PackageId)"
                                                            SourceKind="ModuleBuiltIn"
                                                            RequireTargetLanguage="false"
                                                            LanguageFiles="@(_AtomUIModuleLanguageFile)"
                                                            OutputPath="$(AtomUILanguageModulePropsPath)" />
        <ItemGroup>
            <None Include="@(_AtomUIModuleLanguageFile)"
                  Pack="true"
                  PackagePath="contentFiles/any/any/%(_AtomUIModuleLanguageFile.AtomUILanguagePackagePath)" />
            <None Include="$(AtomUILanguageModulePropsPath)"
                  Pack="true"
                  PackagePath="buildTransitive/$(PackageId).props" />
        </ItemGroup>
    </Target>
</Project>
