<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <AtomUIGenerateControlThemeAssetResources
            Condition="'$(AtomUIGenerateControlThemeAssetResources)' == ''">true</AtomUIGenerateControlThemeAssetResources>
        <AtomUIThemeAssetProjectDirectory>$(MSBuildProjectDirectory)</AtomUIThemeAssetProjectDirectory>
        <AtomUIThemeControlCatalog
            Condition="'$(AtomUIThemeControlCatalog)' == ''">$(AssemblyName)</AtomUIThemeControlCatalog>
        <AtomUIPackageSharedThemePaths
            Condition="'$(AtomUIPackageSharedThemePaths)' == ''">@(AtomUIPackageSharedTheme->'%(Identity)', ';')</AtomUIPackageSharedThemePaths>
    </PropertyGroup>

    <ItemGroup>
        <CompilerVisibleProperty Include="AtomUIThemeAssetProjectDirectory" />
        <CompilerVisibleProperty Include="AtomUIThemeControlCatalog" />
        <CompilerVisibleProperty Include="AtomUIPackageSharedThemePaths" />
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="Link" />
        <CompilerVisibleItemMetadata Include="AdditionalFiles" MetadataName="AtomUIRegistrationUnit" />
        <CompilerVisibleItemMetadata Include="Compile" MetadataName="AtomUIRegistrationUnit" />
    </ItemGroup>

    <UsingTask TaskName="AtomUI.Build.Tasks.GenerateThemeAssetWrappersTask"
               AssemblyFile="$(AtomUIBuildTasksAssembly)" />

    <Target Name="GenerateAtomUIThemeAssetWrappers"
            BeforeTargets="GenerateAvaloniaResources"
            Condition="'$(AtomUIGenerateControlThemeAssetResources)' == 'true' and
                       '@(AvaloniaXaml)' != ''">
        <PropertyGroup>
            <_AtomUIThemeAssetOutputDirectory>$(IntermediateOutputPath)AtomUIThemeAssets</_AtomUIThemeAssetOutputDirectory>
            <_AtomUIThemeAssetGeneratedCode>$(_AtomUIThemeAssetOutputDirectory)/GeneratedThemeAssetResources.g.cs</_AtomUIThemeAssetGeneratedCode>
        </PropertyGroup>
        <Error Condition="!Exists('$(AtomUIBuildTasksAssembly)')"
               Text="AtomUI.Build.Tasks could not be found at '$(AtomUIBuildTasksAssembly)'." />
        <AtomUI.Build.Tasks.GenerateThemeAssetWrappersTask ThemeAssets="@(AvaloniaXaml)"
                                                           OutputDirectory="$(_AtomUIThemeAssetOutputDirectory)"
                                                           AssemblyName="$(AssemblyName)"
                                                           GeneratedCodePath="$(_AtomUIThemeAssetGeneratedCode)">
            <Output TaskParameter="GeneratedAssets" ItemName="_AtomUIGeneratedThemeAsset" />
        </AtomUI.Build.Tasks.GenerateThemeAssetWrappersTask>
        <ItemGroup>
            <AvaloniaXaml Include="@(_AtomUIGeneratedThemeAsset)" />
            <Compile Include="$(_AtomUIThemeAssetGeneratedCode)" />
            <FileWrites Include="@(_AtomUIGeneratedThemeAsset)" />
            <FileWrites Include="$(_AtomUIThemeAssetGeneratedCode)" />
        </ItemGroup>
    </Target>
</Project>
