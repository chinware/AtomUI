<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <AssemblyName>AtomUI.LinkedRegistration.ProjectReference.Fixtures.Shared</AssemblyName>
    </PropertyGroup>

    <Target Name="ValidateFixtureProjectReferenceMetadata"
            BeforeTargets="CoreCompile">
        <Error Condition="'$(AtomUIFixtureSentinel)' != 'preserved'"
               Text="ProjectReference AdditionalProperties sentinel was not preserved." />
    </Target>

    <ItemGroup>
        <ProjectReference Include="../Feature/ProjectReferenceFeature.csproj" />
    </ItemGroup>
</Project>
