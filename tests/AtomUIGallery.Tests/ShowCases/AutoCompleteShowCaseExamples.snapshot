<gallery:ShowCaseItem Title="{gallery:AutoCompleteShowCaseLangResource BasicUsageTitle}"
Description="{gallery:AutoCompleteShowCaseLangResource BasicUsageDescription}">
<atom:AutoComplete Name="BasicAutoComplete"
OptionsAsyncLoader="{Binding BasicOptionsAsyncLoader}"
PlaceholderText="{gallery:AutoCompleteShowCaseLangResource P2PlaceholderTextInputHere}"
Width="200" />
</gallery:ShowCaseItem>
<gallery:ShowCaseItem Title="{gallery:AutoCompleteShowCaseLangResource CustomizedTitle}"
Description="{gallery:AutoCompleteShowCaseLangResource CustomizedDescription}">
<atom:AutoComplete Name="CustomizedAutoComplete"
OptionsAsyncLoader="{Binding CustomLabelOptionsAsyncLoader}"
PlaceholderText="{gallery:AutoCompleteShowCaseLangResource P2PlaceholderTextInputHere}"
Width="200" />
</gallery:ShowCaseItem>
<gallery:ShowCaseItem Title="{gallery:AutoCompleteShowCaseLangResource CustomOptionRenderingTitle}"
Description="{gallery:AutoCompleteShowCaseLangResource CustomOptionRenderingDescription}">
<atom:AutoComplete Name="CityAutoComplete"
OptionsSource="{Binding CityOptions}"
PlaceholderText="{gallery:AutoCompleteShowCaseLangResource P2PlaceholderTextTryAOrB}"
Width="320"
IsAllowClear="True"
Filter="{atom:ValueFilterProvider Contains}">
<atom:AutoComplete.OptionTemplate>
<DataTemplate x:DataType="vm:CityAutoCompleteOption">
<Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="2">
<TextBlock Grid.Row="0" Grid.Column="0"
Text="{Binding Header}"
FontWeight="SemiBold"
TextTrimming="CharacterEllipsis" />
<Border Grid.Row="0" Grid.Column="1"
Padding="6 0"
VerticalAlignment="Center"
Background="{atom:SharedTokenResource ColorFillSecondary}"
CornerRadius="{atom:SharedTokenResource BorderRadiusXS}">
<TextBlock Text="{Binding Country}"
FontSize="{atom:SharedTokenResource FontSizeSM}" />
</Border>
<TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
Text="{Binding Population, StringFormat='Population {0:N0}'}"
FontSize="{atom:SharedTokenResource FontSizeSM}"
Foreground="{atom:SharedTokenResource ColorTextTertiary}" />
</Grid>
</DataTemplate>
</atom:AutoComplete.OptionTemplate>
</atom:AutoComplete>
</gallery:ShowCaseItem>
<gallery:ShowCaseItem Title="{gallery:AutoCompleteShowCaseLangResource SizeTypeTitle}"
Description="{gallery:AutoCompleteShowCaseLangResource SizeTypeDescription}">
<StackPanel Spacing="10">
<atom:AutoComplete Width="220"
Name="LargeAutoComplete"
OptionsAsyncLoader="{Binding BasicOptionsAsyncLoader}"
SizeType="Large"
PlaceholderText="{gallery:AutoCompleteShowCaseLangResource P2PlaceholderSizeTypeLarge}" />
<atom:AutoComplete Width="220"
Name="MiddleAutoComplete"
OptionsAsyncLoader="{Binding BasicOptionsAsyncLoader}"
SizeType="Middle"
PlaceholderText="{gallery:AutoCompleteShowCaseLangResource P2PlaceholderSizeTypeMiddle}" />
<atom:AutoComplete Width="220"
Name="SmallAutoComplete"
OptionsAsyncLoader="{Binding BasicOptionsAsyncLoader}"
SizeType="Small"
PlaceholderText="{gallery:AutoCompleteShowCaseLangResource P2PlaceholderSizeTypeSmall}" />
<atom:AutoComplete Width="220"
Name="CustomAutoComplete"
OptionsAsyncLoader="{Binding BasicOptionsAsyncLoader}"
SizeType="Custom"
Height="36"
PlaceholderText="{gallery:AutoCompleteShowCaseLangResource P2PlaceholderSizeTypeCustom}" />
</StackPanel>
</gallery:ShowCaseItem>
<gallery:ShowCaseItem
Title="{gallery:AutoCompleteShowCaseLangResource LookupPatternsUncertainCategoryTitle}"
Description="{gallery:AutoCompleteShowCaseLangResource LookupPatternsUncertainCategoryDescription}">
<atom:AutoCompleteSearchEdit Name="SearchAutoComplete"
OptionsAsyncLoader="{Binding SearchEditOptionsAsyncLoader}"
PlaceholderText="{gallery:AutoCompleteShowCaseLangResource P2PlaceholderTextInputHere}"
Width="300"
SizeType="Large"
SearchButtonStyle="Primary"
Filter="{atom:ValueFilterProvider Contains}">
<atom:AutoCompleteSearchEdit.OptionTemplate>
<DataTemplate x:DataType="vm:CustomAutoCompleteOption">
<DockPanel LastChildFill="True">
<TextBlock
Text="{gallery:AutoCompleteShowCaseLangResource P2TextResults}"
DockPanel.Dock="Right"
Margin="5 0 0 0" />
<TextBlock Text="{Binding ResultCount}"
DockPanel.Dock="Right" />
<TextBlock Text="{Binding Header}"
TextTrimming="CharacterEllipsis" />
</DockPanel>
</DataTemplate>
</atom:AutoCompleteSearchEdit.OptionTemplate>
</atom:AutoCompleteSearchEdit>
</gallery:ShowCaseItem>
<gallery:ShowCaseItem
Title="{gallery:AutoCompleteShowCaseLangResource TextAreaAutoCompletionTitle}"
Description="{gallery:AutoCompleteShowCaseLangResource TextAreaAutoCompletionDescription}">
<atom:AutoCompleteTextArea Name="TextAreaAutoComplete"
OptionsAsyncLoader="{Binding BasicOptionsAsyncLoader}"
PlaceholderText="{gallery:AutoCompleteShowCaseLangResource P2PlaceholderTextInputHere}"
Width="300"
Lines="5"
IsAllowClear="True" />
</gallery:ShowCaseItem>
<gallery:ShowCaseItem Title="{gallery:AutoCompleteShowCaseLangResource NonCaseSensitiveTitle}"
Description="{gallery:AutoCompleteShowCaseLangResource NonCaseSensitiveDescription}">
<atom:AutoComplete Name="FilterAutoComplete"
OptionsSource="{Binding FilterCaseOptions}"
PlaceholderText="{gallery:AutoCompleteShowCaseLangResource P2PlaceholderTextTryToTypeB}"
Width="300"
IsAllowClear="True"
Filter="{atom:ValueFilterProvider Contains}" />
</gallery:ShowCaseItem>
<gallery:ShowCaseItem Title="{gallery:AutoCompleteShowCaseLangResource StatusTitle}"
Description="{gallery:AutoCompleteShowCaseLangResource StatusDescription}">
<StackPanel Spacing="10">
<atom:AutoComplete Name="ErrorAutoComplete"
OptionsAsyncLoader="{Binding BasicOptionsAsyncLoader}"
Width="200"
Status="Error" />
<atom:AutoComplete Width="200"
Name="WarningAutoComplete"
OptionsAsyncLoader="{Binding BasicOptionsAsyncLoader}"
Status="Warning" />
</StackPanel>
</gallery:ShowCaseItem>
<gallery:ShowCaseItem Title="{gallery:AutoCompleteShowCaseLangResource VariantsTitle}"
Description="{gallery:AutoCompleteShowCaseLangResource VariantsDescription}">
<StackPanel Spacing="10">
<atom:AutoComplete Width="200"
Name="OutlineAutoComplete"
OptionsAsyncLoader="{Binding BasicOptionsAsyncLoader}"
StyleVariant="Outlined"
PlaceholderText="{gallery:AutoCompleteShowCaseLangResource P2PlaceholderTextOutline}" />
<atom:AutoComplete Width="200"
Name="FilledAutoComplete"
OptionsAsyncLoader="{Binding BasicOptionsAsyncLoader}"
StyleVariant="Filled"
PlaceholderText="{gallery:AutoCompleteShowCaseLangResource P2PlaceholderTextFilled}" />
<atom:AutoComplete Width="200"
Name="BorderlessAutoComplete"
OptionsAsyncLoader="{Binding BasicOptionsAsyncLoader}"
StyleVariant="Borderless"
PlaceholderText="{gallery:AutoCompleteShowCaseLangResource P2PlaceholderTextBorderless}" />
<atom:AutoComplete Width="200"
Name="UnderlinedAutoComplete"
OptionsAsyncLoader="{Binding BasicOptionsAsyncLoader}"
StyleVariant="Underlined"
PlaceholderText="{gallery:AutoCompleteShowCaseLangResource P2PlaceholderTextUnderlined}" />
</StackPanel>
</gallery:ShowCaseItem>
<gallery:ShowCaseItem Title="{gallery:AutoCompleteShowCaseLangResource CustomizeClearButtonTitle}"
Description="{gallery:AutoCompleteShowCaseLangResource CustomizeClearButtonDescription}">
<StackPanel Spacing="10">
<atom:AutoComplete Width="200"
Name="UnClearableAutoComplete"
OptionsAsyncLoader="{Binding BasicOptionsAsyncLoader}"
PlaceholderText="{gallery:AutoCompleteShowCaseLangResource P2PlaceholderTextUnclearable}" />
<atom:AutoComplete Width="200"
Name="ClearableAutoComplete"
OptionsAsyncLoader="{Binding BasicOptionsAsyncLoader}"
IsAllowClear="True"
PlaceholderText="{gallery:AutoCompleteShowCaseLangResource P2PlaceholderTextCustomizedClearIcon}"
ClearIcon="{antdicons:AntDesignIconProvider CloseSquareFilled}" />
</StackPanel>
</gallery:ShowCaseItem>
