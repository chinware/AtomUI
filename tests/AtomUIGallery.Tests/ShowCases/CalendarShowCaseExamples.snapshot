<gallery:ShowCaseItem Title="{gallery:CalendarShowCaseLangResource BasicTitle}"
                                      Description="{gallery:CalendarShowCaseLangResource BasicDescription}"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CalendarViewModel">
                            <atom:Calendar Value="{Binding SampleDate}"
                                           MinWidth="640"
                                           HorizontalAlignment="Stretch" />
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:CalendarShowCaseLangResource NoticeCalendarTitle}"
                                      Description="{gallery:CalendarShowCaseLangResource NoticeCalendarDescription}"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CalendarViewModel">
                            <atom:Calendar Value="{Binding SampleDate}"
                                           MinWidth="640"
                                           HorizontalAlignment="Stretch">
                                <atom:Calendar.CellTemplate>
                                    <DataTemplate x:DataType="atom:CalendarCellContext">
                                        <Grid>
                                            <atom:ScrollViewer IsLiteMode="True"
                                                               AllowAutoHide="True"
                                                               MaxHeight="74"
                                                               VerticalScrollBarVisibility="Auto"
                                                               HorizontalScrollBarVisibility="Disabled"
                                                               IsScrollChainingEnabled="False"
                                                               ClipToBounds="True"
                                                               IsVisible="{Binding ., Converter={StaticResource NoticeCalendarDateCellVisibilityConverter}}">
                                                <StackPanel Margin="0,4,0,0" Spacing="4">
                                                    <Grid ColumnDefinitions="14,*"
                                                          MinHeight="22"
                                                          ClipToBounds="True"
                                                          IsVisible="{Binding ., Converter={StaticResource NoticeCalendarDateEventVisibilityConverter}, ConverterParameter=8|10|15}">
                                                        <atom:DotBadge Status="Warning" VerticalAlignment="Center" />
                                                        <atom:TextBlock Grid.Column="1"
                                                                        Text="{gallery:CalendarShowCaseLangResource NoticeCalendarWarningEventText}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="14,*"
                                                          MinHeight="22"
                                                          ClipToBounds="True"
                                                          IsVisible="{Binding ., Converter={StaticResource NoticeCalendarDateEventVisibilityConverter}, ConverterParameter=8|10}">
                                                        <atom:DotBadge Status="Success" VerticalAlignment="Center" />
                                                        <atom:TextBlock Grid.Column="1"
                                                                        Text="{gallery:CalendarShowCaseLangResource NoticeCalendarUsualEventText}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="14,*"
                                                          MinHeight="22"
                                                          ClipToBounds="True"
                                                          IsVisible="{Binding ., Converter={StaticResource NoticeCalendarDateEventVisibilityConverter}, ConverterParameter=10}">
                                                        <atom:DotBadge Status="Error" VerticalAlignment="Center" />
                                                        <atom:TextBlock Grid.Column="1"
                                                                        Text="{gallery:CalendarShowCaseLangResource NoticeCalendarErrorEventText}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="14,*"
                                                          MinHeight="22"
                                                          ClipToBounds="True"
                                                          IsVisible="{Binding ., Converter={StaticResource NoticeCalendarDateEventVisibilityConverter}, ConverterParameter=15}">
                                                        <atom:DotBadge Status="Success" VerticalAlignment="Center" />
                                                        <atom:TextBlock Grid.Column="1"
                                                                        Text="{gallery:CalendarShowCaseLangResource NoticeCalendarLongUsualEventText}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="14,*"
                                                          MinHeight="22"
                                                          ClipToBounds="True"
                                                          IsVisible="{Binding ., Converter={StaticResource NoticeCalendarDateEventVisibilityConverter}, ConverterParameter=15}">
                                                        <atom:DotBadge Status="Error" VerticalAlignment="Center" />
                                                        <atom:TextBlock Grid.Column="1"
                                                                        Text="{gallery:CalendarShowCaseLangResource NoticeCalendarErrorEvent1Text}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="14,*"
                                                          MinHeight="22"
                                                          ClipToBounds="True"
                                                          IsVisible="{Binding ., Converter={StaticResource NoticeCalendarDateEventVisibilityConverter}, ConverterParameter=15}">
                                                        <atom:DotBadge Status="Error" VerticalAlignment="Center" />
                                                        <atom:TextBlock Grid.Column="1"
                                                                        Text="{gallery:CalendarShowCaseLangResource NoticeCalendarErrorEvent2Text}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="14,*"
                                                          MinHeight="22"
                                                          ClipToBounds="True"
                                                          IsVisible="{Binding ., Converter={StaticResource NoticeCalendarDateEventVisibilityConverter}, ConverterParameter=15}">
                                                        <atom:DotBadge Status="Error" VerticalAlignment="Center" />
                                                        <atom:TextBlock Grid.Column="1"
                                                                        Text="{gallery:CalendarShowCaseLangResource NoticeCalendarErrorEvent3Text}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                    <Grid ColumnDefinitions="14,*"
                                                          MinHeight="22"
                                                          ClipToBounds="True"
                                                          IsVisible="{Binding ., Converter={StaticResource NoticeCalendarDateEventVisibilityConverter}, ConverterParameter=15}">
                                                        <atom:DotBadge Status="Error" VerticalAlignment="Center" />
                                                        <atom:TextBlock Grid.Column="1"
                                                                        Text="{gallery:CalendarShowCaseLangResource NoticeCalendarErrorEvent4Text}"
                                                                        TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                </StackPanel>
                                            </atom:ScrollViewer>
                                            <StackPanel HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Spacing="2"
                                                        IsVisible="{Binding ., Converter={StaticResource NoticeCalendarMonthBacklogVisibilityConverter}}">
                                                <atom:TextBlock Text="1394"
                                                                FontSize="{atom:SharedTokenResource FontSizeXL}"
                                                                FontWeight="SemiBold"
                                                                HorizontalAlignment="Center" />
                                                <atom:TextBlock Text="{gallery:CalendarShowCaseLangResource NoticeCalendarBacklogText}"
                                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                                HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </atom:Calendar.CellTemplate>
                            </atom:Calendar>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:CalendarShowCaseLangResource MiniTitle}"
                                      Description="{gallery:CalendarShowCaseLangResource MiniDescription}"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CalendarViewModel">
                            <atom:Calendar Value="{Binding SampleDate}" Fullscreen="False" Width="300" />
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:CalendarShowCaseLangResource YearModeTitle}"
                                      Description="{gallery:CalendarShowCaseLangResource YearModeDescription}"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CalendarViewModel">
                            <atom:Calendar Value="{Binding SampleDate}"
                                           Mode="Year"
                                           MinWidth="640"
                                           HorizontalAlignment="Stretch" />
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:CalendarShowCaseLangResource ShowWeekTitle}"
                                      Description="{gallery:CalendarShowCaseLangResource ShowWeekDescription}"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CalendarViewModel">
                            <atom:Calendar Value="{Binding SampleDate}"
                                           ShowWeek="True"
                                           MinWidth="640"
                                           HorizontalAlignment="Stretch" />
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:CalendarShowCaseLangResource RangeTitle}"
                                      Description="{gallery:CalendarShowCaseLangResource RangeDescription}"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CalendarViewModel">
                            <atom:Calendar Value="{Binding SampleDate}"
                                           ValidRange="{Binding SampleValidRange}"
                                           DisabledDate="{Binding DisableWeekends}"
                                           MinWidth="640"
                                           HorizontalAlignment="Stretch" />
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:CalendarShowCaseLangResource CellTemplateTitle}"
                                      Description="{gallery:CalendarShowCaseLangResource CellTemplateDescription}"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CalendarViewModel">
                            <atom:Calendar Value="{Binding SampleDate}"
                                           MinWidth="640"
                                           HorizontalAlignment="Stretch">
                                <atom:Calendar.CellTemplate>
                                    <DataTemplate x:DataType="atom:CalendarCellContext">
                                        <Border IsVisible="{Binding IsInView}"
                                                Background="{atom:SharedTokenResource ColorInfoBg}"
                                                CornerRadius="2"
                                                Margin="0,2,0,0"
                                                Height="4" />
                                    </DataTemplate>
                                </atom:Calendar.CellTemplate>
                            </atom:Calendar>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:CalendarShowCaseLangResource FullCellTemplateTitle}"
                                      Description="{gallery:CalendarShowCaseLangResource FullCellTemplateDescription}"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CalendarViewModel">
                            <atom:Calendar Value="{Binding SampleDate}"
                                           MinWidth="640"
                                           HorizontalAlignment="Stretch">
                                <atom:Calendar.FullCellTemplate>
                                    <DataTemplate x:DataType="atom:CalendarCellContext">
                                        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                                CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="{Binding DisplayValue}" HorizontalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </atom:Calendar.FullCellTemplate>
                            </atom:Calendar>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:CalendarShowCaseLangResource HeaderTemplateTitle}"
                                      Description="{gallery:CalendarShowCaseLangResource HeaderTemplateDescription}"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CalendarViewModel">
                            <atom:Calendar Value="{Binding SampleDate}"
                                           MinWidth="640"
                                           HorizontalAlignment="Stretch">
                                <atom:Calendar.HeaderTemplate>
                                    <DataTemplate x:DataType="atom:CalendarHeaderContext">
                                        <Border Padding="8"
                                                Background="{atom:SharedTokenResource ColorFillQuaternary}"
                                                CornerRadius="4">
                                            <TextBlock Text="{Binding Value, StringFormat='{}{0:yyyy MMMM}'}"
                                                       HorizontalAlignment="Center" />
                                        </Border>
                                    </DataTemplate>
                                </atom:Calendar.HeaderTemplate>
                            </atom:Calendar>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem Title="{gallery:CalendarShowCaseLangResource EventsTitle}"
                                      Description="{gallery:CalendarShowCaseLangResource EventsDescription}"
                                      IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CalendarViewModel">
                            <StackPanel Orientation="Vertical" Spacing="12">
                                <atom:Calendar Value="{Binding SampleDate}"
                                               MinWidth="640"
                                               HorizontalAlignment="Stretch"
                                               ValueChanged="OnCalendarValueChanged"
                                               Selected="OnCalendarSelected"
                                               PanelChanged="OnCalendarPanelChanged" />
                                <atom:TextBlock Text="{Binding EventLog}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
