<gallery:ShowCaseItem
            Title="{gallery:TagShowCaseLangResource BasicTitle}"
            Description="{gallery:TagShowCaseLangResource BasicDescription}">
            <WrapPanel HorizontalAlignment="Left" Orientation="Horizontal">
                <atom:Tag Text="{gallery:TagShowCaseLangResource P2ContentTagN1}" />
                <atom:Tag Text="{gallery:TagShowCaseLangResource P2ContentLink}" />
                <atom:Tag IsClosable="true" Text="{gallery:TagShowCaseLangResource P2ContentPreventDefault}" />
                <atom:Tag IsClosable="True"
                          CloseIcon="{antdicons:AntDesignIconProvider Kind=CloseCircleOutlined}" Text="{gallery:TagShowCaseLangResource P2ContentTagN2}" />
            </WrapPanel>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:TagShowCaseLangResource CheckableTagTitle}"
            Description="{gallery:TagShowCaseLangResource CheckableTagDescription}">
            <atom:Form LabelColInfo="6*"
                       WrapperColInfo="18*"
                       MaxWidth="560"
                       HorizontalAlignment="Stretch">
                <atom:FormItem LabelText="{gallery:TagShowCaseLangResource P2LabelCheckable}">
                    <atom:CheckableTag Content="{gallery:TagShowCaseLangResource P2ContentYes}"
                                       IsChecked="{Binding IsCheckableTagChecked, Mode=TwoWay}" />
                </atom:FormItem>
                <atom:FormItem LabelText="{gallery:TagShowCaseLangResource P2LabelSingle}">
                    <atom:CheckableTagGroup Options="{Binding CheckableTagOptions}"
                                            CheckedItem="{Binding SingleCheckedTag, Mode=TwoWay}" />
                </atom:FormItem>
                <atom:FormItem LabelText="{gallery:TagShowCaseLangResource P2LabelMultiple}">
                    <atom:CheckableTagGroup IsMultiple="True"
                                            Options="{Binding CheckableTagOptions}"
                                            CheckedItems="{Binding MultipleCheckedTags, Mode=TwoWay}" />
                </atom:FormItem>
            </atom:Form>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:TagShowCaseLangResource ColorfulTagTitle}"
            Description="{gallery:TagShowCaseLangResource ColorfulTagDescription}">
            <StackPanel Orientation="Vertical">
                <atom:Separator Title="{gallery:TagShowCaseLangResource P2TextPresetsFilled}"
                                TitlePosition="Left"
                                FontWeight="SemiBold" />
                <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                    <atom:Tag TagColor="magenta" Variant="Filled">magenta</atom:Tag>
                    <atom:Tag TagColor="red" Variant="Filled">red</atom:Tag>
                    <atom:Tag TagColor="volcano" Variant="Filled">volcano</atom:Tag>
                    <atom:Tag TagColor="orange" Variant="Filled">orange</atom:Tag>
                    <atom:Tag TagColor="gold" Variant="Filled">gold</atom:Tag>
                    <atom:Tag TagColor="lime" Variant="Filled">lime</atom:Tag>
                    <atom:Tag TagColor="green" Variant="Filled">green</atom:Tag>
                    <atom:Tag TagColor="cyan" Variant="Filled">cyan</atom:Tag>
                    <atom:Tag TagColor="blue" Variant="Filled">blue</atom:Tag>
                    <atom:Tag TagColor="geekblue" Variant="Filled">geekblue</atom:Tag>
                    <atom:Tag TagColor="purple" Variant="Filled">purple</atom:Tag>
                </WrapPanel>

                <atom:Separator Title="{gallery:TagShowCaseLangResource P2TextPresetsSolid}"
                                TitlePosition="Left"
                                FontWeight="SemiBold" />
                <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                    <atom:Tag TagColor="magenta" Variant="Solid">magenta</atom:Tag>
                    <atom:Tag TagColor="red" Variant="Solid">red</atom:Tag>
                    <atom:Tag TagColor="volcano" Variant="Solid">volcano</atom:Tag>
                    <atom:Tag TagColor="orange" Variant="Solid">orange</atom:Tag>
                    <atom:Tag TagColor="gold" Variant="Solid">gold</atom:Tag>
                    <atom:Tag TagColor="lime" Variant="Solid">lime</atom:Tag>
                    <atom:Tag TagColor="green" Variant="Solid">green</atom:Tag>
                    <atom:Tag TagColor="cyan" Variant="Solid">cyan</atom:Tag>
                    <atom:Tag TagColor="blue" Variant="Solid">blue</atom:Tag>
                    <atom:Tag TagColor="geekblue" Variant="Solid">geekblue</atom:Tag>
                    <atom:Tag TagColor="purple" Variant="Solid">purple</atom:Tag>
                </WrapPanel>

                <atom:Separator Title="{gallery:TagShowCaseLangResource P2TextPresetsOutlined}"
                                TitlePosition="Left"
                                FontWeight="SemiBold" />
                <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                    <atom:Tag TagColor="magenta" Variant="Outlined">magenta</atom:Tag>
                    <atom:Tag TagColor="red" Variant="Outlined">red</atom:Tag>
                    <atom:Tag TagColor="volcano" Variant="Outlined">volcano</atom:Tag>
                    <atom:Tag TagColor="orange" Variant="Outlined">orange</atom:Tag>
                    <atom:Tag TagColor="gold" Variant="Outlined">gold</atom:Tag>
                    <atom:Tag TagColor="lime" Variant="Outlined">lime</atom:Tag>
                    <atom:Tag TagColor="green" Variant="Outlined">green</atom:Tag>
                    <atom:Tag TagColor="cyan" Variant="Outlined">cyan</atom:Tag>
                    <atom:Tag TagColor="blue" Variant="Outlined">blue</atom:Tag>
                    <atom:Tag TagColor="geekblue" Variant="Outlined">geekblue</atom:Tag>
                    <atom:Tag TagColor="purple" Variant="Outlined">purple</atom:Tag>
                </WrapPanel>

                <atom:Separator Title="{gallery:TagShowCaseLangResource P2TextCustomFilled}"
                                TitlePosition="Left"
                                FontWeight="SemiBold" />
                <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                    <atom:Tag TagColor="#f50" Variant="Filled">#f50</atom:Tag>
                    <atom:Tag TagColor="#2db7f5" Variant="Filled">#2db7f5</atom:Tag>
                    <atom:Tag TagColor="#87d068" Variant="Filled">#87d068</atom:Tag>
                    <atom:Tag TagColor="#108ee9" Variant="Filled">#108ee9</atom:Tag>
                </WrapPanel>

                <atom:Separator Title="{gallery:TagShowCaseLangResource P2TextCustomSolid}"
                                TitlePosition="Left"
                                FontWeight="SemiBold" />
                <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                    <atom:Tag TagColor="#f50" Variant="Solid">#f50</atom:Tag>
                    <atom:Tag TagColor="#2db7f5" Variant="Solid">#2db7f5</atom:Tag>
                    <atom:Tag TagColor="#87d068" Variant="Solid">#87d068</atom:Tag>
                    <atom:Tag TagColor="#108ee9" Variant="Solid">#108ee9</atom:Tag>
                </WrapPanel>

                <atom:Separator Title="{gallery:TagShowCaseLangResource P2TextCustomOutlined}"
                                TitlePosition="Left"
                                FontWeight="SemiBold" />
                <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                    <atom:Tag TagColor="#f50" Variant="Outlined">#f50</atom:Tag>
                    <atom:Tag TagColor="#2db7f5" Variant="Outlined">#2db7f5</atom:Tag>
                    <atom:Tag TagColor="#87d068" Variant="Outlined">#87d068</atom:Tag>
                    <atom:Tag TagColor="#108ee9" Variant="Outlined">#108ee9</atom:Tag>
                </WrapPanel>
            </StackPanel>

        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:TagShowCaseLangResource StatusTagTitle}"
            Description="{gallery:TagShowCaseLangResource StatusTagDescription}">
            <StackPanel Orientation="Vertical">
                <atom:Separator Title="{gallery:TagShowCaseLangResource P2TextStatusFilled}"
                                TitlePosition="Left"
                                FontWeight="SemiBold" />
                <WrapPanel HorizontalAlignment="Left">
                    <atom:Tag TagColor="success"
                              Variant="Filled"
                              Icon="{antdicons:AntDesignIconProvider Kind=CheckCircleOutlined}"
                              Text="{gallery:TagShowCaseLangResource P2ContentSuccess}" />
                    <atom:Tag TagColor="processing"
                              Variant="Filled"
                              Text="{gallery:TagShowCaseLangResource P2ContentProcessing}">
                        <atom:Tag.Icon>
                            <antdicons:SyncOutlined LoadingAnimation="Spin" />
                        </atom:Tag.Icon>
                    </atom:Tag>
                    <atom:Tag TagColor="warning"
                              Variant="Filled"
                              Icon="{antdicons:AntDesignIconProvider Kind=ExclamationCircleOutlined}"
                              Text="{gallery:TagShowCaseLangResource P2ContentWarning}" />
                    <atom:Tag TagColor="error"
                              Variant="Filled"
                              Icon="{antdicons:AntDesignIconProvider Kind=CloseCircleOutlined}"
                              Text="{gallery:TagShowCaseLangResource P2ContentError}" />
                    <atom:Tag TagColor="default"
                              Variant="Filled"
                              Icon="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}"
                              Text="{gallery:TagShowCaseLangResource P2ContentDefault}" />
                </WrapPanel>

                <atom:Separator Title="{gallery:TagShowCaseLangResource P2TextStatusSolid}"
                                TitlePosition="Left"
                                FontWeight="SemiBold" />
                <WrapPanel HorizontalAlignment="Left">
                    <atom:Tag TagColor="success"
                              Variant="Solid"
                              Icon="{antdicons:AntDesignIconProvider Kind=CheckCircleOutlined}"
                              Text="{gallery:TagShowCaseLangResource P2ContentSuccess}" />
                    <atom:Tag TagColor="processing"
                              Variant="Solid"
                              Text="{gallery:TagShowCaseLangResource P2ContentProcessing}">
                        <atom:Tag.Icon>
                            <antdicons:SyncOutlined LoadingAnimation="Spin" />
                        </atom:Tag.Icon>
                    </atom:Tag>
                    <atom:Tag TagColor="warning"
                              Variant="Solid"
                              Icon="{antdicons:AntDesignIconProvider Kind=ExclamationCircleOutlined}"
                              Text="{gallery:TagShowCaseLangResource P2ContentWarning}" />
                    <atom:Tag TagColor="error"
                              Variant="Solid"
                              Icon="{antdicons:AntDesignIconProvider Kind=CloseCircleOutlined}"
                              Text="{gallery:TagShowCaseLangResource P2ContentError}" />
                    <atom:Tag TagColor="default"
                              Variant="Solid"
                              Icon="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}"
                              Text="{gallery:TagShowCaseLangResource P2ContentDefault}" />
                </WrapPanel>

                <atom:Separator Title="{gallery:TagShowCaseLangResource P2TextStatusOutlined}"
                                TitlePosition="Left"
                                FontWeight="SemiBold" />
                <WrapPanel HorizontalAlignment="Left">
                    <atom:Tag TagColor="success"
                              Variant="Outlined"
                              Icon="{antdicons:AntDesignIconProvider Kind=CheckCircleOutlined}"
                              Text="{gallery:TagShowCaseLangResource P2ContentSuccess}" />
                    <atom:Tag TagColor="processing"
                              Variant="Outlined"
                              Text="{gallery:TagShowCaseLangResource P2ContentProcessing}">
                        <atom:Tag.Icon>
                            <antdicons:SyncOutlined LoadingAnimation="Spin" />
                        </atom:Tag.Icon>
                    </atom:Tag>
                    <atom:Tag TagColor="warning"
                              Variant="Outlined"
                              Icon="{antdicons:AntDesignIconProvider Kind=ExclamationCircleOutlined}"
                              Text="{gallery:TagShowCaseLangResource P2ContentWarning}" />
                    <atom:Tag TagColor="error"
                              Variant="Outlined"
                              Icon="{antdicons:AntDesignIconProvider Kind=CloseCircleOutlined}"
                              Text="{gallery:TagShowCaseLangResource P2ContentError}" />
                    <atom:Tag TagColor="default"
                              Variant="Outlined"
                              Icon="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}"
                              Text="{gallery:TagShowCaseLangResource P2ContentDefault}" />
                </WrapPanel>
            </StackPanel>

        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:TagShowCaseLangResource IconTitle}"
            Description="{gallery:TagShowCaseLangResource IconDescription}">
            <WrapPanel HorizontalAlignment="Left" Orientation="Horizontal">
                <atom:Tag TagColor="#55acee"
                          Icon="{antdicons:AntDesignIconProvider Kind=TwitterOutlined}" Text="{gallery:TagShowCaseLangResource P2ContentTwitter}" />
                <atom:Tag TagColor="#cd201f"
                          Icon="{antdicons:AntDesignIconProvider Kind=YoutubeOutlined}" Text="{gallery:TagShowCaseLangResource P2ContentYoutube}" />
                <atom:Tag TagColor="#3b5999"
                          Icon="{antdicons:AntDesignIconProvider Kind=FacebookOutlined}" Text="{gallery:TagShowCaseLangResource P2ContentFacebook}" />
                <atom:Tag TagColor="#55acee"
                          Icon="{antdicons:AntDesignIconProvider Kind=LinkedinOutlined}" Text="{gallery:TagShowCaseLangResource P2ContentLinkedin}" />
                <atom:Tag Text="{gallery:TagShowCaseLangResource P2TextMaterialIcon}" TagColor="#55acee">
                    <atom:Tag.Icon>
                        <PathIcon Data="M240-200h120v-240h240v240h120v-360L480-740 240-560v360Zm-80 80v-480l320-240 320 240v480H520v-240h-80v240H160Zm320-350Z"/>
                    </atom:Tag.Icon></atom:Tag>
            </WrapPanel>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:TagShowCaseLangResource VariantTitle}"
            Description="{gallery:TagShowCaseLangResource VariantDescription}">
            <StackPanel Orientation="Vertical">
                <atom:TextBlock FontWeight="Bold" FontSize="14" Margin="0, 0, 0, 10" Text="{gallery:TagShowCaseLangResource P2TextVariants}" />
                <WrapPanel HorizontalAlignment="Left">
                    <atom:Tag Variant="Filled" Text="{gallery:TagShowCaseLangResource P2ContentFilled}" />
                    <atom:Tag Variant="Solid" Text="{gallery:TagShowCaseLangResource P2ContentSolid}" />
                    <atom:Tag Variant="Outlined" Text="{gallery:TagShowCaseLangResource P2ContentOutlined}" />
                </WrapPanel>

                <atom:TextBlock FontWeight="Bold" FontSize="14" Margin="0, 20, 0, 10" Text="{gallery:TagShowCaseLangResource P2TextPresetVariant}" />
                <WrapPanel HorizontalAlignment="Left">
                    <atom:Tag TagColor="blue" Variant="Filled" Text="{gallery:TagShowCaseLangResource P2ContentBlue}" />
                    <atom:Tag TagColor="blue" Variant="Solid" Text="{gallery:TagShowCaseLangResource P2ContentBlue}" />
                    <atom:Tag TagColor="blue" Variant="Outlined" Text="{gallery:TagShowCaseLangResource P2ContentBlue}" />
                </WrapPanel>

                <atom:TextBlock FontWeight="Bold" FontSize="14" Margin="0, 20, 0, 10" Text="{gallery:TagShowCaseLangResource P2TextStatusVariant}" />
                <WrapPanel HorizontalAlignment="Left">
                    <atom:Tag TagColor="success" Variant="Filled" Text="{gallery:TagShowCaseLangResource P2ContentSuccess}" />
                    <atom:Tag TagColor="success" Variant="Solid" Text="{gallery:TagShowCaseLangResource P2ContentSuccess}" />
                    <atom:Tag TagColor="success" Variant="Outlined" Text="{gallery:TagShowCaseLangResource P2ContentSuccess}" />
                </WrapPanel>

                <atom:TextBlock FontWeight="Bold" FontSize="14" Margin="0, 20, 0, 10" Text="{gallery:TagShowCaseLangResource P2TextCustomVariant}" />
                <WrapPanel HorizontalAlignment="Left">
                    <atom:Tag TagColor="#1677ff" Variant="Filled" Text="#1677ff" />
                    <atom:Tag TagColor="#1677ff" Variant="Solid" Text="#1677ff" />
                    <atom:Tag TagColor="#1677ff" Variant="Outlined" Text="#1677ff" />
                </WrapPanel>
            </StackPanel>

        </gallery:ShowCaseItem>
