<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <RootNamespace>Acme.LocalizationConsumer</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <FixturePackageVersion Condition="'$(FixturePackageVersion)' == ''">1.0.0</FixturePackageVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Headless" />
        <PackageReference Include="Acme.LocalizationComponent" VersionOverride="$(FixturePackageVersion)" />
        <PackageReference Include="Acme.LocalizationComponent.I18n.JaJP" VersionOverride="$(FixturePackageVersion)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../../../src/AtomUI.Core/AtomUI.Core.csproj" />
        <ProjectReference Include="../../../../src/AtomUI.Generator/AtomUI.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
    </ItemGroup>
</Project>
