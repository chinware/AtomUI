<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             x:Class="AtomUI.Desktop.Controls.TestApp.Scenarios.PopupInDialog.PopupInDialogScenario">
    <UserControl.Styles>
        <Style Selector="Border.direct-popup-surface">
            <Setter Property="Background"
                    Value="{atom:SharedTokenResource ColorBgElevated}" />
        </Style>
    </UserControl.Styles>
    <Grid>
        <ScrollViewer>
            <Border Padding="32"
                    Background="{atom:SharedTokenResource ColorBgLayout}">
                <StackPanel Spacing="24">
                    <StackPanel Spacing="8">
                        <TextBlock FontSize="28"
                                   FontWeight="SemiBold"
                                   Text="Popup in Dialog 回归" />
                        <TextBlock Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                   Text="Issue #441 · owning TopLevel · Overlay / LightDismiss / Popup 家族矩阵" />
                    </StackPanel>

                    <Border Padding="20"
                            BorderThickness="1"
                            BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                            Background="{atom:SharedTokenResource ColorBgContainer}"
                            CornerRadius="6">
                        <Grid ColumnDefinitions="190,*" RowDefinitions="Auto,16,Auto">
                            <TextBlock VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="页面内 ComboBox" />
                            <atom:ComboBox Grid.Column="1"
                                           Width="300"
                                           HorizontalAlignment="Left"
                                           PlaceholderText="选择页面内选项">
                                <atom:ComboBoxItem>页面选项 A</atom:ComboBoxItem>
                                <atom:ComboBoxItem>页面选项 B</atom:ComboBoxItem>
                                <atom:ComboBoxItem>页面选项 C</atom:ComboBoxItem>
                            </atom:ComboBox>

                            <TextBlock Grid.Row="2"
                                       VerticalAlignment="Center"
                                       FontWeight="SemiBold"
                                       Text="原始 Issue #441 场景" />
                            <atom:Button Grid.Row="2"
                                         Grid.Column="1"
                                         Width="180"
                                         HorizontalAlignment="Left"
                                         ButtonType="Primary"
                                         Content="打开 ComboBox Dialog"
                                         Click="HandleOpenBasicDialog" />
                        </Grid>
                    </Border>

                    <Border Padding="20"
                            BorderThickness="1"
                            BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                            Background="{atom:SharedTokenResource ColorBgContainer}"
                            CornerRadius="6">
                        <StackPanel Spacing="14">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Popup 家族人工矩阵" />
                            <TextBlock Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                       TextWrapping="Wrap"
                                       Text="每组必须由用户打开 Dialog，再点击其中的下拉、菜单或弹层。预期：弹层可见、可操作、可关闭，Dialog 保持打开且进程不崩溃。" />
                            <WrapPanel ItemSpacing="12" LineSpacing="12">
                                <atom:Button Content="选择器"
                                             Click="HandleOpenSelectorFamily" />
                                <atom:Button Content="自动建议"
                                             Click="HandleOpenSuggestionFamily" />
                                <atom:Button Content="日期 / 颜色 Picker"
                                             Click="HandleOpenPickerFamily" />
                                <atom:Button Content="Popup / Flyout / ToolTip"
                                             Click="HandleOpenPrimitiveFamily" />
                                <atom:Button Content="Menu / NavMenu / Tour"
                                             Click="HandleOpenMenuAndTourFamily" />
                                <atom:Button Content="Avatar / Transfer / Tab / DataGrid"
                                             Click="HandleOpenDelegatedConsumerFamily" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Padding="16"
                            BorderThickness="1"
                            BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                            Background="{atom:SharedTokenResource ColorBgContainer}"
                            CornerRadius="6">
                        <Grid ColumnDefinitions="Auto,16,*">
                            <TextBlock FontWeight="SemiBold"
                                       Text="最近状态" />
                            <TextBlock Name="LastStatusText"
                                       Grid.Column="2"
                                       Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                       Text="尚未执行" />
                        </Grid>
                    </Border>

                    <Border Padding="16"
                            BorderThickness="1"
                            BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                            Background="{atom:SharedTokenResource ColorBgContainer}"
                            CornerRadius="6">
                        <StackPanel Spacing="10">
                            <TextBlock FontWeight="SemiBold"
                                       Text="交互日志" />
                            <TextBox Name="EventLogTextBox"
                                     Height="220"
                                     AcceptsReturn="True"
                                     IsReadOnly="True"
                                     FontFamily="monospace"
                                     FontSize="12"
                                     TextWrapping="NoWrap"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <atom:Dialog Name="BasicDialog"
                     Title="Dialog 内 ComboBox"
                     DialogHostType="Overlay"
                     IsModal="True"
                     IsResizable="True"
                     IsDragMovable="True"
                     HostWidth="480"
                     HostHeight="400"
                     StandardButtons="Cancel,Ok"
                     DefaultStandardButton="Ok">
            <StackPanel Spacing="16">
                <TextBlock Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                           Text="点击下拉并选择；再点击下拉外部，Dialog 不应关闭。" />
                <atom:ComboBox Name="DialogComboBox"
                               Width="320"
                               HorizontalAlignment="Left"
                               PlaceholderText="请选择一个选项"
                               SelectionChanged="HandleDialogComboBoxSelectionChanged">
                    <atom:ComboBoxItem>Dialog 选项 1</atom:ComboBoxItem>
                    <atom:ComboBoxItem>Dialog 选项 2</atom:ComboBoxItem>
                    <atom:ComboBoxItem>Dialog 选项 3</atom:ComboBoxItem>
                    <atom:ComboBoxItem>Dialog 选项 4</atom:ComboBoxItem>
                </atom:ComboBox>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <atom:Button Content="代码打开下拉"
                                 Click="HandleOpenDropDownFromCode" />
                    <TextBlock Name="DropDownStateText"
                               VerticalAlignment="Center"
                               Text="IsDropDownOpen = False" />
                </StackPanel>
                <TextBlock Name="DialogSelectionText"
                           Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                           Text="尚未选择" />
                <TextBlock Name="BasicOwnershipText"
                           TextWrapping="Wrap"
                           Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                           Text="TopLevel：Dialog 尚未打开" />
            </StackPanel>
        </atom:Dialog>

        <atom:Dialog Name="FamilyDialog"
                     DialogHostType="Overlay"
                     IsModal="True"
                     IsResizable="True"
                     IsDragMovable="True"
                     HostWidth="820"
                     HostHeight="620"
                     StandardButtons="Close">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Name="FamilyContentHost"
                            Margin="0,0,12,0"
                            Spacing="16" />
            </ScrollViewer>
        </atom:Dialog>
    </Grid>
</UserControl>
