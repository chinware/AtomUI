<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <IsPackable>false</IsPackable>
        <AssemblyName>AtomUI.LinkedRegistration.BinaryReference.Fixtures.Host</AssemblyName>
        <PublishAot>true</PublishAot>
        <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
        <CompilerGeneratedFilesOutputPath>$(IntermediateOutputPath)GeneratedFiles</CompilerGeneratedFilesOutputPath>
        <_FixtureConsumerAssembly>$(MSBuildThisFileDirectory)../../../.artifacts/bin/Release/net10.0/AtomUI.LinkedRegistration.BinaryReference.Fixtures.Consumer.dll</_FixtureConsumerAssembly>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Headless" />
        <Reference Include="AtomUI.LinkedRegistration.BinaryReference.Fixtures.Consumer">
            <HintPath>$(_FixtureConsumerAssembly)</HintPath>
            <Private>true</Private>
        </Reference>
        <ProjectReference Include="../../../src/AtomUI.Desktop.Controls/AtomUI.Desktop.Controls.csproj" />
        <ProjectReference Include="../../../src/AtomUI.Generator/AtomUI.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
        <ProjectReference Include="../../../src/AtomUI.Generator.LinkedPublish/AtomUI.Generator.LinkedPublish.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
    </ItemGroup>

    <Target Name="ValidateFixtureConsumerAssembly" BeforeTargets="ResolveReferences">
        <Error Condition="!Exists('$(_FixtureConsumerAssembly)')"
               Text="Build the ordinary Consumer fixture before the binary Host fixture." />
    </Target>
</Project>
