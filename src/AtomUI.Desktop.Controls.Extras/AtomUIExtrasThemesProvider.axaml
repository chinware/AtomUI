<atom:ControlThemesProvider xmlns="https://github.com/avaloniaui"
                            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                            xmlns:atom="https://atomui.net"
                            x:Class="AtomUI.Desktop.Controls.AtomUIExtrasThemesProvider"
                            Id="AtomUI.Desktop.Controls.Extras"
                            x:ClassModifier="internal">
    <atom:ControlThemesProvider.ControlThemes>
        <ResourceInclude Source="Splash/Themes/SplashThemes.axaml" />
    </atom:ControlThemesProvider.ControlThemes>
</atom:ControlThemesProvider>
