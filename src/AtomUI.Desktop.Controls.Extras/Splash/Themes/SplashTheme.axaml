<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:Splash}" TargetType="atom:Splash">
        
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_SurfaceLayout"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Name="PART_ContentLayout"
                                    HorizontalAlignment="Stretch"
                                    Spacing="{atom:SplashTokenResource ContentGap}">
                            <ContentPresenter Name="PART_LogoPresenter"
                                              HorizontalAlignment="Center"
                                              Content="{TemplateBinding Logo}"
                                              ContentTemplate="{TemplateBinding LogoTemplate}" />
                            <atom:TextBlock Name="PART_TitleBlock"
                                            HorizontalAlignment="Center"
                                            TextAlignment="Center"
                                            Text="{TemplateBinding Title}" />
                            <atom:TextBlock Name="PART_SubtitleBlock"
                                            HorizontalAlignment="Center"
                                            TextAlignment="Center"
                                            Text="{TemplateBinding Subtitle}" />
                            <ContentPresenter Name="PART_ContentPresenter"
                                              HorizontalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                            <Panel Name="PART_ProgressLayout"
                                   Margin="{atom:SplashTokenResource ProgressMarginTop}">
                                <atom:Spin Name="PART_Spin"
                                           HorizontalAlignment="Center"
                                           IsSpinning="{TemplateBinding IsSpinVisible}"
                                           IsVisible="{TemplateBinding IsSpinVisible}" />
                                <atom:ProgressBar Name="PART_ProgressBar"
                                                  Minimum="0"
                                                  Maximum="1"
                                                  Value="{TemplateBinding ProgressValue}"
                                                  IsProgressInfoVisible="False"
                                                  IsVisible="{TemplateBinding IsProgressBarVisible}" />
                            </Panel>
                            <atom:TextBlock Name="PART_MessageBlock"
                                            HorizontalAlignment="Center"
                                            TextAlignment="Center"
                                            Text="{TemplateBinding Message}" />
                            <atom:TextBlock Name="PART_DetailBlock"
                                            HorizontalAlignment="Center"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap"
                                            Text="{TemplateBinding Detail}" />
                            <ContentPresenter Name="PART_FooterPresenter"
                                              HorizontalAlignment="Center"
                                              Margin="{atom:SplashTokenResource FooterMarginTop}"
                                              Content="{TemplateBinding Footer}"
                                              ContentTemplate="{TemplateBinding FooterTemplate}" />
                        </StackPanel>
                    </Border>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="CornerRadius" Value="{atom:SplashTokenResource SurfaceCornerRadius}" />
        <Setter Property="Background" Value="{atom:SplashTokenResource SurfaceBackground}" />
        <Setter Property="Padding" Value="{atom:SplashTokenResource ContentPadding}" />
        <Setter Property="Width" Value="{atom:SplashTokenResource WindowWidth}" />
        <Setter Property="MinHeight" Value="{atom:SplashTokenResource WindowMinHeight}" />
        <Setter Property="IsMotionEnabled" Value="{atom:SharedTokenResource EnableMotion}" />
        
        <Style Selector="^ /template/ ContentPresenter#PART_LogoPresenter">
            <Setter Property="Width" Value="{atom:SplashTokenResource LogoSize}" />
            <Setter Property="Height" Value="{atom:SplashTokenResource LogoSize}" />
        </Style>

        <Style Selector="^ /template/ atom|TextBlock#PART_TitleBlock">
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextHeading}" />
            <Setter Property="FontSize" Value="{atom:SplashTokenResource TitleFontSize}" />
            <Setter Property="LineHeight" Value="{atom:SplashTokenResource TitleLineHeight}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="^ /template/ atom|TextBlock#PART_SubtitleBlock">
            <Setter Property="Foreground" Value="{atom:SplashTokenResource SubtleForeground}" />
            <Setter Property="FontSize" Value="{atom:SplashTokenResource SubtitleFontSize}" />
        </Style>

        <Style Selector="^ /template/ atom|TextBlock#PART_MessageBlock">
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorText}" />
            <Setter Property="FontSize" Value="{atom:SplashTokenResource MessageFontSize}" />
        </Style>

        <Style Selector="^ /template/ atom|TextBlock#PART_DetailBlock">
            <Setter Property="Foreground" Value="{atom:SplashTokenResource SubtleForeground}" />
            <Setter Property="FontSize" Value="{atom:SplashTokenResource DetailFontSize}" />
        </Style>

        <Style Selector="^ /template/ atom|ProgressBar#PART_ProgressBar">
            <Setter Property="Height" Value="{atom:SplashTokenResource ProgressBarHeight}" />
        </Style>

        <Style Selector="^:success /template/ atom|TextBlock#PART_MessageBlock">
            <Setter Property="Foreground" Value="{atom:SplashTokenResource SuccessColor}" />
        </Style>

        <Style Selector="^:error /template/ atom|TextBlock#PART_MessageBlock">
            <Setter Property="Foreground" Value="{atom:SplashTokenResource ErrorColor}" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
