<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themeResources="using:AtomUI.Theme.Resources"
    xmlns:generated="using:AtomUI.Generated.AtomUI_Controls"
    themeResources:ControlTokenScope.Identity="{x:Static generated:IconThemeAsset.Identity}"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type PathIcon}" TargetType="PathIcon">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}">
                    <Viewbox Height="{TemplateBinding Height}"
                             Width="{TemplateBinding Width}">
                        <Path Fill="{TemplateBinding Foreground}"
                              Data="{TemplateBinding Data}" Stretch="Uniform" />
                    </Viewbox>
                </Border>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="Height" Value="{atom:SharedTokenResource IconSize}" />
        <Setter Property="Width" Value="{atom:SharedTokenResource IconSize}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorIcon}" />
        
    </ControlTheme>
</ResourceDictionary>
