<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themeResources="using:AtomUI.Theme.Resources"
    xmlns:generated="using:AtomUI.Generated.AtomUI_Controls"
    themeResources:ControlTokenScope.Identity="{x:Static generated:IconThemeAsset.Identity}"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:IconPresenter}" TargetType="atom:IconPresenter">
        <Setter Property="IconBrush" Value="{atom:SharedTokenResource ColorIconHover}" />
    </ControlTheme>
</ResourceDictionary>
