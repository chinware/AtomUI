<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal"
    xmlns:atom="https://atomui.net">
    <ControlTheme x:Key="{x:Type atom:DataGridHeaderViewItem}" TargetType="atom:DataGridHeaderViewItem">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame">
                    <atom:PixelAlignedBorder Name="{x:Static atom:DataGridHeaderViewItemThemeConstants.ContentPresenterPart}"
                                             BorderThickness="{TemplateBinding EffectiveBorderThickness}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </atom:PixelAlignedBorder>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ Border#PART_ContentPresenter">
            <Setter Property="atom:DashedBorder.Background" Value="{atom:DataGridTokenResource TableHeaderBg}" />
            <Setter Property="atom:DashedBorder.BorderBrush" Value="{atom:DataGridTokenResource TableBorderColor}" />
        </Style>

        <Setter Property="ClipToBounds" Value="False" />
        <Style Selector="^[IsFrozen=True]">

            <Setter Property="ZIndex" Value="1000" />
            <Style Selector="^[IsShowRightFrozenShadow=True]">
                <Style Selector="^ /template/ Border#Frame">
                    <Setter Property="BoxShadow"
                            Value="{atom:DataGridTokenResource RightFrozenShadows}" />
                </Style>
            </Style>
            <Style Selector="^[IsShowLeftFrozenShadow=True]">
                <Style Selector="^ /template/ Border#Frame">
                    <Setter Property="BoxShadow"
                            Value="{atom:DataGridTokenResource LeftFrozenShadows}" />
                </Style>
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
