<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:ColorBlock}" TargetType="atom:ColorBlock">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="PART_ColorPreviewFrame"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Background="{TemplateBinding TransparentBgBrush}"
                            IsVisible="{TemplateBinding IsEmptyColorMode, Converter={x:Static BoolConverters.Not}}">
                        <Border Name="PART_ColorPreview"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                BoxShadow="{atom:ColorPickerTokenResource ColorBlockInnerShadows}"/>
                    </Border>
                    <atom:PixelAlignedBorder Name="PART_EmptyColorFrame"
                                             CornerRadius="{TemplateBinding CornerRadius}"
                                             BorderThickness="{TemplateBinding BorderThickness}"
                                             IsVisible="{TemplateBinding IsEmptyColorMode}"
                                             Background="Transparent"/>
                </Panel>
                
            </ControlTemplate>
        </Setter>
        
        <Setter Property="TransparentBgIntervalColor" Value="{atom:ColorPickerTokenSharedTokenResource ColorFillSecondary}" />
        <Setter Property="TransparentBgSize" Value="{atom:ColorPickerTokenResource TransparentBgSize}" />
        <Setter Property="BorderThickness" Value="{atom:ColorPickerTokenSharedTokenResource BorderThickness}" />
        
        <Style Selector="^[IsEmptyColorMode=True]">
            <Setter Property="Cursor" Value="Hand" />
            <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_EmptyColorFrame">
                <Setter Property="BorderBrush" Value="{atom:ColorPickerTokenSharedTokenResource ColorFillSecondary}" />
            </Style>
            
            <Style Selector="^:pointerover">
                <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_EmptyColorFrame">
                    <Setter Property="BorderBrush" Value="{atom:ColorPickerTokenSharedTokenResource ColorBorder}" />
                </Style>
            </Style>
        </Style>
        
        <Style Selector="^[IsCustomSize=False]">
            <Style Selector="^[SizeType=Large]">
                <Setter Property="Width" Value="{atom:ColorPickerTokenSharedTokenResource ControlHeight}" />
                <Setter Property="Height" Value="{atom:ColorPickerTokenSharedTokenResource ControlHeight}" />
                <Setter Property="CornerRadius" Value="{atom:ColorPickerTokenSharedTokenResource BorderRadius}" />
            </Style>

            <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
                <Setter Property="Width" Value="{atom:ColorPickerTokenSharedTokenResource ControlHeightSM}" />
                <Setter Property="Height" Value="{atom:ColorPickerTokenSharedTokenResource ControlHeightSM}" />
                <Setter Property="CornerRadius" Value="{atom:ColorPickerTokenSharedTokenResource BorderRadiusSM}" />
            </Style>

            <Style Selector="^[SizeType=Small]">
                <Setter Property="Width" Value="{atom:ColorPickerTokenSharedTokenResource ControlHeightXS}" />
                <Setter Property="Height" Value="{atom:ColorPickerTokenSharedTokenResource ControlHeightXS}" />
                <Setter Property="CornerRadius" Value="{atom:ColorPickerTokenSharedTokenResource BorderRadiusXS}" />
            </Style>
        </Style>
        
        <Style Selector="^[SizeType=Large]">
            <Setter Property="CornerRadius" Value="{atom:ColorPickerTokenSharedTokenResource BorderRadius}" />
        </Style>

        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Setter Property="CornerRadius" Value="{atom:ColorPickerTokenSharedTokenResource BorderRadiusSM}" />
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Setter Property="CornerRadius" Value="{atom:ColorPickerTokenSharedTokenResource BorderRadiusXS}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
