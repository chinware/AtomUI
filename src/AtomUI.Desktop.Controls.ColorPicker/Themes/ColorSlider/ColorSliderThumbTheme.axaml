<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themeResources="using:AtomUI.Theme.Resources"
    xmlns:generated="using:AtomUI.Generated.AtomUI_Desktop_Controls_ColorPicker"
    themeResources:ControlTokenScope.Identity="{x:Static generated:ColorPickerThemeAsset.Identity}"
    x:ClassModifier="internal">

    <ControlTheme x:Key="{x:Type atom:ColorSliderThumb}" TargetType="atom:ColorSliderThumb">
        <Setter Property="Template">
            <ControlTemplate>
                <atom:PixelAlignedBorder Name="PART_Frame"
                                         Background="{atom:SharedTokenResource ColorBgElevated}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         BorderThickness="{TemplateBinding BorderThickness}"
                                         Padding="2"
                                         CornerRadius="{TemplateBinding CornerRadius}">
                    <atom:PixelAlignedBorder Name="PART_InnerEllipse"
                                             BorderBrush="{atom:SharedTokenResource ColorFillSecondary}"
                                             CornerRadius="{TemplateBinding InnerCornerRadius}"
                                             BorderThickness="{TemplateBinding BorderThickness}"
                                             Background="{TemplateBinding ColorValueBrush}">
                    </atom:PixelAlignedBorder>
                </atom:PixelAlignedBorder>
            </ControlTemplate>
        </Setter>

        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorFillSecondary}" />
        <Setter Property="BorderThickness" Value="{atom:SharedTokenResource BorderThickness}" />
        
        <Setter Property="Width"
                Value="{atom:ColorPickerTokenResource ColorPickerSliderThumbSize}" />
        <Setter Property="Height"
                Value="{atom:ColorPickerTokenResource ColorPickerSliderThumbSize}" />
        
        <Style Selector="^:focus,^:pressed">
            <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorPrimaryActive}" />
        </Style>
    </ControlTheme>

</ResourceDictionary>
