<ControlTheme
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:Class="AtomUI.Desktop.Controls.Themes.AbstractColorPickerTheme"
    TargetType="atom:AbstractColorPicker"
    x:ClassModifier="internal">

    <Style Selector="^:is(atom|AbstractColorPicker)">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Placement" Value="BottomEdgeAlignedLeft" />
        <Setter Property="IsMotionEnabled" Value="{atom:ColorPickerTokenSharedTokenResource EnableMotion}" />
        <Setter Property="BorderBrush" Value="{atom:ColorPickerTokenSharedTokenResource ColorBorder}" />
        <Setter Property="BorderThickness" Value="{atom:ColorPickerTokenSharedTokenResource BorderThickness}" />
        <Setter Property="Background" Value="{atom:ColorPickerTokenSharedTokenResource ColorBgElevated}" />
        <Setter Property="Padding" Value="{atom:ColorPickerTokenResource TriggerPadding}" />
        <Setter Property="TriggerPadding" Value="{atom:ColorPickerTokenResource TriggerPadding}" />
        <Setter Property="EmptyColorText" Value="{atom:ColorPickerLangResource EmptyColorText}" />
        <Setter Property="IsArrowVisible" Value="True" />
        <Setter Property="ShouldUseOverlayPopup" Value="True" />
        <Setter Property="MarginToAnchor" Value="{atom:PopupHostTokenResource MarginToAnchor}" />

        <Style Selector="^:pointerover, ^:flyout-open">
            <Setter Property="BorderBrush" Value="{atom:ColorPickerTokenSharedTokenResource ColorPrimaryHover}" />
        </Style>
        
        <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_Frame">
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <Transitions>
                    <atom:SolidColorBrushTransition Property="BorderBrush" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="^[Status=Error]">
            <Setter Property="BorderBrush"
                    Value="{atom:ColorPickerTokenSharedTokenResource ColorError}" />
        </Style>
        
        <Style Selector="^[Status=Warning]">
            <Setter Property="BorderBrush"
                    Value="{atom:ColorPickerTokenSharedTokenResource ColorWarning}" />
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Setter Property="CornerRadius" Value="{atom:ColorPickerTokenSharedTokenResource BorderRadiusLG}" />
            <Setter Property="FontSize" Value="{atom:ColorPickerTokenSharedTokenResource FontSizeLG}" />
        </Style>

        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Setter Property="CornerRadius" Value="{atom:ColorPickerTokenSharedTokenResource BorderRadius}" />
            <Setter Property="FontSize" Value="{atom:ColorPickerTokenSharedTokenResource FontSize}" />
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Setter Property="CornerRadius" Value="{atom:ColorPickerTokenSharedTokenResource BorderRadiusSM}" />
            <Setter Property="FontSize" Value="{atom:ColorPickerTokenSharedTokenResource FontSizeSM}" />
            <Style Selector="^ /template/ TextBlock#PART_ColorText">
                <Setter Property="Height" Value="{atom:ColorPickerTokenSharedTokenResource ControlHeightXS}" />
            </Style>
        </Style>

        <Style Selector="^ /template/ TextBlock#PART_ColorText">
            <Setter Property="Foreground" Value="{atom:ColorPickerTokenSharedTokenResource ColorText}" />
            <Setter Property="Margin" Value="{atom:ColorPickerTokenResource TriggerTextMargin}"/>
        </Style>

        <Style Selector="^:disabled">
            <Style Selector="^ /template/ TextBlock#PART_ColorText">
                <Setter Property="Foreground"
                        Value="{atom:ColorPickerTokenSharedTokenResource ColorTextDisabled}" />
            </Style>
            <Setter Property="Background"
                    Value="{atom:ColorPickerTokenSharedTokenResource ColorBgContainerDisabled}" />
            <Style Selector="^ /template/ atom|ColorBlock#PART_ColorIndicator">
                <Setter Property="Opacity"
                        Value="{atom:ColorPickerTokenResource ColorBlockDisabledOpacity}" />
            </Style>
        </Style>
    </Style>

</ControlTheme>
