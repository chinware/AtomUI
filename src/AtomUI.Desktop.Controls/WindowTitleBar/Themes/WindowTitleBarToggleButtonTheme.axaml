<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:WindowTitleBarToggleButton}"
                  TargetType="atom:WindowTitleBarToggleButton"
                  x:Class="AtomUI.Desktop.Controls.Themes.WindowTitleBarToggleButtonTheme">
        <ControlTheme.BasedOn>
            <themes:ToggleIconButtonTheme TargetType="{x:Type atom:WindowTitleBarToggleButton}" />
        </ControlTheme.BasedOn>

        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Padding" Value="{atom:WindowTitleBarTokenResource CaptionButtonPadding}" />
        <Setter Property="IconWidth" Value="{atom:WindowTitleBarTokenResource CaptionButtonIconSize}" />
        <Setter Property="IconHeight" Value="{atom:WindowTitleBarTokenResource CaptionButtonIconSize}" />
        <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadiusSM}" />
        <Setter Property="Background" Value="{atom:WindowTitleBarTokenResource ActiveBgColor}" />
        <Setter Property="IconBrush" Value="{atom:WindowTitleBarTokenResource ActiveColor}" />

        <Style Selector="^[IsWindowActive=False]">
            <Setter Property="Background" Value="{atom:WindowTitleBarTokenResource InactiveBgColor}" />
            <Setter Property="IconBrush" Value="{atom:WindowTitleBarTokenResource InactiveColor}" />
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{atom:WindowTitleBarTokenResource InactiveHoverBgColor}" />
            </Style>
        </Style>

        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{atom:WindowTitleBarTokenResource ActiveHoverBgColor}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Background" Value="{atom:WindowTitleBarTokenResource ActivePressedBgColor}" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="IconBrush" Value="{atom:SharedTokenResource ColorTextDisabled}" />
        </Style>

        <Style Selector="^[HostMotionEnabled=False]">
            <Setter Property="IsMotionEnabled" Value="False" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
