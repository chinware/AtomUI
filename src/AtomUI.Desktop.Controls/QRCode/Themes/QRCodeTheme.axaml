<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:ClassModifier="internal"
    xmlns:atom="https://atomui.net">
    <ControlTheme x:Key="{x:Type atom:QRCode}" TargetType="atom:QRCode">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame"
                        Width="{TemplateBinding Size}"
                        Height="{TemplateBinding Size}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <Panel>
                        <Panel Name="PART_ImageHost">
                            <Image Source="{TemplateBinding Bitmap}" />
                        </Panel>
                        <Border Name="Mask" IsVisible="False" />
                        <Panel Name="PART_StatusHost" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Color" Value="{atom:QRCodeTokenResource QRCodeTextColor}" />
        <Setter Property="Foreground" Value="{atom:QRCodeTokenResource QRCodeTextColor}" />
        <Setter Property="Background" Value="Transparent" />
        
        <Setter Property="IconBgColor" Value="{atom:SharedTokenResource ColorBgContainer}" />
        <Setter Property="BorderThickness"
                Value="{atom:SharedTokenResource BorderThickness}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadiusLG}" />

        <Style Selector="^[IsBordered=True]">
            <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorSplit}" />
            <Style Selector="^ /template/ Border#Frame">
                <Setter Property="Padding"
                        Value="{atom:SharedTokenResource PaddingSM}" />
            </Style>
        </Style>

        <Style Selector="^ /template/ Border#Mask">
            <Setter Property="Background"
                    Value="{atom:QRCodeTokenResource QRCodeMaskBackgroundColor}" />
        </Style>

        <Style Selector="^ /template/ Border#ImageFrame">
            <Setter Property="Padding"
                    Value="{atom:SharedTokenResource PaddingXXS}" />
        </Style>

        <Style Selector="^[Status=Active]">
            <Style Selector="^ /template/ Border#Mask">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>

        <Style Selector="^:not(^[Status=Active])">
            <Style Selector="^ /template/ Border#Mask">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>

    </ControlTheme>
</ResourceDictionary>
