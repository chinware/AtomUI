<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:CascaderViewFilterList}" TargetType="atom:CascaderViewFilterList">
        <ControlTheme.BasedOn>
            <atom:ListBoxTheme TargetType="atom:CascaderViewFilterList" />
        </ControlTheme.BasedOn>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type atom:CascaderViewFilterListItem}" TargetType="atom:CascaderViewFilterListItem">
        <ControlTheme.BasedOn>
            <atom:ListBoxItemTheme TargetType="atom:CascaderViewFilterListItem" />
        </ControlTheme.BasedOn>

        <Style Selector="^:is(atom|CascaderViewFilterListItem)">
            <Style Selector="^[IsSelected=False][IsCandidateSelected=True]">
                <Setter Property="Background" Value="{atom:ListViewTokenResource ItemHoverBgColor}" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
