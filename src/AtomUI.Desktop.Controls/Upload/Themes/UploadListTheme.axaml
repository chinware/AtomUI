<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:UploadList}" TargetType="atom:UploadList">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        ClipToBounds="True">
                    <atom:ScrollViewer IsLiteMode="True"
                                       AllowAutoHide="True"
                                       MaxHeight="{TemplateBinding ListMaxHeight}"
                                       HorizontalScrollBarVisibility="Disabled"
                                       VerticalScrollBarVisibility="{TemplateBinding ListScrollBarVisibility}">
                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
                    </atom:ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical"/>
            </ItemsPanelTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
