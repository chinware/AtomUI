<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              x:Class="AtomUI.Desktop.Controls.Themes.AbstractUploadPictureContentTheme"
              TargetType="atom:Button"
              x:ClassModifier="internal">
    <Style Selector="^:is(atom|AbstractUploadPictureContent)">
        <Setter Property="Background" Value="Transparent" />

        <Setter Property="CornerRadius" Value="{atom:UploadTokenSharedTokenResource BorderRadiusLG}" />
        <Setter Property="BorderBrush" Value="{atom:UploadTokenSharedTokenResource ColorBorder}" />
        <Setter Property="BorderThickness" Value="{atom:UploadTokenSharedTokenResource BorderThickness}" />
        <Setter Property="Padding" Value="{atom:UploadTokenSharedTokenResource PaddingXS}" />
        <Setter Property="Foreground" Value="{atom:UploadTokenSharedTokenResource ColorTextSecondary}" />
        
        <Style Selector="^[Status=Failed]">
            <Setter Property="Foreground" Value="{atom:UploadTokenSharedTokenResource ColorError}" />
            <Setter Property="BorderBrush" Value="{atom:UploadTokenSharedTokenResource ColorError}" />
        </Style>
        
        <Style Selector="^[Status=Cancelled]">
            <Setter Property="Foreground" Value="{atom:UploadTokenSharedTokenResource ColorError}" />
            <Setter Property="BorderBrush" Value="{atom:UploadTokenSharedTokenResource ColorError}" />
        </Style>
        
        <Style Selector="^ /template/ Border#Mask">
            <Setter Property="Background" Value="{atom:UploadTokenSharedTokenResource ColorBgMask}" />
            <Setter Property="TemplatedControl.Foreground"
                    Value="{atom:UploadTokenSharedTokenResource ColorTextLightSolid}" />
        </Style>

        <Style Selector="^[Status=Success]:pointerover">
            <Setter Property="MaskOpacity" Value="1" />
        </Style>

        <Style Selector="^[Status=Failed]:pointerover">
            <Setter Property="MaskOpacity" Value="1" />
        </Style>

        <Style Selector="^[Status=Cancelled]:pointerover">
            <Setter Property="MaskOpacity" Value="1" />
        </Style>
        
        <Style Selector="^ /template/ atom|IconButton">
            <Setter Property="IconBrush" Value="{atom:UploadTokenSharedTokenResource ColorTextLightSolid}" />
            <Setter Property="IconWidth" Value="{atom:UploadTokenSharedTokenResource FontSizeLG}" />
            <Setter Property="IconHeight" Value="{atom:UploadTokenSharedTokenResource FontSizeLG}" />
        </Style>
        
        <Style Selector="^ /template/ atom|IconButton:pointerover">
            <Setter Property="IconBrush" Value="{atom:UploadTokenSharedTokenResource ColorTextLightSolid}" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="MaskOpacity" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationSlow}" />
                </Transitions>
            </Setter>
        </Style>
    </Style>

</ControlTheme>
