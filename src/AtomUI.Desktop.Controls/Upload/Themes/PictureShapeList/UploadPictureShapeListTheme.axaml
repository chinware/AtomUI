<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themeResources="using:AtomUI.Theme.Resources"
    xmlns:generated="using:AtomUI.Generated.AtomUI_Desktop_Controls"
    themeResources:ControlTokenScope.Identity="{x:Static generated:UploadThemeAsset.Identity}"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:UploadPictureShapeList}" TargetType="atom:UploadPictureShapeList">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        ClipToBounds="True">
                    <ScrollViewer MaxHeight="{TemplateBinding ListMaxHeight}"
                                  VerticalScrollBarVisibility="{TemplateBinding ListScrollBarVisibility}">
                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}"/>
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <WrapPanel LineSpacing="{atom:SharedTokenResource SpacingXS}"
                           ItemSpacing="{atom:SharedTokenResource SpacingXS}"/>
            </ItemsPanelTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
