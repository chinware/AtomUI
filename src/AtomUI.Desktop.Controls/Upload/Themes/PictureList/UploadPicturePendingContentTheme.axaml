<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:UploadPicturePendingContent}" TargetType="atom:UploadPicturePendingContent">
        <ControlTheme.BasedOn>
            <atom:AbstractUploadPictureContentTheme TargetType="atom:UploadPicturePendingContent" />
        </ControlTheme.BasedOn>
        <Setter Property="Template">
            <ControlTemplate>
                <atom:PixelAlignedBorder Name="Frame"
                                         Background="{TemplateBinding Background}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         BorderThickness="{TemplateBinding BorderThickness}"
                                         CornerRadius="{TemplateBinding CornerRadius}"
                                         Padding="{TemplateBinding Padding}">
                    <DockPanel LastChildFill="True" Name="ContentLayout">
                        <antdicons:HistoryOutlined Name="Indicator" DockPanel.Dock="Left"/>
                        <atom:IconButton Icon="{antdicons:AntDesignIconProvider DeleteOutlined}"
                                         DockPanel.Dock="Right"
                                         Tag="{x:Static atom:UploadListActions.Remove}" 
                                         VerticalAlignment="Center"/>
                        <TextBlock Text="{atom:UploadLangResource Pending}"
                                   VerticalAlignment="Center" />
                    </DockPanel>
                </atom:PixelAlignedBorder>
            </ControlTemplate>
        </Setter>
        
        <Style Selector="^ /template/ DockPanel#ContentLayout">
            <Setter Property="HorizontalSpacing" Value="{atom:UploadTokenSharedTokenResource SpacingXS}" />
            <Setter Property="Height" Value="{atom:UploadTokenResource PictureListPreviewerSize}" />
        </Style>
        
        <Style Selector="^ /template/ atom|IconButton">
            <Setter Property="IconBrush" Value="{atom:UploadTokenSharedTokenResource ColorTextSecondary}" />
            <Setter Property="Padding" Value="{atom:UploadTokenSharedTokenResource PaddingXXS}" />
        </Style>
        
        <Style Selector="^ /template/ atom|Icon#Indicator">
            <Setter Property="StrokeBrush" Value="{atom:UploadTokenSharedTokenResource ColorTextSecondary}" />
            <Setter Property="Width" Value="{atom:UploadTokenResource UploadThumbnailSize}" />
            <Setter Property="Height" Value="{atom:UploadTokenResource UploadThumbnailSize}" />
        </Style>
        
        <Style Selector="^ /template/ atom|IconButton:pointerover">
            <Setter Property="IconBrush" Value="{atom:UploadTokenSharedTokenResource ColorTextSecondary}" />
            <Setter Property="Background" Value="{atom:UploadTokenSharedTokenResource ColorBgTextHover}" />
        </Style>
        
    </ControlTheme>
</ResourceDictionary>
