<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:atom="https://atomui.net"
                    xmlns:themeResources="using:AtomUI.Theme.Resources"
                    xmlns:generated="using:AtomUI.Generated.AtomUI_Desktop_Controls"
                    themeResources:ControlTokenScope.Identity="{x:Static generated:ButtonThemeAsset.Identity}"
                    xmlns:antdicons="https://atomui.net/icons/antdesign"
                    x:ClassModifier="internal">
    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="SplitButtonTheme.axaml" />
        <ResourceInclude Source="HyperLinkButtonTheme.axaml" />
    </ResourceDictionary.MergedDictionaries>
    <ControlTheme x:Key="{x:Type atom:Button}" TargetType="atom:Button">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <atom:WaveSpiritDecorator Name="PART_WaveSpirit"
                                              CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                              IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                              IsWaveSpiritEnabled="{TemplateBinding IsWaveSpiritEnabled}"
                                              WaveType="{TemplateBinding WaveSpiritType}" />
                    <Border Name="ShadowsFrame"
                            CornerRadius="{TemplateBinding EffectiveCornerRadius}" />
                    <atom:DashedBorder Name="Frame"
                                       Height="{TemplateBinding Height}"
                                       Padding="{TemplateBinding Padding}"
                                       BorderThickness="{TemplateBinding EffectiveBorderThickness}"
                                       BorderBrush="{TemplateBinding BorderBrush}"
                                       BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                       Background="{TemplateBinding Background}"
                                       CornerRadius="{TemplateBinding EffectiveCornerRadius}" />
                    <Border Name="CustomBackgroundLayer"
                            IsHitTestVisible="False"
                            Background="{TemplateBinding CustomBackground}"
                            CornerRadius="{TemplateBinding EffectiveCornerRadius}" />
                    <Border Padding="{TemplateBinding Padding}">
                        <DockPanel Name="PART_RootLayout"
                                   LastChildFill="True"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <antdicons:LoadingOutlined Name="PART_LoadingIcon"
                                                       DockPanel.Dock="Left"
                                                       LoadingAnimation="Spin" />
                            <atom:IconPresenter Name="PART_ButtonIcon"
                                                DockPanel.Dock="Left"
                                                Icon="{TemplateBinding Icon}"
                                                IconBrush="{TemplateBinding Foreground}"
                                                IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </DockPanel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^[ButtonType=Dashed]">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <atom:WaveSpiritDecorator Name="PART_WaveSpirit"
                                                  CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                                  IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                                  IsWaveSpiritEnabled="{TemplateBinding IsWaveSpiritEnabled}"
                                                  WaveType="{TemplateBinding WaveSpiritType}" />
                        <Border Name="ShadowsFrame"
                                CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                Background="{TemplateBinding Background}" />
                        <Border Name="CustomBackgroundLayer"
                                IsHitTestVisible="False"
                                Background="{TemplateBinding CustomBackground}"
                                CornerRadius="{TemplateBinding EffectiveCornerRadius}" />
                        <atom:DashedBorder Name="Frame"
                                           Height="{TemplateBinding Height}"
                                           Padding="{TemplateBinding Padding}"
                                           BorderThickness="{TemplateBinding EffectiveBorderThickness}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                           Background="{TemplateBinding Background}"
                                           CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                           StrokeDashArray="{x:Static atom:ButtonTheme.DashedStyle}">
                            <DockPanel Name="PART_RootLayout"
                                       LastChildFill="True"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <antdicons:LoadingOutlined Name="PART_LoadingIcon"
                                                           DockPanel.Dock="Left"
                                                           LoadingAnimation="Spin" />
                                <atom:IconPresenter Name="PART_ButtonIcon"
                                                    DockPanel.Dock="Left"
                                                    Icon="{TemplateBinding Icon}"
                                                    IconBrush="{TemplateBinding Foreground}"
                                                    IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </DockPanel>
                        </atom:DashedBorder>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^[EffectiveVariant=Dashed]">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <atom:WaveSpiritDecorator Name="PART_WaveSpirit"
                                                  CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                                  IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                                  IsWaveSpiritEnabled="{TemplateBinding IsWaveSpiritEnabled}"
                                                  WaveType="{TemplateBinding WaveSpiritType}" />
                        <Border Name="ShadowsFrame"
                                CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                Background="{TemplateBinding Background}" />
                        <Border Name="CustomBackgroundLayer"
                                IsHitTestVisible="False"
                                Background="{TemplateBinding CustomBackground}"
                                CornerRadius="{TemplateBinding EffectiveCornerRadius}" />
                        <atom:DashedBorder Name="Frame"
                                           Height="{TemplateBinding Height}"
                                           Padding="{TemplateBinding Padding}"
                                           BorderThickness="{TemplateBinding EffectiveBorderThickness}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                           Background="{TemplateBinding Background}"
                                           CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                           StrokeDashArray="{x:Static atom:ButtonTheme.DashedStyle}">
                            <DockPanel Name="PART_RootLayout"
                                       LastChildFill="True"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <antdicons:LoadingOutlined Name="PART_LoadingIcon"
                                                           DockPanel.Dock="Left"
                                                           LoadingAnimation="Spin" />
                                <atom:IconPresenter Name="PART_ButtonIcon"
                                                    DockPanel.Dock="Left"
                                                    Icon="{TemplateBinding Icon}"
                                                    IconBrush="{TemplateBinding Foreground}"
                                                    IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </DockPanel>
                        </atom:DashedBorder>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>

        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="{atom:SharedTokenResource BorderThickness}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="IsMotionEnabled" Value="{atom:SharedTokenResource EnableMotion}" />
        <Setter Property="IsWaveSpiritEnabled" Value="{atom:SharedTokenResource EnableWaveSpirit}" />

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <Transitions>
                    <atom:SolidColorBrushTransition Property="Background"
                                                    Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    <atom:SolidColorBrushTransition Property="Foreground"
                                                    Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    <atom:SolidColorBrushTransition Property="BorderBrush"
                                                    Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Setter Property="Height" Value="{atom:SharedTokenResource ControlHeightLG}" />
            <Setter Property="FontSize" Value="{atom:ButtonTokenResource ContentFontSizeLG}" />
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadiusLG}" />
            <Style Selector="^:not(^[Shape=Circle])">
                <Setter Property="Padding" Value="{atom:ButtonTokenResource PaddingLG}" />
            </Style>
            <Style Selector="^:icononly">
                <Setter Property="Padding" Value="{atom:ButtonTokenResource IconOnyPaddingLG}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Middle]">
            <Setter Property="Height" Value="{atom:SharedTokenResource ControlHeight}" />
            <Setter Property="FontSize" Value="{atom:ButtonTokenResource ContentFontSize}" />
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadius}" />
            <Style Selector="^:not(^[Shape=Circle])">
                <Setter Property="Padding" Value="{atom:ButtonTokenResource Padding}" />
            </Style>
            <Style Selector="^:icononly">
                <Setter Property="Padding" Value="{atom:ButtonTokenResource IconOnyPadding}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Setter Property="Height" Value="{atom:SharedTokenResource ControlHeightSM}" />
            <Setter Property="FontSize" Value="{atom:ButtonTokenResource ContentFontSizeSM}" />
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadiusSM}" />
            <Style Selector="^:not(^[Shape=Circle])">
                <Setter Property="Padding" Value="{atom:ButtonTokenResource PaddingSM}" />
            </Style>
            <Style Selector="^:icononly">
                <Setter Property="Padding" Value="{atom:ButtonTokenResource IconOnyPaddingSM}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Custom]">
            <Setter Property="Height" Value="{atom:SharedTokenResource ControlHeight}" />
            <Setter Property="FontSize" Value="{atom:ButtonTokenResource ContentFontSize}" />
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadius}" />
            <Style Selector="^:not(^[Shape=Circle])">
                <Setter Property="Padding" Value="{atom:ButtonTokenResource Padding}" />
            </Style>
            <Style Selector="^:icononly">
                <Setter Property="Padding" Value="{atom:ButtonTokenResource IconOnyPadding}" />
            </Style>
        </Style>

        <Style Selector="^[Shape=Circle]">
            <Setter Property="Padding" Value="{atom:ButtonTokenResource CirclePadding}" />
        </Style>

        <Style Selector="^[SizeType=Large] /template/ atom|IconPresenter#PART_ButtonIcon, ^[SizeType=Large] /template/ atom|Icon#PART_LoadingIcon">
            <Setter Property="Width" Value="{atom:SharedTokenResource IconSizeLG}" />
            <Setter Property="Height" Value="{atom:SharedTokenResource IconSizeLG}" />
        </Style>

        <Style Selector="^[SizeType=Middle] /template/ atom|IconPresenter#PART_ButtonIcon, ^[SizeType=Middle] /template/ atom|Icon#PART_LoadingIcon">
            <Setter Property="Width" Value="{atom:SharedTokenResource IconSize}" />
            <Setter Property="Height" Value="{atom:SharedTokenResource IconSize}" />
        </Style>

        <Style Selector="^[SizeType=Custom] /template/ atom|IconPresenter#PART_ButtonIcon, ^[SizeType=Custom] /template/ atom|Icon#PART_LoadingIcon">
            <Setter Property="Width" Value="{atom:SharedTokenResource IconSize}" />
            <Setter Property="Height" Value="{atom:SharedTokenResource IconSize}" />
        </Style>

        <Style Selector="^[SizeType=Small] /template/ atom|IconPresenter#PART_ButtonIcon, ^[SizeType=Small] /template/ atom|Icon#PART_LoadingIcon">
            <Setter Property="Width" Value="{atom:SharedTokenResource IconSizeSM}" />
            <Setter Property="Height" Value="{atom:SharedTokenResource IconSizeSM}" />
        </Style>

        <Style Selector="^:not(:icononly) /template/ atom|IconPresenter#PART_ButtonIcon, ^:not(:icononly) /template/ atom|Icon#PART_LoadingIcon">
            <Setter Property="Margin" Value="{atom:ButtonTokenResource IconMargin}" />
        </Style>

        <Style Selector="^:icononly /template/ atom|IconPresenter#PART_ButtonIcon, ^:icononly /template/ atom|Icon#PART_LoadingIcon">
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="^:icononly^[SizeType=Large] /template/ atom|IconPresenter#PART_ButtonIcon, ^:icononly^[SizeType=Large] /template/ atom|Icon#PART_LoadingIcon">
            <Setter Property="Width" Value="{atom:ButtonTokenResource OnlyIconSizeLG}" />
            <Setter Property="Height" Value="{atom:ButtonTokenResource OnlyIconSizeLG}" />
        </Style>

        <Style Selector="^:icononly^[SizeType=Middle] /template/ atom|IconPresenter#PART_ButtonIcon, ^:icononly^[SizeType=Middle] /template/ atom|Icon#PART_LoadingIcon">
            <Setter Property="Width" Value="{atom:ButtonTokenResource OnlyIconSize}" />
            <Setter Property="Height" Value="{atom:ButtonTokenResource OnlyIconSize}" />
        </Style>

        <Style Selector="^:icononly^[SizeType=Custom] /template/ atom|IconPresenter#PART_ButtonIcon, ^:icononly^[SizeType=Custom] /template/ atom|Icon#PART_LoadingIcon">
            <Setter Property="Width" Value="{atom:ButtonTokenResource OnlyIconSize}" />
            <Setter Property="Height" Value="{atom:ButtonTokenResource OnlyIconSize}" />
        </Style>

        <Style Selector="^:icononly^[SizeType=Small] /template/ atom|IconPresenter#PART_ButtonIcon, ^:icononly^[SizeType=Small] /template/ atom|Icon#PART_LoadingIcon">
            <Setter Property="Width" Value="{atom:ButtonTokenResource OnlyIconSizeSM}" />
            <Setter Property="Height" Value="{atom:ButtonTokenResource OnlyIconSizeSM}" />
        </Style>

        <Style Selector="^ /template/ atom|Icon#PART_LoadingIcon">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Foreground" Value="{TemplateBinding Foreground}" />
            <Setter Property="FillBrush" Value="{TemplateBinding Foreground}" />
            <Setter Property="StrokeBrush" Value="{TemplateBinding Foreground}" />
        </Style>

        <Style Selector="^:loading">
            <Setter Property="Opacity" Value="{atom:SharedTokenResource OpacityLoading}" />
            <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ atom|Icon#PART_LoadingIcon">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>

        <Style Selector="^ /template/ Border#CustomBackgroundLayer">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True] /template/ Border#CustomBackgroundLayer">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="^[HasCustomBackground=True] /template/ Border#CustomBackgroundLayer">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^[HasCustomBackground=True]:not(:pointerover):not(:pressed) /template/ Border#CustomBackgroundLayer">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextDisabled}" />
            <Setter Property="BorderBrush" Value="{atom:ButtonTokenResource BorderColorDisabled}" />
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgContainerDisabled}" />
        </Style>

        <Style Selector="^:not(:disabled)">
            <Setter Property="Foreground"
                    Value="{Binding VariantTextBrush, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Background"
                    Value="{Binding VariantBackgroundBrush, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderBrush"
                    Value="{Binding VariantBorderBrush, RelativeSource={RelativeSource Self}}" />
            <Style Selector="^:pointerover">
                <Setter Property="Foreground"
                        Value="{Binding VariantTextHoverBrush, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Background"
                        Value="{Binding VariantBackgroundHoverBrush, RelativeSource={RelativeSource Self}}" />
                <Setter Property="BorderBrush"
                        Value="{Binding VariantBorderHoverBrush, RelativeSource={RelativeSource Self}}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Foreground"
                        Value="{Binding VariantTextPressedBrush, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Background"
                        Value="{Binding VariantBackgroundPressedBrush, RelativeSource={RelativeSource Self}}" />
                <Setter Property="BorderBrush"
                        Value="{Binding VariantBorderPressedBrush, RelativeSource={RelativeSource Self}}" />
            </Style>
        </Style>

        <Style Selector="^[EffectiveVariant=Text]:disabled, ^[EffectiveVariant=Link]:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="^ /template/ Border#ShadowsFrame">
            <Setter Property="BoxShadow"
                    Value="{Binding VariantShadow, RelativeSource={RelativeSource TemplatedParent}}" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type atom:DropdownButton}" TargetType="atom:DropdownButton">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <atom:WaveSpiritDecorator Name="PART_WaveSpirit"
                                              CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                              IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                              IsWaveSpiritEnabled="{TemplateBinding IsWaveSpiritEnabled}"
                                              WaveType="{TemplateBinding WaveSpiritType}" />
                    <Border Name="ShadowsFrame"
                            CornerRadius="{TemplateBinding EffectiveCornerRadius}" />
                    <atom:DashedBorder Name="Frame"
                                       Height="{TemplateBinding Height}"
                                       Padding="{TemplateBinding Padding}"
                                       BorderThickness="{TemplateBinding EffectiveBorderThickness}"
                                       BorderBrush="{TemplateBinding BorderBrush}"
                                       BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                       Background="{TemplateBinding Background}"
                                       CornerRadius="{TemplateBinding EffectiveCornerRadius}" />
                    <Border Name="CustomBackgroundLayer"
                            IsHitTestVisible="False"
                            Background="{TemplateBinding CustomBackground}"
                            CornerRadius="{TemplateBinding EffectiveCornerRadius}" />
                    <Border Padding="{TemplateBinding Padding}">
                        <DockPanel Name="PART_RootLayout"
                                   LastChildFill="True"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <atom:IconPresenter Name="PART_DropdownIndicator"
                                                DockPanel.Dock="Right"
                                                VerticalAlignment="Center"
                                                Icon="{TemplateBinding OpenIndicator}"
                                                IconBrush="{TemplateBinding Foreground}"
                                                IsVisible="{TemplateBinding IsShowOpenIndicator}" />
                            <antdicons:LoadingOutlined Name="PART_LoadingIcon"
                                                       DockPanel.Dock="Left"
                                                       LoadingAnimation="Spin" />
                            <atom:IconPresenter Name="PART_ButtonIcon"
                                                DockPanel.Dock="Left"
                                                Icon="{TemplateBinding Icon}"
                                                IconBrush="{TemplateBinding Foreground}"
                                                IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <ContentPresenter Name="PART_ContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </DockPanel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="{atom:SharedTokenResource BorderThickness}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="IsMotionEnabled" Value="{atom:SharedTokenResource EnableMotion}" />
        <Setter Property="IsWaveSpiritEnabled" Value="{atom:SharedTokenResource EnableWaveSpirit}" />
        <Setter Property="MarginToAnchor" Value="{atom:PopupHostTokenResource MarginToAnchor}" />

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <Transitions>
                    <atom:SolidColorBrushTransition Property="Background"
                                                    Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    <atom:SolidColorBrushTransition Property="Foreground"
                                                    Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    <atom:SolidColorBrushTransition Property="BorderBrush"
                                                    Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Setter Property="Height" Value="{atom:SharedTokenResource ControlHeightLG}" />
            <Setter Property="FontSize" Value="{atom:ButtonTokenResource ContentFontSizeLG}" />
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadiusLG}" />
            <Setter Property="Padding" Value="{atom:ButtonTokenResource PaddingLG}" />
            <Style Selector="^ /template/ atom|IconPresenter#PART_DropdownIndicator">
                <Setter Property="Margin" Value="{atom:ButtonTokenResource ExtraContentMarginLG}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Middle]">
            <Setter Property="Height" Value="{atom:SharedTokenResource ControlHeight}" />
            <Setter Property="FontSize" Value="{atom:ButtonTokenResource ContentFontSize}" />
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadius}" />
            <Setter Property="Padding" Value="{atom:ButtonTokenResource Padding}" />
            <Style Selector="^ /template/ atom|IconPresenter#PART_DropdownIndicator">
                <Setter Property="Margin" Value="{atom:ButtonTokenResource ExtraContentMargin}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Setter Property="Height" Value="{atom:SharedTokenResource ControlHeightSM}" />
            <Setter Property="FontSize" Value="{atom:ButtonTokenResource ContentFontSizeSM}" />
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadiusSM}" />
            <Setter Property="Padding" Value="{atom:ButtonTokenResource PaddingSM}" />
            <Style Selector="^ /template/ atom|IconPresenter#PART_DropdownIndicator">
                <Setter Property="Margin" Value="{atom:ButtonTokenResource ExtraContentMarginSM}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Custom]">
            <Setter Property="Height" Value="{atom:SharedTokenResource ControlHeight}" />
            <Setter Property="FontSize" Value="{atom:ButtonTokenResource ContentFontSize}" />
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadius}" />
            <Setter Property="Padding" Value="{atom:ButtonTokenResource Padding}" />
            <Style Selector="^ /template/ atom|IconPresenter#PART_DropdownIndicator">
                <Setter Property="Margin" Value="{atom:ButtonTokenResource ExtraContentMargin}" />
            </Style>
        </Style>

        <Style Selector="^ /template/ atom|IconPresenter#PART_DropdownIndicator">
            <Setter Property="Width" Value="{atom:SharedTokenResource IconSizeSM}" />
            <Setter Property="Height" Value="{atom:SharedTokenResource IconSizeSM}" />
        </Style>

        <Style Selector="^:not(:icononly) /template/ atom|IconPresenter#PART_ButtonIcon, ^:not(:icononly) /template/ atom|Icon#PART_LoadingIcon">
            <Setter Property="Margin" Value="{atom:ButtonTokenResource IconMargin}" />
        </Style>

        <Style Selector="^ /template/ atom|Icon#PART_LoadingIcon">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Foreground" Value="{TemplateBinding Foreground}" />
            <Setter Property="FillBrush" Value="{TemplateBinding Foreground}" />
            <Setter Property="StrokeBrush" Value="{TemplateBinding Foreground}" />
        </Style>

        <Style Selector="^:loading">
            <Setter Property="Opacity" Value="{atom:SharedTokenResource OpacityLoading}" />
            <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ atom|Icon#PART_LoadingIcon">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>

        <Style Selector="^ /template/ Border#CustomBackgroundLayer">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True] /template/ Border#CustomBackgroundLayer">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="^[HasCustomBackground=True] /template/ Border#CustomBackgroundLayer">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^[HasCustomBackground=True]:not(:pointerover):not(:pressed) /template/ Border#CustomBackgroundLayer">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextDisabled}" />
            <Setter Property="BorderBrush" Value="{atom:ButtonTokenResource BorderColorDisabled}" />
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorBgContainerDisabled}" />
        </Style>

        <Style Selector="^:not(:disabled)">
            <Setter Property="Foreground"
                    Value="{Binding VariantTextBrush, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Background"
                    Value="{Binding VariantBackgroundBrush, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderBrush"
                    Value="{Binding VariantBorderBrush, RelativeSource={RelativeSource Self}}" />
            <Style Selector="^:pointerover">
                <Setter Property="Foreground"
                        Value="{Binding VariantTextHoverBrush, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Background"
                        Value="{Binding VariantBackgroundHoverBrush, RelativeSource={RelativeSource Self}}" />
                <Setter Property="BorderBrush"
                        Value="{Binding VariantBorderHoverBrush, RelativeSource={RelativeSource Self}}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Foreground"
                        Value="{Binding VariantTextPressedBrush, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Background"
                        Value="{Binding VariantBackgroundPressedBrush, RelativeSource={RelativeSource Self}}" />
                <Setter Property="BorderBrush"
                        Value="{Binding VariantBorderPressedBrush, RelativeSource={RelativeSource Self}}" />
            </Style>
        </Style>

        <Style Selector="^[EffectiveVariant=Text]:disabled, ^[EffectiveVariant=Link]:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="^ /template/ Border#ShadowsFrame">
            <Setter Property="BoxShadow"
                    Value="{Binding VariantShadow, RelativeSource={RelativeSource TemplatedParent}}" />
        </Style>
    </ControlTheme>
    <atom:IconButtonTheme x:Key="{x:Type atom:IconButton}" TargetType="atom:IconButton" />
</ResourceDictionary>
