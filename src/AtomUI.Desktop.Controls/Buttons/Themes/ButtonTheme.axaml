<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              xmlns:antdicons="https://atomui.net/icons/antdesign"
              x:Class="AtomUI.Desktop.Controls.Themes.ButtonTheme"
              TargetType="atom:Button">
    <Style Selector="^:is(atom|Button)">
        <Style Selector="^[ButtonType=Default], ^[ButtonType=Link], ^[ButtonType=Primary], ^[ButtonType=Text]">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <atom:WaveSpiritDecorator Name="PART_WaveSpirit"
                                                  CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                                  WaveType="{TemplateBinding WaveSpiritType}" />
                        <Border Name="ShadowsFrame"
                                CornerRadius="{TemplateBinding EffectiveCornerRadius}" />
                        <atom:DashedBorder Name="Frame"
                                           Height="{TemplateBinding Height}"
                                           Padding="{TemplateBinding Padding}"
                                           BorderThickness="{TemplateBinding EffectiveBorderThickness}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                           CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                           Background="{TemplateBinding Background}" />
                        <Border Name="CustomBackgroundLayer"
                                IsHitTestVisible="False"
                                Background="{TemplateBinding CustomBackground}"
                                CornerRadius="{TemplateBinding EffectiveCornerRadius}" />
                        <Border Padding="{TemplateBinding Padding}">
                            <DockPanel Name="PART_RootLayout"
                                       LastChildFill="True"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <antdicons:LoadingOutlined
                                    Name="PART_LoadingIcon"
                                    LoadingAnimation="Spin"
                                    FillBrush="{TemplateBinding Foreground}"
                                    StrokeBrush="{TemplateBinding Foreground}"
                                    DockPanel.Dock="Left" />

                                <atom:IconPresenter
                                    Name="PART_ButtonIcon"
                                    Icon="{TemplateBinding Icon}"
                                    IconBrush="{TemplateBinding Foreground}">
                                    <atom:IconPresenter.IsVisible>
                                        <MultiBinding
                                            Converter="{x:Static atom:ButtonTheme.IconVisibleConverter}">
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Icon" />
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}"
                                                     Path="IsIconVisible" />
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="IsLoading" />
                                        </MultiBinding>
                                    </atom:IconPresenter.IsVisible>
                                </atom:IconPresenter>
                                <ContentPresenter
                                    Name="PART_ContentPresenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </DockPanel>
                        </Border>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^[ButtonType=Dashed]">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <atom:WaveSpiritDecorator Name="PART_WaveSpirit"
                                                  CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                                  WaveType="{TemplateBinding WaveSpiritType}" />
                        <Border Name="ShadowsFrame"
                                CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                Background="{TemplateBinding Background}" />
                        <Border Name="CustomBackgroundLayer"
                                IsHitTestVisible="False"
                                Background="{TemplateBinding CustomBackground}"
                                CornerRadius="{TemplateBinding EffectiveCornerRadius}" />
                        <atom:DashedBorder Name="Frame"
                                           Height="{TemplateBinding Height}"
                                           Padding="{TemplateBinding Padding}"
                                           BorderThickness="{TemplateBinding EffectiveBorderThickness}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                           CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                           Background="{TemplateBinding Background}"
                                           StrokeDashArray="{x:Static atom:ButtonTheme.DashedStyle}">
                            <DockPanel Name="PART_RootLayout"
                                       LastChildFill="True"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <antdicons:LoadingOutlined
                                    Name="PART_LoadingIcon"
                                    LoadingAnimation="Spin"
                                    FillBrush="{TemplateBinding Foreground}"
                                    StrokeBrush="{TemplateBinding Foreground}"
                                    DockPanel.Dock="Left" />

                                <atom:IconPresenter
                                    Name="PART_ButtonIcon"
                                    Icon="{TemplateBinding Icon}"
                                    IconBrush="{TemplateBinding Foreground}">
                                    <atom:IconPresenter.IsVisible>
                                        <MultiBinding
                                            Converter="{x:Static atom:ButtonTheme.IconVisibleConverter}">
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Icon" />
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}"
                                                     Path="IsIconVisible" />
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="IsLoading" />
                                        </MultiBinding>
                                    </atom:IconPresenter.IsVisible>
                                </atom:IconPresenter>
                                <ContentPresenter
                                    Name="PART_ContentPresenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </DockPanel>
                        </atom:DashedBorder>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="^[EffectiveVariant=Dashed]">
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <atom:WaveSpiritDecorator Name="PART_WaveSpirit"
                                                  CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                                  WaveType="{TemplateBinding WaveSpiritType}" />
                        <Border Name="ShadowsFrame"
                                CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                Background="{TemplateBinding Background}" />
                        <Border Name="CustomBackgroundLayer"
                                IsHitTestVisible="False"
                                Background="{TemplateBinding CustomBackground}"
                                CornerRadius="{TemplateBinding EffectiveCornerRadius}" />
                        <atom:DashedBorder Name="Frame"
                                           Height="{TemplateBinding Height}"
                                           Padding="{TemplateBinding Padding}"
                                           BorderThickness="{TemplateBinding EffectiveBorderThickness}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                           CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                           Background="{TemplateBinding Background}"
                                           StrokeDashArray="{x:Static atom:ButtonTheme.DashedStyle}">
                            <DockPanel Name="PART_RootLayout"
                                       LastChildFill="True"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                <antdicons:LoadingOutlined
                                    Name="PART_LoadingIcon"
                                    LoadingAnimation="Spin"
                                    FillBrush="{TemplateBinding Foreground}"
                                    StrokeBrush="{TemplateBinding Foreground}"
                                    DockPanel.Dock="Left" />

                                <atom:IconPresenter
                                    Name="PART_ButtonIcon"
                                    Icon="{TemplateBinding Icon}"
                                    IconBrush="{TemplateBinding Foreground}">
                                    <atom:IconPresenter.IsVisible>
                                        <MultiBinding
                                            Converter="{x:Static atom:ButtonTheme.IconVisibleConverter}">
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Icon" />
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}"
                                                     Path="IsIconVisible" />
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="IsLoading" />
                                        </MultiBinding>
                                    </atom:IconPresenter.IsVisible>
                                </atom:IconPresenter>
                                <ContentPresenter
                                    Name="PART_ContentPresenter"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </DockPanel>
                        </atom:DashedBorder>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- 公用样式开始 -->

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <Transitions>
                    <atom:SolidColorBrushTransition Property="Background"
                                                    Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    <atom:SolidColorBrushTransition Property="Foreground"
                                                    Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    <atom:SolidColorBrushTransition Property="BorderBrush"
                                                    Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                </Transitions>
            </Setter>
        </Style>

        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="{atom:ButtonTokenSharedTokenResource BorderThickness}" />
        <Setter Property="IsMotionEnabled" Value="{atom:ButtonTokenSharedTokenResource EnableMotion}" />
        <Setter Property="IsWaveSpiritEnabled"
                Value="{atom:ButtonTokenSharedTokenResource EnableWaveSpirit}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />

        <Style Selector="^[SizeType=Large]">
            <Setter Property="Height" Value="{atom:ButtonTokenSharedTokenResource ControlHeightLG}" />
            <Setter Property="FontSize" Value="{atom:ButtonTokenResource ContentFontSizeLG}" />
            <Setter Property="CornerRadius" Value="{atom:ButtonTokenSharedTokenResource BorderRadiusLG}" />
            <Style Selector="^:not(^[Shape=Circle])">
                <Setter Property="Padding" Value="{atom:ButtonTokenResource PaddingLG}" />
            </Style>
            <Style Selector="^:icononly">
                <Setter Property="Padding" Value="{atom:ButtonTokenResource IconOnyPaddingLG}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Middle]">
            <Setter Property="Height" Value="{atom:ButtonTokenSharedTokenResource ControlHeight}" />
            <Setter Property="FontSize" Value="{atom:ButtonTokenResource ContentFontSize}" />
            <Setter Property="CornerRadius" Value="{atom:ButtonTokenSharedTokenResource BorderRadius}" />
            <Style Selector="^:not(^[Shape=Circle])">
                <Setter Property="Padding" Value="{atom:ButtonTokenResource Padding}" />
            </Style>
            <Style Selector="^:icononly">
                <Setter Property="Padding" Value="{atom:ButtonTokenResource IconOnyPadding}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Setter Property="Height" Value="{atom:ButtonTokenSharedTokenResource ControlHeightSM}" />
            <Setter Property="FontSize" Value="{atom:ButtonTokenResource ContentFontSizeSM}" />
            <Setter Property="CornerRadius" Value="{atom:ButtonTokenSharedTokenResource BorderRadiusSM}" />
            <Style Selector="^:not(^[Shape=Circle])">
                <Setter Property="Padding" Value="{atom:ButtonTokenResource PaddingSM}" />
            </Style>
            <Style Selector="^:icononly">
                <Setter Property="Padding" Value="{atom:ButtonTokenResource IconOnyPaddingSM}" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Custom]">
            <Setter Property="Height" Value="{atom:ButtonTokenSharedTokenResource ControlHeight}" />
            <Setter Property="FontSize" Value="{atom:ButtonTokenResource ContentFontSize}" />
            <Setter Property="CornerRadius" Value="{atom:ButtonTokenSharedTokenResource BorderRadius}" />
            <Style Selector="^:not(^[Shape=Circle])">
                <Setter Property="Padding" Value="{atom:ButtonTokenResource Padding}" />
            </Style>
            <Style Selector="^:icononly">
                <Setter Property="Padding" Value="{atom:ButtonTokenResource IconOnyPadding}" />
            </Style>
        </Style>

        <!--  text 和 icon 都存在的情况 -->
        <Style Selector="^[SizeType=Large]">
            <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon">
                <Setter Property="Width" Value="{atom:ButtonTokenSharedTokenResource IconSizeLG}" />
                <Setter Property="Height" Value="{atom:ButtonTokenSharedTokenResource IconSizeLG}" />
            </Style>
            <Style Selector="^ /template/ atom|Icon#PART_LoadingIcon">
                <Setter Property="Width" Value="{atom:ButtonTokenSharedTokenResource IconSizeLG}" />
                <Setter Property="Height" Value="{atom:ButtonTokenSharedTokenResource IconSizeLG}" />
            </Style>
        </Style>
        <Style Selector="^[SizeType=Middle]">
            <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon">
                <Setter Property="Width" Value="{atom:ButtonTokenSharedTokenResource IconSize}" />
                <Setter Property="Height" Value="{atom:ButtonTokenSharedTokenResource IconSize}" />
            </Style>
            <Style Selector="^ /template/ atom|Icon#PART_LoadingIcon">
                <Setter Property="Width" Value="{atom:ButtonTokenSharedTokenResource IconSize}" />
                <Setter Property="Height" Value="{atom:ButtonTokenSharedTokenResource IconSize}" />
            </Style>
        </Style>
        <Style Selector="^[SizeType=Custom]">
            <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon">
                <Setter Property="Width" Value="{atom:ButtonTokenSharedTokenResource IconSize}" />
                <Setter Property="Height" Value="{atom:ButtonTokenSharedTokenResource IconSize}" />
            </Style>
            <Style Selector="^ /template/ atom|Icon#PART_LoadingIcon">
                <Setter Property="Width" Value="{atom:ButtonTokenSharedTokenResource IconSize}" />
                <Setter Property="Height" Value="{atom:ButtonTokenSharedTokenResource IconSize}" />
            </Style>
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon">
                <Setter Property="Width" Value="{atom:ButtonTokenSharedTokenResource IconSizeSM}" />
                <Setter Property="Height" Value="{atom:ButtonTokenSharedTokenResource IconSizeSM}" />
            </Style>
            <Style Selector="^ /template/ atom|Icon#PART_LoadingIcon">
                <Setter Property="Width" Value="{atom:ButtonTokenSharedTokenResource IconSizeSM}" />
                <Setter Property="Height" Value="{atom:ButtonTokenSharedTokenResource IconSizeSM}" />
            </Style>
        </Style>

        <Style Selector="^:icononly">
            <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon, ^ /template/ atom|Icon#PART_LoadingIcon">
                <Setter Property="Margin" Value="0" />
            </Style>
            <Style Selector="^[SizeType=Large]">
                <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon atom|Icon">
                    <Setter Property="Width"
                            Value="{atom:ButtonTokenResource OnlyIconSizeLG}" />
                    <Setter Property="Height"
                            Value="{atom:ButtonTokenResource OnlyIconSizeLG}" />
                </Style>
                <Style Selector="^ /template/ atom|Icon#PART_LoadingIcon">
                    <Setter Property="Width"
                            Value="{atom:ButtonTokenResource OnlyIconSizeLG}" />
                    <Setter Property="Height"
                            Value="{atom:ButtonTokenResource OnlyIconSizeLG}" />
                </Style>
            </Style>
            <Style Selector="^[SizeType=Middle]">
                <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon atom|Icon">
                    <Setter Property="Width"
                            Value="{atom:ButtonTokenResource OnlyIconSize}" />
                    <Setter Property="Height"
                            Value="{atom:ButtonTokenResource OnlyIconSize}" />
                </Style>
                <Style Selector="^ /template/ atom|Icon#PART_LoadingIcon">
                    <Setter Property="Width"
                            Value="{atom:ButtonTokenResource OnlyIconSize}" />
                    <Setter Property="Height"
                            Value="{atom:ButtonTokenResource OnlyIconSize}" />
                </Style>
            </Style>
            <Style Selector="^[SizeType=Custom]">
                <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon atom|Icon">
                    <Setter Property="Width"
                            Value="{atom:ButtonTokenResource OnlyIconSize}" />
                    <Setter Property="Height"
                            Value="{atom:ButtonTokenResource OnlyIconSize}" />
                </Style>
                <Style Selector="^ /template/ atom|Icon#PART_LoadingIcon">
                    <Setter Property="Width"
                            Value="{atom:ButtonTokenResource OnlyIconSize}" />
                    <Setter Property="Height"
                            Value="{atom:ButtonTokenResource OnlyIconSize}" />
                </Style>
            </Style>
            <Style Selector="^[SizeType=Small]">
                <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon atom|Icon">
                    <Setter Property="Width"
                            Value="{atom:ButtonTokenResource OnlyIconSizeSM}" />
                    <Setter Property="Height"
                            Value="{atom:ButtonTokenResource OnlyIconSizeSM}" />
                </Style>
                <Style Selector="^ /template/ atom|Icon#PART_LoadingIcon">
                    <Setter Property="Width"
                            Value="{atom:ButtonTokenResource OnlyIconSizeSM}" />
                    <Setter Property="Height"
                            Value="{atom:ButtonTokenResource OnlyIconSizeSM}" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^[IconPlacement=Start]">
            <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon">
                <Setter Property="DockPanel.Dock" Value="Left" />
            </Style>
        </Style>

        <Style Selector="^[IconPlacement=End]">
            <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon">
                <Setter Property="DockPanel.Dock" Value="Right" />
            </Style>
        </Style>

        <Style Selector="^:not(:icononly)">
            <Style Selector="^[IconPlacement=Start] /template/ atom|IconPresenter#PART_ButtonIcon, ^ /template/ atom|Icon#PART_LoadingIcon">
                <Setter Property="Margin" Value="{atom:ButtonTokenResource IconMargin}" />
            </Style>
            <Style Selector="^[IconPlacement=End] /template/ atom|IconPresenter#PART_ButtonIcon">
                <Setter Property="Margin" Value="{atom:ButtonTokenResource IconEndMargin}" />
            </Style>
        </Style>

        <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^ /template/ atom|Icon#PART_LoadingIcon">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:loading">
            <Style Selector="^ /template/ atom|IconPresenter#PART_ButtonIcon">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ atom|Icon#PART_LoadingIcon">
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Setter Property="Opacity" Value="{atom:ButtonTokenSharedTokenResource OpacityLoading}" />
        </Style>

        <Style Selector="^[Shape=Circle]">
            <Setter Property="Padding" Value="{atom:ButtonTokenResource CirclePadding}" />
        </Style>

        <Style Selector="^ /template/ Border#FocusVisual">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#FocusVisual">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^ /template/ Border#CustomBackgroundLayer">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True] /template/ Border#CustomBackgroundLayer">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity"
                                      Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="^[HasCustomBackground=True] /template/ Border#CustomBackgroundLayer">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <Style Selector="^[HasCustomBackground=True]:not(:pointerover):not(:pressed) /template/ Border#CustomBackgroundLayer">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground"
                    Value="{atom:ButtonTokenSharedTokenResource ColorTextDisabled}" />
            <Setter Property="BorderBrush"
                    Value="{atom:ButtonTokenResource BorderColorDisabled}" />

            <Setter Property="Background"
                    Value="{atom:ButtonTokenSharedTokenResource ColorBgContainerDisabled}" />
        </Style>
        <!-- 公用样式结束 -->

        <!-- 默认按钮样式开始 -->
        <Style Selector="^[ButtonType=Default]">
            <Style Selector="^:not(:disabled)">
                <Setter Property="Foreground" Value="{atom:ButtonTokenResource DefaultColor}" />
                <Setter Property="BorderBrush"
                        Value="{atom:ButtonTokenResource DefaultBorderColor}" />
                <Setter Property="Background" Value="{atom:ButtonTokenResource DefaultBg}" />

                <Style Selector="^:pointerover">
                    <Setter Property="Foreground"
                            Value="{atom:ButtonTokenResource DefaultHoverColor}" />
                    <Setter Property="BorderBrush"
                            Value="{atom:ButtonTokenResource DefaultHoverBorderColor}" />
                </Style>

                <Style Selector="^:pressed">
                    <Setter Property="Foreground"
                            Value="{atom:ButtonTokenResource DefaultActiveColor}" />
                    <Setter Property="BorderBrush"
                            Value="{atom:ButtonTokenResource DefaultActiveBorderColor}" />
                </Style>

                <Style Selector="^:danger">
                    <Setter Property="Foreground" Value="{atom:ButtonTokenSharedTokenResource ColorError}" />
                    <Setter Property="BorderBrush" Value="{atom:ButtonTokenSharedTokenResource ColorError}" />

                    <Style Selector="^:pointerover">
                        <Setter Property="Foreground"
                                Value="{atom:ButtonTokenSharedTokenResource ColorErrorBorderHover}" />
                        <Setter Property="BorderBrush"
                                Value="{atom:ButtonTokenSharedTokenResource ColorErrorBorderHover}" />
                    </Style>

                    <Style Selector="^:pressed">
                        <Setter Property="Foreground"
                                Value="{atom:ButtonTokenSharedTokenResource ColorErrorActive}" />
                        <Setter Property="BorderBrush"
                                Value="{atom:ButtonTokenSharedTokenResource ColorErrorActive}" />
                    </Style>
                </Style>

                <Style Selector="^[IsGhost=True]">

                    <Setter Property="Foreground"
                            Value="{atom:ButtonTokenSharedTokenResource ColorTextLightSolid}" />
                    <Setter Property="BorderBrush"
                            Value="{atom:ButtonTokenSharedTokenResource ColorTextLightSolid}" />
                    <Setter Property="Background" Value="Transparent" />

                    <Style Selector="^:pointerover">
                        <Setter Property="Foreground"
                                Value="{atom:ButtonTokenSharedTokenResource ColorPrimaryHover}" />
                        <Setter Property="BorderBrush"
                                Value="{atom:ButtonTokenSharedTokenResource ColorPrimaryHover}" />
                    </Style>

                    <Style Selector="^:pressed">
                        <Setter Property="Foreground"
                                Value="{atom:ButtonTokenSharedTokenResource ColorPrimaryActive}" />
                        <Setter Property="BorderBrush"
                                Value="{atom:ButtonTokenSharedTokenResource ColorPrimaryActive}" />
                    </Style>

                    <Style Selector="^:danger">
                        <Setter Property="Foreground"
                                Value="{atom:ButtonTokenSharedTokenResource ColorError}" />
                        <Setter Property="BorderBrush"
                                Value="{atom:ButtonTokenSharedTokenResource ColorError}" />

                        <Style Selector="^:pointerover">
                            <Setter Property="Foreground"
                                    Value="{atom:ButtonTokenSharedTokenResource ColorErrorBorderHover}" />
                            <Setter Property="BorderBrush"
                                    Value="{atom:ButtonTokenSharedTokenResource ColorErrorBorderHover}" />
                        </Style>

                        <Style Selector="^:pressed">
                            <Setter Property="Foreground"
                                    Value="{atom:ButtonTokenSharedTokenResource ColorErrorActive}" />
                            <Setter Property="BorderBrush"
                                    Value="{atom:ButtonTokenSharedTokenResource ColorErrorActive}" />
                        </Style>
                    </Style>
                </Style>
            </Style>

        </Style>
        <!-- 默认按钮样式结束 -->

        <!-- 主按钮样式开始 -->
        <Style Selector="^[ButtonType=Primary]">
            <Style Selector="^[IsMotionEnabled=True]">
                <Setter Property="Transitions">
                    <Transitions>
                        <atom:SolidColorBrushTransition Property="Background"
                                                        Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                        <atom:SolidColorBrushTransition Property="Foreground"
                                                        Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    </Transitions>
                </Setter>
            </Style>
            <Style Selector="^:not(:disabled)">
                <Setter Property="Foreground" Value="{atom:ButtonTokenResource PrimaryColor}" />
                <Setter Property="Background" Value="{atom:ButtonTokenSharedTokenResource ColorPrimary}" />
                <Setter Property="BorderBrush" Value="{Binding Background, RelativeSource={RelativeSource Self}}" />

                <Style Selector="^:pointerover">
                    <Setter Property="Background"
                            Value="{atom:ButtonTokenSharedTokenResource ColorPrimaryHover}" />
                </Style>

                <Style Selector="^:pressed">
                    <Setter Property="Background"
                            Value="{atom:ButtonTokenSharedTokenResource ColorPrimaryActive}" />
                </Style>

                <Style Selector="^:danger">
                    <Setter Property="Background" Value="{atom:ButtonTokenSharedTokenResource ColorError}" />
                    <Style Selector="^:pointerover">
                        <Setter Property="Background"
                                Value="{atom:ButtonTokenSharedTokenResource ColorErrorHover}" />
                        <Setter Property="BorderBrush" Value="{atom:ButtonTokenSharedTokenResource ColorErrorHover}" />
                    </Style>

                    <Style Selector="^:pressed">
                        <Setter Property="Background"
                                Value="{atom:ButtonTokenSharedTokenResource ColorErrorActive}" />
                        <Setter Property="BorderBrush" Value="{atom:ButtonTokenSharedTokenResource ColorErrorActive}" />
                    </Style>
                </Style>

                <Style Selector="^[IsGhost=True]">
                    <Setter Property="Foreground" Value="{atom:ButtonTokenSharedTokenResource ColorPrimary}" />
                    <Setter Property="BorderBrush"
                            Value="{atom:ButtonTokenSharedTokenResource ColorPrimary}" />

                    <Setter Property="Background" Value="Transparent" />

                    <Style Selector="^:pointerover">
                        <Setter Property="Foreground"
                                Value="{atom:ButtonTokenSharedTokenResource ColorPrimaryHover}" />
                        <Setter Property="BorderBrush"
                                Value="{atom:ButtonTokenSharedTokenResource ColorPrimaryHover}" />
                    </Style>

                    <Style Selector="^:pressed">
                        <Setter Property="Foreground"
                                Value="{atom:ButtonTokenSharedTokenResource ColorPrimaryActive}" />
                        <Setter Property="BorderBrush"
                                Value="{atom:ButtonTokenSharedTokenResource ColorPrimaryActive}" />
                    </Style>

                    <Style Selector="^:danger">
                        <Setter Property="Foreground"
                                Value="{atom:ButtonTokenSharedTokenResource ColorError}" />
                        <Setter Property="BorderBrush"
                                Value="{atom:ButtonTokenSharedTokenResource ColorError}" />

                        <Style Selector="^:pointerover">
                            <Setter Property="Foreground"
                                    Value="{atom:ButtonTokenSharedTokenResource ColorErrorBorderHover}" />
                            <Setter Property="BorderBrush"
                                    Value="{atom:ButtonTokenSharedTokenResource ColorErrorBorderHover}" />
                        </Style>

                        <Style Selector="^:pressed">
                            <Setter Property="Foreground"
                                    Value="{atom:ButtonTokenSharedTokenResource ColorErrorActive}" />
                            <Setter Property="BorderBrush"
                                    Value="{atom:ButtonTokenSharedTokenResource ColorErrorActive}" />
                        </Style>
                    </Style>
                </Style>
            </Style>

        </Style>
        <!-- 主按钮样式结束 -->

        <!-- 链接按钮样式开始 -->
        <Style Selector="^[ButtonType=Link]">
            <Style Selector="^:not(:disabled)">
                <Setter Property="Foreground" Value="{atom:ButtonTokenSharedTokenResource ColorLink}" />
                <Setter Property="Background" Value="Transparent" />

                <Style Selector="^:pointerover">
                    <Setter Property="Foreground"
                            Value="{atom:ButtonTokenSharedTokenResource ColorLinkHover}" />
                </Style>

                <Style Selector="^:pressed">
                    <Setter Property="Foreground"
                            Value="{atom:ButtonTokenSharedTokenResource ColorLinkActive}" />
                </Style>

                <Style Selector="^:danger">
                    <Setter Property="Foreground" Value="{atom:ButtonTokenSharedTokenResource ColorError}" />

                    <Style Selector="^:pointerover">
                        <Setter Property="Foreground"
                                Value="{atom:ButtonTokenSharedTokenResource ColorErrorHover}" />
                    </Style>

                    <Style Selector="^:pressed">
                        <Setter Property="Foreground"
                                Value="{atom:ButtonTokenSharedTokenResource ColorErrorActive}" />
                    </Style>
                </Style>

                <Style Selector="^[IsGhost=True]">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </Style>

            <Style Selector="^:disabled">
                <Setter Property="Background" Value="Transparent" />
            </Style>

        </Style>
        <!-- 链接按钮样式结束 -->

        <!-- 文字按钮样式开始 -->
        <Style Selector="^[ButtonType=Text]">
            <Style Selector="^:not(:disabled)">
                <Setter Property="Foreground" Value="{atom:ButtonTokenResource DefaultColor}" />
                <Setter Property="Background" Value="Transparent" />

                <Style Selector="^:pointerover">
                    <Setter Property="Background" Value="{atom:ButtonTokenResource TextHoverBg}" />
                </Style>

                <Style Selector="^:pressed">
                    <Setter Property="Background"
                            Value="{atom:ButtonTokenSharedTokenResource ColorBgTextActive}" />
                </Style>

                <Style Selector="^:danger">
                    <Setter Property="Foreground" Value="{atom:ButtonTokenSharedTokenResource ColorError}" />

                    <Style Selector="^:pointerover">
                        <Setter Property="Background"
                                Value="{atom:ButtonTokenSharedTokenResource ColorErrorBgHover}" />
                        <Setter Property="Foreground"
                                Value="{atom:ButtonTokenSharedTokenResource ColorErrorHover}" />
                    </Style>

                    <Style Selector="^:pressed">
                        <Setter Property="Background"
                                Value="{atom:ButtonTokenSharedTokenResource ColorErrorBgActive}" />
                        <Setter Property="Foreground"
                                Value="{atom:ButtonTokenSharedTokenResource ColorErrorActive}" />
                    </Style>
                </Style>

            </Style>

            <Style Selector="^:disabled">
                <Setter Property="Background" Value="Transparent" />
            </Style>

        </Style>
        <!-- 文字按钮样式结束 -->

        <!-- 虚线按钮样式开始 -->
        <Setter Property="Template">
            <ControlTemplate TargetType="atom:Button">
                <Panel>
                    <atom:WaveSpiritDecorator Name="PART_WaveSpirit"
                                              CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                              WaveType="{TemplateBinding WaveSpiritType}" />
                    <Border Name="ShadowsFrame"
                            CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                            Background="{TemplateBinding Background}" />
                    <Border Name="CustomBackgroundLayer"
                            IsHitTestVisible="False"
                            Background="{TemplateBinding CustomBackground}"
                            CornerRadius="{TemplateBinding EffectiveCornerRadius}" />
                    <atom:DashedBorder Name="Frame"
                                       Height="{TemplateBinding Height}"
                                       Padding="{TemplateBinding Padding}"
                                       BorderThickness="{TemplateBinding EffectiveBorderThickness}"
                                       BorderBrush="{TemplateBinding BorderBrush}"
                                       BackgroundSizing="{TemplateBinding BackgroundSizing}"
                                       CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                       Background="{TemplateBinding Background}"
                                       StrokeDashArray="{x:Static atom:ButtonTheme.DashedStyle}">
                        <DockPanel Name="PART_RootLayout"
                                   LastChildFill="True"
                                   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <atom:IconPresenter
                                Name="PART_ButtonIcon"
                                Icon="{TemplateBinding Icon}"
                                IconBrush="{TemplateBinding Foreground}"
                                DockPanel.Dock="Left">
                                <atom:IconPresenter.IsVisible>
                                    <MultiBinding
                                        Converter="{x:Static atom:ButtonTheme.IconVisibleConverter}">
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Icon" />
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="IsIconVisible" />
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="IsLoading" />
                                    </MultiBinding>
                                </atom:IconPresenter.IsVisible>
                            </atom:IconPresenter>
                            <antdicons:LoadingOutlined
                                Name="PART_LoadingIcon"
                                LoadingAnimation="Spin"
                                FillBrush="{TemplateBinding Foreground}"
                                StrokeBrush="{TemplateBinding Foreground}"
                                DockPanel.Dock="Left" />
                            <ContentPresenter
                                Name="PART_ContentPresenter"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </DockPanel>
                    </atom:DashedBorder>
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^[ButtonType=Dashed]">
            <Style Selector="^:not(:disabled)">
                <Setter Property="Foreground" Value="{atom:ButtonTokenResource DefaultColor}" />
                <Setter Property="BorderBrush"
                        Value="{atom:ButtonTokenResource DefaultBorderColor}" />
                <Setter Property="Background" Value="{atom:ButtonTokenResource DefaultBg}" />

                <Style Selector="^:pointerover">
                    <Setter Property="Foreground"
                            Value="{atom:ButtonTokenResource DefaultHoverColor}" />
                    <Setter Property="BorderBrush"
                            Value="{atom:ButtonTokenResource DefaultHoverBorderColor}" />
                </Style>

                <Style Selector="^:pressed">
                    <Setter Property="Foreground"
                            Value="{atom:ButtonTokenResource DefaultActiveColor}" />
                    <Setter Property="BorderBrush"
                            Value="{atom:ButtonTokenResource DefaultActiveBorderColor}" />
                </Style>

                <Style Selector="^:danger">
                    <Setter Property="Foreground" Value="{atom:ButtonTokenSharedTokenResource ColorError}" />
                    <Setter Property="BorderBrush" Value="{atom:ButtonTokenSharedTokenResource ColorError}" />

                    <Style Selector="^:pointerover">
                        <Setter Property="Foreground"
                                Value="{atom:ButtonTokenSharedTokenResource ColorErrorBorderHover}" />
                        <Setter Property="BorderBrush"
                                Value="{atom:ButtonTokenSharedTokenResource ColorErrorBorderHover}" />
                    </Style>

                    <Style Selector="^:pressed">
                        <Setter Property="Foreground"
                                Value="{atom:ButtonTokenSharedTokenResource ColorErrorActive}" />
                        <Setter Property="BorderBrush"
                                Value="{atom:ButtonTokenSharedTokenResource ColorErrorActive}" />
                    </Style>
                </Style>

                <Style Selector="^[IsGhost=True]">

                    <Setter Property="Foreground"
                            Value="{atom:ButtonTokenSharedTokenResource ColorTextLightSolid}" />
                    <Setter Property="BorderBrush"
                            Value="{atom:ButtonTokenSharedTokenResource ColorTextLightSolid}" />
                    <Setter Property="Background" Value="Transparent" />

                    <Style Selector="^:pointerover">
                        <Setter Property="Foreground"
                                Value="{atom:ButtonTokenSharedTokenResource ColorPrimaryHover}" />
                        <Setter Property="BorderBrush"
                                Value="{atom:ButtonTokenSharedTokenResource ColorPrimaryHover}" />
                    </Style>

                    <Style Selector="^:pressed">
                        <Setter Property="Foreground"
                                Value="{atom:ButtonTokenSharedTokenResource ColorPrimaryActive}" />
                        <Setter Property="BorderBrush"
                                Value="{atom:ButtonTokenSharedTokenResource ColorPrimaryActive}" />
                    </Style>

                    <Style Selector="^:danger">
                        <Setter Property="Foreground"
                                Value="{atom:ButtonTokenSharedTokenResource ColorError}" />
                        <Setter Property="BorderBrush"
                                Value="{atom:ButtonTokenSharedTokenResource ColorError}" />

                        <Style Selector="^:pointerover">
                            <Setter Property="Foreground"
                                    Value="{atom:ButtonTokenSharedTokenResource ColorErrorBorderHover}" />
                            <Setter Property="BorderBrush"
                                    Value="{atom:ButtonTokenSharedTokenResource ColorErrorBorderHover}" />
                        </Style>

                        <Style Selector="^:pressed">
                            <Setter Property="Foreground"
                                    Value="{atom:ButtonTokenSharedTokenResource ColorErrorActive}" />
                            <Setter Property="BorderBrush"
                                    Value="{atom:ButtonTokenSharedTokenResource ColorErrorActive}" />
                        </Style>
                    </Style>
                </Style>
            </Style>

            <Style Selector="^ /template/ Border#FocusVisual">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^:focus-visible /template/ Border#FocusVisual">
                <Setter Property="IsVisible" Value="True" />
            </Style>

        </Style>
        <!-- 虚线按钮样式结束 -->

        <!-- Color / Variant 视觉变量开始 -->
        <Style Selector="^:not(:disabled)">
            <Setter Property="Foreground"
                    Value="{Binding VariantTextBrush, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Background"
                    Value="{Binding VariantBackgroundBrush, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderBrush"
                    Value="{Binding VariantBorderBrush, RelativeSource={RelativeSource Self}}" />

            <Style Selector="^:pointerover">
                <Setter Property="Foreground"
                        Value="{Binding VariantTextHoverBrush, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Background"
                        Value="{Binding VariantBackgroundHoverBrush, RelativeSource={RelativeSource Self}}" />
                <Setter Property="BorderBrush"
                        Value="{Binding VariantBorderHoverBrush, RelativeSource={RelativeSource Self}}" />
            </Style>

            <Style Selector="^:pressed">
                <Setter Property="Foreground"
                        Value="{Binding VariantTextPressedBrush, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Background"
                        Value="{Binding VariantBackgroundPressedBrush, RelativeSource={RelativeSource Self}}" />
                <Setter Property="BorderBrush"
                        Value="{Binding VariantBorderPressedBrush, RelativeSource={RelativeSource Self}}" />
            </Style>
        </Style>

        <Style Selector="^[EffectiveVariant=Text]:disabled, ^[EffectiveVariant=Link]:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="^ /template/ Border#ShadowsFrame">
            <Setter Property="BoxShadow"
                    Value="{Binding VariantShadow, RelativeSource={RelativeSource TemplatedParent}}" />
        </Style>
        <!-- Color / Variant 视觉变量结束 -->
    </Style>
</ControlTheme>
