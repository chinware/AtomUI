<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:OtpLineEdit}" TargetType="atom:OtpLineEdit">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid Name="PART_RootPanel">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="{atom:SharedTokenResource UniformlyPaddingXXS}">
                        <ItemsControl
                            Name="PART_CellsHost"
                            ItemsSource="{TemplateBinding CellItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="{atom:OtpLineEditTokenResource CellGap}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="atom:OtpLineEditCellInfo">
                                    <StackPanel Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <atom:OtpLineEditCell
                                            DisplayText="{Binding DisplayText}"
                                            PlaceholderText="{Binding PlaceholderText}"
                                            IsActive="{Binding IsActive}"
                                            IsInputTarget="{Binding IsInputTarget}"
                                            IsMotionEnabled="{Binding IsMotionEnabled}"
                                            Status="{Binding EffectiveStatus}"
                                            SizeType="{Binding SizeType}"
                                            StyleVariant="{Binding StyleVariant}">
                                            <atom:OtpTextBox
                                                Name="PART_TextBox"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                HorizontalContentAlignment="Center"
                                                VerticalContentAlignment="Center"
                                                TextAlignment="Center"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Focusable="False"
                                                IsReadOnly="True"
                                                IsTabStop="False"
                                                Foreground="{Binding $parent[atom:OtpLineEditCell].Foreground}"
                                                FontSize="{Binding $parent[atom:OtpLineEditCell].FontSize}"
                                                CaretBrush="{atom:SharedTokenResource ColorText}"
                                                SelectionBrush="{atom:SharedTokenResource SelectionBackground}"
                                                SelectionForegroundBrush="{atom:SharedTokenResource SelectionForeground}"
                                                SourcePlaceholderText="{Binding PlaceholderText}"
                                                PlaceholderForeground="{atom:SharedTokenResource ColorTextPlaceholder}"
                                                IsCellActive="{Binding IsActive}"
                                                Text="{Binding DisplayText}" />
                                        </atom:OtpLineEditCell>
                                        <!--
                                            星号等分隔符的字形墨迹偏行盒上半区、偏
                                            advance 左侧，属字体排版事实；补偿量由
                                            OtpLineEditToken 的光学补偿比例按 FontSize
                                            驱动（主题可覆盖），容器保持与 cell 中心
                                            对齐（测试锁定）。
                                        -->
                                        <Border
                                            Margin="4,0"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding IsSeparatorVisible}">
                                            <ContentControl
                                                Name="PART_SeparatorPresenter"
                                                atom:OtpSeparatorGlyphAlignment.X="0.1"
                                                atom:OtpSeparatorGlyphAlignment.Y="0.21"
                                                VerticalContentAlignment="Center"
                                                Content="{Binding Separator}"
                                                ContentTemplate="{Binding SeparatorTemplate}" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <atom:InputClearIconButton
                            Name="PART_ClearButton"
                            Icon="{TemplateBinding ClearIcon}"
                            IsVisible="{TemplateBinding IsEffectiveShowClearButton}"
                            IsMotionEnabled="{TemplateBinding IsMotionEnabled}" />
                        <ContentPresenter
                            Name="PART_FormFeedBack"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            HorizontalAlignment="Right"
                            Content="{TemplateBinding FormFeedback}"
                            IsVisible="{TemplateBinding IsFormFeedbackVisible}" />
                    </StackPanel>
                </Grid>
            </ControlTemplate>
        </Setter>

        <Setter Property="Background" Value="Transparent" />
        <Setter Property="IsMotionEnabled" Value="{atom:SharedTokenResource EnableMotion}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
    </ControlTheme>
</ResourceDictionary>
