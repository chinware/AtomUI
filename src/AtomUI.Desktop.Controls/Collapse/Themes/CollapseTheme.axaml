<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:Collapse}" TargetType="atom:Collapse">
        <Setter Property="Template">
            <ControlTemplate>
                <atom:PixelAlignedBorder Name="PART_Frame"
                                         BorderThickness="{TemplateBinding EffectiveBorderThickness}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         CornerRadius="{TemplateBinding CornerRadius}"
                                         ClipToBounds="True">
                    <ItemsPresenter Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"/>
                </atom:PixelAlignedBorder>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="IsMotionEnabled" Value="{atom:CollapseTokenSharedTokenResource EnableMotion}" />
        <Setter Property="BorderThickness" Value="{atom:CollapseTokenSharedTokenResource BorderThickness}" />
        <Setter Property="BorderBrush" Value="{atom:CollapseTokenSharedTokenResource ColorBorder}" />
        <Setter Property="CornerRadius" Value="{atom:CollapseTokenResource CollapsePanelBorderRadius}" />
    </ControlTheme>
</ResourceDictionary>
