<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themeResources="using:AtomUI.Theme.Resources"
    xmlns:generated="using:AtomUI.Generated.AtomUI_Desktop_Controls"
    themeResources:ControlTokenScope.Identity="{x:Static generated:CollapseThemeAsset.Identity}"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:Collapse}" TargetType="atom:Collapse">
        <Setter Property="Template">
            <ControlTemplate>
                <atom:PixelAlignedBorder Name="PART_Frame"
                                         BorderThickness="{TemplateBinding EffectiveBorderThickness}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         CornerRadius="{TemplateBinding CornerRadius}"
                                         ClipToBounds="True">
                    <ItemsPresenter Name="PART_ItemsPresenter"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"/>
                </atom:PixelAlignedBorder>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="IsMotionEnabled" Value="{atom:SharedTokenResource EnableMotion}" />
        <Setter Property="BorderThickness" Value="{atom:SharedTokenResource BorderThickness}" />
        <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorBorder}" />
        <Setter Property="CornerRadius" Value="{atom:CollapseTokenResource CollapsePanelBorderRadius}" />
    </ControlTheme>
</ResourceDictionary>
