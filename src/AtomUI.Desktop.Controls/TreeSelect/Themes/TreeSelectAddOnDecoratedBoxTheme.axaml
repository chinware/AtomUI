<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:TreeSelectAddOnDecoratedBox}" TargetType="atom:TreeSelectAddOnDecoratedBox">
        <ControlTheme.BasedOn>
            <atom:AddOnDecoratedBoxTheme TargetType="atom:TreeSelectAddOnDecoratedBox" />
        </ControlTheme.BasedOn>

        <Style Selector="^:is(atom|TreeSelectAddOnDecoratedBox)">
            <Style Selector="^^[IsMultiple=True]">
                <Style Selector="^[IsSelectionEmpty=False]">
                    <Style Selector="^ /template/ atom|AddOnDecoratedBoxContentFrame#PART_ContentFrame">
                        <Setter Property="Padding"
                                Value="{Binding (atom:AddOnDecoratedBox).EffectiveContentFramePadding, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Style>
                    <Style Selector="^[SizeType=Large]">
                        <Setter Property="ContentFramePadding"
                                Value="{atom:SelectTokenResource MultiModePaddingLG}" />
                        <Setter Property="CompactContentFramePadding"
                                Value="{atom:SelectTokenResource MultiModePaddingSM}" />
                        <Setter Property="ContentMinHeight"
                                Value="{atom:SelectTokenResource MultipleItemHeightLG}" />
                    </Style>
                    <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
                        <Setter Property="ContentFramePadding"
                                Value="{atom:SelectTokenResource MultiModePadding}" />
                        <Setter Property="CompactContentFramePadding"
                                Value="{atom:SelectTokenResource MultiModePaddingSM}" />
                        <Setter Property="ContentMinHeight"
                                Value="{atom:SelectTokenResource MultipleItemHeight}" />
                    </Style>
                    <Style Selector="^[SizeType=Small]">
                        <Setter Property="ContentFramePadding"
                                Value="{atom:SelectTokenResource MultiModePaddingSM}" />
                        <Setter Property="CompactContentFramePadding"
                                Value="{atom:SelectTokenResource MultiModePaddingSM}" />
                        <Setter Property="ContentMinHeight"
                                Value="{atom:SelectTokenResource MultipleItemHeightSM}" />
                    </Style>
                </Style>
                
                <Style Selector="^[IsSelectionEmpty=True]">
                    <Style Selector="^[SizeType=Large]">
                        <Style Selector="^ /template/ atom|AddOnDecoratedBoxContentFrame#PART_ContentFrame">
                            <Setter Property="Padding"
                                    Value="{atom:SelectTokenResource PaddingLG}" />
                        </Style>
                    </Style>
                    <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
                        <Style Selector="^ /template/ atom|AddOnDecoratedBoxContentFrame#PART_ContentFrame">
                            <Setter Property="Padding"
                                    Value="{atom:SelectTokenResource Padding}" />
                        </Style>

                    </Style>
                    <Style Selector="^[SizeType=Small]">
                        <Style Selector="^ /template/ atom|AddOnDecoratedBoxContentFrame#PART_ContentFrame">
                            <Setter Property="Padding"
                                    Value="{atom:SelectTokenResource Padding}" />
                        </Style>
                    </Style>
                </Style>
            </Style>

            <Style Selector="^[StyleVariant=Outlined]">
                <Setter Property="BorderBrush" Value="{atom:TreeSelectTokenSharedTokenResource ColorBorder}" />

                <Style Selector="^[IsInnerBoxHover=True]">
                    <Setter Property="BorderBrush"
                            Value="{atom:AddOnDecoratedBoxTokenResource HoverBorderColor}" />
                </Style>

                <Style Selector="^:focus-within">
                    <Setter Property="BorderBrush"
                            Value="{atom:AddOnDecoratedBoxTokenResource ActiveBorderColor}" />
                </Style>

                <Style Selector="^:pressed">
                    <Setter Property="BorderBrush"
                            Value="{atom:AddOnDecoratedBoxTokenResource ActiveBorderColor}" />
                </Style>
                
                <Style Selector="^[IsDropDownOpen=True]">
                    <Setter Property="BorderBrush"
                            Value="{atom:AddOnDecoratedBoxTokenResource ActiveBorderColor}" />
                </Style>

                <Style Selector="^[EffectiveStatus=Error]">
                    <Setter Property="BorderBrush"
                            Value="{atom:TreeSelectTokenSharedTokenResource ColorError}" />

                    <Style Selector="^[IsInnerBoxHover=True]">
                        <Setter Property="BorderBrush"
                                Value="{atom:TreeSelectTokenSharedTokenResource ColorErrorBorderHover}" />
                    </Style>

                    <Style Selector="^:focus-within">
                        <Setter Property="BorderBrush"
                                Value="{atom:TreeSelectTokenSharedTokenResource ColorError}" />
                    </Style>

                    <Style Selector="^:pressed">
                        <Setter Property="BorderBrush"
                                Value="{atom:TreeSelectTokenSharedTokenResource ColorError}" />
                    </Style>
                    
                    <Style Selector="^[IsDropDownOpen=True]">
                        <Setter Property="BorderBrush"
                                Value="{atom:TreeSelectTokenSharedTokenResource ColorError}" />
                    </Style>
                </Style>

                <Style Selector="^[EffectiveStatus=Warning]">
                    <Setter Property="BorderBrush"
                            Value="{atom:TreeSelectTokenSharedTokenResource ColorWarning}" />

                    <Style Selector="^[IsInnerBoxHover=True]">
                        <Setter Property="BorderBrush"
                                Value="{atom:TreeSelectTokenSharedTokenResource ColorWarningBorderHover}" />
                    </Style>

                    <Style Selector="^:focus-within">
                        <Setter Property="BorderBrush"
                                Value="{atom:TreeSelectTokenSharedTokenResource ColorWarning}" />
                    </Style>

                    <Style Selector="^:pressed">
                        <Setter Property="BorderBrush"
                                Value="{atom:TreeSelectTokenSharedTokenResource ColorWarning}" />
                    </Style>
                    <Style Selector="^[IsDropDownOpen=True]">
                        <Setter Property="BorderBrush"
                                Value="{atom:TreeSelectTokenSharedTokenResource ColorWarning}" />
                    </Style>
                </Style>
            </Style>

            <Style Selector="^[StyleVariant=Filled]">
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Background"
                        Value="{atom:TreeSelectTokenSharedTokenResource ColorFillTertiary}" />

                <Style Selector="^[IsInnerBoxHover=True]">
                    <Setter Property="Background"
                            Value="{atom:TreeSelectTokenSharedTokenResource ColorFillSecondary}" />
                </Style>

                <Style Selector="^:focus-within">
                    <Setter Property="BorderBrush"
                            Value="{atom:AddOnDecoratedBoxTokenResource ActiveBorderColor}" />
                    <Setter Property="Background" Value="Transparent" />
                </Style>

                <Style Selector="^:pressed">
                    <Setter Property="BorderBrush"
                            Value="{atom:AddOnDecoratedBoxTokenResource ActiveBorderColor}" />
                </Style>
                
                <Style Selector="^[IsDropDownOpen=True]">
                    <Setter Property="BorderBrush"
                            Value="{atom:AddOnDecoratedBoxTokenResource ActiveBorderColor}" />
                </Style>

                <Style Selector="^[EffectiveStatus=Error]">
                    <Setter Property="BorderBrush"
                            Value="Transparent" />
                    <Setter Property="Background"
                            Value="{atom:TreeSelectTokenSharedTokenResource ColorErrorBg}" />

                    <Style Selector="^[IsInnerBoxHover=True]">
                        <Setter Property="Background"
                                Value="{atom:TreeSelectTokenSharedTokenResource ColorErrorBgHover}" />
                    </Style>

                    <Style Selector="^:focus-within">
                        <Setter Property="BorderBrush"
                                Value="{atom:TreeSelectTokenSharedTokenResource ColorError}" />
                        <Setter Property="Background"
                                Value="{atom:AddOnDecoratedBoxTokenResource ActiveBg}" />
                    </Style>

                    <Style Selector="^:pressed">
                        <Setter Property="BorderBrush"
                                Value="{atom:TreeSelectTokenSharedTokenResource ColorError}" />
                    </Style>
                    
                    <Style Selector="^[IsDropDownOpen=True]">
                        <Setter Property="BorderBrush"
                                Value="{atom:TreeSelectTokenSharedTokenResource ColorError}" />
                    </Style>
                </Style>

                <Style Selector="^[EffectiveStatus=Warning]">
                    <Setter Property="BorderBrush" Value="Transparent" />
                    <Setter Property="Background"
                            Value="{atom:TreeSelectTokenSharedTokenResource ColorWarningBg}" />

                    <Style Selector="^[IsInnerBoxHover=True]">
                        <Setter Property="Background"
                                Value="{atom:TreeSelectTokenSharedTokenResource ColorWarningBgHover}" />
                    </Style>

                    <Style Selector="^:focus-within">
                        <Setter Property="BorderBrush"
                                Value="{atom:TreeSelectTokenSharedTokenResource ColorWarning}" />
                        <Setter Property="Background"
                                Value="{atom:AddOnDecoratedBoxTokenResource ActiveBg}" />
                    </Style>

                    <Style Selector="^:pressed">
                        <Setter Property="BorderBrush"
                                Value="{atom:TreeSelectTokenSharedTokenResource ColorWarning}" />
                    </Style>
                    
                    <Style Selector="^[IsDropDownOpen=True]">
                        <Setter Property="BorderBrush"
                                Value="{atom:TreeSelectTokenSharedTokenResource ColorWarning}" />
                    </Style>
                </Style>
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
