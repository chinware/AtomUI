<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
              x:Class="AtomUI.Desktop.Controls.Themes.SearchButtonTheme"
              TargetType="{x:Type atom:SearchButton}"
              x:ClassModifier="internal">
    <ControlTheme.BasedOn>
        <themes:ButtonTheme TargetType="{x:Type atom:SearchButton}" />
    </ControlTheme.BasedOn>
    
    <Style Selector="^:is(atom|SearchButton)[ButtonType=Text]">
        <Style Selector="^[StyleVariant=Filled]">
            <Setter Property="Background"
                    Value="{atom:LineEditTokenSharedTokenResource ColorFillTertiary}" />
        </Style>

        <Style Selector="^:pointerover">
            <Setter Property="Background"
                    Value="{atom:LineEditTokenSharedTokenResource ColorBgTextHover}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Background"
                    Value="{atom:LineEditTokenSharedTokenResource ColorBgTextActive}" />
        </Style>

        <Style Selector="^[Status=Error]">
            <Setter Property="Background"
                    Value="{atom:LineEditTokenSharedTokenResource ColorErrorBg}" />
            <Style Selector="^:pointerover">
                <Setter Property="Background"
                        Value="{atom:LineEditTokenSharedTokenResource ColorErrorBgHover}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background"
                        Value="{atom:LineEditTokenSharedTokenResource ColorErrorBgActive}" />
            </Style>
        </Style>

        <Style Selector="^[Status=Warning]">
            <Setter Property="Background"
                    Value="{atom:LineEditTokenSharedTokenResource ColorWarningBg}" />
            <Style Selector="^:pointerover">
                <Setter Property="Background"
                        Value="{atom:LineEditTokenSharedTokenResource ColorWarningHover}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="Background"
                        Value="{atom:LineEditTokenSharedTokenResource ColorWarningActive}" />
            </Style>
        </Style>

        <Setter Property="Foreground" Value="{atom:LineEditTokenSharedTokenResource ColorTextDescription}" />

        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{atom:ButtonTokenResource DefaultHoverColor}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Foreground" Value="{atom:ButtonTokenResource DefaultActiveColor}" />
        </Style>
        
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{atom:LineEditTokenSharedTokenResource ColorTextDisabled}" />
        </Style>
    </Style>

</ControlTheme>
