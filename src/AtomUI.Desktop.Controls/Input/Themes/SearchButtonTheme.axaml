<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              xmlns:themes="using:AtomUI.Desktop.Controls.Themes"
              x:Class="AtomUI.Desktop.Controls.Themes.SearchButtonTheme"
              TargetType="{x:Type atom:Button}"
              x:ClassModifier="internal">
    <ControlTheme.BasedOn>
        <themes:ButtonTheme TargetType="{x:Type atom:Button}" />
    </ControlTheme.BasedOn>
    
    <Style Selector="^:is(atom|Button)[ButtonType=Text]">
        <Style Selector="^:pointerover">
            <Setter Property="Background"
                    Value="{atom:SearchEditTokenResource ColorBgTextHover}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Background"
                    Value="{atom:SearchEditTokenResource ColorBgTextActive}" />
        </Style>

        <Setter Property="Foreground" Value="{atom:SearchEditTokenResource ColorTextDescription}" />

        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{atom:ButtonTokenResource DefaultHoverColor}" />
        </Style>

        <Style Selector="^:pressed">
            <Setter Property="Foreground" Value="{atom:ButtonTokenResource DefaultActiveColor}" />
        </Style>
        
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{atom:SearchEditTokenResource ColorTextDisabled}" />
        </Style>
    </Style>

</ControlTheme>
