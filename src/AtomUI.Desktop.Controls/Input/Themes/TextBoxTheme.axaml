<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              x:Class="AtomUI.Desktop.Controls.Themes.TextBoxTheme"
              x:ClassModifier="internal"
              TargetType="atom:TextBox">
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:TextBox">
            <atom:PixelAlignedBorder
                Name="InnerBoxDecorator"
                Padding="{TemplateBinding Padding}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                BorderBrush="{TemplateBinding BorderBrush}"
                Background="{TemplateBinding Background}"
                BackgroundSizing="InnerBorderEdge">
                <DockPanel Name="ContentLayout" LastChildFill="True">
                    <StackPanel
                        Orientation="Horizontal"
                        DockPanel.Dock="Right"
                        Spacing="{atom:TextBoxTokenSharedTokenResource UniformlyPaddingXXS}">
                        <atom:InputClearIconButton
                            Name="PART_ClearButton"
                            IsVisible="{TemplateBinding IsEffectiveShowClearButton}" 
                            IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                            Icon="{TemplateBinding ClearIcon}"
                            VerticalAlignment="Center"/>
                        <atom:RevealButton
                            Name="PART_RevealButton"
                            IsChecked="{TemplateBinding RevealPassword, Mode=TwoWay}"
                            IsVisible="{TemplateBinding IsEnableRevealButton}" 
                            IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                            VerticalAlignment="Center"/>
                        <ContentPresenter
                            Name="FormFeedBack"
                            VerticalAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            HorizontalAlignment="Right"
                            IsVisible="{TemplateBinding IsFormFeedbackVisible}"
                            Content="{TemplateBinding FormFeedback}"/>
                        <atom:TextBlock Name="TextCountIndicator" 
                                        VerticalAlignment="Center"
                                        Text="{TemplateBinding CountText}"
                                        IsVisible="{TemplateBinding IsShowCount}"/>
                    </StackPanel>
            
                    <atom:ScrollViewer
                        Name="ScrollViewer"
                        Cursor="Ibeam"
                        IsLiteMode="{TemplateBinding atom:ScrollViewer.IsLiteMode}"
                        AllowAutoHide="{TemplateBinding atom:ScrollViewer.AllowAutoHide}"
                        HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                        VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"
                        IsScrollChainingEnabled="{TemplateBinding ScrollViewer.IsScrollChainingEnabled}">
                        <Panel>
                            <atom:TextBlock
                                Name="Placeholder"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Text="{TemplateBinding PlaceholderText}"
                                Foreground="{TemplateBinding PlaceholderForeground}"
                                LineHeight="{TemplateBinding LineHeight}"
                                TextAlignment="{TemplateBinding TextAlignment}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="{TemplateBinding TextWrapping}"
                                IsVisible="{TemplateBinding IsPlaceholderTextVisible}" />
                            <atom:InputTextPresenter
                                Name="PART_TextPresenter"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                CaretBrush="{TemplateBinding CaretBrush}"
                                CaretIndex="{TemplateBinding CaretIndex}"
                                LineHeight="{TemplateBinding LineHeight}"
                                PasswordChar="{TemplateBinding PasswordChar}"
                                RevealPassword="{TemplateBinding RevealPassword}"
                                SelectionBrush="{TemplateBinding SelectionBrush}"
                                SelectionStart="{TemplateBinding SelectionStart}"
                                SelectionEnd="{TemplateBinding SelectionEnd}"
                                SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                Text="{TemplateBinding Text, Mode=TwoWay}"
                                TextAlignment="{TemplateBinding TextAlignment}"
                                TextWrapping="{TemplateBinding TextWrapping}" />
                        </Panel>
                    </atom:ScrollViewer>
                </DockPanel>
            </atom:PixelAlignedBorder>
        </ControlTemplate>
    </Setter>

    <Style Selector="^:is(atom|TextBox)">
        <Setter Property="atom:ScrollViewer.IsLiteMode" Value="True" />
        <Setter Property="atom:ScrollViewer.AllowAutoHide" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{atom:TextBoxTokenResource BorderColor}" />
        <Setter Property="BorderThickness" Value="{atom:TextBoxTokenResource BorderThickness}" />
        <Setter Property="SelectionBrush" Value="{atom:TextBoxTokenSharedTokenResource SelectionBackground}" />
        <Setter Property="CaretBrush" Value="{atom:TextBoxTokenSharedTokenResource ColorText}" />
        <Setter Property="SelectionForegroundBrush"
                Value="{atom:TextBoxTokenSharedTokenResource SelectionForeground}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="True" />
        <Setter Property="IsMotionEnabled" Value="{atom:TextBoxTokenSharedTokenResource EnableMotion}" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="ClipToBounds" Value="False" />
    
        <Style Selector="^[SizeType=Large]">
            <Setter Property="LineHeight" Value="{atom:TextBoxTokenSharedTokenResource FontHeightLG}" />
            <Setter Property="CornerRadius" Value="{atom:TextBoxTokenResource BorderRadiusLG}" />
            <Setter Property="Padding" Value="{atom:TextBoxTokenResource PaddingLG}" />
        </Style>
        <Style Selector="^[SizeType=Middle]">
            <Setter Property="LineHeight" Value="{atom:TextBoxTokenSharedTokenResource FontHeight}" />
            <Setter Property="CornerRadius" Value="{atom:TextBoxTokenResource BorderRadius}" />
            <Setter Property="Padding" Value="{atom:TextBoxTokenResource Padding}" />
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Setter Property="LineHeight" Value="{atom:TextBoxTokenSharedTokenResource FontHeightSM}" />
            <Setter Property="CornerRadius" Value="{atom:TextBoxTokenResource BorderRadiusSM}" />
            <Setter Property="Padding" Value="{atom:TextBoxTokenResource PaddingSM}" />
        </Style>
        <Style Selector="^[SizeType=Custom]">
            <Setter Property="LineHeight" Value="{atom:TextBoxTokenSharedTokenResource FontHeight}" />
            <Setter Property="CornerRadius" Value="{atom:TextBoxTokenResource BorderRadius}" />
        </Style>
    
        <Style Selector="^[IsCustomFontSize=False]">
            <Style Selector="^[SizeType=Large]">
                <Setter Property="FontSize" Value="{atom:TextBoxTokenSharedTokenResource FontSizeLG}" />
                <Setter Property="CornerRadius" Value="{atom:TextBoxTokenResource BorderRadiusLG}" />
            </Style>
            <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
                <Setter Property="FontSize" Value="{atom:TextBoxTokenSharedTokenResource FontSize}" />
                <Setter Property="CornerRadius" Value="{atom:TextBoxTokenResource BorderRadius}" />
            </Style>
            <Style Selector="^[SizeType=Small]">
                <Setter Property="FontSize" Value="{atom:TextBoxTokenSharedTokenResource FontSizeSM}" />
                <Setter Property="CornerRadius" Value="{atom:TextBoxTokenResource BorderRadiusSM}" />
            </Style>
        </Style>
    
        <Setter Property="PlaceholderForeground" Value="{atom:TextBoxTokenSharedTokenResource ColorTextPlaceholder}" />

        <Style Selector="^ /template/ TextPresenter#PART_TextPresenter">
            <Setter Property="Margin"
                    Value="2 0 2 0" />
        </Style>
    
        <Style Selector="^ /template/ atom|TextBlock#TextCountIndicator">
            <Setter Property="Foreground" Value="{atom:TextBoxTokenSharedTokenResource ColorTextPlaceholder}" />
        </Style>

        <Style Selector="^:pointerover /template/ atom|PixelAlignedBorder#InnerBoxDecorator">
            <Setter Property="BorderBrush"
                    Value="{atom:TextBoxTokenResource HoverBorderColor}" />
        </Style>

        <Style Selector="^:focus /template/ atom|PixelAlignedBorder#InnerBoxDecorator">
            <Setter Property="BorderBrush"
                    Value="{atom:TextBoxTokenResource ActiveBorderColor}" />
            <Setter Property="BoxShadow"
                    Value="{atom:TextBoxTokenResource ActiveShadow}" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True] /template/ atom|PixelAlignedBorder#InnerBoxDecorator">
            <Setter Property="Transitions">
                <Transitions>
                    <atom:SolidColorBrushTransition Property="BorderBrush" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    <atom:SolidColorBrushTransition Property="Background" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    <atom:BoxShadowsTransition Property="BoxShadow" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                </Transitions>
            </Setter>
        </Style>
        
        <Style Selector="^:disabled">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#InnerBoxDecorator">
                <Setter Property="Background" Value="{atom:TextBoxTokenSharedTokenResource ColorBgContainerDisabled}" />
                <Setter Property="BorderBrush" Value="{atom:TextBoxTokenSharedTokenResource ColorBorder}" />
            </Style>
            <Style Selector="^ /template/ atom|ScrollViewer#ScrollViewer">
                <Setter Property="Foreground" Value="{atom:TextBoxTokenSharedTokenResource ColorTextDisabled}" />
            </Style>
        </Style>
    </Style>
</ControlTheme>
