<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:StepsItemIndicator}" TargetType="atom:StepsItemIndicator">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="FontSize" Value="{atom:StepsTokenResource IconFontSize}" />
        <Setter Property="ProgressGrooveColor" Value="{atom:StepsTokenResource ProgressGrooveColor}" />
        <Setter Property="ProgressColor" Value="{atom:StepsTokenResource ProgressColor}" />
        <Setter Property="ProgressLineThickness" Value="{atom:StepsTokenSharedTokenResource LineWidthBold}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Margin="{TemplateBinding Padding}">
                    <atom:WaveSpiritDecorator Name="{x:Static atom:WaveSpiritDecorator.WaveSpiritPart}" />
                    <atom:PixelAlignedBorder
                        Name="Frame"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <Panel>
                            <TextBlock
                                Name="StepNumberText"
                                Text="{TemplateBinding DisplayStepNumber}"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <antdicons:CheckOutlined
                                Name="FinishedMark"
                                Width="{TemplateBinding FontSize}"
                                Height="{TemplateBinding FontSize}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="False" />
                            <antdicons:CloseOutlined
                                Name="ErrorMark"
                                Width="{TemplateBinding FontSize}"
                                Height="{TemplateBinding FontSize}"
                                Foreground="{TemplateBinding Foreground}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsVisible="False" />
                        </Panel>
                    </atom:PixelAlignedBorder>
                    <atom:IconPresenter
                        Name="CustomIconPresenter"
                        Width="{atom:StepsTokenResource CustomIconFontSize}"
                        Height="{atom:StepsTokenResource CustomIconFontSize}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Icon="{TemplateBinding Icon}"
                        IconBrush="{TemplateBinding Foreground}"
                        IsVisible="{TemplateBinding IsCustom}" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ atom|PixelAlignedBorder#Frame">
            <Setter Property="Width" Value="{atom:StepsTokenResource IconSize}" />
            <Setter Property="Height" Value="{atom:StepsTokenResource IconSize}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="^[Status=Wait]">
            <Setter Property="BorderBrush" Value="{atom:StepsTokenResource WaitIconBorderColor}" />
            <Setter Property="Background" Value="{atom:StepsTokenResource WaitIconBgColor}" />
            <Setter Property="Foreground" Value="{atom:StepsTokenResource WaitIconColor}" />
        </Style>
        <Style Selector="^[Status=Process]">
            <Setter Property="BorderBrush" Value="{atom:StepsTokenResource ProcessIconBorderColor}" />
            <Setter Property="Background" Value="{atom:StepsTokenResource ProcessIconBgColor}" />
            <Setter Property="Foreground" Value="{atom:StepsTokenResource ProcessIconColor}" />
        </Style>
        <Style Selector="^[Status=Finish]">
            <Setter Property="BorderBrush" Value="{atom:StepsTokenResource FinishIconBorderColor}" />
            <Setter Property="Background" Value="{atom:StepsTokenResource FinishIconBgColor}" />
            <Setter Property="Foreground" Value="{atom:StepsTokenResource FinishIconColor}" />
            <Style Selector="^ /template/ TextBlock#StepNumberText">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ atom|Icon#FinishedMark">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>
        <Style Selector="^[Status=Error]">
            <Setter Property="BorderBrush" Value="{atom:StepsTokenResource ErrorIconBorderColor}" />
            <Setter Property="Background" Value="{atom:StepsTokenResource ErrorIconBgColor}" />
            <Setter Property="Foreground" Value="{atom:StepsTokenResource ErrorIconColor}" />
            <Style Selector="^ /template/ TextBlock#StepNumberText">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ atom|Icon#ErrorMark">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>

        <Style Selector="^[IsCustom=True]">
            <Setter Property="MinWidth" Value="{atom:StepsTokenResource CustomIconSize}" />
            <Setter Property="MinHeight" Value="{atom:StepsTokenResource CustomIconSize}" />
            <Style Selector="^ /template/ atom|PixelAlignedBorder#Frame">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Setter Property="FontSize" Value="{atom:StepsTokenSharedTokenResource FontSizeSM}" />
            <Style Selector="^ /template/ atom|PixelAlignedBorder#Frame">
                <Setter Property="Width" Value="{atom:StepsTokenResource IconSizeSM}" />
                <Setter Property="Height" Value="{atom:StepsTokenResource IconSizeSM}" />
            </Style>
        </Style>

        <Style Selector="^[Type=Dot]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#Frame">
                <Setter Property="Width" Value="{atom:StepsTokenResource DotSize}" />
                <Setter Property="Height" Value="{atom:StepsTokenResource DotSize}" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style Selector="^ /template/ TextBlock#StepNumberText">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ atom|Icon#FinishedMark">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ atom|Icon#ErrorMark">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>
        <Style Selector="^[Type=Dot][IsCurrent=True] /template/ atom|PixelAlignedBorder#Frame">
            <Setter Property="Width" Value="{atom:StepsTokenResource DotCurrentSize}" />
            <Setter Property="Height" Value="{atom:StepsTokenResource DotCurrentSize}" />
        </Style>
        <Style Selector="^[Type=Dot][Status=Wait]">
            <Setter Property="Background" Value="{atom:StepsTokenResource WaitDotColor}" />
        </Style>
        <Style Selector="^[Type=Dot][Status=Process]">
            <Setter Property="Background" Value="{atom:StepsTokenResource ProcessDotColor}" />
        </Style>
        <Style Selector="^[Type=Dot][Status=Finish]">
            <Setter Property="Background" Value="{atom:StepsTokenResource FinishDotColor}" />
        </Style>
        <Style Selector="^[Type=Dot][Status=Error]">
            <Setter Property="Background" Value="{atom:StepsTokenResource ErrorDotColor}" />
        </Style>

        <Style Selector="^[Type=Inline]">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Style Selector="^ /template/ atom|PixelAlignedBorder#Frame">
                <Setter Property="Width" Value="{atom:StepsTokenResource InlineDotSize}" />
                <Setter Property="Height" Value="{atom:StepsTokenResource InlineDotSize}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="IsVisible" Value="True" />
            </Style>
            <Style Selector="^ /template/ TextBlock#StepNumberText">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ atom|Icon#FinishedMark">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ atom|Icon#ErrorMark">
                <Setter Property="IsVisible" Value="False" />
            </Style>
            <Style Selector="^ /template/ atom|IconPresenter#CustomIconPresenter">
                <Setter Property="IsVisible" Value="False" />
            </Style>
        </Style>
        <Style Selector="^[Type=Inline][Status=Wait]">
            <Setter Property="Background" Value="{atom:StepsTokenResource WaitDotColor}" />
        </Style>
        <Style Selector="^[Type=Inline][Status=Process]">
            <Setter Property="Background" Value="{atom:StepsTokenResource ProcessDotColor}" />
        </Style>
        <Style Selector="^[Type=Inline][Status=Finish]">
            <Setter Property="Background" Value="{atom:StepsTokenResource FinishDotColor}" />
        </Style>
        <Style Selector="^[Type=Inline][Status=Error]">
            <Setter Property="Background" Value="{atom:StepsTokenResource ErrorDotColor}" />
        </Style>

        <Style Selector="^[IsProgressVisible=True]">
            <Setter Property="Padding" Value="{atom:StepsTokenResource ProgressFramePadding}" />
        </Style>
        <Style Selector="^[IsProgressVisible=True][SizeType=Small]">
            <Setter Property="Padding" Value="{atom:StepsTokenResource ProgressFramePaddingSM}" />
        </Style>

        <Style Selector="^[IsClickable=True][IsItemHover=True]">
            <Setter Property="BorderBrush" Value="{atom:StepsTokenResource ProcessIconBorderColor}" />
            <Setter Property="Foreground" Value="{atom:StepsTokenResource ProcessIconBorderColor}" />
        </Style>
        <Style Selector="^[Type=Dot][IsClickable=True][IsItemHover=True]">
            <Setter Property="Background" Value="{atom:StepsTokenResource ProcessDotColor}" />
        </Style>

        <Style Selector="^ /template/ atom|WaveSpiritDecorator#PART_WaveSpirit">
            <Setter Property="WaveType" Value="CircleWave" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
