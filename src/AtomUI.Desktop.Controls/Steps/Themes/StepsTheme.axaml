<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:Steps}" TargetType="atom:Steps">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="IsMotionEnabled" Value="{atom:StepsTokenSharedTokenResource EnableMotion}" />
        <Setter Property="Template">
            <ControlTemplate>
                <ItemsPresenter Name="PART_ItemsPresenter">
                    <ItemsPresenter.ItemsPanel>
                        <ItemsPanelTemplate>
                            <atom:StepsPanel
                                Type="{Binding Type, RelativeSource={RelativeSource AncestorType=atom:Steps}}"
                                Orientation="{Binding Orientation, RelativeSource={RelativeSource AncestorType=atom:Steps}}"
                                VerticalItemSpacing="{atom:StepsTokenResource VerticalItemSpacing}" />
                        </ItemsPanelTemplate>
                    </ItemsPresenter.ItemsPanel>
                </ItemsPresenter>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
