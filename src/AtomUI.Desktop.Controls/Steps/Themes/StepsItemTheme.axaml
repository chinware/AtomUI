<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <atom:StringToTextBlockConverter x:Key="StepsStringToTextBlockConverter" TextWrapping="Wrap" />

    <ControlTheme x:Key="{x:Type atom:StepsItem}" TargetType="atom:StepsItem">
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <atom:StepsItemLayoutPanel
                    Background="Transparent"
                    ConnectorThickness="{atom:SharedTokenResource LineWidth}"
                    HorizontalConnectorGap="{atom:SharedTokenResource UniformlyMarginXXS}"
                    IndicatorSpacing="{atom:SharedTokenResource SpacingXS}"
                    Type="{TemplateBinding Type}"
                    VerticalConnectorMargin="{atom:StepsTokenResource VerticalItemSpacing}"
                    VerticalItemPadding="{atom:SharedTokenResource UniformlyPaddingSM}"
                    Orientation="{TemplateBinding Orientation}"
                    TitlePlacement="{TemplateBinding TitlePlacement}">
                    <Border
                        Name="ItemWrapper"
                        atom:StepsItemLayoutPanel.Role="ItemWrapper"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{atom:SharedTokenResource BorderRadiusSM}"
                        IsHitTestVisible="False" />

                    <atom:StepsItemIndicator
                        Name="PART_Indicator"
                        atom:StepsItemLayoutPanel.Role="Indicator"
                        Status="{TemplateBinding EffectiveStatus}"
                        Type="{TemplateBinding Type}"
                        SizeType="{TemplateBinding SizeType}"
                        Icon="{TemplateBinding Icon}"
                        StepNumber="{TemplateBinding StepNumber}"
                        IsCurrent="{TemplateBinding IsCurrent}"
                        IsClickable="{TemplateBinding CanInvoke}"
                        IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                        IsProgressVisible="{TemplateBinding IsProgressVisible}"
                        IsProgressFrameReserved="{TemplateBinding IsProgressFrameReserved}"
                        Percent="{TemplateBinding Percent}" />

                    <ContentPresenter
                        Name="HeaderPresenter"
                        atom:StepsItemLayoutPanel.Role="Header"
                        Content="{TemplateBinding Header, Converter={StaticResource StepsStringToTextBlockConverter}}"
                        ContentTemplate="{TemplateBinding HeaderTemplate}"
                        Foreground="{TemplateBinding Foreground}"
                        VerticalAlignment="Center" />

                    <ContentPresenter
                        Name="SubHeaderPresenter"
                        atom:StepsItemLayoutPanel.Role="SubHeader"
                        Content="{TemplateBinding SubHeader, Converter={StaticResource StepsStringToTextBlockConverter}}"
                        ContentTemplate="{TemplateBinding SubHeaderTemplate}"
                        IsVisible="{TemplateBinding SubHeader, Converter={x:Static ObjectConverters.IsNotNull}}"
                        VerticalAlignment="Center" />

                    <atom:PixelAlignedBorder
                        Name="Connector"
                        atom:StepsItemLayoutPanel.Role="Connector"
                        UseLayoutRounding="False" />

                    <ContentPresenter
                        Name="ContentPresenter"
                        atom:StepsItemLayoutPanel.Role="Content"
                        Content="{TemplateBinding Content, Converter={StaticResource StepsStringToTextBlockConverter}}"
                        ContentTemplate="{TemplateBinding ContentTemplate}"
                        MaxWidth="{atom:StepsTokenResource DescriptionMaxWidth}" />

                    <atom:StepsNavigationArrow
                        Name="NavigationArrow"
                        atom:StepsItemLayoutPanel.Role="NavigationArrow"
                        Width="{atom:SharedTokenResource FontSizeIcon}"
                        Height="{atom:SharedTokenResource FontSizeIcon}"
                        BorderBrush="{atom:StepsTokenResource NavArrowColor}"
                        BorderThickness="{atom:SharedTokenResource LineWidth}"
                        RenderTransformOrigin="{x:Static RelativePoint.Center}"
                        RenderTransform="rotate(45deg)"
                        IsHitTestVisible="False"
                        IsVisible="False" />

                    <atom:PixelAlignedBorder
                        Name="NavigationActiveIndicator"
                        atom:StepsItemLayoutPanel.Role="NavigationActiveIndicator"
                        IsHitTestVisible="False"
                        MinWidth="{atom:SharedTokenResource LineWidthBold}"
                        MinHeight="{atom:SharedTokenResource LineWidthBold}"
                        Background="{atom:StepsTokenResource StepsNavActiveColor}"
                        RenderTransformOrigin="{x:Static RelativePoint.Center}"
                        IsVisible="False" />
                </atom:StepsItemLayoutPanel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^[CanInvoke=True]">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="^:focus-visible">
            <Setter Property="Background" Value="{atom:SharedTokenResource ControlItemBgHover}" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#HeaderPresenter">
            <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSizeLG}" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#SubHeaderPresenter">
            <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSize}" />
            <Setter Property="Margin" Value="{atom:StepsTokenResource SubHeaderMargin}" />
        </Style>
        <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
            <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSize}" />
        </Style>
        <Style Selector="^[CanInvoke=True]:not(^[IsCurrent=True]):not(^[Type=Inline]):pointerover">
            <Setter Property="Foreground" Value="{atom:StepsTokenResource ProcessIconBorderColor}" />
            <Style Selector="^ /template/ ContentPresenter#SubHeaderPresenter">
                <Setter Property="Foreground" Value="{atom:StepsTokenResource ProcessIconBorderColor}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Foreground" Value="{atom:StepsTokenResource ProcessIconBorderColor}" />
            </Style>
        </Style>

        <Style Selector="^[EffectiveStatus=Wait]">
            <Setter Property="Foreground" Value="{atom:StepsTokenResource WaitTitleColor}" />
            <Style Selector="^ /template/ ContentPresenter#SubHeaderPresenter">
                <Setter Property="Foreground" Value="{atom:StepsTokenResource WaitDescriptionColor}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Foreground" Value="{atom:StepsTokenResource WaitDescriptionColor}" />
            </Style>
            <Style Selector="^ /template/ atom|PixelAlignedBorder#Connector">
                <Setter Property="Background" Value="{atom:StepsTokenResource WaitTailColor}" />
            </Style>
        </Style>
        <Style Selector="^[EffectiveStatus=Process]">
            <Setter Property="Foreground" Value="{atom:StepsTokenResource ProcessTitleColor}" />
            <Style Selector="^ /template/ ContentPresenter#SubHeaderPresenter">
                <Setter Property="Foreground" Value="{atom:StepsTokenResource ProcessDescriptionColor}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Foreground" Value="{atom:StepsTokenResource ProcessDescriptionColor}" />
            </Style>
            <Style Selector="^ /template/ atom|PixelAlignedBorder#Connector">
                <Setter Property="Background" Value="{atom:StepsTokenResource ProcessTailColor}" />
            </Style>
        </Style>
        <Style Selector="^[EffectiveStatus=Finish]">
            <Setter Property="Foreground" Value="{atom:StepsTokenResource FinishTitleColor}" />
            <Style Selector="^ /template/ ContentPresenter#SubHeaderPresenter">
                <Setter Property="Foreground" Value="{atom:StepsTokenResource FinishDescriptionColor}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Foreground" Value="{atom:StepsTokenResource FinishDescriptionColor}" />
            </Style>
            <Style Selector="^ /template/ atom|PixelAlignedBorder#Connector">
                <Setter Property="Background" Value="{atom:StepsTokenResource FinishTailColor}" />
            </Style>
        </Style>
        <Style Selector="^[EffectiveStatus=Error]">
            <Setter Property="Foreground" Value="{atom:StepsTokenResource ErrorTitleColor}" />
            <Style Selector="^ /template/ ContentPresenter#SubHeaderPresenter">
                <Setter Property="Foreground" Value="{atom:StepsTokenResource ErrorDescriptionColor}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="Foreground" Value="{atom:StepsTokenResource ErrorDescriptionColor}" />
            </Style>
            <Style Selector="^ /template/ atom|PixelAlignedBorder#Connector">
                <Setter Property="Background" Value="{atom:StepsTokenResource ErrorTailColor}" />
            </Style>
        </Style>

        <Style Selector="^[ConnectorStatus=Wait] /template/ atom|PixelAlignedBorder#Connector">
            <Setter Property="Background" Value="{atom:StepsTokenResource WaitTailColor}" />
        </Style>
        <Style Selector="^[ConnectorStatus=Process] /template/ atom|PixelAlignedBorder#Connector">
            <Setter Property="Background" Value="{atom:StepsTokenResource ProcessTailColor}" />
        </Style>
        <Style Selector="^[ConnectorStatus=Finish] /template/ atom|PixelAlignedBorder#Connector">
            <Setter Property="Background" Value="{atom:StepsTokenResource FinishTailColor}" />
        </Style>
        <Style Selector="^[ConnectorStatus=Error] /template/ atom|PixelAlignedBorder#Connector">
            <Setter Property="Background" Value="{atom:StepsTokenResource ErrorTailColor}" />
        </Style>

        <Style Selector="^[Orientation=Horizontal] /template/ atom|PixelAlignedBorder#Connector">
            <Setter Property="Margin" Value="{atom:StepsTokenResource HorizontalHeaderMargin}" />
        </Style>
        <Style Selector="^[Orientation=Vertical] /template/ ContentPresenter#ContentPresenter">
            <Setter Property="Padding" Value="{atom:StepsTokenResource VerticalDescriptionPadding}" />
        </Style>
        <Style Selector="^[Orientation=Vertical][IsLast=True] /template/ atom|StepsItemLayoutPanel">
            <Setter Property="VerticalItemPadding" Value="0" />
        </Style>

        <Style Selector="^[Type=Default][Orientation=Horizontal][TitlePlacement=Vertical] /template/ atom|StepsItemLayoutPanel">
            <Setter Property="IndicatorSpacing" Value="{atom:SharedTokenResource PaddingSM}" />
        </Style>
        <Style Selector="^[Type=Default][Orientation=Horizontal][TitlePlacement=Vertical] /template/ ContentPresenter#HeaderPresenter">
            <Setter Property="Margin" Value="{atom:StepsTokenResource VerticalLabelContentMargin}" />
        </Style>
        <Style Selector="^[Type=Default][Orientation=Horizontal][TitlePlacement=Vertical] /template/ ContentPresenter#SubHeaderPresenter">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="^[Type=Default][Orientation=Horizontal][TitlePlacement=Vertical] /template/ atom|PixelAlignedBorder#Connector">
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style Selector="^[Type=Dot] /template/ atom|StepsItemLayoutPanel">
            <Setter Property="ConnectorThickness" Value="{atom:StepsTokenResource DotLineThickness}" />
            <Setter Property="IndicatorSpacing" Value="{atom:SharedTokenResource PaddingSM}" />
        </Style>
        <Style Selector="^[Type=OutlineDot] /template/ atom|StepsItemLayoutPanel">
            <Setter Property="ConnectorThickness" Value="{atom:StepsTokenResource DotLineThickness}" />
            <Setter Property="IndicatorSpacing" Value="{atom:SharedTokenResource PaddingSM}" />
        </Style>
        <Style Selector="^[Type=Dot][Orientation=Vertical] /template/ atom|StepsItemLayoutPanel">
            <Setter Property="IndicatorSpacing" Value="{atom:SharedTokenResource UniformlyMargin}" />
        </Style>
        <Style Selector="^[Type=OutlineDot][Orientation=Vertical] /template/ atom|StepsItemLayoutPanel">
            <Setter Property="IndicatorSpacing" Value="{atom:SharedTokenResource UniformlyMargin}" />
        </Style>
        <Style Selector="^[Type=Dot] /template/ atom|PixelAlignedBorder#Connector">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="^[Type=OutlineDot] /template/ atom|PixelAlignedBorder#Connector">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="^[Type=Dot][Orientation=Horizontal] /template/ ContentPresenter#SubHeaderPresenter">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="^[Type=OutlineDot][Orientation=Horizontal] /template/ ContentPresenter#SubHeaderPresenter">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="^[Type=Navigation] /template/ atom|StepsItemLayoutPanel">
            <Setter Property="Padding" Value="{atom:SharedTokenResource PaddingSM}" />
            <Setter Property="IndicatorSpacing" Value="{atom:StepsTokenResource NavItemGutter}" />
        </Style>
        <Style Selector="^[Type=Navigation][Orientation=Vertical] /template/ atom|StepsItemLayoutPanel">
            <Setter Property="Padding" Value="{atom:StepsTokenResource VerticalNavItemPadding}" />
        </Style>
        <Style Selector="^[Type=Navigation] /template/ atom|PixelAlignedBorder#Connector">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^[Type=Navigation] /template/ atom|StepsNavigationArrow#NavigationArrow">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^[Type=Navigation] /template/ atom|PixelAlignedBorder#NavigationActiveIndicator">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^[Type=Navigation][Orientation=Horizontal] /template/ atom|PixelAlignedBorder#NavigationActiveIndicator">
            <Setter Property="RenderTransform" Value="scale(0, 1)" />
        </Style>
        <Style Selector="^[Type=Navigation][Orientation=Vertical] /template/ atom|PixelAlignedBorder#NavigationActiveIndicator">
            <Setter Property="RenderTransform" Value="scale(1, 0)" />
        </Style>
        <Style Selector="^[Type=Navigation][IsMotionEnabled=True] /template/ atom|PixelAlignedBorder#NavigationActiveIndicator">
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^[Type=Navigation][Orientation=Vertical] /template/ atom|StepsNavigationArrow#NavigationArrow">
            <Setter Property="Margin" Value="{atom:StepsTokenResource VerticalNavArrowMargin}" />
            <Setter Property="RenderTransform" Value="rotate(135deg)" />
        </Style>
        <Style Selector="^[Type=Navigation][Orientation=Vertical][SizeType=Small] /template/ atom|StepsNavigationArrow#NavigationArrow">
            <Setter Property="Margin" Value="{atom:StepsTokenResource VerticalNavArrowMarginSM}" />
        </Style>
        <Style Selector="^[Type=Navigation][IsCurrent=True] /template/ atom|PixelAlignedBorder#NavigationActiveIndicator">
            <Setter Property="RenderTransform" Value="scale(1, 1)" />
        </Style>

        <Style Selector="^[Type=Inline]">
            <Setter Property="Foreground" Value="{atom:StepsTokenResource InlineTitleColor}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="atom:ToolTip.Tip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
            <Setter Property="atom:ToolTip.Placement" Value="Top" />
        </Style>
        <Style Selector="^[Type=Inline]:pointerover:not(:disabled)">
            <Setter Property="Background" Value="{atom:SharedTokenResource ControlItemBgHover}" />
        </Style>
        <Style Selector="^[Type=Inline][IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <Transitions>
                    <atom:SolidColorBrushTransition Property="Background" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="^[Type=Inline] /template/ atom|StepsItemLayoutPanel">
            <Setter Property="Padding" Value="{atom:StepsTokenResource InlineItemPadding}" />
            <Setter Property="IndicatorSpacing" Value="{atom:SharedTokenResource UniformlyPaddingXS}" />
            <Setter Property="HorizontalConnectorGap" Value="0" />
        </Style>
        <Style Selector="^[Type=Inline] /template/ ContentPresenter#HeaderPresenter">
            <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSizeSM}" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Margin" Value="{atom:StepsTokenResource InlineHeaderMargin}" />
            <Setter Property="Padding" Value="{atom:StepsTokenResource InlineHeaderPadding}" />
        </Style>
        <Style Selector="^[Type=Inline] /template/ ContentPresenter#SubHeaderPresenter">
            <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSizeSM}" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="^[Type=Inline] /template/ ContentPresenter#ContentPresenter">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^[Type=Inline] /template/ atom|PixelAlignedBorder#Connector">
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="^[Type=Inline][ConnectorStatus=Wait] /template/ atom|PixelAlignedBorder#Connector">
            <Setter Property="Background" Value="{atom:StepsTokenResource InlineTailColor}" />
        </Style>

        <Style Selector="^[SizeType=Small]:not(^[Type=Inline]) /template/ ContentPresenter#HeaderPresenter">
            <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSize}" />
        </Style>

        <Style Selector="^[IsLast=True] /template/ atom|PixelAlignedBorder#Connector">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="^[IsLast=True] /template/ atom|StepsNavigationArrow#NavigationArrow">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="^:item-header-foreground-override /template/ ContentPresenter#HeaderPresenter">
            <Setter Property="Foreground" Value="{TemplateBinding ItemHeaderForeground}" />
        </Style>
        <Style Selector="^:item-sub-header-foreground-override /template/ ContentPresenter#SubHeaderPresenter">
            <Setter Property="Foreground" Value="{TemplateBinding ItemSubHeaderForeground}" />
        </Style>
        <Style Selector="^:item-rail-background-override /template/ atom|PixelAlignedBorder#Connector">
            <Setter Property="Background" Value="{TemplateBinding ItemRailBackground}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
