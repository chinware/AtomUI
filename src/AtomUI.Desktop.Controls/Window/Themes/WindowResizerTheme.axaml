<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:WindowResizer}" TargetType="atom:WindowResizer">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Name="PART_RootLayout">
                    <Border Tag="{x:Static atom:ResizeHandleLocation.North}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Top"
                            Cursor="TopSide"
                            Height="{Binding GripThickness.Top, RelativeSource={RelativeSource TemplatedParent}}" />
                    <Border Tag="{x:Static atom:ResizeHandleLocation.South}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Bottom"
                            Cursor="BottomSide"
                            Height="{Binding GripThickness.Bottom, RelativeSource={RelativeSource TemplatedParent}}" />
                    <Border Tag="{x:Static atom:ResizeHandleLocation.West}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Stretch"
                            Cursor="LeftSide"
                            Width="{Binding GripThickness.Left, RelativeSource={RelativeSource TemplatedParent}}" />
                    <Border Tag="{x:Static atom:ResizeHandleLocation.East}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Stretch"
                            Cursor="RightSide"
                            Width="{Binding GripThickness.Right, RelativeSource={RelativeSource TemplatedParent}}" />
                    <Border Tag="{x:Static atom:ResizeHandleLocation.NorthWest}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Cursor="TopLeftCorner"
                            Width="{Binding GripThickness.Left, RelativeSource={RelativeSource TemplatedParent}}"
                            Height="{Binding GripThickness.Top, RelativeSource={RelativeSource TemplatedParent}}" />
                    <Border Tag="{x:Static atom:ResizeHandleLocation.NorthEast}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Cursor="TopRightCorner"
                            Width="{Binding GripThickness.Right, RelativeSource={RelativeSource TemplatedParent}}"
                            Height="{Binding GripThickness.Top, RelativeSource={RelativeSource TemplatedParent}}" />
                    <Border Tag="{x:Static atom:ResizeHandleLocation.SouthWest}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Cursor="BottomLeftCorner"
                            Width="{Binding GripThickness.Left, RelativeSource={RelativeSource TemplatedParent}}"
                            Height="{Binding GripThickness.Bottom, RelativeSource={RelativeSource TemplatedParent}}" />
                    <Border Tag="{x:Static atom:ResizeHandleLocation.SouthEast}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom"
                            Cursor="BottomRightCorner"
                            Width="{Binding GripThickness.Right, RelativeSource={RelativeSource TemplatedParent}}"
                            Height="{Binding GripThickness.Bottom, RelativeSource={RelativeSource TemplatedParent}}" />
                </Panel>
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ Border">
            <Setter Property="Background" Value="Transparent" />
        </Style>

    </ControlTheme>
</ResourceDictionary>
