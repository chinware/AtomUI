<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themeResources="using:AtomUI.Theme.Resources"
    xmlns:generated="using:AtomUI.Generated.AtomUI_Desktop_Controls"
    themeResources:ControlTokenScope.Identity="{x:Static generated:DatePickerThemeAsset.Identity}"
    xmlns:calendarView="using:AtomUI.Desktop.Controls.CalendarView"
    x:ClassModifier="internal">
    <atom:StringToTextBlockConverter x:Key="StringToTextBlockConverter"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
    <ControlTheme x:Key="{x:Type calendarView:CalendarButton}"
                  TargetType="calendarView:CalendarButton">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,*"
                      Background="Transparent">
                    <Border Name="RangeIndicator"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            IsVisible="False"/>
                    <Border Name="RangeStartIndicator"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            IsVisible="False"/>
                    <Border Name="RangeEndIndicator"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            IsVisible="False"/>
                    <atom:PixelAlignedBorder
                        Grid.ColumnSpan="2"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <ContentPresenter Name="Content"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontSize="{TemplateBinding FontSize}"
                                          Content="{TemplateBinding Content, Converter={StaticResource StringToTextBlockConverter}}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </atom:PixelAlignedBorder>
                </Grid>
            </ControlTemplate>
        </Setter>

        <Setter Property="ClickMode" Value="Release" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextLabel}" />
        <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadiusSM}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="{atom:SharedTokenResource BorderThickness}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSize}" />
        <Setter Property="MinHeight" Value="{atom:CalendarTokenResource CellHeight}" />

        <Style Selector="^ /template/ Border#RangeIndicator">
            <Setter Property="Height" Value="{atom:CalendarTokenResource CellHeight}" />
        </Style>

        <Style Selector="^ /template/ Border#RangeStartIndicator">
            <Setter Property="Height" Value="{atom:CalendarTokenResource CellHeight}" />
        </Style>

        <Style Selector="^ /template/ Border#RangeEndIndicator">
            <Setter Property="Height" Value="{atom:CalendarTokenResource CellHeight}" />
        </Style>

        <Style Selector="^ /template/ ContentPresenter#Content">
            <Setter Property="Width" Value="{atom:DatePickerTokenResource YearMonthCellWidth}" />
            <Setter Property="Height" Value="{atom:CalendarTokenResource CellHeight}" />
            <Setter Property="LineHeight" Value="{atom:CalendarTokenResource CellLineHeight}" />
        </Style>

        <Style Selector="^:pointerover:not(:selected):not(:range-start):not(:range-end):not(:range-middle):not(:range-preview-start):not(:range-preview-end):not(:range-preview-middle)">
            <Setter Property="Background" Value="{atom:CalendarTokenResource CellHoverBg}" />
        </Style>

        <Style Selector="^:inactive">
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextDisabled}" />
        </Style>

        <Style Selector="^:today">
            <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorPrimary}" />
        </Style>

        <Style Selector="^:selected:not(:inactive)">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorPrimary}" />
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorWhite}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="^:range-middle:not(:inactive), ^:range-preview-middle:not(:inactive)">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style Selector="^ /template/ Border#RangeIndicator">
                <Setter Property="IsVisible" Value="True" />
                <Setter Property="Background" Value="{atom:CalendarTokenResource CellActiveWithRangeBg}" />
            </Style>
        </Style>

        <Style Selector="^:range-start:not(:inactive), ^:range-preview-start:not(:inactive)">
            <Style Selector="^ /template/ Border#RangeStartIndicator">
                <Setter Property="IsVisible" Value="True" />
                <Setter Property="Background" Value="{atom:CalendarTokenResource CellActiveWithRangeBg}" />
            </Style>
        </Style>

        <Style Selector="^:range-end:not(:inactive), ^:range-preview-end:not(:inactive)">
            <Style Selector="^ /template/ Border#RangeEndIndicator">
                <Setter Property="IsVisible" Value="True" />
                <Setter Property="Background" Value="{atom:CalendarTokenResource CellActiveWithRangeBg}" />
            </Style>
        </Style>

        <Style Selector="^:range-start:not(:inactive), ^:range-end:not(:inactive), ^:range-preview-start:not(:inactive), ^:range-preview-end:not(:inactive)">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorPrimary}" />
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorWhite}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <Transitions>
                    <atom:SolidColorBrushTransition Property="Background" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationFast}" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
