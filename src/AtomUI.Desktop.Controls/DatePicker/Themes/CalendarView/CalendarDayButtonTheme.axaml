<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:calendarView="clr-namespace:AtomUI.Desktop.Controls.CalendarView"
    x:ClassModifier="internal">
    <atom:StringToTextBlockConverter x:Key="StringToTextBlockConverter" VerticalAlignment="Center"
                                     HorizontalAlignment="Center" />
    <ControlTheme x:Key="{x:Type calendarView:CalendarDayButton}" TargetType="calendarView:CalendarDayButton">
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="*,*"
                      Background="Transparent">
                    <Border Name="WeekRangeIndicator"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                            IsVisible="False"/>
                    <Border Name="WeekHoverIndicator"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                            IsVisible="False"/>
                    <Border Name="WeekSelectionIndicator"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                            IsVisible="False"/>
                    <Border Name="RangeIndicator"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            IsVisible="False"/>
                    <Border Name="RangeStartIndicator"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            IsVisible="False"/>
                    <Border Name="RangeEndIndicator"
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            IsVisible="False"/>
                    <atom:PixelAlignedBorder
                        Grid.ColumnSpan="2"
                        Width="{atom:CalendarTokenResource CellWidth}"
                        Height="{atom:CalendarTokenResource CellHeight}"
                        Margin="{atom:CalendarTokenResource CellMargin}"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <ContentPresenter
                            Name="Content"
                            Foreground="{TemplateBinding Foreground}"
                            FontSize="{TemplateBinding FontSize}"
                            Content="{TemplateBinding Content, Converter={StaticResource StringToTextBlockConverter}}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </atom:PixelAlignedBorder>
                </Grid>
            </ControlTemplate>
        </Setter>

        <Setter Property="ClickMode" Value="Release" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextLabel}" />
        <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadiusSM}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="{atom:SharedTokenResource FontSize}" />
        
        <Style Selector="^ /template/ Border#RangeIndicator">
            <Setter Property="Height" Value="{atom:CalendarTokenResource CellHeight}" />
        </Style>

        <Style Selector="^ /template/ Border#WeekHoverIndicator">
            <Setter Property="Height" Value="{atom:CalendarTokenResource CellHeight}" />
        </Style>

        <Style Selector="^ /template/ Border#WeekRangeIndicator">
            <Setter Property="Height" Value="{atom:CalendarTokenResource CellHeight}" />
        </Style>

        <Style Selector="^ /template/ Border#WeekSelectionIndicator">
            <Setter Property="Height" Value="{atom:CalendarTokenResource CellHeight}" />
        </Style>
        
        <Style Selector="^ /template/ Border#RangeStartIndicator">
            <Setter Property="Height" Value="{atom:CalendarTokenResource CellHeight}" />
        </Style>
        
        <Style Selector="^ /template/ Border#RangeEndIndicator">
            <Setter Property="Height" Value="{atom:CalendarTokenResource CellHeight}" />
        </Style>

        <Style Selector="^:pointerover:not(:range-start):not(:range-middle):not(:range-end):not(:range-preview-start):not(:range-preview-middle):not(:range-preview-end):not(:week-range-start):not(:week-range-middle):not(:week-range-end):not(:week-hover-start):not(:week-hover-middle):not(:week-hover-end)">
            <Setter Property="Background" Value="{atom:CalendarTokenResource CellHoverBg}" />
        </Style>

        <Style Selector="^:inactive">
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextDisabled}" />
        </Style>

        <Style Selector="^:week-number">
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextDisabled}" />
        </Style>

        <Style Selector="^:today">
            <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorPrimary}" />
            <Setter Property="BorderThickness" Value="{atom:SharedTokenResource BorderThickness}" />
        </Style>

        <Style Selector="^:range-middle:not(:inactive), ^:range-preview-middle:not(:inactive)">
            <Style Selector="^ /template/ Border#RangeIndicator">
                <Setter Property="IsVisible" Value="True" />
                <Setter Property="Background" Value="{atom:CalendarTokenResource CellActiveWithRangeBg}" />
            </Style>
        </Style>

        <Style Selector="^:range-start:not(:inactive), ^:range-preview-start:not(:inactive)">
            <Style Selector="^ /template/ Border#RangeStartIndicator">
                <Setter Property="IsVisible" Value="True" />
                <Setter Property="Background" Value="{atom:CalendarTokenResource CellActiveWithRangeBg}" />
            </Style>
        </Style>

        <Style Selector="^:range-end:not(:inactive), ^:range-preview-end:not(:inactive)">
            <Style Selector="^ /template/ Border#RangeEndIndicator">
                <Setter Property="IsVisible" Value="True" />
                <Setter Property="Background" Value="{atom:CalendarTokenResource CellActiveWithRangeBg}" />
            </Style>
        </Style>
        
        <Style Selector="^:selected:not(:inactive)">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorPrimary}" />
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorWhite}" />
        </Style>

        <Style Selector="^:range-preview-start:not(:inactive), ^:range-preview-end:not(:inactive)">
            <Setter Property="Background" Value="{atom:SharedTokenResource ColorPrimary}" />
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorWhite}" />
        </Style>

        <Style Selector="^:week-range-start, ^:week-range-middle, ^:week-range-end">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style Selector="^ /template/ Border#WeekRangeIndicator">
                <Setter Property="IsVisible" Value="True" />
                <Setter Property="Background" Value="{atom:CalendarTokenResource CellActiveWithRangeBg}" />
            </Style>
        </Style>

        <Style Selector="^:week-hover-start, ^:week-hover-middle, ^:week-hover-end">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style Selector="^ /template/ Border#WeekHoverIndicator">
                <Setter Property="IsVisible" Value="True" />
                <Setter Property="Background" Value="{atom:CalendarTokenResource CellHoverBg}" />
            </Style>
        </Style>

        <Style Selector="^:week-selection-start, ^:week-selection-middle, ^:week-selection-end">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorWhite}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Style Selector="^ /template/ Border#WeekSelectionIndicator">
                <Setter Property="IsVisible" Value="True" />
                <Setter Property="Background" Value="{atom:SharedTokenResource ColorPrimary}" />
            </Style>
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <Transitions>
                    <atom:SolidColorBrushTransition Property="Background" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationFast}" />
                    <atom:SolidColorBrushTransition Property="Foreground" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationFast}" />
                </Transitions>
            </Setter>
        </Style>

    </ControlTheme>
</ResourceDictionary>
