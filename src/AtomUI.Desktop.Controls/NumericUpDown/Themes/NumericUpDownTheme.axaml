<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    x:ClassModifier="internal">
    <Thickness x:Key="NumericUpDownSpinnerContentPadding">0</Thickness>

    <ControlTheme x:Key="{x:Type atom:NumericUpDown}" TargetType="atom:NumericUpDown">
        <Setter Property="Template">
            <ControlTemplate>
                <atom:ButtonSpinner
                    Name="PART_Spinner"
                    IsSpinEnabled="{TemplateBinding AllowSpin}"
                    IsEnabled="{TemplateBinding IsEnabled}"
                    SizeType="{TemplateBinding SizeType}"
                    StyleVariant="{TemplateBinding StyleVariant}"
                    Status="{TemplateBinding Status}"
                    DataValidationErrors.Errors="{TemplateBinding DataValidationErrors.Errors}"
                    IsButtonSpinnerVisible="{TemplateBinding ShowButtonSpinner}"
                    IsButtonSpinnerFloatable="True"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    LeftAddOn="{TemplateBinding LeftAddOn}"
                    LeftAddOnTemplate="{TemplateBinding LeftAddOnTemplate}"
                    RightAddOn="{TemplateBinding RightAddOn}"
                    RightAddOnTemplate="{TemplateBinding RightAddOnTemplate}"
                    InnerLeftContent="{TemplateBinding InnerLeftContent}"
                    InnerLeftContentTemplate="{TemplateBinding InnerLeftContentTemplate}"
                    SpinnerHandleWidth="{TemplateBinding SpinnerHandleWidth}"
                    CompactSpaceItemPosition="{TemplateBinding CompactSpaceItemPosition}"
                    CompactSpaceOrientation="{TemplateBinding CompactSpaceOrientation}"
                    IsUsedInCompactSpace="{TemplateBinding IsUsedInCompactSpace}">
                    <atom:ButtonSpinner.InnerRightContent>
                        <StackPanel Orientation="Horizontal"
                                    Spacing="{atom:SharedTokenResource UniformlyPaddingXXS}">
                            <atom:InputClearIconButton
                                Name="PART_ClearButton"
                                IsPassthroughMouseEvent="False" />
                            <ContentPresenter
                                Name="PART_InnerRightContentPresenter"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                HorizontalAlignment="Right"
                                Focusable="False" />
                        </StackPanel>
                    </atom:ButtonSpinner.InnerRightContent>
                    <atom:TextBox
                        Name="PART_TextBox"
                        VerticalContentAlignment="Center"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        BorderThickness="0"
                        Padding="0"
                        TextWrapping="NoWrap"
                        AcceptsReturn="False"
                        DataValidationErrors.Errors="{TemplateBinding DataValidationErrors.Errors}"
                        SizeType="Custom"
                        IsReadOnly="{TemplateBinding IsReadOnly}"
                        Text="{TemplateBinding Text, Mode=TwoWay}"
                        PlaceholderText="{TemplateBinding PlaceholderText}"
                        PlaceholderForeground="{TemplateBinding PlaceholderForeground}"
                        />
                </atom:ButtonSpinner>
            </ControlTemplate>
        </Setter>

        <Style Selector="^[Mode=Spinner][ShowButtonSpinner=True]">
            <Setter Property="Template">
                <ControlTemplate>
                    <atom:ButtonSpinner
                        Name="PART_Spinner"
                        IsSpinEnabled="{TemplateBinding AllowSpin}"
                        IsEnabled="{TemplateBinding IsEnabled}"
                        SizeType="{TemplateBinding SizeType}"
                        StyleVariant="{TemplateBinding StyleVariant}"
                        Status="{TemplateBinding Status}"
                        DataValidationErrors.Errors="{TemplateBinding DataValidationErrors.Errors}"
                        IsButtonSpinnerVisible="{TemplateBinding ShowButtonSpinner}"
                        IsButtonSpinnerFloatable="False"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        LeftAddOn="{TemplateBinding LeftAddOn}"
                        LeftAddOnTemplate="{TemplateBinding LeftAddOnTemplate}"
                        RightAddOn="{TemplateBinding RightAddOn}"
                        RightAddOnTemplate="{TemplateBinding RightAddOnTemplate}"
                        InnerLeftContent="{TemplateBinding InnerLeftContent}"
                        InnerLeftContentTemplate="{TemplateBinding InnerLeftContentTemplate}"
                        SpinnerHandleWidth="{TemplateBinding SpinnerHandleWidth}"
                        CompactSpaceItemPosition="{TemplateBinding CompactSpaceItemPosition}"
                        CompactSpaceOrientation="{TemplateBinding CompactSpaceOrientation}"
                        IsUsedInCompactSpace="{TemplateBinding IsUsedInCompactSpace}">
                        <atom:ButtonSpinner.Styles>
                            <Style Selector="atom|ButtonSpinner /template/ atom|IconButton#PART_DecreaseButton,
                                             atom|ButtonSpinner /template/ atom|IconButton#PART_IncreaseButton">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="atom|ButtonSpinner /template/ atom|IconButton#PART_DecreaseButton:pointerover:not(:disabled),
                                             atom|ButtonSpinner /template/ atom|IconButton#PART_IncreaseButton:pointerover:not(:disabled)">
                                <Setter Property="IconBrush" Value="{atom:ButtonSpinnerTokenResource HandleHoverColor}" />
                            </Style>
                            <Style Selector="atom|ButtonSpinner /template/ atom|IconButton#PART_DecreaseButton:pressed:not(:disabled),
                                             atom|ButtonSpinner /template/ atom|IconButton#PART_IncreaseButton:pressed:not(:disabled)">
                                <Setter Property="Background" Value="{atom:ButtonSpinnerTokenResource HandleActiveBg}" />
                            </Style>
                        </atom:ButtonSpinner.Styles>
                        <atom:ButtonSpinner.Template>
                            <ControlTemplate TargetType="atom:ButtonSpinner">
                                <atom:ButtonSpinnerDecoratedBox
                                    Name="PART_DecoratedBox"
                                    LeftAddOn="{TemplateBinding LeftAddOn}"
                                    LeftAddOnTemplate="{TemplateBinding LeftAddOnTemplate}"
                                    RightAddOn="{TemplateBinding RightAddOn}"
                                    RightAddOnTemplate="{TemplateBinding RightAddOnTemplate}"
                                    StyleVariant="{TemplateBinding StyleVariant}"
                                    SizeType="{TemplateBinding SizeType}"
                                    Status="{TemplateBinding Status}"
                                    IsShowHandle="False"
                                    IsHandleFloatable="False"
                                    ContentPadding="{Binding Source={StaticResource NumericUpDownSpinnerContentPadding}, Priority=LocalValue}"
                                    Focusable="True"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    CompactSpaceItemPosition="{TemplateBinding CompactSpaceItemPosition}"
                                    CompactSpaceOrientation="{TemplateBinding CompactSpaceOrientation}"
                                    IsUsedInCompactSpace="{TemplateBinding IsUsedInCompactSpace}">
                                    <DockPanel LastChildFill="True">
                                        <atom:PixelAlignedBorder
                                            DockPanel.Dock="Left"
                                            BorderBrush="{atom:ButtonSpinnerTokenResource HandleBorderColor}"
                                            BorderThickness="0,0,1,0"
                                            IsVisible="{TemplateBinding IsButtonSpinnerVisible}">
                                            <atom:IconButton
                                                Name="PART_DecreaseButton"
                                                Icon="{antdicons:AntDesignIconProvider MinusOutlined}"
                                                CornerRadius="0"
                                                BorderThickness="0"
                                                Padding="{atom:AddOnDecoratedBoxTokenResource Padding}"
                                                BackgroundSizing="InnerBorderEdge"
                                                IconWidth="{atom:SharedTokenResource IconSize}"
                                                IconHeight="{atom:SharedTokenResource IconSize}"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch" />
                                        </atom:PixelAlignedBorder>
                                        <atom:PixelAlignedBorder
                                            DockPanel.Dock="Right"
                                            BorderBrush="{atom:ButtonSpinnerTokenResource HandleBorderColor}"
                                            BorderThickness="1,0,0,0"
                                            IsVisible="{TemplateBinding IsButtonSpinnerVisible}">
                                            <atom:IconButton
                                                Name="PART_IncreaseButton"
                                                Icon="{antdicons:AntDesignIconProvider PlusOutlined}"
                                                CornerRadius="0"
                                                BorderThickness="0"
                                                Padding="{atom:AddOnDecoratedBoxTokenResource Padding}"
                                                BackgroundSizing="InnerBorderEdge"
                                                IconWidth="{atom:SharedTokenResource IconSize}"
                                                IconHeight="{atom:SharedTokenResource IconSize}"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch" />
                                        </atom:PixelAlignedBorder>
                                        <DockPanel LastChildFill="True">
                                            <ContentPresenter
                                                DockPanel.Dock="Left"
                                                VerticalAlignment="Stretch"
                                                VerticalContentAlignment="Center"
                                                HorizontalAlignment="Left"
                                                Focusable="False"
                                                Content="{TemplateBinding InnerLeftContent}"
                                                ContentTemplate="{TemplateBinding InnerLeftContentTemplate}"
                                                IsVisible="{TemplateBinding InnerLeftContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            <ContentPresenter
                                                DockPanel.Dock="Right"
                                                VerticalAlignment="Stretch"
                                                VerticalContentAlignment="Center"
                                                HorizontalAlignment="Right"
                                                Focusable="False"
                                                Content="{TemplateBinding InnerRightContent}"
                                                IsVisible="{TemplateBinding InnerRightContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                            <ContentPresenter
                                                Content="{TemplateBinding Content}"
                                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                                        </DockPanel>
                                    </DockPanel>
                                </atom:ButtonSpinnerDecoratedBox>
                            </ControlTemplate>
                        </atom:ButtonSpinner.Template>
                        <atom:ButtonSpinner.InnerRightContent>
                            <StackPanel Orientation="Horizontal"
                                        Spacing="{atom:SharedTokenResource UniformlyPaddingXXS}">
                                <atom:InputClearIconButton
                                    Name="PART_ClearButton"
                                    IsPassthroughMouseEvent="False" />
                                <ContentPresenter
                                    Name="PART_InnerRightContentPresenter"
                                    VerticalAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    HorizontalAlignment="Right"
                                    Focusable="False" />
                            </StackPanel>
                        </atom:ButtonSpinner.InnerRightContent>
                        <atom:TextBox
                            Name="PART_TextBox"
                            VerticalContentAlignment="Center"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            BorderThickness="0"
                            TextWrapping="NoWrap"
                            AcceptsReturn="False"
                            DataValidationErrors.Errors="{TemplateBinding DataValidationErrors.Errors}"
                            SizeType="Custom"
                            IsReadOnly="{TemplateBinding IsReadOnly}"
                            Padding="{atom:AddOnDecoratedBoxTokenResource Padding}"
                            Text="{TemplateBinding Text, Mode=TwoWay}"
                            TextAlignment="Center"
                            PlaceholderText="{TemplateBinding PlaceholderText}"
                            PlaceholderForeground="{TemplateBinding PlaceholderForeground}" />
                    </atom:ButtonSpinner>
                </ControlTemplate>
            </Setter>
        </Style>

        <Setter Property="IsMotionEnabled"
                Value="{atom:SharedTokenResource EnableMotion}" />
        <Setter Property="SpinnerHandleWidth"
                Value="{atom:ButtonSpinnerTokenResource HandleWidth}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="PlaceholderForeground" Value="{atom:SharedTokenResource ColorTextPlaceholder}" />

    </ControlTheme>
</ResourceDictionary>
