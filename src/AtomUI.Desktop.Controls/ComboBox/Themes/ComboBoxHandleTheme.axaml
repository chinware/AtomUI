<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:ComboBoxHandle}" TargetType="atom:ComboBoxHandle">
        <Setter Property="Template">
            <ControlTemplate>
                <atom:IconPresenter
                    Name="PART_OpenIndicator"
                    IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                    Icon="{antdicons:AntDesignIconProvider DownOutlined}"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False" />
            </ControlTemplate>
        </Setter>

        <Style Selector="^ /template/ atom|IconPresenter#PART_OpenIndicator">
            <Setter Property="Width" Value="{atom:SharedTokenResource IconSizeSM}" />
            <Setter Property="Height"
                    Value="{atom:SharedTokenResource IconSizeSM}" />
        </Style>
        
        <Style Selector="^:pointerover /template/ atom|IconPresenter#PART_OpenIndicator">
            <Setter Property="IconBrush"
                    Value="{atom:ButtonSpinnerTokenResource HandleHoverColor}" />
        </Style>
        <Style Selector="^:pressed /template/ atom|IconPresenter#PART_OpenIndicator">
            <Setter Property="IconBrush"
                    Value="{atom:SharedTokenResource ColorPrimaryActive}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
