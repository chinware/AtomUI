<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <atom:StringToTextBlockConverter x:Key="StringToTextBlockConverter" VerticalAlignment="Center" />
    <ControlTheme x:Key="{x:Type atom:PaginationNavItem}" TargetType="atom:PaginationNavItem">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <atom:PixelAlignedBorder Background="{TemplateBinding Background}"
                                             BorderBrush="{TemplateBinding BorderBrush}"
                                             CornerRadius="{TemplateBinding CornerRadius}"
                                             Padding="{TemplateBinding Padding}"
                                             BorderThickness="{TemplateBinding BorderThickness}" />
                    <atom:IconPresenter Name="IconPresenter"
                                         IsVisible="False"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Icon="{TemplateBinding Icon}"
                                         IsEnabled="{TemplateBinding IsEnabled}" />
                    <ContentPresenter Name="ContentPresenter"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center"
                                      Content="{TemplateBinding Content, Mode=Default, Converter={StaticResource StringToTextBlockConverter}}"
                                      IsVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="{atom:PaginationTokenSharedTokenResource BorderRadius}" />
        <Setter Property="FontSize" Value="{atom:PaginationTokenSharedTokenResource FontSize}" />
        <Setter Property="Padding"
                Value="{atom:PaginationTokenResource PaginationItemPaddingInline}" />
        <Setter Property="BorderBrush" Value="{atom:PaginationTokenSharedTokenResource ColorTransparent}" />
        <Setter Property="BorderThickness" Value="{atom:PaginationTokenSharedTokenResource BorderThickness}" />
        <Setter Property="Foreground" Value="{atom:PaginationTokenSharedTokenResource ColorText}" />
        <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
            <Setter Property="IconBrush" Value="{TemplateBinding Foreground}" />
        </Style>

        <Style Selector="^[PaginationItemType=PageIndicator]">
            <Style Selector="^ /template/ ContentPresenter#ContentPresenter">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>
        <Style Selector="^:not(^[PaginationItemType=PageIndicator])">
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="IsVisible" Value="True" />
            </Style>
        </Style>

        <Style Selector="^[IsEnabled=True]">
            <Style Selector="^:not(^[PaginationItemType=Ellipses])">
                <Setter Property="Cursor" Value="Hand" />
            </Style>

            <Style Selector="^[PaginationItemType=PageIndicator]">
                <Style Selector="^:selected">
                    <Setter Property="Foreground" Value="{atom:PaginationTokenSharedTokenResource ColorPrimary}" />
                    <Setter Property="Background"
                            Value="{atom:PaginationTokenResource ItemActiveBg}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="BorderBrush"
                            Value="{atom:PaginationTokenSharedTokenResource ColorPrimary}" />
                    <Style Selector="^:pointerover">
                        <Setter Property="Foreground"
                                Value="{atom:PaginationTokenSharedTokenResource ColorPrimaryHover}" />
                        <Setter Property="BorderBrush"
                                Value="{atom:PaginationTokenSharedTokenResource ColorPrimaryHover}" />
                    </Style>
                </Style>
                <Style Selector="^:not(:selected)">
                    <Setter Property="Background" Value="{atom:PaginationTokenResource ItemBg}" />
                    <Setter Property="Foreground" Value="{atom:PaginationTokenSharedTokenResource ColorText}" />
                    <Style Selector="^:pointerover">
                        <Setter Property="Background"
                                Value="{atom:PaginationTokenSharedTokenResource ColorBgTextHover}" />
                    </Style>
                    <Style Selector="^:pressed">
                        <Setter Property="Background"
                                Value="{atom:PaginationTokenSharedTokenResource ColorBgTextActive}" />
                    </Style>
                </Style>
            </Style>

            <Style Selector="^[PaginationItemType=Previous], ^[PaginationItemType=Next]">
                <Setter Property="Background"
                        Value="{atom:PaginationTokenSharedTokenResource ColorTransparent}" />
                <Setter Property="Foreground"
                        Value="{atom:PaginationTokenSharedTokenResource ColorText}" />
                <Style Selector="^:pointerover">
                    <Setter Property="Background"
                            Value="{atom:PaginationTokenSharedTokenResource ColorBgTextHover}" />
                </Style>
                <Style Selector="^:pressed">
                    <Setter Property="Background"
                            Value="{atom:PaginationTokenSharedTokenResource ColorBgTextActive}" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Setter Property="Height" Value="{atom:PaginationTokenResource ItemSize}" />
            <Setter Property="MinWidth" Value="{atom:PaginationTokenResource ItemSize}" />

            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="Width" Value="{atom:PaginationTokenSharedTokenResource IconSizeLG}" />
                <Setter Property="Height" Value="{atom:PaginationTokenSharedTokenResource IconSizeLG}" />
            </Style>

        </Style>
        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Setter Property="Height" Value="{atom:PaginationTokenResource ItemSize}" />
            <Setter Property="MinWidth" Value="{atom:PaginationTokenResource ItemSize}" />
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="Width" Value="{atom:PaginationTokenSharedTokenResource IconSize}" />
                <Setter Property="Height" Value="{atom:PaginationTokenSharedTokenResource IconSize}" />
            </Style>
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Setter Property="Height" Value="{atom:PaginationTokenResource ItemSizeSM}" />
            <Setter Property="MinWidth" Value="{atom:PaginationTokenResource ItemSizeSM}" />
            <Style Selector="^ /template/ atom|IconPresenter#IconPresenter">
                <Setter Property="Width" Value="{atom:PaginationTokenSharedTokenResource IconSizeSM}" />
                <Setter Property="Height" Value="{atom:PaginationTokenSharedTokenResource IconSizeSM}" />
            </Style>
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground"
                    Value="{atom:PaginationTokenResource ItemActiveColorDisabled}" />
            <Style Selector="^:selected">
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background"
                        Value="{atom:PaginationTokenResource ItemActiveBgDisabled}" />
            </Style>

        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <Transitions>
                    <atom:SolidColorBrushTransition Property="Background" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    <atom:SolidColorBrushTransition Property="BorderBrush" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    <atom:SolidColorBrushTransition Property="Foreground" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                </Transitions>
            </Setter>
        </Style>
    </ControlTheme>
</ResourceDictionary>
