<ControlTheme
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themeResources="using:AtomUI.Theme.Resources"
    xmlns:generated="using:AtomUI.Generated.AtomUI_Desktop_Controls"
    xmlns:calendar="clr-namespace:AtomUI.Desktop.Controls.Internal.Calendar"
    themeResources:ControlTokenScope.Identity="{x:Static generated:CalendarControlThemeAsset.Identity}"
    x:Class="AtomUI.Desktop.Controls.Themes.CalendarViewCellTheme"
    TargetType="calendar:CalendarViewCell"
    x:ClassModifier="internal">
    <Setter Property="Template">
        <ControlTemplate TargetType="calendar:CalendarViewCell">
            <Border Name="PART_Item"
                    Background="Transparent"
                    Focusable="True"
                    Padding="0"
                    Margin="{atom:SharedTokenResource MarginXXS}">
                <Border Name="PART_CellInner"
                        CornerRadius="{atom:SharedTokenResource BorderRadiusSM}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                    <Panel>
                        <ContentControl Name="PART_ItemContent"
                                        Content="{TemplateBinding Context}"
                                        ContentTemplate="{TemplateBinding CellTemplate}"
                                        IsVisible="{Binding CellTemplate, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <atom:TextBlock Name="PART_Value"
                                        Text="{TemplateBinding DisplayText}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding CellTemplate, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNull}}" />
                    </Panel>
                </Border>
            </Border>
        </ControlTemplate>
    </Setter>

    <!-- 基础单元格视觉 -->
    <Style Selector="^ /template/ Border#PART_CellInner">
        <Setter Property="MinWidth" Value="{atom:SharedTokenResource ControlHeightSM}" />
        <Setter Property="MinHeight" Value="{atom:SharedTokenResource ControlHeightSM}" />
    </Style>

    <!-- 今天 -->
    <Style Selector="^:today /template/ Border#PART_CellInner">
        <Setter Property="BorderBrush" Value="{atom:SharedTokenResource ColorPrimary}" />
        <Setter Property="BorderThickness" Value="{atom:SharedTokenResource BorderThickness}" />
    </Style>

    <!-- 选中 -->
    <Style Selector="^:selected /template/ Border#PART_CellInner">
        <Setter Property="Background" Value="{atom:CalendarControlTokenResource ItemActiveBg}" />
    </Style>

    <!-- 相邻月份补位（outside） -->
    <Style Selector="^:outside /template/ atom|TextBlock#PART_Value">
        <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextDisabled}" />
    </Style>

    <!-- 禁用 -->
    <Style Selector="^:disabled /template/ atom|TextBlock#PART_Value">
        <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextDisabled}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_Item">
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- 周序号 -->
    <Style Selector="^:week /template/ atom|TextBlock#PART_Value">
        <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextDisabled}" />
    </Style>

    <!-- hover（非禁用非周序号） -->
    <Style Selector="^:pointerover:not(:disabled):not(:week):not(:selected) /template/ Border#PART_CellInner">
        <Setter Property="Background" Value="{atom:SharedTokenResource ControlItemBgHover}" />
    </Style>
</ControlTheme>
