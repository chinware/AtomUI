<ControlTheme
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themeResources="using:AtomUI.Theme.Resources"
    xmlns:generated="using:AtomUI.Generated.AtomUI_Desktop_Controls"
    xmlns:calendar="clr-namespace:AtomUI.Desktop.Controls.Internal.Calendar"
    themeResources:ControlTokenScope.Identity="{x:Static generated:CalendarControlThemeAsset.Identity}"
    x:Class="AtomUI.Desktop.Controls.Themes.CalendarControlTheme"
    TargetType="atom:Calendar"
    x:ClassModifier="internal">
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:Calendar">
            <Border Name="PART_Root"
                    Background="{atom:CalendarControlTokenResource FullBg}"
                    BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                    BorderThickness="{atom:SharedTokenResource BorderThickness}"
                    CornerRadius="{atom:SharedTokenResource BorderRadiusLG}"
                    Padding="{atom:SharedTokenResource PaddingSM}">
                <DockPanel LastChildFill="True">
                    <ContentControl Name="PART_HeaderPresenter"
                                    DockPanel.Dock="Top"
                                    Content="{TemplateBinding Value}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}" />
                    <calendar:CalendarView Name="PART_CalendarView"
                                           Value="{TemplateBinding Value}"
                                           ViewMode="{Binding ViewMode, RelativeSource={RelativeSource TemplatedParent}}"
                                           ShowWeek="{TemplateBinding ShowWeek}"
                                           ValidRange="{TemplateBinding ValidRange}"
                                           DisabledDate="{TemplateBinding DisabledDate}"
                                           CellTemplate="{TemplateBinding CellTemplate}"
                                           FullCellTemplate="{TemplateBinding FullCellTemplate}" />
                </DockPanel>
            </Border>
        </ControlTemplate>
    </Setter>

    <Style Selector="^">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
</ControlTheme>
