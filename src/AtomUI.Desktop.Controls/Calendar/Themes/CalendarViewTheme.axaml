<ControlTheme
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:themeResources="using:AtomUI.Theme.Resources"
    xmlns:generated="using:AtomUI.Generated.AtomUI_Desktop_Controls"
    xmlns:calendar="clr-namespace:AtomUI.Desktop.Controls.Internal.Calendar"
    themeResources:ControlTokenScope.Identity="{x:Static generated:CalendarControlThemeAsset.Identity}"
    x:Class="AtomUI.Desktop.Controls.Themes.CalendarViewTheme"
    TargetType="calendar:CalendarView"
    x:ClassModifier="internal">
    <Setter Property="Template">
        <ControlTemplate TargetType="calendar:CalendarView">
            <DockPanel Name="PART_Body" LastChildFill="True">
                <StackPanel Name="PART_WeekHeader"
                            DockPanel.Dock="Top"
                            Orientation="Horizontal" />
                <Grid Name="PART_CellHost" />
            </DockPanel>
        </ControlTemplate>
    </Setter>

    <!-- WeekHeader 的每个星期标题等分 -->
    <Style Selector="^ /template/ StackPanel#PART_WeekHeader > TextBlock">
        <Setter Property="Width" Value="{atom:SharedTokenResource ControlHeightSM}" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextLabel}" />
    </Style>
</ControlTheme>
