<ControlTheme
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:calendar="clr-namespace:AtomUI.Desktop.Controls.Internal.Calendar"
    x:Class="AtomUI.Desktop.Controls.Themes.CalendarHeaderTheme"
    TargetType="calendar:CalendarHeader"
    x:ClassModifier="internal">
    <Setter Property="Template">
        <ControlTemplate TargetType="calendar:CalendarHeader">
            <Border Padding="{atom:SharedTokenResource PaddingXS}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="{atom:SharedTokenResource UniformlyMarginXS}">
                    <atom:ComboBox Name="PART_YearSelect"
                                   MinWidth="{atom:CalendarTokenResource YearControlWidth}" />
                    <atom:ComboBox Name="PART_MonthSelect"
                                   MinWidth="{atom:CalendarTokenResource MonthControlWidth}" />
                    <atom:Segmented Name="PART_ModeSwitch">
                        <atom:SegmentedItem Content="Month" />
                        <atom:SegmentedItem Content="Year" />
                    </atom:Segmented>
                </StackPanel>
            </Border>
        </ControlTemplate>
    </Setter>
</ControlTheme>
