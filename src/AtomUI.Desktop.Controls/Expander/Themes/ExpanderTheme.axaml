<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:Expander}" TargetType="atom:Expander">
        <Setter Property="Template">
            <ControlTemplate>
                <atom:PixelAlignedBorder Name="PART_Frame"
                                         ClipToBounds="True"
                                         BorderThickness="{TemplateBinding EffectiveBorderThickness}">
                    <DockPanel Name="PART_MainLayout"
                               LastChildFill="True">
                        <LayoutTransformControl Name="PART_HeaderLayoutTransform">
                            <atom:PixelAlignedBorder Name="PART_HeaderDecorator"
                                                     Padding="{TemplateBinding HeaderPadding}">
                                <Grid Name="PART_HeaderLayout"
                                      ColumnDefinitions="Auto, *, Auto, Auto">
                                    <atom:IconButton
                                        Name="PART_ExpandButton"
                                        Grid.Column="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsMotionEnabled="{TemplateBinding IsMotionEnabled}"
                                        Icon="{TemplateBinding ExpandIcon}"
                                        IsVisible="{TemplateBinding IsShowExpandIcon}"
                                        IsEnabled="{TemplateBinding IsEnabled}" />
                                    <ContentPresenter Name="PART_HeaderPresenter"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center"
                                                      HorizontalContentAlignment="Left"
                                                      VerticalContentAlignment="Center"
                                                      Content="{TemplateBinding Header}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                      Grid.Column="1" />
                                    <ContentPresenter
                                        Name="PART_AddOnContentPresenter"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Center"
                                        Content="{TemplateBinding AddOnContent}"
                                        ContentTemplate="{TemplateBinding AddOnContentTemplate}"
                                        Grid.Column="2" />
                                </Grid>
                            </atom:PixelAlignedBorder>
                        </LayoutTransformControl>

                        <atom:LayoutAwareMotionActor
                            Name="PART_ContentMotionActor"
                            ClipToBounds="True"
                            IsVisible="False">
                            <atom:PixelAlignedBorder
                                BorderBrush="{atom:ExpanderTokenSharedTokenResource ColorBorder}"
                                BorderThickness="{TemplateBinding ContentBorderThickness}">
                                <ContentPresenter Name="PART_ContentPresenter"
                                                  Content="{TemplateBinding Content, Converter={StaticResource StringToTextBlockConverter}}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Padding="{TemplateBinding ContentPadding}" />
                            </atom:PixelAlignedBorder>
                        </atom:LayoutAwareMotionActor>
                    </DockPanel>
                </atom:PixelAlignedBorder>
            </ControlTemplate>
        </Setter>

        <Setter Property="MotionDuration" Value="{atom:ExpanderTokenSharedTokenResource MotionDurationSlow}" />
        <Setter Property="IsMotionEnabled" Value="{atom:ExpanderTokenSharedTokenResource EnableMotion}" />
        <Setter Property="BorderThickness" Value="{atom:ExpanderTokenSharedTokenResource BorderThickness}" />
        
        <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_Frame">
            <Setter Property="CornerRadius"
                    Value="{atom:ExpanderTokenResource ExpanderBorderRadius}" />
            <Setter Property="BorderBrush" Value="{atom:ExpanderTokenSharedTokenResource ColorBorder}" />
        </Style>

        <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
            <Setter Property="Background" Value="{atom:ExpanderTokenResource HeaderBg}" />
        </Style>

        <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
            <Setter Property="Foreground" Value="{atom:ExpanderTokenSharedTokenResource ColorTextHeading}" />
            <Setter Property="Margin" Value="0, 1, 0, 0" />
        </Style>

        <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
            <Setter Property="IconWidth" Value="{atom:ExpanderTokenSharedTokenResource IconSizeSM}" />
            <Setter Property="IconHeight" Value="{atom:ExpanderTokenSharedTokenResource IconSizeSM}" />
        </Style>

        <Style Selector="^[ExpandIconPosition=Start]">
            <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
                <Setter Property="Grid.Column" Value="0" />
                <Setter Property="Margin"
                        Value="{atom:ExpanderTokenResource LeftExpandButtonHMargin}" />
            </Style>
        </Style>

        <Style Selector="^[ExpandIconPosition=End]">
            <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
                <Setter Property="Grid.Column" Value="3" />
                <Setter Property="Margin"
                        Value="{atom:ExpanderTokenResource RightExpandButtonHMargin}" />
            </Style>
        </Style>

        <Style Selector="^:custom-header-padding">
            <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
                <Setter Property="Margin"
                        Value="{TemplateBinding EffectiveExpandButtonMargin}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_HeaderPresenter">
                <Setter Property="Margin" Value="0" />
            </Style>
        </Style>

        <Style Selector="^:up">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Style Selector="^ /template/ LayoutTransformControl#PART_HeaderLayoutTransform">
                <Setter Property="DockPanel.Dock" Value="Bottom" />
            </Style>
        </Style>

        <Style Selector="^:down">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style Selector="^ /template/ LayoutTransformControl#PART_HeaderLayoutTransform">
                <Setter Property="DockPanel.Dock" Value="Top" />
            </Style>
        </Style>

        <Style Selector="^:left">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Style Selector="^ /template/ LayoutTransformControl#PART_HeaderLayoutTransform">
                <Setter Property="DockPanel.Dock" Value="Right" />
                <Setter Property="LayoutTransform" Value="rotate(90deg)" />
            </Style>
        </Style>

        <Style Selector="^:right">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Style Selector="^ /template/ LayoutTransformControl#PART_HeaderLayoutTransform">
                <Setter Property="DockPanel.Dock" Value="Left" />
                <Setter Property="LayoutTransform" Value="rotate(90deg)" />
            </Style>
        </Style>

        <Style Selector="^:expanded">
            <Style Selector="^:up">
                <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
                    <Setter Property="RenderTransform" Value="rotate(-90deg)" />
                </Style>
            </Style>

            <Style Selector="^:down">
                <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
                    <Setter Property="RenderTransform" Value="rotate(90deg)" />
                </Style>
            </Style>

            <Style Selector="^:left">
                <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
                    <Setter Property="RenderTransform" Value="rotate(90deg)" />
                </Style>
            </Style>

            <Style Selector="^:right">
                <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
                    <Setter Property="RenderTransform" Value="rotate(-90deg)" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^:not(:custom-header-padding)">
            <Style Selector="^[SizeType=Large]">
                <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
                    <Setter Property="Padding"
                            Value="{atom:ExpanderTokenResource HeaderPaddingLG}" />
                </Style>

            </Style>
            <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
                <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
                    <Setter Property="Padding" Value="{atom:ExpanderTokenResource HeaderPadding}" />
                </Style>

            </Style>
            <Style Selector="^[SizeType=Small]">
                <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
                    <Setter Property="Padding"
                            Value="{atom:ExpanderTokenResource HeaderPaddingSM}" />
                </Style>

            </Style>
        </Style>

        <Style Selector="^:not(:custom-content-padding)">
            <Style Selector="^[SizeType=Large]">

                <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Padding"
                            Value="{atom:ExpanderTokenResource ContentPaddingLG}" />
                </Style>
            </Style>
            <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
                <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Padding"
                            Value="{atom:ExpanderTokenResource ContentPadding}" />
                </Style>
            </Style>
            <Style Selector="^[SizeType=Small]">
                <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                    <Setter Property="Padding"
                            Value="{atom:ExpanderTokenResource ContentPaddingSM}" />
                </Style>
            </Style>
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
                <Setter Property="TextElement.FontSize"
                        Value="{atom:ExpanderTokenSharedTokenResource FontSizeLG}" />
                <Setter Property="TextBlock.LineHeight"
                        Value="{atom:ExpanderTokenSharedTokenResource FontHeightLG}" />
            </Style>
        </Style>
        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
                <Setter Property="TextElement.FontSize"
                        Value="{atom:ExpanderTokenSharedTokenResource FontSize}" />
                <Setter Property="TextBlock.LineHeight"
                        Value="{atom:ExpanderTokenSharedTokenResource FontHeight}" />
            </Style>
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
                <Setter Property="TextElement.FontSize"
                        Value="{atom:ExpanderTokenSharedTokenResource FontSize}" />
                <Setter Property="TextBlock.LineHeight"
                        Value="{atom:ExpanderTokenSharedTokenResource FontHeight}" />
            </Style>
            
        </Style>

        <Style Selector="^[TriggerType=Header]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
                <Setter Property="Cursor" Value="Hand" />
            </Style>
        </Style>

        <Style Selector="^[TriggerType=Icon]">
            <Style Selector="^ /template/ atom|IconButton#PART_ExpandButton">
                <Setter Property="Cursor" Value="Hand" />
            </Style>
        </Style>

        <Style Selector="^[IsBorderless=True]">
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="{atom:ExpanderTokenResource HeaderBg}" />
            </Style>
        </Style>

        <Style Selector="^[IsGhostStyle=True]">
            <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator">
                <Setter Property="Background" Value="{atom:ExpanderTokenResource ContentBg}" />
            </Style>
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{atom:ExpanderTokenSharedTokenResource ColorTextDisabled}" />
            <Style Selector="^ /template/ atom|PixelAlignedBorder#PART_HeaderDecorator ContentPresenter">
                <Setter Property="Foreground"
                        Value="{atom:ExpanderTokenSharedTokenResource ColorTextDisabled}" />
            </Style>
        </Style>
    </ControlTheme>
</ResourceDictionary>
