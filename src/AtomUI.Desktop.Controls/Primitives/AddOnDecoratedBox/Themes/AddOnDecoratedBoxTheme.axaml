<ControlTheme xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:atom="https://atomui.net"
              x:Class="AtomUI.Desktop.Controls.Primitives.Themes.AddOnDecoratedBoxTheme"
              TargetType="atom:AddOnDecoratedBox"
              x:ClassModifier="internal">
    <Setter Property="Template">
        <ControlTemplate TargetType="atom:AddOnDecoratedBox">
            <DockPanel Name="RootLayout" LastChildFill="True">
                <Border Name="{x:Static atom:AddOnDecoratedBoxThemeConstants.ContentFramePart}"
                        BorderThickness="{TemplateBinding InnerBoxBorderThickness}"
                        CornerRadius="{TemplateBinding InnerBoxCornerRadius}"
                        BorderBrush="{TemplateBinding EffectiveInnerBoxBorderBrush}"
                        Background="{TemplateBinding EffectiveInnerBoxBackground}"
                        BackgroundSizing="InnerBorderEdge">
                    <atom:AdaptiveSpacingDockPanel Name="ContentLayout" LastChildFill="True">
                        <ContentPresenter
                            Name="{x:Static atom:AddOnDecoratedBoxThemeConstants.ContentPresenterPart}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </atom:AdaptiveSpacingDockPanel>
                </Border>
            </DockPanel>
        </ControlTemplate>
    </Setter>
    
    <Style Selector="^:is(atom|AddOnDecoratedBox)">
        <Setter Property="IsMotionEnabled" Value="{atom:SharedTokenResource EnableMotion}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="UseLayoutRounding" Value="False" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="ScrollViewer.IsScrollChainingEnabled" Value="True" />
        <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorText}" />
        <Setter Property="BorderThickness" Value="{atom:SharedTokenResource BorderThickness}" />
        <Setter Property="OuterAddOnDefaultBackground" Value="{atom:AddOnDecoratedBoxTokenResource AddonBg}" />
        <Setter Property="OuterAddOnDefaultBorderBrush" Value="{atom:SharedTokenResource ColorBorder}" />
        <Setter Property="OuterAddOnFilledBackground" Value="{atom:SharedTokenResource ColorFillTertiary}" />
        <Setter Property="OuterAddOnFilledBorderBrush" Value="{atom:SharedTokenResource ColorFillTertiary}" />
        <Setter Property="OuterAddOnErrorBorderBrush" Value="{atom:SharedTokenResource ColorError}" />
        <Setter Property="OuterAddOnWarningBorderBrush" Value="{atom:SharedTokenResource ColorWarning}" />
        <Setter Property="OuterAddOnErrorFilledBackground" Value="{atom:SharedTokenResource ColorErrorBg}" />
        <Setter Property="OuterAddOnWarningFilledBackground" Value="{atom:SharedTokenResource ColorWarningBg}" />
        <Setter Property="OuterAddOnDisabledBackground" Value="{atom:SharedTokenResource ColorBgContainerDisabled}" />
        <Setter Property="OuterAddOnDisabledBorderBrush" Value="{atom:SharedTokenResource ColorBorder}" />
        <Setter Property="OuterAddOnPadding" Value="{atom:AddOnDecoratedBoxTokenResource Padding}" />

        <Style
            Selector="^ /template/ atom|AdaptiveSpacingDockPanel#ContentLayout">
            <Setter Property="HorizontalSpacing"
                    Value="{atom:SharedTokenResource SpacingXXS}" />
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Setter Property="OuterAddOnPadding" Value="{atom:AddOnDecoratedBoxTokenResource PaddingLG}" />
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadiusLG}" />
        </Style>
        <Style Selector="^[SizeType=Middle]">
            <Setter Property="OuterAddOnPadding" Value="{atom:AddOnDecoratedBoxTokenResource Padding}" />
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadius}" />
        </Style>

        <Style Selector="^[SizeType=Small]">
            <Setter Property="OuterAddOnPadding" Value="{atom:AddOnDecoratedBoxTokenResource PaddingSM}" />
            <Setter Property="CornerRadius" Value="{atom:SharedTokenResource BorderRadiusSM}" />
        </Style>

        <Style Selector="^[SizeType=Large]">
            <Style Selector="^ /template/ Border#PART_ContentFrame">
                <Setter Property="Padding"
                        Value="{atom:AddOnDecoratedBoxTokenResource PaddingLG}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="LineHeight" Value="{atom:SharedTokenResource FontHeightLG}" />
                <Setter Property="MinHeight" Value="{atom:SharedTokenResource FontHeightLG}" />
            </Style>
        </Style>
        <Style Selector="^[SizeType=Middle]">
            <Style Selector="^ /template/ Border#PART_ContentFrame">
                <Setter Property="Padding"
                        Value="{atom:AddOnDecoratedBoxTokenResource Padding}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="LineHeight" Value="{atom:SharedTokenResource FontHeight}" />
                <Setter Property="MinHeight" Value="{atom:SharedTokenResource FontHeight}" />
            </Style>
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Style Selector="^ /template/ Border#PART_ContentFrame">
                <Setter Property="Padding"
                        Value="{atom:AddOnDecoratedBoxTokenResource PaddingSM}" />
            </Style>
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="LineHeight" Value="{atom:SharedTokenResource FontHeightSM}" />
                <Setter Property="MinHeight" Value="{atom:SharedTokenResource FontHeightSM}" />
                <Setter Property="Margin" Value="{atom:AddOnDecoratedBoxTokenResource ContentMargin}" />
            </Style>
        </Style>
        
        <!-- status 不同的时候左右附加区域的主体色设置 -->
        <Style Selector="^[Status=Error]">
            <Setter Property="AddOnStatusForeground" Value="{atom:SharedTokenResource ColorErrorText}" />
            <Setter Property="AddOnStatusIconBrush" Value="{atom:SharedTokenResource ColorError}" />
        </Style>

        <Style Selector="^[Status=Warning]">
            <Setter Property="AddOnStatusForeground" Value="{atom:SharedTokenResource ColorWarningText}" />
            <Setter Property="AddOnStatusIconBrush" Value="{atom:SharedTokenResource ColorWarning}" />
        </Style>

        <Setter Property="InnerBoxDefaultBorderBrush" Value="{atom:SharedTokenResource ColorBorder}" />
        <Setter Property="InnerBoxHoverBorderBrush" Value="{atom:AddOnDecoratedBoxTokenResource HoverBorderColor}" />
        <Setter Property="InnerBoxActiveBorderBrush" Value="{atom:AddOnDecoratedBoxTokenResource ActiveBorderColor}" />
        <Setter Property="InnerBoxFilledBackground" Value="{atom:SharedTokenResource ColorFillTertiary}" />
        <Setter Property="InnerBoxFilledBorderBrush" Value="{atom:SharedTokenResource ColorFillTertiary}" />
        <Setter Property="InnerBoxFilledHoverBackground" Value="{atom:SharedTokenResource ColorFillSecondary}" />
        <Setter Property="InnerBoxActiveBackground" Value="{atom:AddOnDecoratedBoxTokenResource ActiveBg}" />
        <Setter Property="InnerBoxDisabledBackground" Value="{atom:SharedTokenResource ColorBgContainerDisabled}" />
        <Setter Property="InnerBoxErrorBorderBrush" Value="{atom:SharedTokenResource ColorError}" />
        <Setter Property="InnerBoxErrorHoverBorderBrush" Value="{atom:SharedTokenResource ColorErrorBorderHover}" />
        <Setter Property="InnerBoxErrorBackground" Value="{atom:SharedTokenResource ColorErrorBg}" />
        <Setter Property="InnerBoxErrorFilledBorderBrush" Value="{atom:SharedTokenResource ColorErrorBg}" />
        <Setter Property="InnerBoxErrorHoverBackground" Value="{atom:SharedTokenResource ColorErrorBgHover}" />
        <Setter Property="InnerBoxWarningBorderBrush" Value="{atom:SharedTokenResource ColorWarning}" />
        <Setter Property="InnerBoxWarningHoverBorderBrush" Value="{atom:SharedTokenResource ColorWarningBorderHover}" />
        <Setter Property="InnerBoxWarningBackground" Value="{atom:SharedTokenResource ColorWarningBg}" />
        <Setter Property="InnerBoxWarningFilledBorderBrush" Value="{atom:SharedTokenResource ColorWarningBg}" />
        <Setter Property="InnerBoxWarningHoverBackground" Value="{atom:SharedTokenResource ColorWarningBgHover}" />

        <!-- Disabled -->
        <Style Selector="^:disabled">
            <Setter Property="AddOnStatusForeground" Value="{atom:SharedTokenResource ColorTextDisabled}" />
            <Setter Property="AddOnStatusIconBrush" Value="{atom:SharedTokenResource ColorTextDisabled}" />
            <Setter Property="Foreground"
                    Value="{atom:SharedTokenResource ColorTextDisabled}" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <Transitions>
                    <atom:SolidColorBrushTransition Property="EffectiveInnerBoxBorderBrush" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    <atom:SolidColorBrushTransition Property="EffectiveInnerBoxBackground" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                </Transitions>
            </Setter>
        </Style>
    </Style>
</ControlTheme>
