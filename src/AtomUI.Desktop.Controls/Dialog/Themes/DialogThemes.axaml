<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:atom="https://atomui.net"
                    x:ClassModifier="internal">
    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="OverlayDialogHeaderTheme.axaml"/>
        <ResourceInclude Source="DialogCaptionButtonTheme.axaml"/>
        <ResourceInclude Source="OverlayDialogResizerTheme.axaml"/>
        <ResourceInclude Source="DialogButtonBoxTheme.axaml"/>
        <ResourceInclude Source="DialogSurfaceTheme.axaml"/>
        <ResourceInclude Source="OverlayDialogPresenterTheme.axaml"/>
        <ResourceInclude Source="DialogTheme.axaml"/>
        <ResourceInclude Source="OverlayDialogMaskTheme.axaml"/>
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
