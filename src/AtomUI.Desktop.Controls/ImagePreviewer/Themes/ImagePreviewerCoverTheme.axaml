<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:antdicons="https://atomui.net/icons/antdesign"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:ImagePreviewerCover}" TargetType="atom:ImagePreviewerCover">
        <Setter Property="Template">
            <ControlTemplate>
                <atom:PixelAlignedBorder Background="{TemplateBinding Background}"
                                         Padding="{TemplateBinding Padding}"
                                         BorderThickness="{TemplateBinding BorderThickness}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         CornerRadius="{TemplateBinding OwnerCornerRadius}">
                    <Panel>
                        <atom:ImagePreviewRenderer Source="{TemplateBinding ImageSource}"
                                                   Classes.semantic-image="True"
                                                   Stretch="Uniform"
                                                   IsVisible="{TemplateBinding ImageSource, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <Border Name="PART_LoadingPresenter"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                MinWidth="{atom:ImagePreviewerTokenResource CoverImageWidth}"
                                MinHeight="{atom:ImagePreviewerTokenResource CoverImageWidth}"
                                Background="{atom:SharedTokenResource ColorFillTertiary}"
                                CornerRadius="{TemplateBinding OwnerCornerRadius}"
                                IsVisible="False">
                            <Panel HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                                <atom:SkeletonImage Name="PART_LoadingSkeleton"
                                                    IsActive="False"
                                                    IsVisible="{TemplateBinding LoadingContent, Converter={x:Static ObjectConverters.IsNull}}" />
                                <ContentPresenter Content="{TemplateBinding LoadingContent}"
                                                  ContentTemplate="{TemplateBinding LoadingContentTemplate}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  IsVisible="{TemplateBinding LoadingContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </Panel>
                        </Border>
                        <Border Name="PART_ErrorPresenter"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                MinWidth="{atom:ImagePreviewerTokenResource CoverImageWidth}"
                                MinHeight="{atom:ImagePreviewerTokenResource CoverImageWidth}"
                                Background="{atom:SharedTokenResource ColorFillTertiary}"
                                CornerRadius="{TemplateBinding OwnerCornerRadius}"
                                IsVisible="{TemplateBinding HasError}">
                            <Panel HorizontalAlignment="Center"
                                   VerticalAlignment="Center">
                                <StackPanel Name="DefaultErrorLayout"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Spacing="{atom:SharedTokenResource SpacingXXS}"
                                            IsVisible="{TemplateBinding ErrorContent, Converter={x:Static ObjectConverters.IsNull}}">
                                    <antdicons:PictureOutlined Name="DefaultErrorIcon"
                                                              HorizontalAlignment="Center" />
                                    <TextBlock Name="DefaultErrorText"
                                               Text="{atom:ImagePreviewerLangResource ImageLoadFailed}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center" />
                                </StackPanel>
                                <ContentPresenter Content="{TemplateBinding ErrorContent}"
                                                  ContentTemplate="{TemplateBinding ErrorContentTemplate}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  IsVisible="{TemplateBinding ErrorContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </Panel>
                        </Border>
                        <Border Name="Mask"
                                Classes.semantic-cover="True"
                                Opacity="{TemplateBinding MaskOpacity}"
                                IsVisible="{TemplateBinding IsCoverMaskVisible}"
                                Background="{atom:ImagePreviewerTokenResource MaskBgColor}"
                                TextBlock.Foreground="{atom:SharedTokenResource ColorTextLightSolid}"
                                CornerRadius="{TemplateBinding OwnerCornerRadius}"
                                Margin="{Binding OwnerMaskMargin, RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter Name="MaskContentPresenter"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                    </Panel>
                </atom:PixelAlignedBorder>
            </ControlTemplate>
        </Setter>

        <Style Selector="^[IsCoverMaskVisible=True]">
            <Setter Property="Cursor" Value="Hand" />
        </Style>
      
        <Setter Property="IsMotionEnabled" Value="{atom:SharedTokenResource EnableMotion}" />
        <Style Selector="^ /template/ TextBlock#DefaultErrorText">
            <Setter Property="Foreground" Value="{atom:SharedTokenResource ColorTextTertiary}" />
        </Style>
        <Style Selector="^ /template/ atom|Icon#DefaultErrorIcon">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="StrokeBrush" Value="{atom:SharedTokenResource ColorTextTertiary}" />
        </Style>

        <Style Selector="^:loading:not(:has-image) /template/ Border#PART_LoadingPresenter">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="^:loading-skeleton /template/ atom|SkeletonImage#PART_LoadingSkeleton">
            <Setter Property="IsActive" Value="True" />
        </Style>

        <Style Selector="^[IsCoverMaskVisible=True]:pointerover">
            <Setter Property="MaskOpacity" Value="1" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="MaskOpacity" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationSlow}" />
                </Transitions>
            </Setter>
        </Style>

    </ControlTheme>
</ResourceDictionary>
