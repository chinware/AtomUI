<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:CompactSpaceAddOn}" TargetType="atom:CompactSpaceAddOn">
        <Setter Property="Template">
            <ControlTemplate>
                <atom:PixelAlignedBorder CornerRadius="{TemplateBinding EffectiveCornerRadius}"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         BorderThickness="{TemplateBinding BorderThickness}"
                                         Background="{TemplateBinding Background}"
                                         Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                </atom:PixelAlignedBorder>
            </ControlTemplate>
        </Setter>

        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="BorderThickness" Value="{atom:SpaceTokenSharedTokenResource BorderThickness}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />

        <Style Selector="^[SizeType=Large]">
            <Setter Property="FontSize"
                    Value="{atom:SpaceTokenSharedTokenResource FontSizeLG}" />
            <Setter Property="CornerRadius"
                    Value="{atom:SpaceTokenSharedTokenResource BorderRadiusLG}" />
            <Setter Property="Padding"
                    Value="{atom:SpaceTokenResource AddOnPaddingLG}" />
            <Setter Property="MinHeight" Value="{atom:SpaceTokenSharedTokenResource ControlHeightLG}" />
        </Style>
        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Setter Property="FontSize"
                    Value="{atom:SpaceTokenSharedTokenResource FontSize}" />
            <Setter Property="CornerRadius"
                    Value="{atom:SpaceTokenSharedTokenResource BorderRadius}" />
            <Setter Property="Padding"
                    Value="{atom:SpaceTokenResource AddOnPadding}" />
            <Setter Property="MinHeight" Value="{atom:SpaceTokenSharedTokenResource ControlHeight}" />
        </Style>
        <Style Selector="^[SizeType=Small]">
            <Setter Property="FontSize"
                    Value="{atom:SpaceTokenSharedTokenResource FontSizeSM}" />
            <Setter Property="CornerRadius"
                    Value="{atom:SpaceTokenSharedTokenResource BorderRadiusSM}" />
            <Setter Property="Padding"
                    Value="{atom:SpaceTokenResource AddOnPaddingSM}" />
            <Setter Property="MinHeight" Value="{atom:SpaceTokenSharedTokenResource ControlHeightSM}" />
        </Style>
        
        <Style Selector="^[Status=Error]">
            <Setter Property="Foreground"
                    Value="{atom:SpaceTokenSharedTokenResource ColorErrorText}" />
        </Style>
        
        <Style Selector="^[Status=Warning]">
            <Setter Property="Foreground"
                    Value="{atom:SpaceTokenSharedTokenResource ColorWarningText}" />
        </Style>
        
        <Style Selector="^[StyleVariant=Outlined]">
            <Setter Property="Background"
                    Value="{atom:SpaceTokenResource AddonBg}" />
            <Setter Property="BorderBrush" Value="{atom:SpaceTokenSharedTokenResource ColorBorder}" />
            
            <Style Selector="^[Status=Error]">
                <Setter Property="BorderBrush"
                        Value="{atom:SpaceTokenSharedTokenResource ColorError}" />
            </Style>
        
            <Style Selector="^[Status=Warning]">
                <Setter Property="BorderBrush"
                        Value="{atom:SpaceTokenSharedTokenResource ColorWarning}" />
            </Style>
        </Style>

        <Style Selector="^[StyleVariant=Filled]">
            <Setter Property="Background"
                    Value="{atom:SpaceTokenResource AddonBg}" />
            
            <Style Selector="^[Status=Error]">
                <Setter Property="Background"
                        Value="{atom:SpaceTokenSharedTokenResource ColorErrorBg}" />
            </Style>
        
            <Style Selector="^[Status=Warning]">
                <Setter Property="Background"
                        Value="{atom:SpaceTokenSharedTokenResource ColorWarningBg}" />
            </Style>
        </Style>

        <Style Selector="^:disabled">
            <Setter Property="BorderBrush" Value="{atom:SpaceTokenSharedTokenResource ColorBorder}" />
            <Setter Property="Foreground"
                    Value="{atom:SpaceTokenSharedTokenResource ColorTextDisabled}" />
            <Setter Property="Background"
                    Value="{atom:SpaceTokenSharedTokenResource ColorBgContainerDisabled}" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
