<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:atomc="https://atomui.net/common-controls"
    x:ClassModifier="internal">
    <ControlTheme x:Key="{x:Type atom:Segmented}" TargetType="atom:Segmented">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        ClipToBounds="True">
                    <ItemsPresenter Name="PART_ItemsPresenter">
                        <ItemsPresenter.ItemsPanel>
                            <ItemsPanelTemplate>
                                <atomc:SegmentedStackPanel IsExpanding="{Binding IsExpanding, RelativeSource={RelativeSource AncestorType=atom:Segmented}}"/>
                            </ItemsPanelTemplate>
                        </ItemsPresenter.ItemsPanel>
                    </ItemsPresenter>
                </Border>
            </ControlTemplate>
        </Setter>
        
        <Setter Property="IsMotionEnabled" Value="{atom:SegmentedTokenSharedTokenResource EnableMotion}" />
        <Setter Property="Padding" Value="{atom:SegmentedTokenResource TrackPadding}" />
        <Setter Property="Background" Value="{atom:SegmentedTokenResource TrackBg}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="SelectedThumbBg" Value="{atom:SegmentedTokenResource ItemSelectedBg}" />
        <Setter Property="SelectedThumbBoxShadows" Value="{atom:SegmentedTokenSharedTokenResource BoxShadowsTertiary}" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Style Selector="^[IsExpanding=True]">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        
        <Style Selector="^[SizeType=Large]">
            <Setter Property="CornerRadius" Value="{atom:SegmentedTokenSharedTokenResource BorderRadiusLG}" />
            <Setter Property="SelectedThumbCornerRadius" Value="{atom:SegmentedTokenSharedTokenResource BorderRadius}" />
        </Style>
                
        <Style Selector="^[SizeType=Middle], ^[SizeType=Custom]">
            <Setter Property="CornerRadius" Value="{atom:SegmentedTokenSharedTokenResource BorderRadius}" />
            <Setter Property="SelectedThumbCornerRadius" Value="{atom:SegmentedTokenSharedTokenResource BorderRadiusSM}" />
        </Style>
                
        <Style Selector="^[SizeType=Small]">
            <Setter Property="CornerRadius" Value="{atom:SegmentedTokenSharedTokenResource BorderRadiusSM}" />
            <Setter Property="SelectedThumbCornerRadius" Value="{atom:SegmentedTokenSharedTokenResource BorderRadiusXS}" />
        </Style>

        <Style Selector="^[IsMotionEnabled=True]">
            <Setter Property="Transitions">
                <Transitions>
                    <PointTransition Property="SelectedThumbPos" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                    <SizeTransition Property="SelectedThumbSize" Duration="{atom:SharedTokenResourceValue Kind=MotionDurationMid}" />
                </Transitions>
            </Setter>
        </Style>

        <Setter Property="ItemTemplate">
            <DataTemplate x:DataType="x:String">
                <atom:TextBlock Text="{Binding}" />
            </DataTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
