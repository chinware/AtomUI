<Project Sdk="Microsoft.NET.Sdk"
         TreatAsLocalProperty="IsAotCompatible;EnableAotAnalyzer;EnableTrimAnalyzer;EnableSingleFileAnalyzer;PublishAot;PublishTrimmed;PublishSingleFile;RunAOTCompilation;SelfContained;RuntimeIdentifier">
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <AssemblyName>AtomUI.Generator.LinkedPublish</AssemblyName>
        <RootNamespace>AtomUI.Generator</RootNamespace>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IncludeInPublish>false</IncludeInPublish>
        <!-- These dependencies belong to the analyzer toolset. Do not obtain them
             as incidental outputs of the independently hosted Build Tasks tool. -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <IsAotCompatible>false</IsAotCompatible>
        <EnableAotAnalyzer>false</EnableAotAnalyzer>
        <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
        <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
        <PublishAot>false</PublishAot>
        <PublishTrimmed>false</PublishTrimmed>
        <PublishSingleFile>false</PublishSingleFile>
        <RunAOTCompilation>false</RunAOTCompilation>
        <SelfContained>false</SelfContained>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
        <InternalsVisibleTo Include="AtomUI.Generator.Tests" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="LinkedCSharpUsageCandidateProvider.cs" />
        <Compile Include="LinkedRegistrationPackageManifestGenerator.cs" />
        <Compile Include="RegistrationUnitGraphPlanner.cs" />
        <Compile Include="../AtomUI.Build.Tasks/LinkedRegistration/LinkedRegistrationSidecar.cs"
                 Link="LinkedRegistration/Sidecar/LinkedRegistrationSidecar.cs" />
        <Compile Include="../AtomUI.Build.Tasks/LinkedRegistration/LinkedRegistrationAnalysisBudget.cs"
                 Link="LinkedRegistration/Sidecar/LinkedRegistrationAnalysisBudget.cs" />
        <Compile Include="../AtomUI.Generator/GeneratedSourceText.cs"
                 Link="GeneratedSourceText.cs" />
        <Compile Include="../AtomUI.Generator/TargetMarkConstants.cs"
                 Link="TargetMarkConstants.cs" />
        <Compile Include="../AtomUI.Generator/Diagnostics/**/*.cs"
                 Link="Diagnostics/%(RecursiveDir)%(Filename)%(Extension)" />
        <Compile Include="../AtomUI.Generator/LinkedRegistration/**/*.cs"
                 Exclude="../AtomUI.Generator/LinkedRegistration/Model/RegistrationUnitDependencyAnalyzer.cs"
                 Link="LinkedRegistration/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
</Project>
