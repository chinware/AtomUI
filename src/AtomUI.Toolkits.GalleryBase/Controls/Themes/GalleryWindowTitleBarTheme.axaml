<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:atom="https://atomui.net"
                    xmlns:gallery="https://atomui.net/toolkits/gallery-base">
    <ControlTheme x:Key="{x:Type gallery:GalleryWindowTitleBar}"
                  TargetType="gallery:GalleryWindowTitleBar">
        <ControlTheme.BasedOn>
            <atom:WindowTitleBarTheme TargetType="gallery:GalleryWindowTitleBar" />
        </ControlTheme.BasedOn>

        <Setter Property="FontWeight"
                Value="{gallery:GalleryWindowTitleBarTokenResource MenuFontWeight}" />

        <Style Selector="^ /template/ ContentPresenter#PART_LeftAddOn">
            <Setter Property="Margin"
                    Value="{gallery:GalleryWindowTitleBarTokenResource MenuMargin}" />
            <Setter Property="FontWeight"
                    Value="{gallery:GalleryWindowTitleBarTokenResource MenuFontWeight}" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
