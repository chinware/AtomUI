<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:gallery="https://atomui.net/toolkits/gallery-base">

    <ControlTheme x:Key="{x:Type gallery:GalleryShowCaseHeader}"
                  TargetType="{x:Type gallery:GalleryShowCaseHeader}">
        <Setter Property="MetadataLabelWidth"
                Value="{gallery:GalleryShowCaseHeaderTokenResource MetadataLabelWidth}" />
        <Setter Property="MetadataValueWidth"
                Value="{gallery:GalleryShowCaseHeaderTokenResource MetadataValueWidth}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="{x:Type gallery:GalleryShowCaseHeader}">
                <StackPanel Margin="{gallery:GalleryShowCaseHeaderTokenResource HeaderMargin}"
                            Spacing="{gallery:GalleryShowCaseHeaderTokenResource HeaderSpacing}">
                    <StackPanel Spacing="{gallery:GalleryShowCaseHeaderTokenResource SummarySpacing}">
                        <Grid ColumnDefinitions="Auto,*"
                              VerticalAlignment="Center">
                            <atom:TextBlock Name="PART_TitleText"
                                            Grid.Column="0"
                                            Text="{TemplateBinding Title}"
                                            FontSize="{gallery:GalleryShowCaseHeaderTokenResource TitleFontSize}"
                                            FontWeight="{gallery:GalleryShowCaseHeaderTokenResource TitleFontWeight}"
                                            VerticalAlignment="Center" />
                            <WrapPanel Name="PART_TagsPanel"
                                       Grid.Column="1"
                                       Margin="{gallery:GalleryShowCaseHeaderTokenResource TagsMargin}"
                                       ItemSpacing="{gallery:GalleryShowCaseHeaderTokenResource TagItemSpacing}"
                                       LineSpacing="{gallery:GalleryShowCaseHeaderTokenResource TagLineSpacing}"
                                       IsVisible="{TemplateBinding IsTagsVisible}"
                                       VerticalAlignment="Center">
                                <atom:Tag Name="PART_CategoryTag"
                                          Text="{TemplateBinding Category}"
                                          TagColor="{TemplateBinding CategoryTagColor}"
                                          IsVisible="{TemplateBinding IsCategoryVisible}"
                                          VerticalAlignment="Center" />
                                <atom:Tag Name="PART_StatusTag"
                                          Text="{TemplateBinding Status}"
                                          TagColor="{TemplateBinding StatusTagColor}"
                                          IsVisible="{TemplateBinding IsStatusVisible}"
                                          VerticalAlignment="Center" />
                                <atom:Tag Name="PART_IntroducedVersionTag"
                                          Text="{TemplateBinding IntroducedVersion}"
                                          TagColor="{TemplateBinding IntroducedVersionTagColor}"
                                          IsBordered="{TemplateBinding IsIntroducedVersionTagBordered}"
                                          IsVisible="{TemplateBinding IsIntroducedVersionVisible}"
                                          VerticalAlignment="Center" />
                            </WrapPanel>
                        </Grid>
                        <atom:TextBlock Name="PART_SubtitleText"
                                        Text="{TemplateBinding Subtitle}"
                                        FontSize="{gallery:GalleryShowCaseHeaderTokenResource SubtitleFontSize}"
                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                        IsVisible="{TemplateBinding IsSubtitleVisible}" />
                        <atom:TextBlock Name="PART_DescriptionText"
                                        Text="{TemplateBinding Description}"
                                        HorizontalAlignment="Left"
                                        TextWrapping="Wrap"
                                        Foreground="{atom:SharedTokenResource ColorTextTertiary}"
                                        IsVisible="{TemplateBinding IsDescriptionVisible}" />
                    </StackPanel>

                    <atom:PixelAlignedBorder Name="PART_MetadataCard"
                                             Background="{atom:SharedTokenResource ColorBgContainer}"
                                             BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                                             BorderThickness="1"
                                             CornerRadius="{gallery:GalleryShowCaseHeaderTokenResource MetadataCornerRadius}"
                                             MinHeight="{gallery:GalleryShowCaseHeaderTokenResource MetadataMinHeight}"
                                             Padding="{gallery:GalleryShowCaseHeaderTokenResource MetadataPadding}"
                                             IsVisible="{TemplateBinding IsMetadataVisible}">
                        <WrapPanel Name="PART_MetadataItems"
                                   Orientation="Horizontal"
                                   ItemSpacing="{gallery:GalleryShowCaseHeaderTokenResource MetadataItemSpacing}"
                                   LineSpacing="{gallery:GalleryShowCaseHeaderTokenResource MetadataLineSpacing}"
                                   VerticalAlignment="Center">
                            <StackPanel Name="PART_NamespaceMetadataItem"
                                        Orientation="Horizontal"
                                        Spacing="{gallery:GalleryShowCaseHeaderTokenResource MetadataPairSpacing}"
                                        VerticalAlignment="Center"
                                        IsVisible="{TemplateBinding IsNamespaceVisible}">
                                <atom:TextBlock Width="{TemplateBinding MetadataLabelWidth}"
                                                Text="{gallery:GalleryShowCaseHeaderLangResource NamespaceLabel}"
                                                FontWeight="Bold"
                                                LineHeight="{gallery:GalleryShowCaseHeaderTokenResource MetadataLineHeight}"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Width="{TemplateBinding MetadataValueWidth}"
                                                Text="{TemplateBinding Namespace}"
                                                FontFamily="{gallery:GalleryShowCaseHeaderTokenResource MetadataValueFontFamily}"
                                                LineHeight="{gallery:GalleryShowCaseHeaderTokenResource MetadataLineHeight}"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Name="PART_PackageMetadataItem"
                                        Orientation="Horizontal"
                                        Spacing="{gallery:GalleryShowCaseHeaderTokenResource MetadataPairSpacing}"
                                        VerticalAlignment="Center"
                                        IsVisible="{TemplateBinding IsPackageVisible}">
                                <atom:TextBlock Width="{TemplateBinding MetadataLabelWidth}"
                                                Text="{gallery:GalleryShowCaseHeaderLangResource PackageLabel}"
                                                FontWeight="Bold"
                                                LineHeight="{gallery:GalleryShowCaseHeaderTokenResource MetadataLineHeight}"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Width="{TemplateBinding MetadataValueWidth}"
                                                Text="{TemplateBinding Package}"
                                                FontFamily="{gallery:GalleryShowCaseHeaderTokenResource MetadataValueFontFamily}"
                                                LineHeight="{gallery:GalleryShowCaseHeaderTokenResource MetadataLineHeight}"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Name="PART_BaseClassMetadataItem"
                                        Orientation="Horizontal"
                                        Spacing="{gallery:GalleryShowCaseHeaderTokenResource MetadataPairSpacing}"
                                        VerticalAlignment="Center"
                                        IsVisible="{TemplateBinding IsBaseClassVisible}">
                                <atom:TextBlock Width="{TemplateBinding MetadataLabelWidth}"
                                                Text="{gallery:GalleryShowCaseHeaderLangResource BaseClassLabel}"
                                                FontWeight="Bold"
                                                LineHeight="{gallery:GalleryShowCaseHeaderTokenResource MetadataLineHeight}"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Width="{TemplateBinding MetadataValueWidth}"
                                                Text="{TemplateBinding BaseClass}"
                                                FontFamily="{gallery:GalleryShowCaseHeaderTokenResource MetadataValueFontFamily}"
                                                LineHeight="{gallery:GalleryShowCaseHeaderTokenResource MetadataLineHeight}"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                    </atom:PixelAlignedBorder>
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
