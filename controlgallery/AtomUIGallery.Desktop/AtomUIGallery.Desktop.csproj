<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>$(AtomUIDevelopTargetFramework)</TargetFramework>
        <OutputType>WinExe</OutputType>
        <RootNamespace>AtomUIGallery.Desktop</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <ApplicationIcon>../AtomUIGallery/Assets/AtomUIGallery.ico</ApplicationIcon>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <IsAotCompatible>true</IsAotCompatible>
        <IsTrimmable>true</IsTrimmable>
        <PublishTrimmed>true</PublishTrimmed>
        <PublishAot Condition="'$(GalleryPublishAot)' == ''">true</PublishAot>
        <PublishAot Condition="'$(GalleryPublishAot)' != ''">$(GalleryPublishAot)</PublishAot>
        <SelfContained>true</SelfContained>
        <UseAppHost>true</UseAppHost>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <MetricsSupport>true</MetricsSupport>
        <HasAvaloniaDiagnosticsSupport>true</HasAvaloniaDiagnosticsSupport>
    </PropertyGroup>

    <PropertyGroup>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Desktop"/>
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport"
                          GeneratePathProperty="true"
                          ExcludeAssets="all"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions"
                          GeneratePathProperty="true"
                          ExcludeAssets="all"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"
                          GeneratePathProperty="true"
                          ExcludeAssets="all"/>
        <PackageReference Include="Microsoft.IO.RecyclableMemoryStream"
                          GeneratePathProperty="true"
                          ExcludeAssets="all"/>
        <Reference Condition="'$(Configuration)' == 'Debug'"
                   Include="AvaloniaUI.DiagnosticsSupport.Avalonia">
            <HintPath>$(PkgAvaloniaUI_DiagnosticsSupport)/lib/net10.0/AvaloniaUI.DiagnosticsSupport.Avalonia.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Condition="'$(Configuration)' == 'Debug'"
                   Include="Microsoft.Extensions.DependencyInjection.Abstractions">
            <HintPath>$(PkgMicrosoft_Extensions_DependencyInjection_Abstractions)/lib/net8.0/Microsoft.Extensions.DependencyInjection.Abstractions.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Condition="'$(Configuration)' == 'Debug'"
                   Include="Microsoft.Extensions.Logging.Abstractions">
            <HintPath>$(PkgMicrosoft_Extensions_Logging_Abstractions)/lib/net8.0/Microsoft.Extensions.Logging.Abstractions.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <Reference Condition="'$(Configuration)' == 'Debug'"
                   Include="Microsoft.IO.RecyclableMemoryStream">
            <HintPath>$(PkgMicrosoft_IO_RecyclableMemoryStream)/lib/net6.0/Microsoft.IO.RecyclableMemoryStream.dll</HintPath>
            <Private>true</Private>
        </Reference>
        <RuntimeHostConfigurationOption Condition="'$(Configuration)' == 'Debug'"
                                        Include="Avalonia.Diagnostics.Diagnostic.IsEnabled"
                                        Value="True"/>
    </ItemGroup>

    <ItemGroup Condition="'$(PublishAot)' == 'true' and $([MSBuild]::IsOSPlatform('OSX'))">
        <LinkerArg Include="-L/opt/homebrew/lib" Condition="Exists('/opt/homebrew/lib/libssl.dylib')"/>
        <LinkerArg Include="-L/opt/homebrew/opt/openssl@3/lib" Condition="Exists('/opt/homebrew/opt/openssl@3/lib/libssl.dylib')"/>
        <LinkerArg Include="-L/usr/local/lib" Condition="Exists('/usr/local/lib/libssl.dylib')"/>
        <LinkerArg Include="-L/usr/local/opt/openssl@3/lib" Condition="Exists('/usr/local/opt/openssl@3/lib/libssl.dylib')"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../AtomUIGallery/AtomUIGallery.csproj"/>
        <ProjectReference Include="../../src/AtomUI.Desktop.Controls.Extras/AtomUI.Desktop.Controls.Extras.csproj"/>
        <ProjectReference Include="../../src/AtomUI.Generator/AtomUI.Generator.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          PrivateAssets="all" />
        <AtomUILanguagePackProjectReference Include="../../src/LanguagePacks/pt-BR/AtomUI.Controls.I18n.PtBR/AtomUI.Controls.I18n.PtBR.csproj" />
        <AtomUILanguagePackProjectReference Include="../../src/LanguagePacks/pt-BR/AtomUI.Desktop.Controls.I18n.PtBR/AtomUI.Desktop.Controls.I18n.PtBR.csproj" />
        <AtomUILanguagePackProjectReference Include="../../src/LanguagePacks/pt-BR/AtomUI.Desktop.Controls.DataGrid.I18n.PtBR/AtomUI.Desktop.Controls.DataGrid.I18n.PtBR.csproj" />
        <AtomUILanguagePackProjectReference Include="../../src/LanguagePacks/pt-BR/AtomUI.Desktop.Controls.ColorPicker.I18n.PtBR/AtomUI.Desktop.Controls.ColorPicker.I18n.PtBR.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Assets/Images/AtomUIGallery.ico">
            <Link>AtomUIGallery.ico</Link>
        </None>
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Remove="Assets/Images/AtomUIGallery.ico" />
    </ItemGroup>
    
</Project>
