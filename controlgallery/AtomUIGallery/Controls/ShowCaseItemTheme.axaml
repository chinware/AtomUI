<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:gallery="https://atomui.net/oss-controls/gallery">

    <ControlTheme x:Key="{x:Type gallery:ShowCaseItem}"
                  TargetType="{x:Type gallery:ShowCaseItem}">
        <Setter Property="Template">
            <ControlTemplate TargetType="{x:Type gallery:ShowCaseItem}">
                <Border x:Name="PART_RootBorder"
                        Background="{atom:SharedTokenResource ColorBgContainer}"
                        BoxShadow="{gallery:ShowCaseItemTokenResource CardShadow}"
                        Padding="{gallery:ShowCaseItemTokenResource CardPadding}"
                        CornerRadius="{gallery:ShowCaseItemTokenResource CardCornerRadius}">
                    <StackPanel Orientation="Vertical">
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Margin="{gallery:ShowCaseItemTokenResource PreviewMargin}" />
                        <atom:Separator TitlePosition="Left"
                                        FontWeight="{gallery:ShowCaseItemTokenResource TitleFontWeight}"
                                        Title="{TemplateBinding Title}" />
                        <atom:TextBlock TextWrapping="Wrap"
                                        Margin="{gallery:ShowCaseItemTokenResource DescriptionMargin}"
                                        Text="{TemplateBinding Description}" />
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>

        <Style Selector="^[IsFake=True] /template/ Border#PART_RootBorder">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BoxShadow" Value="0 0 0 0 #00000000" />
        </Style>
        <Style Selector="^[IsFake=True] /template/ atom|Separator">
            <Setter Property="IsVisible" Value="False" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
