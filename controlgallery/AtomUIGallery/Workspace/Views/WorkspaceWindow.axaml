<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:rxui="http://reactiveui.net"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:workspaceviews="using:AtomUIGallery.Workspace.Views"
             xmlns:vm="using:AtomUIGallery.Workspace.ViewModels"
             x:Class="AtomUIGallery.Workspace.Views.WorkspaceWindow"
             x:DataType="vm:WorkspaceWindowViewModel"
             Icon="/Assets/AtomUIGallery.ico"
             Title="{x:Null}"
             IsPinCaptionButtonVisible="True"
             IsFullScreenCaptionButtonVisible="True"
             WindowState="Normal"
             WindowStartupLocation="CenterScreen"
             Height="900"
             MinWidth="1040"
             Width="1300">
    <atom:Window.Resources>
        <atom:Menu x:Key="WorkspaceTitleBarMenu">
            <atom:MenuItem Header="{gallery:WorkspaceWindowLangResource MenuItemSettings}"
                           Icon="{antdicons:AntDesignIconProvider Kind=SettingOutlined}">
                <atom:MenuItem Header="{gallery:WorkspaceWindowLangResource MenuItemWindowOptions}">
                    <atom:MenuItem Header="{gallery:WorkspaceWindowLangResource MenuItemEnableFullScreen}"
                                   ToggleType="CheckBox"
                                   IsChecked="True"
                                   Tag="{x:Static workspaceviews:WindowMenuItemKind.FullScreen}" />
                    <atom:MenuItem Header="{gallery:WorkspaceWindowLangResource MenuItemEnablePin}"
                                   ToggleType="CheckBox"
                                   IsChecked="True"
                                   Tag="{x:Static workspaceviews:WindowMenuItemKind.Pin}" />
                    <atom:MenuItem Header="{gallery:WorkspaceWindowLangResource MenuItemEnableMinimize}"
                                   ToggleType="CheckBox"
                                   IsChecked="True"
                                   Tag="{x:Static workspaceviews:WindowMenuItemKind.Minimize}" />
                    <atom:MenuItem Header="{gallery:WorkspaceWindowLangResource MenuItemEnableMaximize}"
                                   ToggleType="CheckBox"
                                   IsChecked="True"
                                   Tag="{x:Static workspaceviews:WindowMenuItemKind.Maximize}" />
                    <atom:MenuItem Header="{gallery:WorkspaceWindowLangResource MenuItemEnableMove}"
                                   ToggleType="CheckBox"
                                   IsChecked="True"
                                   Tag="{x:Static workspaceviews:WindowMenuItemKind.Move}" />
                    <atom:MenuItem Header="{gallery:WorkspaceWindowLangResource MenuItemEnableResize}"
                                   ToggleType="CheckBox"
                                   IsChecked="True"
                                   Tag="{x:Static workspaceviews:WindowMenuItemKind.Resize}" />
                </atom:MenuItem>
            </atom:MenuItem>
            <atom:MenuItem Header="{gallery:WorkspaceWindowLangResource MenuItemTheme}"
                           Icon="{antdicons:AntDesignIconProvider Kind=BulbOutlined}">
                <atom:MenuItem Header="{gallery:WorkspaceWindowLangResource MenuItemDarkMode}"
                               ToggleType="CheckBox"
                               Tag="{x:Static workspaceviews:WindowMenuItemKind.DarkMode}" />
                <atom:MenuItem Header="{gallery:WorkspaceWindowLangResource MenuItemCompactMode}"
                               ToggleType="CheckBox"
                               Tag="{x:Static workspaceviews:WindowMenuItemKind.Compact}" />
                <atom:MenuItem Header="{gallery:WorkspaceWindowLangResource MenuItemEnableMotion}"
                               ToggleType="CheckBox"
                               IsChecked="True"
                               Tag="{x:Static workspaceviews:WindowMenuItemKind.Motion}" />
                <atom:MenuItem Header="{gallery:WorkspaceWindowLangResource MenuItemEnableWaveSpirit}"
                               ToggleType="CheckBox"
                               IsChecked="True"
                               Tag="{x:Static workspaceviews:WindowMenuItemKind.WaveSpirit}" />
            </atom:MenuItem>
            <atom:MenuItem Header="{gallery:WorkspaceWindowLangResource MenuItemLanguage}"
                           Icon="{antdicons:AntDesignIconProvider Kind=GlobalOutlined}">
                <atom:MenuItem Header="简体中文"
                               ToggleType="Radio"
                               IsChecked="{Binding IsZhCN}"
                               Tag="{x:Static workspaceviews:WindowMenuItemKind.LanguageZhCN}" />
                <atom:MenuItem Header="繁體中文"
                               ToggleType="Radio"
                               IsChecked="{Binding IsZhTW}"
                               Tag="{x:Static workspaceviews:WindowMenuItemKind.LanguageZhTW}" />
                <atom:MenuItem Header="English"
                               ToggleType="Radio"
                               IsChecked="{Binding IsEnUS}"
                               Tag="{x:Static workspaceviews:WindowMenuItemKind.LanguageEnUS}" />
            </atom:MenuItem>
        </atom:Menu>
    </atom:Window.Resources>
    <Grid ColumnDefinitions="280,*"
          Background="{atom:SharedTokenResource ColorBgContainer}">
        <Border Grid.Column="0"
                BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto">
                <StackPanel Grid.Row="0"
                            Margin="24,28,24,24">
                    <Svg Path="avares://AtomUIGallery/Assets/atomui-oss.svg"
                         Width="190"
                         Height="45"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center" />
                </StackPanel>

                <workspaceviews:CaseNavigation Grid.Row="1"
                                               Name="ShowCaseNavigation" />

                <Border Grid.Row="2"
                        BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                        BorderThickness="0,1,0,0"
                        Padding="16,12">
                    <Grid ColumnDefinitions="Auto,*">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="0">
                            <atom:HyperLinkButton Width="40"
                                                  Height="40"
                                                  IconWidth="22"
                                                  IconHeight="22"
                                                  Icon="{antdicons:AntDesignIconProvider Kind=GlobalOutlined}"
                                                  NavigateUri="https://www.atomui.net" />
                            <atom:HyperLinkButton Width="40"
                                                  Height="40"
                                                  IconWidth="22"
                                                  IconHeight="22"
                                                  Icon="{antdicons:AntDesignIconProvider Kind=GiteeOutlined}"
                                                  NavigateUri="https://gitee.com/chinware/AtomUI" />
                            <atom:HyperLinkButton Width="40"
                                                  Height="40"
                                                  IconWidth="22"
                                                  IconHeight="22"
                                                  Icon="{antdicons:AntDesignIconProvider Kind=GithubOutlined}"
                                                  NavigateUri="https://github.com/chinware/atomui" />
                        </StackPanel>
                        <atom:Tag Grid.Column="1"
                                  Text="{x:Static gallery:GalleryVersionInfo.DisplayVersion}"
                                  TagColor="Green"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center" />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1"
                Background="{atom:SharedTokenResource ColorBgLayout}">
            <rxui:RoutedViewHost Name="RoutedViewHost"
                                 PageTransition="{x:Null}"
                                 ClipToBounds="True" />
        </Border>

        <Border Name="TitleBarBottomSeparator"
                Grid.ColumnSpan="2"
                Height="1"
                VerticalAlignment="Top"
                Background="{atom:SharedTokenResource ColorBorderSecondary}"
                IsHitTestVisible="False" />
    </Grid>
</atom:Window>
