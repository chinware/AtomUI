  <file id="AtomUIGallery.Localization.SplitterShowCaseLangResourceKind">
    <unit id="1" name="ScenarioExamples">
      <segment>
        <source>Examples</source>
        <target state="translated">示例</target>
      </segment>
    </unit>
    <unit id="2" name="ComponentCategory">
      <segment>
        <source>Layout</source>
        <target state="translated">佈局</target>
      </segment>
    </unit>
    <unit id="3" name="ComponentStatusStable">
      <segment>
        <source>.NET 10</source>
        <target state="translated">.NET 10</target>
      </segment>
    </unit>
    <unit id="4" name="PageSubtitle">
      <segment>
        <source>Resize adjacent panes with draggable handles, constraints, collapse controls, and lazy updates.</source>
        <target state="translated">通過可拖拽把手、約束、折疊控制和延遲更新調整相鄰面板尺寸。</target>
      </segment>
    </unit>
    <unit id="5" name="PageDescription">
      <segment>
        <source>Splitter divides a region into resizable panels. It supports horizontal and vertical layouts, nested splitters, fixed or constrained panels, collapsible handles, multiple panels, and lazy resize feedback.</source>
        <target state="translated">Splitter 將區域拆分為可調整大小的面板，支持水平和垂直佈局、嵌套分割器、固定或受約束面板、可折疊把手、多面板和延遲拖拽反饋。</target>
      </segment>
    </unit>
    <unit id="6" name="BasicTitle">
      <segment>
        <source>Basic</source>
        <target state="translated">基礎用法</target>
      </segment>
    </unit>
    <unit id="7" name="BasicDescription">
      <segment>
        <source>Initial sizes with min/max constraints.</source>
        <target state="translated">帶最小/最大約束的初始尺寸。</target>
      </segment>
    </unit>
    <unit id="8" name="HorizontalTitle">
      <segment>
        <source>Horizontal</source>
        <target state="translated">水平分割</target>
      </segment>
    </unit>
    <unit id="9" name="HorizontalDescription">
      <segment>
        <source>Top-bottom splitter with collapsible icons.</source>
        <target state="translated">帶可折疊圖標的上下分割器。</target>
      </segment>
    </unit>
    <unit id="10" name="CompositeTitle">
      <segment>
        <source>Composite</source>
        <target state="translated">組合佈局</target>
      </segment>
    </unit>
    <unit id="11" name="CompositeDescription">
      <segment>
        <source>Nested horizontal splitter inside a vertical layout.</source>
        <target state="translated">在垂直佈局中嵌套水平分割器。</target>
      </segment>
    </unit>
    <unit id="12" name="ResizableDisabledTitle">
      <segment>
        <source>Resizable Disabled</source>
        <target state="translated">禁用拖拽調整</target>
      </segment>
    </unit>
    <unit id="13" name="ResizableDisabledDescription">
      <segment>
        <source>If either side disables resizable, dragging is blocked.</source>
        <target state="translated">任意一側禁用 resizable 時，拖拽會被阻止。</target>
      </segment>
    </unit>
    <unit id="14" name="ShowCollapsibleIconTitle">
      <segment>
        <source>ShowCollapsibleIcon</source>
        <target state="translated">顯示折疊圖標</target>
      </segment>
    </unit>
    <unit id="15" name="ShowCollapsibleIconDescription">
      <segment>
        <source>Three panels with hover and always-visible collapsible icons.</source>
        <target state="translated">三個面板展示 hover 和始終可見的折疊圖標。</target>
      </segment>
    </unit>
    <unit id="16" name="MultiPanelsTitle">
      <segment>
        <source>Multi Panels</source>
        <target state="translated">多個面板</target>
      </segment>
    </unit>
    <unit id="17" name="MultiPanelsDescription">
      <segment>
        <source>Multiple panels in vertical layout.</source>
        <target state="translated">垂直佈局中的多個面板。</target>
      </segment>
    </unit>
    <unit id="18" name="LazyTitle">
      <segment>
        <source>Lazy</source>
        <target state="translated">延遲模式</target>
      </segment>
    </unit>
    <unit id="19" name="LazyDescription">
      <segment>
        <source>Lazy rendering mode: sizes update on drag release.</source>
        <target state="translated">延遲渲染模式：拖拽釋放後更新尺寸。</target>
      </segment>
    </unit>
    <unit id="20" name="LineStyleTitle">
      <segment>
        <source>Line Style</source>
        <target state="translated">分割線樣式</target>
      </segment>
    </unit>
    <unit id="21" name="LineStyleDescription">
      <segment>
        <source>Customize the root frame, visible divider thickness, and line corner radius.</source>
        <target state="translated">定制根框架、可見分割線厚度和線條圓角。</target>
      </segment>
    </unit>
