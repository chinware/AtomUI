<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Masonry.MasonryShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Masonry"
             xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
             x:DataType="vm:MasonryViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <StackPanel Margin="28,24,28,18"
                            Spacing="16">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <atom:TextBlock Text="Masonry"
                                            FontSize="26"
                                            FontWeight="Bold"
                                            VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:MasonryShowCaseLangResource ComponentCategory}"
                                      TagColor="blue"
                                      VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:MasonryShowCaseLangResource ComponentStatusStable}"
                                      TagColor="success"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                        <atom:TextBlock Text="{gallery:MasonryShowCaseLangResource PageSubtitle}"
                                        FontSize="15"
                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                        <atom:TextBlock Text="{gallery:MasonryShowCaseLangResource PageDescription}"
                                        HorizontalAlignment="Left"
                                        TextWrapping="Wrap"
                                        Foreground="{atom:SharedTokenResource ColorTextTertiary}" />
                    </StackPanel>

                    <Border Background="{atom:SharedTokenResource ColorBgContainer}"
                            BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinHeight="48"
                            Padding="16,8">
                        <Border.Styles>
                            <Style Selector="atom|TextBlock.info-label">
                                <Setter Property="Width" Value="84" />
                            </Style>
                            <Style Selector="atom|TextBlock.info-value">
                                <Setter Property="Width" Value="220" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </Border.Styles>
                        <WrapPanel Orientation="Horizontal"
                                   ItemSpacing="48"
                                   LineSpacing="8"
                                   VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:MasonryShowCaseLangResource InfoNamespaceLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:MasonryShowCaseLangResource InfoPackageLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:MasonryShowCaseLangResource InfoBaseClassLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="ItemsControl"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </gallery:GalleryStickyTabsHost.Header>

            <gallery:GalleryStickyTabsHost.StickyContent>
                <atom:TabStrip Name="ScenarioTabs"
                               SizeType="Large"
                               SelectedIndex="0">
                    <atom:TabStripItem Content="{gallery:MasonryShowCaseLangResource ScenarioExamples}"
                                       Tag="Examples"
                                       IsSelected="True" />
                    <atom:TabStripItem Content="{gallery:MasonryShowCaseLangResource ScenarioApi}"
                                       Tag="Api" />
                    <atom:TabStripItem Content="{gallery:MasonryShowCaseLangResource ScenarioDesignToken}"
                                       Tag="DesignToken" />
                </atom:TabStrip>
            </gallery:GalleryStickyTabsHost.StickyContent>

            <ContentControl Name="ScenarioContentHost">
                <gallery:ShowCasePanel Name="ExamplesContent"
                                       IsScrollEnabled="False"
                                       IsDeferredLoadingEnabled="True"
                                       InitialDeferredLoadItemCount="4"
                                       DeferredLoadBatchSize="2"
                                       ContentMargin="28,10,28,28">

                    <!-- Basic: 4-column masonry with varying-height cards, mirroring the Ant Design basic demo. -->
                    <gallery:ShowCaseItem
                        Title="{gallery:MasonryShowCaseLangResource BasicTitle}"
                        Description="{gallery:MasonryShowCaseLangResource BasicDescription}"
                        IsDeferredContentEnabled="True"
                        IsOccupyEntireRow="True">
                        <gallery:ShowCaseItem.DeferredContentTemplate>
                            <DataTemplate x:DataType="vm:MasonryViewModel">
                                <atom:Masonry ItemsSource="{Binding BasicItems}"
                                              ColumnCount="4"
                                              ColumnGap="16"
                                              RowGap="16"
                                              HorizontalAlignment="Stretch">
                                    <atom:Masonry.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MasonryBasicItem">
                                            <Panel>
                                                <atom:Card SizeType="Small"
                                                           Height="{Binding Height}"
                                                           HorizontalAlignment="Stretch"
                                                           IsVisible="{Binding !IsSpecial}">
                                                    <atom:TextBlock Text="{Binding Index}" />
                                                </atom:Card>
                                                <atom:Card SizeType="Small"
                                                           ClipToBounds="True"
                                                           HorizontalAlignment="Stretch"
                                                           IsVisible="{Binding IsSpecial}">
                                                    <atom:Card.Cover>
                                                        <Panel MinHeight="210"
                                                               ClipToBounds="True">
                                                            <Image Name="SpecialCoverImage"
                                                                   asyncImageLoader:ImageLoader.Source="{Binding CoverSource}"
                                                                   Stretch="UniformToFill" />
                                                            <Border Padding="16,16"
                                                                    IsVisible="{Binding #SpecialCoverImage.Source, Converter={x:Static ObjectConverters.IsNull}}">
                                                                <atom:Skeleton IsLoading="True"
                                                                               IsActive="True"
                                                                               IsShowAvatar="False"
                                                                               IsShowTitle="True"
                                                                               ParagraphRows="3"
                                                                               IsRound="True" />
                                                            </Border>
                                                        </Panel>
                                                    </atom:Card.Cover>
                                                    <atom:CardMetaContent Header="{Binding Title}"
                                                                          Content="{Binding Description}" />
                                                </atom:Card>
                                            </Panel>
                                        </DataTemplate>
                                    </atom:Masonry.ItemTemplate>
                                </atom:Masonry>
                            </DataTemplate>
                        </gallery:ShowCaseItem.DeferredContentTemplate>
                    </gallery:ShowCaseItem>

                    <!-- Responsive: mirrors the Ant Design responsive demo with breakpoint columns and gutter. -->
                    <gallery:ShowCaseItem
                        Title="{gallery:MasonryShowCaseLangResource ResponsiveTitle}"
                        Description="{gallery:MasonryShowCaseLangResource ResponsiveDescription}"
                        IsDeferredContentEnabled="True"
                        IsOccupyEntireRow="True">
                        <gallery:ShowCaseItem.DeferredContentTemplate>
                            <DataTemplate x:DataType="vm:MasonryViewModel">
                                <atom:Masonry ItemsSource="{Binding ResponsiveItems}"
                                              ColumnInfo="xs: 1, sm: 2, md: 3, lg: 4"
                                              Gutter="xs: 8, sm: 12, md: 16; xs: 8, sm: 12, md: 16"
                                              HorizontalAlignment="Stretch">
                                    <atom:Masonry.ItemTemplate>
                                        <DataTemplate x:DataType="vm:MasonryBasicItem">
                                            <atom:Card SizeType="Small"
                                                       Height="{Binding Height}"
                                                       HorizontalAlignment="Stretch">
                                                <atom:TextBlock Text="{Binding Index}" />
                                            </atom:Card>
                                        </DataTemplate>
                                    </atom:Masonry.ItemTemplate>
                                </atom:Masonry>
                            </DataTemplate>
                        </gallery:ShowCaseItem.DeferredContentTemplate>
                    </gallery:ShowCaseItem>
                </gallery:ShowCasePanel>
            </ContentControl>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
