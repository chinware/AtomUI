<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Segmented.SegmentedShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Segmented"
             x:DataType="vm:SegmentedViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <StackPanel Margin="28,24,28,18"
                            Spacing="16">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <atom:TextBlock Text="Segmented"
                                            FontSize="26"
                                            FontWeight="Bold"
                                            VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:SegmentedShowCaseLangResource ComponentCategory}"
                                      TagColor="blue"
                                      VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:SegmentedShowCaseLangResource ComponentStatusStable}"
                                      TagColor="success"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                        <atom:TextBlock Text="{gallery:SegmentedShowCaseLangResource PageSubtitle}"
                                        FontSize="15"
                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                        <atom:TextBlock Text="{gallery:SegmentedShowCaseLangResource PageDescription}"
                                        HorizontalAlignment="Left"
                                        TextWrapping="Wrap"
                                        Foreground="{atom:SharedTokenResource ColorTextTertiary}" />
                    </StackPanel>

                    <Border Background="{atom:SharedTokenResource ColorBgContainer}"
                            BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinHeight="48"
                            Padding="16,8">
                        <Border.Styles>
                            <Style Selector="atom|TextBlock.info-label">
                                <Setter Property="Width" Value="84" />
                            </Style>
                            <Style Selector="atom|TextBlock.info-value">
                                <Setter Property="Width" Value="200" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </Border.Styles>
                        <WrapPanel Orientation="Horizontal"
                                   ItemSpacing="48"
                                   LineSpacing="8"
                                   VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:SegmentedShowCaseLangResource InfoNamespaceLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:SegmentedShowCaseLangResource InfoPackageLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:SegmentedShowCaseLangResource InfoBaseClassLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AbstractSegmented"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </gallery:GalleryStickyTabsHost.Header>

            <gallery:GalleryStickyTabsHost.StickyContent>
                <atom:TabStrip Name="ScenarioTabs"
                               SizeType="Large"
                               SelectedIndex="0">
                    <atom:TabStripItem Content="{gallery:SegmentedShowCaseLangResource ScenarioExamples}"
                                       Tag="Examples"
                                       IsSelected="True" />
                    <atom:TabStripItem Content="{gallery:SegmentedShowCaseLangResource ScenarioApi}"
                                       Tag="Api" />
                    <atom:TabStripItem Content="{gallery:SegmentedShowCaseLangResource ScenarioDesignToken}"
                                       Tag="DesignToken" />
                </atom:TabStrip>
            </gallery:GalleryStickyTabsHost.StickyContent>

            <ContentControl Name="ScenarioContentHost">
                <gallery:ShowCasePanel Name="ExamplesContent"
                                       IsScrollEnabled="False"
                                       IsDeferredLoadingEnabled="True"
                                       InitialDeferredLoadItemCount="4"
                                       DeferredLoadBatchSize="2"
                                       ContentMargin="28,10,28,28">
                    <gallery:ShowCaseItem
                        Title="{gallery:SegmentedShowCaseLangResource BasicTitle}"
                        Description="{gallery:SegmentedShowCaseLangResource BasicDescription}"
                        IsDeferredContentEnabled="True">
                        <gallery:ShowCaseItem.DeferredContentTemplate>
                            <DataTemplate x:DataType="vm:SegmentedViewModel">
                        <StackPanel HorizontalAlignment="Left" Orientation="Vertical" Spacing="10">
                            <atom:Segmented Margin="20">
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentDaily}" />
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentWeekly}" />
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentMonthly}" />
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentQuarterly}" />
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentYearly}" />
                            </atom:Segmented>
                        </StackPanel>
                            </DataTemplate>
                        </gallery:ShowCaseItem.DeferredContentTemplate>
                    </gallery:ShowCaseItem>

                    <gallery:ShowCaseItem
                        Title="{gallery:SegmentedShowCaseLangResource BlockSegmentedTitle}"
                        Description="{gallery:SegmentedShowCaseLangResource BlockSegmentedDescription}"
                        IsDeferredContentEnabled="True">
                        <gallery:ShowCaseItem.DeferredContentTemplate>
                            <DataTemplate x:DataType="vm:SegmentedViewModel">
                        <StackPanel HorizontalAlignment="Stretch" Orientation="Vertical">
                            <atom:Segmented IsExpanding="True" Margin="20">
                                <atom:SegmentedItem>123</atom:SegmentedItem>
                                <atom:SegmentedItem>456</atom:SegmentedItem>
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentLongtextLongtextLongtextLongtext}" />
                            </atom:Segmented>
                        </StackPanel>
                            </DataTemplate>
                        </gallery:ShowCaseItem.DeferredContentTemplate>
                    </gallery:ShowCaseItem>

                    <gallery:ShowCaseItem
                        Title="{gallery:SegmentedShowCaseLangResource DisabledTitle}"
                        Description="{gallery:SegmentedShowCaseLangResource DisabledDescription}"
                        IsDeferredContentEnabled="True">
                        <gallery:ShowCaseItem.DeferredContentTemplate>
                            <DataTemplate x:DataType="vm:SegmentedViewModel">
                        <StackPanel HorizontalAlignment="Stretch" Orientation="Vertical" Spacing="10">
                            <atom:Segmented Margin="20">
                                <atom:SegmentedItem IsEnabled="False" Content="{gallery:SegmentedShowCaseLangResource P2ContentMap}" />
                                <atom:SegmentedItem IsEnabled="False" Content="{gallery:SegmentedShowCaseLangResource P2ContentTransit}" />
                                <atom:SegmentedItem IsEnabled="False" Content="{gallery:SegmentedShowCaseLangResource P2ContentSatellite}" />
                            </atom:Segmented>
                            <atom:Segmented>
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentDaily}" />
                                <atom:SegmentedItem IsEnabled="False" Content="{gallery:SegmentedShowCaseLangResource P2ContentWeekly}" />
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentMonthly}" />
                                <atom:SegmentedItem IsEnabled="False" Content="{gallery:SegmentedShowCaseLangResource P2ContentQuarterly}" />
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentYearly}" />
                            </atom:Segmented>
                        </StackPanel>
                            </DataTemplate>
                        </gallery:ShowCaseItem.DeferredContentTemplate>
                    </gallery:ShowCaseItem>

                    <gallery:ShowCaseItem
                        Title="{gallery:SegmentedShowCaseLangResource ThreeSizesTitle}"
                        Description="{gallery:SegmentedShowCaseLangResource ThreeSizesDescription}"
                        IsDeferredContentEnabled="True">
                        <gallery:ShowCaseItem.DeferredContentTemplate>
                            <DataTemplate x:DataType="vm:SegmentedViewModel">
                        <StackPanel HorizontalAlignment="Left" Orientation="Vertical" Spacing="10">
                            <atom:Segmented SizeType="Large" Margin="20">
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentDaily}" />
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentWeekly}" />
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentMonthly}" />
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentQuarterly}" />
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentYearly}" />
                            </atom:Segmented>

                            <atom:Segmented Margin="20">
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentDaily}" />
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentWeekly}" />
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentMonthly}" />
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentQuarterly}" />
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentYearly}" />
                            </atom:Segmented>

                            <atom:Segmented SizeType="Small" Margin="20">
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentDaily}" />
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentWeekly}" />
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentMonthly}" />
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentQuarterly}" />
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentYearly}" />
                            </atom:Segmented>

                            <atom:Segmented SizeType="Custom"
                                            Margin="20"
                                            Padding="3"
                                            CornerRadius="8">
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentDaily}"
                                                    MinHeight="36"
                                                    Padding="16,0"
                                                    FontSize="15"
                                                    CornerRadius="6" />
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentWeekly}"
                                                    IsSelected="True"
                                                    MinHeight="36"
                                                    Padding="16,0"
                                                    FontSize="15"
                                                    CornerRadius="6" />
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentMonthly}"
                                                    MinHeight="36"
                                                    Padding="16,0"
                                                    FontSize="15"
                                                    CornerRadius="6" />
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentQuarterly}"
                                                    MinHeight="36"
                                                    Padding="16,0"
                                                    FontSize="15"
                                                    CornerRadius="6" />
                            </atom:Segmented>
                        </StackPanel>
                            </DataTemplate>
                        </gallery:ShowCaseItem.DeferredContentTemplate>
                    </gallery:ShowCaseItem>

                    <gallery:ShowCaseItem
                        Title="{gallery:SegmentedShowCaseLangResource IconOnlyTitle}"
                        Description="{gallery:SegmentedShowCaseLangResource IconOnlyDescription}"
                        IsDeferredContentEnabled="True">
                        <gallery:ShowCaseItem.DeferredContentTemplate>
                            <DataTemplate x:DataType="vm:SegmentedViewModel">
                        <StackPanel HorizontalAlignment="Left" Orientation="Vertical" Spacing="10">
                            <atom:Segmented Margin="20">
                                <atom:SegmentedItem Icon="{antdicons:AntDesignIconProvider Kind=BarsOutlined}" />
                                <atom:SegmentedItem Icon="{antdicons:AntDesignIconProvider Kind=AppstoreOutlined}" />
                            </atom:Segmented>
                        </StackPanel>
                            </DataTemplate>
                        </gallery:ShowCaseItem.DeferredContentTemplate>
                    </gallery:ShowCaseItem>

                    <gallery:ShowCaseItem
                        Title="{gallery:SegmentedShowCaseLangResource WithIconTitle}"
                        Description="{gallery:SegmentedShowCaseLangResource WithIconDescription}"
                        IsDeferredContentEnabled="True">
                        <gallery:ShowCaseItem.DeferredContentTemplate>
                            <DataTemplate x:DataType="vm:SegmentedViewModel">
                        <StackPanel HorizontalAlignment="Left" Orientation="Vertical" Spacing="10">
                            <atom:Segmented Margin="20">
                                <atom:SegmentedItem Icon="{antdicons:AntDesignIconProvider Kind=BarsOutlined}" Content="{gallery:SegmentedShowCaseLangResource P2ContentList}" />
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentKanban}" Icon="{antdicons:AntDesignIconProvider Kind=AppstoreOutlined}" />
                            </atom:Segmented>

                            <atom:Segmented Margin="20">
                                <atom:SegmentedItem Icon="{antdicons:AntDesignIconProvider Kind=BarsOutlined}" Content="{gallery:SegmentedShowCaseLangResource P2ContentAva}" />
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentAtomUI}" Icon="{antdicons:AntDesignIconProvider Kind=WechatOutlined}" IsEnabled="False"/>

                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentAtomUI}"
                                                    Icon="{antdicons:AntDesignIconProvider Kind=WindowsOutlined}" />

                            </atom:Segmented>

                            <atom:Segmented SizeType="Large" Margin="20">
                                <atom:SegmentedItem Icon="{antdicons:AntDesignIconProvider Kind=BarsOutlined}" Content="{gallery:SegmentedShowCaseLangResource P2ContentAva}" />
                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentAtomUI}" Icon="{antdicons:AntDesignIconProvider Kind=WechatOutlined}" />

                                <atom:SegmentedItem Content="{gallery:SegmentedShowCaseLangResource P2ContentAtomUI}"
                                                    Icon="{antdicons:AntDesignIconProvider Kind=WindowsOutlined}" />

                            </atom:Segmented>

                        </StackPanel>
                            </DataTemplate>
                        </gallery:ShowCaseItem.DeferredContentTemplate>
                    </gallery:ShowCaseItem>
                </gallery:ShowCasePanel>
            </ContentControl>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
