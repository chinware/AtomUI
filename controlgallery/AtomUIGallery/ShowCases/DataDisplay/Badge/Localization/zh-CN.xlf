    <unit id="1" name="ScenarioExamples">
      <segment>
        <source>Examples</source>
        <target state="translated">示例</target>
      </segment>
    </unit>
    <unit id="2" name="ComponentCategory">
      <segment>
        <source>Data Display</source>
        <target state="translated">数据展示</target>
      </segment>
    </unit>
    <unit id="3" name="ComponentStatusStable">
      <segment>
        <source>Stable</source>
        <target state="translated">稳定</target>
      </segment>
    </unit>
    <unit id="4" name="PageSubtitle">
      <segment>
        <source>Highlight counts, statuses, and contextual labels near related content.</source>
        <target state="translated">在相关内容旁突出数量、状态和上下文标签。</target>
      </segment>
    </unit>
    <unit id="5" name="PageDescription">
      <segment>
        <source>Badge draws attention to notifications, counts, status dots, and ribbon labels without interrupting the user's workflow.</source>
        <target state="translated">Badge 用于提示通知、计数、状态点和缎带标签，在不打断用户流程的情况下强调需要关注的信息。</target>
      </segment>
    </unit>
    <unit id="6" name="BasicTitle">
      <segment>
        <source>Basic</source>
        <target state="translated">基础用法</target>
      </segment>
    </unit>
    <unit id="7" name="BasicDescription">
      <segment>
        <source>Simplest Usage. Badge will be hidden when count is 0, but we can use showZero to show it.</source>
        <target state="translated">最简单的用法。count 为 0 时 Badge 会隐藏，但可以使用 showZero 显示。</target>
      </segment>
    </unit>
    <unit id="8" name="OverflowCountTitle">
      <segment>
        <source>Overflow Count</source>
        <target state="translated">封顶数字</target>
      </segment>
    </unit>
    <unit id="9" name="OverflowCountDescription">
      <segment>
        <source>${overflowCount}+ is displayed when count is larger than overflowCount. The default value of overflowCount is 99.</source>
        <target state="translated">当 count 大于 overflowCount 时显示 ${overflowCount}+。overflowCount 的默认值是 99。</target>
      </segment>
    </unit>
    <unit id="10" name="OffsetTitle">
      <segment>
        <source>Offset</source>
        <target state="translated">偏移量</target>
      </segment>
    </unit>
    <unit id="11" name="OffsetDescription">
      <segment>
        <source>Set offset of the badge dot, the format is [left, top], which represents the offset of the status dot from the left and top of the default position.</source>
        <target state="translated">设置徽标点的偏移量，格式为 [left, top]，表示状态点相对于默认位置左侧和顶部的偏移。</target>
      </segment>
    </unit>
    <unit id="12" name="SizeTitle">
      <segment>
        <source>Size</source>
        <target state="translated">尺寸</target>
      </segment>
    </unit>
    <unit id="13" name="SizeDescription">
      <segment>
        <source>Set size of numeral Badge.</source>
        <target state="translated">设置数字 Badge 的尺寸。</target>
      </segment>
    </unit>
    <unit id="14" name="StandaloneTitle">
      <segment>
        <source>Standalone</source>
        <target state="translated">独立使用</target>
      </segment>
    </unit>
    <unit id="15" name="StandaloneDescription">
      <segment>
        <source>Used in standalone when children is empty.</source>
        <target state="translated">children 为空时可独立使用。</target>
      </segment>
    </unit>
    <unit id="16" name="DynamicTitle">
      <segment>
        <source>Dynamic</source>
        <target state="translated">动态变化</target>
      </segment>
    </unit>
    <unit id="17" name="DynamicDescription">
      <segment>
        <source>The count will be animated as it changes.</source>
        <target state="translated">数字变化时会带有动画。</target>
      </segment>
    </unit>
    <unit id="18" name="RedBadgeTitle">
      <segment>
        <source>Red badge</source>
        <target state="translated">红点徽标</target>
      </segment>
    </unit>
    <unit id="19" name="RedBadgeDescription">
      <segment>
        <source>This will simply display a red badge, without a specific count. If count equals 0, it won't display the dot.</source>
        <target state="translated">简单展示一个红色徽标，不显示具体数字。如果 count 等于 0，则不会显示圆点。</target>
      </segment>
    </unit>
