  <file id="AtomUIGallery.Localization.DataGridShowCaseLangResourceKind">
    <unit id="1" name="BasicTitle">
      <segment>
        <source>Basic</source>
        <target state="translated">基礎表格</target>
      </segment>
    </unit>
    <unit id="2" name="BasicDescription">
      <segment>
        <source>Simple table with actions.</source>
        <target state="translated">帶操作列的簡單表格。</target>
      </segment>
    </unit>
    <unit id="3" name="SelectionTitle">
      <segment>
        <source>Selection</source>
        <target state="translated">選擇</target>
      </segment>
    </unit>
    <unit id="4" name="SelectionDescription">
      <segment>
        <source>Rows can be selectable by making first column as a selectable column. You can use rowSelection.type to set selection type. Default is checkbox.</source>
        <target state="translated">通過將第一列設置為可選擇列，可以讓行支持選擇。可使用 rowSelection.type 設置選擇類型，默認是 checkbox。</target>
      </segment>
    </unit>
    <unit id="5" name="DragResizeColumnTitle">
      <segment>
        <source>Drag resize column</source>
        <target state="translated">拖拽調整列寬</target>
      </segment>
    </unit>
    <unit id="6" name="DragResizeColumnDescription">
      <segment>
        <source>You can drag to change the size of the column.</source>
        <target state="translated">可以通過拖拽改變列寬。</target>
      </segment>
    </unit>
    <unit id="7" name="SizeTitle">
      <segment>
        <source>Size</source>
        <target state="translated">尺寸</target>
      </segment>
    </unit>
    <unit id="8" name="SizeDescription">
      <segment>
        <source>There are two compacted table sizes: middle and small. The small size is used in Modals only.</source>
        <target state="translated">表格提供 middle 和 small 兩種緊湊尺寸，其中 small 尺寸僅用於模態框中。</target>
      </segment>
    </unit>
    <unit id="9" name="TableBorderTitleAndFooterTitle">
      <segment>
        <source>border, title and footer</source>
        <target state="translated">邊框、標題和頁腳</target>
      </segment>
    </unit>
    <unit id="10" name="TableBorderTitleAndFooterDescription">
      <segment>
        <source>Add border, title and footer for table.</source>
        <target state="translated">為表格添加邊框、標題和頁腳。</target>
      </segment>
    </unit>
    <unit id="11" name="FilterAndSorterTitle">
      <segment>
        <source>Filter and sorter</source>
        <target state="translated">篩選和排序</target>
      </segment>
    </unit>
    <unit id="12" name="FilterAndSorterDescription">
      <segment>
        <source>Use filters to generate filter menu in columns, onFilter to determine filtered result, and filterMultiple to indicate whether it's multiple or single selection, filterOnClose to specify whether to trigger filter when the filter menu closes. Use defaultFilteredValue to make a column filtered by default.</source>
        <target state="translated">使用 filters 生成列篩選菜單，onFilter 判斷篩選結果，filterMultiple 表示單選或多選，filterOnClose 指定篩選菜單關閉時是否觸發篩選。使用 defaultFilteredValue 可以讓列默認處於篩選狀態。</target>
      </segment>
    </unit>
    <unit id="13" name="FilterInTreeTitle">
      <segment>
        <source>Filter in Tree</source>
        <target state="translated">樹形篩選</target>
      </segment>
    </unit>
    <unit id="14" name="FilterInTreeDescription">
      <segment>
        <source>You can use filterMode to change default filter interface, options: menu(default) and tree.</source>
        <target state="translated">可以使用 filterMode 改變默認篩選界面，可選 menu（默認）和 tree。</target>
      </segment>
    </unit>
    <unit id="15" name="MultipleSorterTitle">
      <segment>
        <source>Multiple sorter</source>
        <target state="translated">多列排序</target>
      </segment>
    </unit>
    <unit id="16" name="MultipleSorterDescription">
      <segment>
        <source>column.sorter support multiple to config the priority of sort columns. Though sorter.compare to customize compare function. You can also leave it empty to use the interactive only.</source>
        <target state="translated">column.sorter 支持通過 multiple 配置排序優先級。可以通過 sorter.compare 自定義比較函數，也可以留空只使用交互排序。</target>
      </segment>
    </unit>
    <unit id="17" name="ResetFiltersAndSortersTitle">
      <segment>
        <source>Reset filters and sorters</source>
        <target state="translated">重置篩選和排序</target>
      </segment>
    </unit>
    <unit id="18" name="ResetFiltersAndSortersDescription">
      <segment>
        <source>Control filters and sorters by API.</source>
        <target state="translated">通過 API 控制篩選和排序。</target>
      </segment>
    </unit>
    <unit id="19" name="ExpandableRowTitle">
      <segment>
        <source>Expandable Row</source>
        <target state="translated">可展開行</target>
      </segment>
    </unit>
    <unit id="20" name="ExpandableRowDescription">
      <segment>
        <source>When there's too much information to show and the table can't display all at once.</source>
        <target state="translated">當需要展示的信息過多，表格無法一次性完整展示時使用。</target>
      </segment>
    </unit>
    <unit id="21" name="OrderSpecificColumnTitle">
      <segment>
        <source>Order Specific Column</source>
        <target state="translated">指定列順序</target>
      </segment>
    </unit>
    <unit id="22" name="OrderSpecificColumnDescription">
      <segment>
        <source>You can control the order of the expand and select columns.</source>
        <target state="translated">可以控制展開列和選擇列的順序。</target>
      </segment>
    </unit>
    <unit id="23" name="RowHeaderTitle">
      <segment>
        <source>Row Header</source>
        <target state="translated">行頭</target>
      </segment>
    </unit>
    <unit id="24" name="RowHeaderDescription">
      <segment>
        <source>You can control whether to display the Column header and RowHeader.</source>
        <target state="translated">可以控制是否顯示列頭和行頭。</target>
      </segment>
    </unit>
    <unit id="25" name="GroupingTableHeadTitle">
      <segment>
        <source>Grouping table head</source>
        <target state="translated">分組表頭</target>
      </segment>
    </unit>
    <unit id="26" name="GroupingTableHeadDescription">
      <segment>
        <source>Group table head with columns[n].children.</source>
        <target state="translated">使用 columns[n].children 對表頭進行分組。</target>
      </segment>
    </unit>
    <unit id="27" name="HiddenColumnsTitle">
