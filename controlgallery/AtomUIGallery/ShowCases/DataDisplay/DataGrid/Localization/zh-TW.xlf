    <unit id="29" name="FixedHeaderTitle">
      <segment>
        <source>Fixed Header</source>
        <target state="translated">固定表頭</target>
      </segment>
    </unit>
    <unit id="30" name="FixedHeaderDescription">
      <segment>
        <source>Display large amounts of data in scrollable view.</source>
        <target state="translated">在可滾動視圖中展示大量數據。</target>
      </segment>
    </unit>
    <unit id="31" name="FixedColumnsTitle">
