        <source>Fixed Columns</source>
        <target state="translated">固定列</target>
      </segment>
    </unit>
    <unit id="32" name="FixedColumnsDescription">
      <segment>
        <source>When there are too many columns, we can make some columns fixed.</source>
        <target state="translated">當列過多時，可以固定部分列。</target>
      </segment>
    </unit>
    <unit id="33" name="FixedColumnsAndHeadersTitle">
      <segment>
        <source>Fixed Columns And Headers</source>
        <target state="translated">固定列和表頭</target>
      </segment>
    </unit>
    <unit id="34" name="FixedColumnsAndHeadersDescription">
