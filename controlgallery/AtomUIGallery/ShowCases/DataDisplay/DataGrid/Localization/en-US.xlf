      <segment>
        <source>Selection</source>
      </segment>
    </unit>
    <unit id="4" name="SelectionDescription">
      <segment>
        <source>Rows can be selectable by making first column as a selectable column. You can use rowSelection.type to set selection type. Default is checkbox.</source>
      </segment>
    </unit>
    <unit id="5" name="DragResizeColumnTitle">
