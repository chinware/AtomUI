                    <atom:CheckBox Name="ColumnCheckBox2" IsChecked="True" IsCheckedChanged="HandleColumnVisibleChanged" Content="{gallery:DataGridShowCaseLangResource P2ContentColumnN2}" />
                    <atom:CheckBox Name="ColumnCheckBox3" IsChecked="True" IsCheckedChanged="HandleColumnVisibleChanged" Content="{gallery:DataGridShowCaseLangResource P2ContentColumnN3}" />
                    <atom:CheckBox Name="ColumnCheckBox4" IsChecked="True" IsCheckedChanged="HandleColumnVisibleChanged" Content="{gallery:DataGridShowCaseLangResource P2ContentColumnN4}" />
