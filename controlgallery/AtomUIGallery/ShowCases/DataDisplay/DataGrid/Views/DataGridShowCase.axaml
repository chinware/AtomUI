                    <atom:DataGrid.Columns>
                        <atom:DataGridRowReorderColumn />
                        <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderName}" Binding="{Binding Name}" />
                        <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAddress}" Binding="{Binding Name}" />
                        <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAge}" Binding="{Binding Address}" />
                    </atom:DataGrid.Columns>
                </atom:DataGrid>
            </StackPanel>
                            </DataTemplate>
                        </gallery:ShowCaseItem.DeferredContentTemplate>
                    </gallery:ShowCaseItem>

<gallery:ShowCaseItem Title="{gallery:DataGridShowCaseLangResource CustomEmptyAndLoadingTitle}"
                              Description="{gallery:DataGridShowCaseLangResource CustomEmptyAndLoadingDescription}"
                              IsOccupyEntireRow="True"
                                          IsDeferredContentEnabled="True">
                        <gallery:ShowCaseItem.DeferredContentTemplate>
                            <DataTemplate x:DataType="vm:DataGridViewModel">

            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <atom:Button ButtonType="Primary" Click="HandleToggleEmptyGridItemsSource" Content="{gallery:DataGridShowCaseLangResource P2ContentToggleData}" />
                    <atom:Button ButtonType="Primary" Click="HandleToggleLoadingState" Content="{gallery:DataGridShowCaseLangResource P2ContentToggleLoading}" />
                </StackPanel>
                <atom:DataGrid x:Name="CustomEmptyDataGrid"
                               CanUserReorderRows="True"
                               x:DataType="vm:DataGridBaseInfo"
                               AttachedToVisualTree="HandleExampleDataGridAttached">
                    <atom:DataGrid.Columns>
                        <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderName}" Binding="{Binding Name}" />
                        <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAge}" Binding="{Binding Address}" />
                        <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAddress}" Binding="{Binding Name}" />
                    </atom:DataGrid.Columns>
                </atom:DataGrid>
            </StackPanel>
                            </DataTemplate>
                        </gallery:ShowCaseItem.DeferredContentTemplate>
                    </gallery:ShowCaseItem>

<gallery:ShowCaseItem Title="{gallery:DataGridShowCaseLangResource EditableCellsTitle}"
                              Description="{gallery:DataGridShowCaseLangResource EditableCellsDescription}"
                              IsOccupyEntireRow="True"
                                          IsDeferredContentEnabled="True">
                        <gallery:ShowCaseItem.DeferredContentTemplate>
                            <DataTemplate x:DataType="vm:DataGridViewModel">

            <StackPanel Spacing="10">
                <atom:Button ButtonType="Primary" Click="HandleAddARowToCellsEditableGrid" Content="{gallery:DataGridShowCaseLangResource P2ContentAddARow}" />
                <atom:DataGrid x:Name="EditableCellsDataGrid"
                                       x:DataType="vm:DataGridBaseInfo"
                               AttachedToVisualTree="HandleExampleDataGridAttached">
                    <atom:DataGrid.Columns>
                        <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderName}" Binding="{Binding Name}" />
                        <atom:DataGridNumericColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAge}" Binding="{Binding Age}" FormatString="0" />
                        <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAddress}" Binding="{Binding Address}" />
                        <atom:DataGridTemplateColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAction}">
                            <atom:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="15">
                                        <atom:PopupConfirm
                                            Title="{gallery:DataGridShowCaseLangResource P2TitleSureToDelete}"
                                            Confirmed="HandleRemoveRowCellsEditableGrid"
                                            DataContext="{Binding Index, RelativeSource={RelativeSource AncestorType=atom:DataGridRow}}">
                                            <atom:HyperLinkTextBlock Text="{gallery:DataGridShowCaseLangResource P2TextDelete}" />
                                        </atom:PopupConfirm>
                                    </StackPanel>
                                </DataTemplate>
                            </atom:DataGridTemplateColumn.CellTemplate>
                        </atom:DataGridTemplateColumn>
                    </atom:DataGrid.Columns>
                </atom:DataGrid>
            </StackPanel>
                            </DataTemplate>
                        </gallery:ShowCaseItem.DeferredContentTemplate>
                    </gallery:ShowCaseItem>

<gallery:ShowCaseItem Title="{gallery:DataGridShowCaseLangResource BasicPagingTitle}"
                              Description="{gallery:DataGridShowCaseLangResource BasicPagingDescription}"
                              IsOccupyEntireRow="True"
                                          IsDeferredContentEnabled="True">
                        <gallery:ShowCaseItem.DeferredContentTemplate>
                            <DataTemplate x:DataType="vm:DataGridViewModel">

            <StackPanel Spacing="20">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <atom:TextBlock Width="180" VerticalAlignment="Center" Text="{gallery:DataGridShowCaseLangResource P2TextPaginationvisibility}" />
                        <atom:CheckBox Name="ShowTopPaginationCheckBox" IsCheckedChanged="HandleShowTopPaginationCheckBoxChanged" Content="{gallery:DataGridShowCaseLangResource P2ContentTopPagination}" />
                        <atom:CheckBox Name="ShowBottomPaginationCheckBox" IsCheckedChanged="HandleShowBottomPaginationCheckBoxChanged" IsChecked="True" Content="{gallery:DataGridShowCaseLangResource P2ContentBottomPagination}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <atom:TextBlock Width="180" VerticalAlignment="Center" Text="{gallery:DataGridShowCaseLangResource P2TextTopPaginationAlign}" />
                        <atom:OptionButtonGroup ButtonStyle="Solid" Name="TopPaginationOptionGroup" OptionCheckedChanged="HandleTopPaginationAlignChanged">
                            <atom:OptionButton Content="{gallery:DataGridShowCaseLangResource P2ContentStart}" />
                            <atom:OptionButton Content="{gallery:DataGridShowCaseLangResource P2ContentCenter}" />
                            <atom:OptionButton IsChecked="True" Content="{gallery:DataGridShowCaseLangResource P2ContentEnd}" />
                        </atom:OptionButtonGroup>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <atom:TextBlock Width="180" VerticalAlignment="Center" Text="{gallery:DataGridShowCaseLangResource P2TextBottomPaginationAlign}" />
                        <atom:OptionButtonGroup ButtonStyle="Solid" Name="BottomPaginationOptionGroup" OptionCheckedChanged="HandleBottomPaginationAlignChanged">
                            <atom:OptionButton Content="{gallery:DataGridShowCaseLangResource P2ContentStart}" />
                            <atom:OptionButton Content="{gallery:DataGridShowCaseLangResource P2ContentCenter}" />
                            <atom:OptionButton IsChecked="True" Content="{gallery:DataGridShowCaseLangResource P2ContentEnd}" />
                        </atom:OptionButtonGroup>
                    </StackPanel>

                </StackPanel>
                <atom:DataGrid x:Name="BasicPagingCaseGrid" Height="400" PaginationVisibility="Bottom"
                               PageSize="10"
                               x:DataType="vm:DataGridBaseInfo"
                               AttachedToVisualTree="HandleExampleDataGridAttached">
                    <atom:DataGrid.Columns>
                        <atom:DataGridTemplateColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderName}">
                            <atom:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:DataGridBaseInfo">
                                    <atom:HyperLinkTextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </atom:DataGridTemplateColumn.CellTemplate>
                        </atom:DataGridTemplateColumn>
                        <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAge}" Binding="{Binding Age}" />
                        <atom:DataGridTextColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAddress}" Binding="{Binding Address}" />
                        <atom:DataGridTemplateColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderTags}">
                            <atom:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="vm:DataGridBaseInfo">
                                    <ItemsControl ItemsSource="{Binding Tags}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="5" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TagInfo">
                                                <atom:Tag Text="{Binding Name}" TagColor="{Binding Color}"></atom:Tag>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>
                            </atom:DataGridTemplateColumn.CellTemplate>
                        </atom:DataGridTemplateColumn>
                        <atom:DataGridTemplateColumn Header="{gallery:DataGridShowCaseLangResource P2HeaderAction}">
                            <atom:DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="15">
                                        <atom:HyperLinkTextBlock Text="{gallery:DataGridShowCaseLangResource P2TextInvite}" />
                                        <atom:HyperLinkTextBlock Text="{gallery:DataGridShowCaseLangResource P2TextModify}" />
                                        <atom:HyperLinkTextBlock Text="{gallery:DataGridShowCaseLangResource P2TextDelete}" />
                                    </StackPanel>
                                </DataTemplate>
                            </atom:DataGridTemplateColumn.CellTemplate>
                        </atom:DataGridTemplateColumn>
                    </atom:DataGrid.Columns>
                </atom:DataGrid>
            </StackPanel>
                            </DataTemplate>
                        </gallery:ShowCaseItem.DeferredContentTemplate>
                    </gallery:ShowCaseItem>
                </gallery:ShowCasePanel>
            </ContentControl>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
