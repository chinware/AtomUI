                    <atom:CheckBox Name="ColumnCheckBox6" IsChecked="True" IsCheckedChanged="HandleColumnVisibleChanged" Content="{gallery:DataGridShowCaseLangResource P2ContentColumnN6}" />
                </StackPanel>
                <atom:DataGrid x:Name="HideColumnDataGrid"
                               RowDetailsVisibilityMode="Collapsed"
                               x:DataType="vm:DataGridBaseInfo"
