<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Carousel.CarouselShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Carousel"
             x:DataType="vm:CarouselViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <StackPanel Margin="28,24,28,18"
                            Spacing="16">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <atom:TextBlock Text="Carousel"
                                            FontSize="26"
                                            FontWeight="Bold"
                                            VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:CarouselShowCaseLangResource ComponentCategory}"
                                      TagColor="blue"
                                      VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:CarouselShowCaseLangResource ComponentStatusStable}"
                                      TagColor="success"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                        <atom:TextBlock Text="{gallery:CarouselShowCaseLangResource PageSubtitle}"
                                        FontSize="15"
                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                        <atom:TextBlock Text="{gallery:CarouselShowCaseLangResource PageDescription}"
                                        HorizontalAlignment="Left"
                                        TextWrapping="Wrap"
                                        Foreground="{atom:SharedTokenResource ColorTextTertiary}" />
                    </StackPanel>

                    <Border Background="{atom:SharedTokenResource ColorBgContainer}"
                            BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinHeight="48"
                            Padding="16,8">
                        <Border.Styles>
                            <Style Selector="atom|TextBlock.info-label">
                                <Setter Property="Width" Value="84" />
                            </Style>
                            <Style Selector="atom|TextBlock.info-value">
                                <Setter Property="Width" Value="200" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </Border.Styles>
                        <WrapPanel Orientation="Horizontal"
                                   ItemSpacing="48"
                                   LineSpacing="8"
                                   VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:CarouselShowCaseLangResource InfoNamespaceLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:CarouselShowCaseLangResource InfoPackageLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:CarouselShowCaseLangResource InfoBaseClassLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="SelectingItemsControl"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </gallery:GalleryStickyTabsHost.Header>

            <gallery:GalleryStickyTabsHost.StickyContent>
                <atom:TabStrip Name="ScenarioTabs"
                               SizeType="Large"
                               SelectedIndex="0">
                    <atom:TabStripItem Content="{gallery:CarouselShowCaseLangResource ScenarioExamples}"
                                       Tag="Examples"
                                       IsSelected="True" />
                    <atom:TabStripItem Content="{gallery:CarouselShowCaseLangResource ScenarioApi}"
                                       Tag="Api" />
                    <atom:TabStripItem Content="{gallery:CarouselShowCaseLangResource ScenarioDesignToken}"
                                       Tag="DesignToken" />
                </atom:TabStrip>
            </gallery:GalleryStickyTabsHost.StickyContent>

            <ContentControl Name="ScenarioContentHost">
                <gallery:ShowCasePanel Name="ExamplesContent"
                                       IsScrollEnabled="False"
                                       ContentMargin="28,10,28,28">
                    <gallery:ShowCasePanel.Styles>
                        <Style Selector="atom|Carousel">
                            <Setter Property="Background" Value="#364d79" />
                            <Setter Property="Foreground" Value="#fff" />
                            <Setter Property="Height" Value="160" />
                        </Style>
                        <Style Selector="atom|CarouselPage">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Style>
                    </gallery:ShowCasePanel.Styles>
                    <gallery:ShowCaseItem Title="{gallery:CarouselShowCaseLangResource BasicTitle}" Description="{gallery:CarouselShowCaseLangResource BasicDescription}">
                        <atom:Carousel SelectedIndex="2">
                            <atom:CarouselPage>1</atom:CarouselPage>
                            <atom:CarouselPage>2</atom:CarouselPage>
                            <atom:CarouselPage>3</atom:CarouselPage>
                            <atom:CarouselPage>4</atom:CarouselPage>
                        </atom:Carousel>
                    </gallery:ShowCaseItem>

                    <gallery:ShowCaseItem
                        Title="{gallery:CarouselShowCaseLangResource CardShapePositionTitle}"
                        Description="{gallery:CarouselShowCaseLangResource CardShapePositionDescription}"
                        Margin="0, 0, 5, 0">
                        <StackPanel Orientation="Vertical" Spacing="20">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <atom:TextBlock VerticalAlignment="Center" Text="{gallery:CarouselShowCaseLangResource P2TextPaginationPosition}" />
                                <atom:OptionButtonGroup ButtonStyle="Outline" Name="PositionOptionGroup">
                                    <atom:OptionButton Content="{gallery:CarouselShowCaseLangResource P2ContentTop}" />
                                    <atom:OptionButton IsChecked="True" Content="{gallery:CarouselShowCaseLangResource P2ContentBottom}" />
                                    <atom:OptionButton Content="{gallery:CarouselShowCaseLangResource P2ContentLeft}" />
                                    <atom:OptionButton Content="{gallery:CarouselShowCaseLangResource P2ContentRight}" />
                                </atom:OptionButtonGroup>
                            </StackPanel>

                            <atom:Carousel PaginationPosition="{Binding PaginationPosition}">
                                <atom:CarouselPage>1</atom:CarouselPage>
                                <atom:CarouselPage>2</atom:CarouselPage>
                                <atom:CarouselPage>3</atom:CarouselPage>
                                <atom:CarouselPage>4</atom:CarouselPage>
                            </atom:Carousel>

                        </StackPanel>
                    </gallery:ShowCaseItem>

                    <gallery:ShowCaseItem Title="{gallery:CarouselShowCaseLangResource AutoScrollTitle}"
                                                  Description="{gallery:CarouselShowCaseLangResource AutoScrollDescription}">
                        <atom:Carousel IsAutoPlay="True" IsInfinite="False">
                            <atom:CarouselPage>1</atom:CarouselPage>
                            <atom:CarouselPage>2</atom:CarouselPage>
                            <atom:CarouselPage>3</atom:CarouselPage>
                            <atom:CarouselPage>4</atom:CarouselPage>
                        </atom:Carousel>
                    </gallery:ShowCaseItem>

                    <gallery:ShowCaseItem Title="{gallery:CarouselShowCaseLangResource FadeInTitle}"
                                                  Description="{gallery:CarouselShowCaseLangResource FadeInDescription}">
                        <atom:Carousel TransitionEffect="Fade">
                            <atom:CarouselPage Background="#B3001B">1</atom:CarouselPage>
                            <atom:CarouselPage Background="#255C99">2</atom:CarouselPage>
                            <atom:CarouselPage Background="#262626">3</atom:CarouselPage>
                            <atom:CarouselPage Background="#CCAD8F">4</atom:CarouselPage>
                        </atom:Carousel>
                    </gallery:ShowCaseItem>

                    <gallery:ShowCaseItem Title="{gallery:CarouselShowCaseLangResource SwitchArrowsTitle}"
                                                  Description="{gallery:CarouselShowCaseLangResource SwitchArrowsDescription}">
                        <StackPanel Orientation="Vertical" Spacing="10">
                            <atom:Carousel IsShowNavButtons="True">
                                <atom:CarouselPage>1</atom:CarouselPage>
                                <atom:CarouselPage>2</atom:CarouselPage>
                                <atom:CarouselPage>3</atom:CarouselPage>
                                <atom:CarouselPage>4</atom:CarouselPage>
                            </atom:Carousel>
                            <atom:Carousel PaginationPosition="Left" IsShowNavButtons="True" IsInfinite="False">
                                <atom:CarouselPage>1</atom:CarouselPage>
                                <atom:CarouselPage>2</atom:CarouselPage>
                                <atom:CarouselPage>3</atom:CarouselPage>
                                <atom:CarouselPage>4</atom:CarouselPage>
                            </atom:Carousel>
                        </StackPanel>
                    </gallery:ShowCaseItem>

                    <gallery:ShowCaseItem Title="{gallery:CarouselShowCaseLangResource DotsProgressTitle}"
                                                  Description="{gallery:CarouselShowCaseLangResource DotsProgressDescription}">
                        <StackPanel Orientation="Vertical" Spacing="10">
                            <atom:Carousel IsShowTransitionProgress="True" IsAutoPlay="True">
                                <atom:CarouselPage>1</atom:CarouselPage>
                                <atom:CarouselPage>2</atom:CarouselPage>
                                <atom:CarouselPage>3</atom:CarouselPage>
                                <atom:CarouselPage>4</atom:CarouselPage>
                            </atom:Carousel>
                        </StackPanel>
                    </gallery:ShowCaseItem>

                </gallery:ShowCasePanel>
            </ContentControl>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
