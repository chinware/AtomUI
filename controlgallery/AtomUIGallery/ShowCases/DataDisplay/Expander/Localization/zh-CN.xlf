    <unit id="9" name="ExpanderTitle">
      <segment>
        <source>Expander</source>
        <target state="translated">展开器</target>
      </segment>
    </unit>
    <unit id="10" name="ExpanderDescription">
      <segment>
        <source>By default, The simplest usage is to expand downward.</source>
        <target state="translated">默认情况下，最简单的用法是向下展开。</target>
      </segment>
    </unit>
    <unit id="11" name="SizeTitle">
      <segment>
        <source>Size</source>
        <target state="translated">尺寸</target>
      </segment>
    </unit>
    <unit id="12" name="SizeDescription">
      <segment>
        <source>Ant Design supports a default Expander size as well as a large and small size. If a large or small Expander is desired, set the size property to either large or small respectively. Omit the size property for a Expander with the default size.</source>
        <target state="translated">Ant Design 支持默认、大号和小号三种 Expander 尺寸。需要大号或小号时分别设置 size 属性；省略 size 属性时使用默认尺寸。</target>
      </segment>
    </unit>
    <unit id="13" name="ExpandingDirectionTitle">
      <segment>
        <source>Expanding Direction</source>
        <target state="translated">展开方向</target>
      </segment>
    </unit>
    <unit id="14" name="ExpandingDirectionDescription">
      <segment>
        <source>The content area supports expansion in four directions.</source>
        <target state="translated">内容区域支持四个方向展开。</target>
      </segment>
    </unit>
