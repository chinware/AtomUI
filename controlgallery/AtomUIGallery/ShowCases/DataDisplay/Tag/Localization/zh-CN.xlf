  <file id="AtomUIGallery.Localization.TagShowCaseLangResourceKind">
    <unit id="1" name="BasicTitle">
      <segment>
        <source>Basic</source>
        <target state="translated">基础用法</target>
      </segment>
    </unit>
    <unit id="2" name="BasicDescription">
      <segment>
        <source>Usage of basic Tag, and it could be IsClosable and customize close button by set closeIcon property,will display default close button when closeIcon is setting to true. IsClosable Tag supports onClose events.</source>
        <target state="translated">基础 Tag 用法。可通过 IsClosable 设置为可关闭，并通过 closeIcon 属性自定义关闭按钮；closeIcon 设置为 true 时显示默认关闭按钮。IsClosable Tag 支持 onClose 事件。</target>
      </segment>
    </unit>
    <unit id="3" name="CheckableTagTitle">
      <segment>
        <source>Checkable</source>
        <target state="translated">可选择标签</target>
      </segment>
    </unit>
    <unit id="4" name="CheckableTagDescription">
      <segment>
        <source>CheckableTag works like Checkbox. CheckableTagGroup provides single and multiple selection over a shared option set.</source>
        <target state="translated">CheckableTag 提供类似 Checkbox 的切换效果，CheckableTagGroup 可在同组选项上进行单选或多选。</target>
      </segment>
    </unit>
    <unit id="5" name="ColorfulTagTitle">
      <segment>
        <source>Colorful Tag</source>
        <target state="translated">多彩标签</target>
      </segment>
    </unit>
    <unit id="6" name="ColorfulTagDescription">
      <segment>
        <source>We preset a series of colorful tag styles for use in different situations. You can also set it to a hex color string for custom color.</source>
        <target state="translated">预设了一系列多彩标签样式，可用于不同场景。也可以设置十六进制颜色字符串来自定义颜色。</target>
      </segment>
    </unit>
    <unit id="7" name="StatusTagTitle">
      <segment>
        <source>Status Tag</source>
        <target state="translated">状态标签</target>
      </segment>
    </unit>
    <unit id="8" name="StatusTagDescription">
      <segment>
        <source>We preset five different colors, you can set color property such as success,processing,error,default and warning to indicate specific status.</source>
        <target state="translated">预设了五种不同颜色，可以设置 success、processing、error、default 和 warning 等 color 属性表示具体状态。</target>
      </segment>
    </unit>
    <unit id="9" name="IconTitle">
      <segment>
        <source>Icon</source>
        <target state="translated">图标</target>
      </segment>
    </unit>
    <unit id="10" name="IconDescription">
      <segment>
        <source>Tag components can contain an Icon. This is done by setting the icon property or placing an Icon component within the Tag. If you want specific control over the positioning and placement of the Icon, then that should be done by placing the Icon component within the Tag rather than using the icon property.</source>
        <target state="translated">Tag 组件可以包含图标。可以通过设置 icon 属性，或在 Tag 内放置 Icon 组件实现。如果需要精确控制图标的位置和布局，应在 Tag 内放置 Icon 组件，而不是使用 icon 属性。</target>
      </segment>
    </unit>
    <unit id="11" name="VariantTitle">
      <segment>
        <source>Variants</source>
        <target state="translated">形态变体</target>
      </segment>
    </unit>
    <unit id="12" name="VariantDescription">
      <segment>
        <source>Use Filled, Solid, and Outlined variants independently of the selected color.</source>
        <target state="translated">Filled、Solid 和 Outlined 三种形态可以与颜色独立组合。</target>
      </segment>
    </unit>
