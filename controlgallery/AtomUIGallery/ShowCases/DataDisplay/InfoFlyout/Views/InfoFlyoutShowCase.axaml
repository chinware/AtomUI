<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AtomUIGallery.ShowCases.InfoFlyout"
             x:Class="AtomUIGallery.ShowCases.InfoFlyout.InfoFlyoutShowCase"
             x:DataType="vm:InfoFlyoutViewModel"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <StackPanel Margin="28,24,28,18"
                            Spacing="16">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <atom:TextBlock Text="InfoFlyout"
                                            FontSize="26"
                                            FontWeight="Bold"
                                            VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:InfoFlyoutShowCaseLangResource ComponentCategory}"
                                      TagColor="blue"
                                      VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:InfoFlyoutShowCaseLangResource ComponentStatusStable}"
                                      TagColor="success"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                        <atom:TextBlock Text="{gallery:InfoFlyoutShowCaseLangResource PageSubtitle}"
                                        FontSize="15"
                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                        <atom:TextBlock Text="{gallery:InfoFlyoutShowCaseLangResource PageDescription}"
                                        HorizontalAlignment="Left"
                                        TextWrapping="Wrap"
                                        Foreground="{atom:SharedTokenResource ColorTextTertiary}" />
                    </StackPanel>

                    <Border Background="{atom:SharedTokenResource ColorBgContainer}"
                            BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinHeight="48"
                            Padding="16,8">
                        <Border.Styles>
                            <Style Selector="atom|TextBlock.info-label">
                                <Setter Property="Width" Value="84" />
                            </Style>
                            <Style Selector="atom|TextBlock.info-value">
                                <Setter Property="Width" Value="200" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </Border.Styles>
                        <WrapPanel Orientation="Horizontal"
                                   ItemSpacing="48"
                                   LineSpacing="8"
                                   VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:InfoFlyoutShowCaseLangResource InfoNamespaceLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:InfoFlyoutShowCaseLangResource InfoPackageLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:InfoFlyoutShowCaseLangResource InfoBaseClassLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="ContentControl"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </gallery:GalleryStickyTabsHost.Header>

            <gallery:GalleryStickyTabsHost.StickyContent>
                <atom:TabStrip Name="ScenarioTabs"
                               SizeType="Large"
                               SelectedIndex="0">
                    <atom:TabStripItem Content="{gallery:InfoFlyoutShowCaseLangResource ScenarioExamples}"
                                       Tag="Examples"
                                       IsSelected="True" />
                    <atom:TabStripItem Content="{gallery:InfoFlyoutShowCaseLangResource ScenarioApi}"
                                       Tag="Api" />
                    <atom:TabStripItem Content="{gallery:InfoFlyoutShowCaseLangResource ScenarioDesignToken}"
                                       Tag="DesignToken" />
                </atom:TabStrip>
            </gallery:GalleryStickyTabsHost.StickyContent>

            <ContentControl Name="ScenarioContentHost">
                <gallery:ShowCasePanel Name="ExamplesContent"
                                       IsScrollEnabled="False"
                                       IsDeferredLoadingEnabled="True"
                                       InitialDeferredLoadItemCount="4"
                                       DeferredLoadBatchSize="2"
                                       ContentMargin="28,10,28,28">
        <gallery:ShowCaseItem
            Title="{gallery:InfoFlyoutShowCaseLangResource BasicTitle}"
            Description="{gallery:InfoFlyoutShowCaseLangResource BasicDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:InfoFlyoutViewModel">
            <StackPanel Orientation="Vertical" Spacing="10">
                <atom:FlyoutHost Trigger="Hover" ShouldUseOverlayPopup="False">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button ButtonType="Primary" Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentHoverMe}" />
                </atom:FlyoutHost>
            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:InfoFlyoutShowCaseLangResource TriggerWaysTitle}"
            Description="{gallery:InfoFlyoutShowCaseLangResource TriggerWaysDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:InfoFlyoutViewModel">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <atom:FlyoutHost Trigger="Hover" ShouldUseOverlayPopup="False">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentHoverMe}" />
                </atom:FlyoutHost>
                <atom:FlyoutHost Trigger="Focus" ShouldUseOverlayPopup="False">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="220" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentFocusMe}" />
                </atom:FlyoutHost>
                <atom:FlyoutHost Trigger="Click" ShouldUseOverlayPopup="False">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentClickMe}" />
                </atom:FlyoutHost>
            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:InfoFlyoutShowCaseLangResource PlacementTitle}"
            Description="{gallery:InfoFlyoutShowCaseLangResource PlacementDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:InfoFlyoutViewModel">
            <Grid>
                <Grid.Styles>
                    <Style Selector="atom|Button">
                        <Setter Property="Margin" Value="5" />
                        <Setter Property="Width" Value="80" />
                    </Style>
                </Grid.Styles>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <atom:FlyoutHost Grid.Row="1" Grid.Column="0" Trigger="Hover" Placement="LeftEdgeAlignedTop">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentLT}" />
                </atom:FlyoutHost>

                <atom:FlyoutHost Grid.Row="2" Grid.Column="0" Trigger="Hover" Placement="Left">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentLeft}" />
                </atom:FlyoutHost>

                <atom:FlyoutHost Grid.Row="3" Grid.Column="0" Trigger="Hover" Placement="LeftEdgeAlignedBottom">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentLB}" />
                </atom:FlyoutHost>

                <atom:FlyoutHost Grid.Row="0" Grid.Column="1" Trigger="Hover" Placement="TopEdgeAlignedLeft">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentTL}" />
                </atom:FlyoutHost>

                <atom:FlyoutHost Grid.Row="0" Grid.Column="2" Trigger="Hover" Placement="Top">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentTop}" />
                </atom:FlyoutHost>

                <atom:FlyoutHost Grid.Row="0" Grid.Column="3" Trigger="Hover" Placement="TopEdgeAlignedRight">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentTR}" />
                </atom:FlyoutHost>

                <atom:FlyoutHost Grid.Row="1" Grid.Column="4" Trigger="Hover" Placement="RightEdgeAlignedTop">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentRT}" />
                </atom:FlyoutHost>

                <atom:FlyoutHost Grid.Row="2" Grid.Column="4" Trigger="Hover" Placement="Right">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentRight}" />
                </atom:FlyoutHost>

                <atom:FlyoutHost Grid.Row="3" Grid.Column="4" Trigger="Hover" Placement="RightEdgeAlignedBottom">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentRB}" />
                </atom:FlyoutHost>

                <atom:FlyoutHost Grid.Row="4" Grid.Column="1" Trigger="Hover" Placement="BottomEdgeAlignedLeft">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentBL}" />
                </atom:FlyoutHost>

                <atom:FlyoutHost Grid.Row="4" Grid.Column="2" Trigger="Hover" Placement="Bottom">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentBottom}" />
                </atom:FlyoutHost>

                <atom:FlyoutHost Grid.Row="4" Grid.Column="3" Trigger="Hover" Placement="BottomEdgeAlignedRight">
                    <atom:FlyoutHost.Flyout>
                        <atom:Flyout>
                            <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                        </atom:Flyout>
                    </atom:FlyoutHost.Flyout>
                    <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentBR}" />
                </atom:FlyoutHost>

            </Grid>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:InfoFlyoutShowCaseLangResource ArrowTitle}"
            Description="{gallery:InfoFlyoutShowCaseLangResource ArrowDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:InfoFlyoutViewModel">
            <StackPanel Orientation="Vertical" Spacing="10">
                <atom:Segmented x:Name="ArrowSegmented"
                                SelectionChanged="HandleArrowSegmentedSelectionChanged">
                    <atom:SegmentedItem Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentShow}" />
                    <atom:SegmentedItem Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentHide}" />
                    <atom:SegmentedItem Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentCenter}" />
                </atom:Segmented>
                <Grid>
                    <Grid.Styles>
                        <Style Selector="atom|Button">
                            <Setter Property="Margin" Value="5" />
                            <Setter Property="Width" Value="80" />
                        </Style>
                    </Grid.Styles>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <atom:FlyoutHost Grid.Row="1" Grid.Column="0"
                                     Trigger="Hover"
                                     Placement="LeftEdgeAlignedTop"
                                     IsArrowVisible="{Binding  ShowArrow}"
                                     IsPointAtCenter="{Binding  IsPointAtCenter}">
                        <atom:FlyoutHost.Flyout>
                            <atom:Flyout>
                                <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                            </atom:Flyout>
                        </atom:FlyoutHost.Flyout>
                        <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentLT}" />
                    </atom:FlyoutHost>

                    <atom:FlyoutHost Grid.Row="2" Grid.Column="0"
                                     Trigger="Hover"
                                     Placement="Left"
                                     IsArrowVisible="{Binding  ShowArrow}"
                                     IsPointAtCenter="{Binding  IsPointAtCenter}">
                        <atom:FlyoutHost.Flyout>
                            <atom:Flyout>
                                <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                            </atom:Flyout>
                        </atom:FlyoutHost.Flyout>
                        <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentLeft}" />
                    </atom:FlyoutHost>

                    <atom:FlyoutHost Grid.Row="3" Grid.Column="0"
                                     Trigger="Hover"
                                     Placement="LeftEdgeAlignedBottom"
                                     IsArrowVisible="{Binding  ShowArrow}"
                                     IsPointAtCenter="{Binding  IsPointAtCenter}">
                        <atom:FlyoutHost.Flyout>
                            <atom:Flyout>
                                <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                            </atom:Flyout>
                        </atom:FlyoutHost.Flyout>
                        <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentLB}" />
                    </atom:FlyoutHost>

                    <atom:FlyoutHost Grid.Row="0" Grid.Column="1"
                                     Trigger="Hover"
                                     Placement="TopEdgeAlignedLeft"
                                     IsArrowVisible="{Binding  ShowArrow}"
                                     IsPointAtCenter="{Binding  IsPointAtCenter}">
                        <atom:FlyoutHost.Flyout>
                            <atom:Flyout>
                                <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                            </atom:Flyout>
                        </atom:FlyoutHost.Flyout>
                        <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentTL}" />
                    </atom:FlyoutHost>

                    <atom:FlyoutHost Grid.Row="0" Grid.Column="2"
                                     Trigger="Hover"
                                     Placement="Top"
                                     IsArrowVisible="{Binding  ShowArrow}"
                                     IsPointAtCenter="{Binding  IsPointAtCenter}">
                        <atom:FlyoutHost.Flyout>
                            <atom:Flyout>
                                <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                            </atom:Flyout>
                        </atom:FlyoutHost.Flyout>
                        <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentTop}" />
                    </atom:FlyoutHost>

                    <atom:FlyoutHost Grid.Row="0" Grid.Column="3"
                                     Trigger="Hover"
                                     Placement="TopEdgeAlignedRight"
                                     IsArrowVisible="{Binding  ShowArrow}"
                                     IsPointAtCenter="{Binding  IsPointAtCenter}">
                        <atom:FlyoutHost.Flyout>
                            <atom:Flyout>
                                <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                            </atom:Flyout>
                        </atom:FlyoutHost.Flyout>
                        <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentTR}" />
                    </atom:FlyoutHost>

                    <atom:FlyoutHost Grid.Row="1" Grid.Column="4"
                                     Trigger="Hover"
                                     Placement="RightEdgeAlignedTop"
                                     IsArrowVisible="{Binding  ShowArrow}"
                                     IsPointAtCenter="{Binding  IsPointAtCenter}">
                        <atom:FlyoutHost.Flyout>
                            <atom:Flyout>
                                <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                            </atom:Flyout>
                        </atom:FlyoutHost.Flyout>
                        <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentRT}" />
                    </atom:FlyoutHost>

                    <atom:FlyoutHost Grid.Row="2" Grid.Column="4"
                                     Trigger="Hover"
                                     Placement="Right"
                                     IsArrowVisible="{Binding  ShowArrow}"
                                     IsPointAtCenter="{Binding  IsPointAtCenter}">
                        <atom:FlyoutHost.Flyout>
                            <atom:Flyout>
                                <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                            </atom:Flyout>
                        </atom:FlyoutHost.Flyout>
                        <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentRight}" />
                    </atom:FlyoutHost>

                    <atom:FlyoutHost Grid.Row="3" Grid.Column="4"
                                     Trigger="Hover"
                                     Placement="RightEdgeAlignedBottom"
                                     IsArrowVisible="{Binding  ShowArrow}"
                                     IsPointAtCenter="{Binding  IsPointAtCenter}">
                        <atom:FlyoutHost.Flyout>
                            <atom:Flyout>
                                <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                            </atom:Flyout>
                        </atom:FlyoutHost.Flyout>
                        <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentRB}" />
                    </atom:FlyoutHost>

                    <atom:FlyoutHost Grid.Row="4" Grid.Column="1"
                                     Trigger="Hover"
                                     Placement="BottomEdgeAlignedLeft"
                                     IsArrowVisible="{Binding  ShowArrow}"
                                     IsPointAtCenter="{Binding  IsPointAtCenter}">
                        <atom:FlyoutHost.Flyout>
                            <atom:Flyout>
                                <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                            </atom:Flyout>
                        </atom:FlyoutHost.Flyout>
                        <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentBL}" />
                    </atom:FlyoutHost>

                    <atom:FlyoutHost Grid.Row="4" Grid.Column="2"
                                     Trigger="Hover"
                                     Placement="Bottom"
                                     IsArrowVisible="{Binding  ShowArrow}"
                                     IsPointAtCenter="{Binding  IsPointAtCenter}">
                        <atom:FlyoutHost.Flyout>
                            <atom:Flyout>
                                <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                            </atom:Flyout>
                        </atom:FlyoutHost.Flyout>
                        <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentBottom}" />
                    </atom:FlyoutHost>

                    <atom:FlyoutHost Grid.Row="4" Grid.Column="3"
                                     Trigger="Hover"
                                     Placement="BottomEdgeAlignedRight"
                                     IsArrowVisible="{Binding  ShowArrow}"
                                     IsPointAtCenter="{Binding  IsPointAtCenter}">
                        <atom:FlyoutHost.Flyout>
                            <atom:Flyout>
                                <TextBlock Width="200" Height="100" Padding="20" Text="{gallery:InfoFlyoutShowCaseLangResource P2TextTheMostBasicExample}" />
                            </atom:Flyout>
                        </atom:FlyoutHost.Flyout>
                        <atom:Button Content="{gallery:InfoFlyoutShowCaseLangResource P2ContentBR}" />
                    </atom:FlyoutHost>

                </Grid>
            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

                </gallery:ShowCasePanel>
            </ContentControl>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
