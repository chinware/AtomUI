<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.GroupBox.GroupBoxShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.GroupBox"
             x:DataType="vm:GroupBoxViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="GroupBox"
                    Category="{gallery:GroupBoxShowCaseLangResource ComponentCategory}"
                    Status="{gallery:GroupBoxShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:GroupBoxShowCaseLangResource PageSubtitle}"
                    Description="{gallery:GroupBoxShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="ContentControl" />
            </gallery:GalleryStickyTabsHost.Header>


            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
                <gallery:ShowCaseItem
                    Title="{gallery:GroupBoxShowCaseLangResource BasicTitle}"
                    Description="{gallery:GroupBoxShowCaseLangResource BasicDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:GroupBoxViewModel">
                    <atom:GroupBox HeaderTitle="{gallery:GroupBoxShowCaseLangResource P2HeaderTitleTitleInfo}">
                        <Panel Height="100">
                            <atom:TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{gallery:GroupBoxShowCaseLangResource P2TextContentOfGroupBox}" />
                        </Panel>
                    </atom:GroupBox>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:GroupBoxShowCaseLangResource AutoHeightTitle}"
                    Description="{gallery:GroupBoxShowCaseLangResource AutoHeightDescription}"
                    BadgeText="v6.0.8"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:GroupBoxViewModel">
                    <atom:GroupBox HeaderTitle="{gallery:GroupBoxShowCaseLangResource AutoHeightTitle}">
                        <StackPanel Spacing="8">
                            <atom:TextBlock Text="{gallery:GroupBoxShowCaseLangResource AutoHeightContentOverview}" TextWrapping="Wrap" />
                            <atom:TextBlock Text="{gallery:GroupBoxShowCaseLangResource AutoHeightContentDetail}" TextWrapping="Wrap" />
                            <atom:TextBlock Text="{gallery:GroupBoxShowCaseLangResource AutoHeightContentFooter}" TextWrapping="Wrap" />
                        </StackPanel>
                    </atom:GroupBox>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:GroupBoxShowCaseLangResource HeaderPositionTitle}"
                    Description="{gallery:GroupBoxShowCaseLangResource HeaderPositionDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:GroupBoxViewModel">
                    <StackPanel Orientation="Vertical" Spacing="10">
                        <atom:GroupBox HeaderTitle="{gallery:GroupBoxShowCaseLangResource P2HeaderTitleTitleInfo}">
                            <Panel Height="40">
                                <atom:TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{gallery:GroupBoxShowCaseLangResource P2TextContentOfGroupBox}" />
                            </Panel>
                        </atom:GroupBox>
                        <atom:GroupBox HeaderTitle="{gallery:GroupBoxShowCaseLangResource P2HeaderTitleTitleInfo}" HeaderTitlePosition="Center">
                            <Panel Height="40">
                                <atom:TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{gallery:GroupBoxShowCaseLangResource P2TextContentOfGroupBox}" />
                            </Panel>
                        </atom:GroupBox>
                        <atom:GroupBox HeaderTitle="{gallery:GroupBoxShowCaseLangResource P2HeaderTitleTitleInfo}" HeaderTitlePosition="Right">
                            <Panel Height="40">
                                <atom:TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{gallery:GroupBoxShowCaseLangResource P2TextContentOfGroupBox}" />
                            </Panel>
                        </atom:GroupBox>
                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:GroupBoxShowCaseLangResource HeaderStyleTitle}"
                    Description="{gallery:GroupBoxShowCaseLangResource HeaderStyleDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:GroupBoxViewModel">
                    <StackPanel Orientation="Vertical" Spacing="10">
                        <atom:GroupBox HeaderTitle="{gallery:GroupBoxShowCaseLangResource P2HeaderTitleTitleInfo}" HeaderFontStyle="Italic">
                            <Panel Height="40">
                                <atom:TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{gallery:GroupBoxShowCaseLangResource P2TextContentOfGroupBox}" />
                            </Panel>
                        </atom:GroupBox>
                        <atom:GroupBox HeaderTitle="{gallery:GroupBoxShowCaseLangResource P2HeaderTitleTitleInfo}" HeaderTitlePosition="Center" HeaderFontWeight="Bold">
                            <Panel Height="40">
                                <atom:TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{gallery:GroupBoxShowCaseLangResource P2TextContentOfGroupBox}" />
                            </Panel>
                        </atom:GroupBox>
                        <atom:GroupBox HeaderTitle="{gallery:GroupBoxShowCaseLangResource P2HeaderTitleTitleInfo}" HeaderTitlePosition="Right" HeaderFontStyle="Oblique">
                            <Panel Height="40">
                                <atom:TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{gallery:GroupBoxShowCaseLangResource P2TextContentOfGroupBox}" />
                            </Panel>
                        </atom:GroupBox>
                        <atom:GroupBox HeaderTitle="{gallery:GroupBoxShowCaseLangResource P2HeaderTitleTitleInfo}" HeaderTitlePosition="Center" HeaderFontStyle="Oblique"
                                       HeaderTitleColor="Coral" HeaderFontWeight="Medium">
                            <Panel Height="40">
                                <atom:TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{gallery:GroupBoxShowCaseLangResource P2TextContentOfGroupBox}" />
                            </Panel>
                        </atom:GroupBox>
                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:GroupBoxShowCaseLangResource HeaderIconTitle}"
                    Description="{gallery:GroupBoxShowCaseLangResource HeaderIconDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:GroupBoxViewModel">
                    <atom:GroupBox HeaderTitle="{gallery:GroupBoxShowCaseLangResource P2HeaderTitleTitleInfo}" HeaderIcon="{antdicons:AntDesignIconProvider Kind=GithubOutlined}">
                        <Panel Height="100">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="{gallery:GroupBoxShowCaseLangResource P2TextContentOfGroupBox}" />
                        </Panel>
                    </atom:GroupBox>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
