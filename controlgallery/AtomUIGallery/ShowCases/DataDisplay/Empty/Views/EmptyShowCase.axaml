<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Empty.EmptyShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Empty"
             x:DataType="vm:EmptyViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Empty"
                    Category="{gallery:EmptyShowCaseLangResource ComponentCategory}"
                    Status="{gallery:EmptyShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:EmptyShowCaseLangResource PageSubtitle}"
                    Description="{gallery:EmptyShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="TemplatedControl" />
            </gallery:GalleryStickyTabsHost.Header>


            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
                <gallery:ShowCaseItem
                    Title="{gallery:EmptyShowCaseLangResource BasicTitle}"
                    Description="{gallery:EmptyShowCaseLangResource BasicDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:EmptyViewModel">
                    <atom:Empty PresetImage="Default" />
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:EmptyShowCaseLangResource SizeTitle}"
                    Description="{gallery:EmptyShowCaseLangResource SizeDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:EmptyViewModel">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <atom:Empty PresetImage="Simple" SizeType="Small" />
                            <atom:Empty PresetImage="Simple" SizeType="Middle" />
                            <atom:Empty PresetImage="Simple" SizeType="Large" />
                        </StackPanel>
                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:EmptyShowCaseLangResource CustomizeTitle}"
                    Description="{gallery:EmptyShowCaseLangResource CustomizeDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:EmptyViewModel">
                    <StackPanel Orientation="Vertical" Spacing="10">
                        <atom:Empty ImagePath="avares://AtomUIGallery/Assets/EmptyShowCase/empty.svg"
                                             SizeType="Large"
                                             Description="{gallery:EmptyShowCaseLangResource P2DescriptionCustomizeDescription}" />
                        <atom:Button HorizontalAlignment="Center" ButtonType="Primary" Content="{gallery:EmptyShowCaseLangResource P2ContentCreateNow}" />
                    </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:EmptyShowCaseLangResource NoDescriptionTitle}"
                    Description="{gallery:EmptyShowCaseLangResource NoDescriptionDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:EmptyViewModel">
                    <atom:Empty PresetImage="Default" IsDescriptionVisible="False" />
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
