        <source>No Arrow</source>
        <target state="translated">隐藏箭头</target>
      </segment>
    </unit>
    <unit id="20" name="NoArrowDescription">
      <segment>
        <source>You can hide the arrow icon by passing IsShowExpandIcon={False} to CollapsePanel component.</source>
        <target state="translated">可以向 CollapsePanel 传入 IsShowExpandIcon={False} 来隐藏箭头图标。</target>
      </segment>
    </unit>
    <unit id="21" name="ExpandIconLocationTitle">
      <segment>
        <source>Expand icon location</source>
        <target state="translated">展开图标位置</target>
      </segment>
    </unit>
    <unit id="22" name="ExpandIconLocationDescription">
      <segment>
        <source>The expand icon can be placed in front or in the back.</source>
        <target state="translated">展开图标可以放在前方或后方。</target>
      </segment>
    </unit>
