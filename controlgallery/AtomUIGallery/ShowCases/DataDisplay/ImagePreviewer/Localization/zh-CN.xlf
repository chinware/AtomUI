  <file id="AtomUIGallery.Localization.ImagePreviewerShowCaseLangResourceKind">
    <unit id="ApiEventDialogClosed">
      <segment>
        <source>Raised after the preview dialog closes.</source>
        <target state="translated">预览窗口关闭后触发。</target>
      </segment>
    </unit>
    <unit id="ApiEventDialogClosing">
      <segment>
        <source>Raised before the preview dialog closes.</source>
        <target state="translated">预览窗口关闭前触发。</target>
      </segment>
    </unit>
    <unit id="ApiEventDialogOpened">
      <segment>
        <source>Raised after the preview dialog opens.</source>
        <target state="translated">预览窗口打开后触发。</target>
      </segment>
    </unit>
    <unit id="BasicUsageDescription">
      <segment>
        <source>Click the image to zoom in.</source>
        <target state="translated">点击图片放大预览。</target>
      </segment>
    </unit>
    <unit id="BasicUsageTitle">
      <segment>
        <source>Basic Usage</source>
        <target state="translated">基础用法</target>
      </segment>
    </unit>
    <unit id="ComponentCategory">
      <segment>
        <source>Data Display</source>
        <target state="translated">数据展示</target>
      </segment>
    </unit>
    <unit id="ComponentStatusStable">
      <segment>
        <source>Stable</source>
        <target state="translated">稳定</target>
      </segment>
    </unit>
    <unit id="CustomPreviewImageDescription">
      <segment>
        <source>Choose which source image is displayed as the cover.</source>
        <target state="translated">选择来源集合中的某一张作为关闭态封面。</target>
      </segment>
    </unit>
    <unit id="CustomPreviewImageTitle">
      <segment>
        <source>Custom preview image</source>
        <target state="translated">自定义预览图片</target>
      </segment>
    </unit>
    <unit id="FaultTolerantDescription">
      <segment>
        <source>Load failed to display image placeholder.</source>
        <target state="translated">加载失败时显示图片占位内容。</target>
      </segment>
    </unit>
    <unit id="FaultTolerantTitle">
      <segment>
        <source>Fault tolerant</source>
        <target state="translated">容错</target>
      </segment>
    </unit>
    <unit id="MultipleImagePreviewDescription">
      <segment>
        <source>Click the left and right switch buttons to preview multiple images.</source>
        <target state="translated">点击左右切换按钮预览多张图片。</target>
      </segment>
    </unit>
    <unit id="MultipleImagePreviewTitle">
      <segment>
        <source>Multiple image preview</source>
        <target state="translated">多图预览</target>
      </segment>
    </unit>
    <unit id="PageDescription">
      <segment>
        <source>ImagePreviewer displays an image cover that opens a preview surface. It supports fallback images, cover indexes, image groups, scaling limits, and dialog lifecycle events.</source>
        <target state="translated">ImagePreviewer 展示图片封面，点击后打开预览界面。它支持容错图片、封面索引、多图预览、缩放范围和预览窗口生命周期事件。</target>
      </segment>
    </unit>
    <unit id="PageSubtitle">
      <segment>
        <source>Preview single or multiple images in an overlay with zooming, moving, and switching controls.</source>
        <target state="translated">在覆盖层中预览单张或多张图片，并支持缩放、移动和切换。</target>
      </segment>
    </unit>
    <unit id="PreviewFromOneImageDescription">
      <segment>
        <source>Preview a collection from one image.</source>
        <target state="translated">从一张图片预览图片集合。</target>
      </segment>
    </unit>
    <unit id="PreviewFromOneImageTitle">
      <segment>
        <source>Preview from one image</source>
        <target state="translated">从单张图片预览集合</target>
      </segment>
    </unit>
    <unit id="RemoteImageLoadingDescription">
      <segment>
        <source>Load an image directly from an HTTPS source URI.</source>
        <target state="translated">直接使用 HTTPS 图片源 URI 加载远程图片。</target>
      </segment>
    </unit>
    <unit id="RemoteImageLoadingTitle">
      <segment>
        <source>Remote image loading</source>
        <target state="translated">远程图片加载</target>
      </segment>
    </unit>
    <unit id="ScenarioExamples">
      <segment>
        <source>Examples</source>
        <target state="translated">示例</target>
      </segment>
    </unit>
    <unit id="TwentyRemoteImagesDescription">
      <segment>
        <source>Load a fixed set of 20 public images with cover-only loading and neighbor preloading.</source>
        <target state="translated">使用 20 张固定公共图片演示封面加载、并发限制和邻近预加载。</target>
      </segment>
    </unit>
    <unit id="TwentyRemoteImagesTitle">
      <segment>
        <source>20 remote images</source>
        <target state="translated">20 张远程图片</target>
      </segment>
    </unit>
  </file>
