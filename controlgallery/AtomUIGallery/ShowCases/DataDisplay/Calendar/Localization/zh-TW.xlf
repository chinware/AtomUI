      <segment>
        <source>A basic calendar component with Year/Month switch.</source>
        <target state="translated">一個通用的日曆面板，支援年/月切換。</target>
      </segment>
    </unit>
    <unit id="21" name="SelectableCalendarSelectedMessage">
