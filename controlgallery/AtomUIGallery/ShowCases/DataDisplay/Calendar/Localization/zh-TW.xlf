        <source>Lunar Calendar</source>
        <target state="translated">農曆日曆</target>
      </segment>
    </unit>
    <unit id="16" name="LunarCalendarDescription">
      <segment>
        <source>A full-screen calendar with lunar dates, solar terms, traditional festivals, and application-provided holiday annotations.</source>
        <target state="translated">完整模式的日曆，展示農曆日期、二十四節氣、傳統節日和應用提供的節假日標記。</target>
      </segment>
    </unit>
    <unit id="17" name="LunarCalendarCardTitle">
      <segment>
        <source>Lunar Calendar Card</source>
        <target state="translated">農曆卡片日曆</target>
      </segment>
    </unit>
    <unit id="18" name="LunarCalendarCardDescription">
      <segment>
        <source>A compact lunar calendar for limited spaces.</source>
        <target state="translated">適用於有限空間的緊湊農曆日曆。</target>
      </segment>
    </unit>
    <unit id="19" name="SelectableCalendarTitle">
