<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Calendar.CalendarShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <StackPanel Margin="28,24,28,18"
                            Spacing="16">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <atom:TextBlock Text="Calendar"
                                            FontSize="26"
                                            FontWeight="Bold"
                                            VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:CalendarShowCaseLangResource ComponentCategory}"
                                      TagColor="blue"
                                      VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:CalendarShowCaseLangResource ComponentStatusStable}"
                                      TagColor="success"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                        <atom:TextBlock Text="{gallery:CalendarShowCaseLangResource PageSubtitle}"
                                        FontSize="15"
                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                        <atom:TextBlock Text="{gallery:CalendarShowCaseLangResource PageDescription}"
                                        HorizontalAlignment="Left"
                                        TextWrapping="Wrap"
                                        Foreground="{atom:SharedTokenResource ColorTextTertiary}" />
                    </StackPanel>

                    <Border Background="{atom:SharedTokenResource ColorBgContainer}"
                            BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinHeight="48"
                            Padding="16,8">
                        <Border.Styles>
                            <Style Selector="atom|TextBlock.info-label">
                                <Setter Property="Width" Value="84" />
                            </Style>
                            <Style Selector="atom|TextBlock.info-value">
                                <Setter Property="Width" Value="200" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </Border.Styles>
                        <WrapPanel Orientation="Horizontal"
                                   ItemSpacing="48"
                                   LineSpacing="8"
                                   VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:CalendarShowCaseLangResource InfoNamespaceLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:CalendarShowCaseLangResource InfoPackageLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:CalendarShowCaseLangResource InfoBaseClassLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="TemplatedControl"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </gallery:GalleryStickyTabsHost.Header>

            <gallery:GalleryStickyTabsHost.StickyContent>
                <atom:TabStrip Name="ScenarioTabs"
                               SizeType="Large"
                               SelectedIndex="0">
                    <atom:TabStripItem Content="{gallery:CalendarShowCaseLangResource ScenarioExamples}"
                                       Tag="Examples"
                                       IsSelected="True" />
                    <atom:TabStripItem Content="{gallery:CalendarShowCaseLangResource ScenarioApi}"
                                       Tag="Api" />
                    <atom:TabStripItem Content="{gallery:CalendarShowCaseLangResource ScenarioDesignToken}"
                                       Tag="DesignToken" />
                </atom:TabStrip>
            </gallery:GalleryStickyTabsHost.StickyContent>

            <ContentControl Name="ScenarioContentHost">
                <gallery:ShowCasePanel Name="ExamplesContent"
                                       IsScrollEnabled="False"
                                       ContentMargin="28,10,28,28">
                    <gallery:ShowCaseItem Description="{gallery:CalendarShowCaseLangResource BasicDescription}" Title="{gallery:CalendarShowCaseLangResource BasicTitle}">
                        <atom:Calendar />
                    </gallery:ShowCaseItem>
                </gallery:ShowCasePanel>
            </ContentControl>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
