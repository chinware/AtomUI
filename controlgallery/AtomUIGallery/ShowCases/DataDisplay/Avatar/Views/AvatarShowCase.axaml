<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Avatar.AvatarShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Avatar"
             x:DataType="vm:AvatarViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <StackPanel Margin="28,24,28,18"
                            Spacing="16">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <atom:TextBlock Text="Avatar"
                                            FontSize="26"
                                            FontWeight="Bold"
                                            VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:AvatarShowCaseLangResource ComponentCategory}"
                                      TagColor="blue"
                                      VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:AvatarShowCaseLangResource ComponentStatusStable}"
                                      TagColor="success"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                        <atom:TextBlock Text="{gallery:AvatarShowCaseLangResource PageSubtitle}"
                                        FontSize="15"
                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                        <atom:TextBlock Text="{gallery:AvatarShowCaseLangResource PageDescription}"
                                        HorizontalAlignment="Left"
                                        TextWrapping="Wrap"
                                        Foreground="{atom:SharedTokenResource ColorTextTertiary}" />
                    </StackPanel>

                    <Border Background="{atom:SharedTokenResource ColorBgContainer}"
                            BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinHeight="48"
                            Padding="16,8">
                        <Border.Styles>
                            <Style Selector="atom|TextBlock.info-label">
                                <Setter Property="Width" Value="84" />
                            </Style>
                            <Style Selector="atom|TextBlock.info-value">
                                <Setter Property="Width" Value="200" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </Border.Styles>
                        <WrapPanel Orientation="Horizontal"
                                   ItemSpacing="48"
                                   LineSpacing="8"
                                   VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:AvatarShowCaseLangResource InfoNamespaceLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:AvatarShowCaseLangResource InfoPackageLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:AvatarShowCaseLangResource InfoBaseClassLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="Avatar"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </gallery:GalleryStickyTabsHost.Header>

            <gallery:GalleryStickyTabsHost.StickyContent>
                <atom:TabStrip Name="ScenarioTabs"
                               SizeType="Large"
                               SelectedIndex="0">
                    <atom:TabStripItem Content="{gallery:AvatarShowCaseLangResource ScenarioExamples}"
                                       Tag="Examples"
                                       IsSelected="True" />
                    <atom:TabStripItem Content="{gallery:AvatarShowCaseLangResource ScenarioApi}"
                                       Tag="Api" />
                    <atom:TabStripItem Content="{gallery:AvatarShowCaseLangResource ScenarioDesignToken}"
                                       Tag="DesignToken" />
                </atom:TabStrip>
            </gallery:GalleryStickyTabsHost.StickyContent>

            <ContentControl Name="ScenarioContentHost">
                <gallery:ShowCasePanel Name="ExamplesContent"
                                       IsScrollEnabled="False"
                                       ContentMargin="28,10,28,0">
                    <gallery:ShowCasePanel.Styles>
                        <Style Selector="atom|Avatar">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </gallery:ShowCasePanel.Styles>
        <gallery:ShowCaseItem Title="{gallery:AvatarShowCaseLangResource BasicTitle}"
                                      Description="{gallery:AvatarShowCaseLangResource BasicDescription}">
            <StackPanel Orientation="Vertical" Spacing="20">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <atom:Avatar Icon="{antdicons:AntDesignIconProvider UserOutlined}" Size="64" />
                    <atom:Avatar Icon="{antdicons:AntDesignIconProvider UserOutlined}" SizeType="Large" />
                    <atom:Avatar Icon="{antdicons:AntDesignIconProvider UserOutlined}" />
                    <atom:Avatar Icon="{antdicons:AntDesignIconProvider UserOutlined}" SizeType="Small" />
                    <atom:Avatar Icon="{antdicons:AntDesignIconProvider UserOutlined}" Size="14" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <atom:Avatar Shape="Square" Icon="{antdicons:AntDesignIconProvider UserOutlined}" Size="64" />
                    <atom:Avatar Shape="Square" Icon="{antdicons:AntDesignIconProvider UserOutlined}" SizeType="Large" />
                    <atom:Avatar Shape="Square" Icon="{antdicons:AntDesignIconProvider UserOutlined}" />
                    <atom:Avatar Shape="Square" Icon="{antdicons:AntDesignIconProvider UserOutlined}" SizeType="Small" />
                    <atom:Avatar Shape="Square" Icon="{antdicons:AntDesignIconProvider UserOutlined}" Size="14" />
                </StackPanel>
            </StackPanel>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem Title="{gallery:AvatarShowCaseLangResource TypeTitle}"
                                      Description="{gallery:AvatarShowCaseLangResource TypeDescription}">
            <StackPanel Orientation="Vertical" Spacing="20">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <atom:Avatar Icon="{antdicons:AntDesignIconProvider UserOutlined}" />
                    <atom:Avatar Text="{gallery:AvatarShowCaseLangResource P2ContentU}" />
                    <atom:Avatar Size="40" Text="{gallery:AvatarShowCaseLangResource P2ContentUser}" />
                    <atom:Avatar Src="avares://AtomUIGallery/Assets/AvatarShowCase/AntDesign.svg" />
                    <atom:Avatar Background="#fde3cf" Foreground="#f56a00" Text="{gallery:AvatarShowCaseLangResource P2ContentU}" />
                    <atom:Avatar Background="#87d068" Icon="{antdicons:AntDesignIconProvider UserOutlined}" />
                </StackPanel>
            </StackPanel>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem Title="{gallery:AvatarShowCaseLangResource AutoSetFontSizeTitle}"
                                      Description="{gallery:AvatarShowCaseLangResource AutoSetFontSizeDescription}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <atom:Avatar Background="{Binding AvatarBackground}"
                             Gap="{Binding AvatarGap}"
                             SizeType="Large"
                             Text="{Binding AvatarText}"/>
                <atom:Button Name="ChangeUserButton"
                             ButtonType="Default"
                             SizeType="Small"
                             VerticalAlignment="Center" Content="{gallery:AvatarShowCaseLangResource P2ContentChangeuser}" />
                <atom:Button Name="ChangeGapButton"
                             ButtonType="Default"
                             SizeType="Small"
                             VerticalAlignment="Center" Content="{gallery:AvatarShowCaseLangResource P2ContentChangegap}" />
            </StackPanel>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem Title="{gallery:AvatarShowCaseLangResource AvatarGroupTitle}"
                                      Description="{gallery:AvatarShowCaseLangResource AvatarGroupDescription}">
            <StackPanel Orientation="Vertical" Spacing="20">
                <atom:AvatarGroup>
                    <atom:Avatar Src="avares://AtomUIGallery/Assets/AvatarShowCase/PeopleAvatar1.svg"/>
                    <atom:Avatar Background="#f56a00" Text="{gallery:AvatarShowCaseLangResource P2ContentK}" />
                    <atom:Avatar Background="#87d068" Icon="{antdicons:AntDesignIconProvider UserOutlined}" />
                    <atom:Avatar Icon="{antdicons:AntDesignIconProvider AntDesignOutlined}" Background="#1677ff"/>
                </atom:AvatarGroup>
                <atom:Separator/>
                <atom:AvatarGroup MaxDisplayCount="2"
                                  FoldInfoAvatarForeground="#f56a00"
                                  FoldInfoAvatarBackground="#fde3cf">
                    <atom:Avatar Src="avares://AtomUIGallery/Assets/AvatarShowCase/PeopleAvatar2.svg"/>
                    <atom:Avatar Background="#f56a00" Text="{gallery:AvatarShowCaseLangResource P2ContentK}" />
                    <atom:Avatar Background="#87d068" Icon="{antdicons:AntDesignIconProvider UserOutlined}" />
                    <atom:Avatar Icon="{antdicons:AntDesignIconProvider AntDesignOutlined}" Background="#1677ff"/>
                </atom:AvatarGroup>
                <atom:Separator/>
                <atom:AvatarGroup MaxDisplayCount="2"
                                  FoldInfoAvatarForeground="#f56a00"
                                  FoldInfoAvatarBackground="#fde3cf"
                                  SizeType="Large">
                    <atom:Avatar Src="avares://AtomUIGallery/Assets/AvatarShowCase/PeopleAvatar3.svg"/>
                    <atom:Avatar Background="#f56a00" Text="{gallery:AvatarShowCaseLangResource P2ContentK}" />
                    <atom:Avatar Background="#87d068" Icon="{antdicons:AntDesignIconProvider UserOutlined}" />
                    <atom:Avatar Icon="{antdicons:AntDesignIconProvider AntDesignOutlined}" Background="#1677ff"/>
                </atom:AvatarGroup>
                <atom:Separator/>
                <atom:AvatarGroup MaxDisplayCount="2"
                                  FoldInfoAvatarForeground="#f56a00"
                                  FoldInfoAvatarBackground="#fde3cf"
                                  SizeType="Large"
                                  FoldAvatarFlyoutTriggerType="Click">
                    <atom:Avatar BitmapSrc="avares://AtomUIGallery/Assets/AvatarShowCase/PeopleAvatar4.png"/>
                    <atom:Avatar Background="#f56a00" Text="{gallery:AvatarShowCaseLangResource P2ContentK}" />
                    <atom:Avatar Background="#87d068" Icon="{antdicons:AntDesignIconProvider UserOutlined}" />
                    <atom:Avatar Icon="{antdicons:AntDesignIconProvider AntDesignOutlined}" Background="#1677ff"/>
                </atom:AvatarGroup>
                <atom:Separator/>
                <atom:AvatarGroup Shape="Square">
                    <atom:Avatar Background="#fde3cf" Text="{gallery:AvatarShowCaseLangResource P2ContentA}" />
                    <atom:Avatar Background="#f56a00" Text="{gallery:AvatarShowCaseLangResource P2ContentK}" />
                    <atom:Avatar Background="#87d068" Icon="{antdicons:AntDesignIconProvider UserOutlined}" />
                    <atom:Avatar Icon="{antdicons:AntDesignIconProvider AntDesignOutlined}" Background="#1677ff"/>
                </atom:AvatarGroup>
            </StackPanel>
        </gallery:ShowCaseItem>
                </gallery:ShowCasePanel>
            </ContentControl>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
