<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Avatar.AvatarShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Avatar"
             x:DataType="vm:AvatarViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Avatar"
                    Category="{gallery:AvatarShowCaseLangResource ComponentCategory}"
                    Status="{gallery:AvatarShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:AvatarShowCaseLangResource PageSubtitle}"
                    Description="{gallery:AvatarShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="Avatar" />
            </gallery:GalleryStickyTabsHost.Header>


            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
                <gallery:ShowCasePanel.Styles>
                    <Style Selector="atom|Avatar">
                        <Setter Property="VerticalAlignment" Value="Center"/>
                    </Style>
                </gallery:ShowCasePanel.Styles>
    <gallery:ShowCaseItem Title="{gallery:AvatarShowCaseLangResource BasicTitle}"
                                  Description="{gallery:AvatarShowCaseLangResource BasicDescription}"
                                  IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:AvatarViewModel">
        <StackPanel Orientation="Vertical" Spacing="20">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <atom:Avatar Icon="{antdicons:AntDesignIconProvider UserOutlined}" Size="64" />
                <atom:Avatar Icon="{antdicons:AntDesignIconProvider UserOutlined}" SizeType="Large" />
                <atom:Avatar Icon="{antdicons:AntDesignIconProvider UserOutlined}" />
                <atom:Avatar Icon="{antdicons:AntDesignIconProvider UserOutlined}" SizeType="Small" />
                <atom:Avatar Icon="{antdicons:AntDesignIconProvider UserOutlined}" Size="14" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="10">
                <atom:Avatar Shape="Square" Icon="{antdicons:AntDesignIconProvider UserOutlined}" Size="64" />
                <atom:Avatar Shape="Square" Icon="{antdicons:AntDesignIconProvider UserOutlined}" SizeType="Large" />
                <atom:Avatar Shape="Square" Icon="{antdicons:AntDesignIconProvider UserOutlined}" />
                <atom:Avatar Shape="Square" Icon="{antdicons:AntDesignIconProvider UserOutlined}" SizeType="Small" />
                <atom:Avatar Shape="Square" Icon="{antdicons:AntDesignIconProvider UserOutlined}" Size="14" />
            </StackPanel>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem Title="{gallery:AvatarShowCaseLangResource TypeTitle}"
                                  Description="{gallery:AvatarShowCaseLangResource TypeDescription}"
                                  IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:AvatarViewModel">
        <StackPanel Orientation="Vertical" Spacing="20">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <atom:Avatar Icon="{antdicons:AntDesignIconProvider UserOutlined}" />
                <atom:Avatar Text="{gallery:AvatarShowCaseLangResource P2ContentU}" />
                <atom:Avatar Size="40" Text="{gallery:AvatarShowCaseLangResource P2ContentUser}" />
                <atom:Avatar Source="avares://AtomUIGallery/Assets/AvatarShowCase/AntDesign.svg" />
                <atom:Avatar Background="#fde3cf" Foreground="#f56a00" Text="{gallery:AvatarShowCaseLangResource P2ContentU}" />
                <atom:Avatar Background="#87d068" Icon="{antdicons:AntDesignIconProvider UserOutlined}" />
            </StackPanel>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem Title="{gallery:AvatarShowCaseLangResource NetworkImageTitle}"
                                  Description="{gallery:AvatarShowCaseLangResource NetworkImageDescription}"
                                  IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:AvatarViewModel">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <atom:Avatar Size="64"
                         Source="https://api.dicebear.com/7.x/miniavs/png?seed=1&amp;size=128"
                         FallbackSource="avares://AtomUIGallery/Assets/AvatarShowCase/AntDesign.svg" />
            <atom:Avatar SizeType="Large"
                         Source="https://api.dicebear.com/7.x/miniavs/png?seed=2&amp;size=128"
                         FallbackSource="avares://AtomUIGallery/Assets/AvatarShowCase/AntDesign.svg" />
            <atom:Avatar Source="https://api.dicebear.com/7.x/miniavs/png?seed=3&amp;size=128"
                         FallbackSource="avares://AtomUIGallery/Assets/AvatarShowCase/AntDesign.svg" />
            <atom:Avatar Shape="Square"
                         Source="https://api.dicebear.com/7.x/miniavs/png?seed=4&amp;size=128"
                         FallbackSource="avares://AtomUIGallery/Assets/AvatarShowCase/AntDesign.svg" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem Title="{gallery:AvatarShowCaseLangResource AutoSetFontSizeTitle}"
                                  Description="{gallery:AvatarShowCaseLangResource AutoSetFontSizeDescription}"
                                  IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:AvatarViewModel">
        <StackPanel Orientation="Horizontal" Spacing="10">
            <atom:Avatar Background="{Binding AvatarBackground}"
                         Gap="{Binding AvatarGap}"
                         SizeType="Large"
                         Text="{Binding AvatarText}"/>
            <atom:Button Name="ChangeUserButton"
                         ButtonType="Default"
                         SizeType="Small"
                         Command="{Binding ChangeUserCommand}"
                         VerticalAlignment="Center" Content="{gallery:AvatarShowCaseLangResource P2ContentChangeuser}" />
            <atom:Button Name="ChangeGapButton"
                         ButtonType="Default"
                         SizeType="Small"
                         Command="{Binding ChangeGapCommand}"
                         VerticalAlignment="Center" Content="{gallery:AvatarShowCaseLangResource P2ContentChangegap}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem Title="{gallery:AvatarShowCaseLangResource AvatarGroupTitle}"
                                  Description="{gallery:AvatarShowCaseLangResource AvatarGroupDescription}"
                                  IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:AvatarViewModel">
        <StackPanel Orientation="Vertical" Spacing="20">
            <atom:AvatarGroup>
                <atom:Avatar Source="avares://AtomUIGallery/Assets/AvatarShowCase/PeopleAvatar1.svg"/>
                <atom:Avatar Background="#f56a00" Text="{gallery:AvatarShowCaseLangResource P2ContentK}" />
                <atom:Avatar Background="#87d068" Icon="{antdicons:AntDesignIconProvider UserOutlined}" />
                <atom:Avatar Icon="{antdicons:AntDesignIconProvider AntDesignOutlined}" Background="#1677ff"/>
            </atom:AvatarGroup>
            <atom:Separator/>
            <atom:AvatarGroup MaxDisplayCount="2"
                              FoldInfoAvatarForeground="#f56a00"
                              FoldInfoAvatarBackground="#fde3cf">
                <atom:Avatar Source="avares://AtomUIGallery/Assets/AvatarShowCase/PeopleAvatar2.svg"/>
                <atom:Avatar Background="#f56a00" Text="{gallery:AvatarShowCaseLangResource P2ContentK}" />
                <atom:Avatar Background="#87d068" Icon="{antdicons:AntDesignIconProvider UserOutlined}" />
                <atom:Avatar Icon="{antdicons:AntDesignIconProvider AntDesignOutlined}" Background="#1677ff"/>
            </atom:AvatarGroup>
            <atom:Separator/>
            <atom:AvatarGroup MaxDisplayCount="2"
                              FoldInfoAvatarForeground="#f56a00"
                              FoldInfoAvatarBackground="#fde3cf"
                              SizeType="Large">
                <atom:Avatar Source="avares://AtomUIGallery/Assets/AvatarShowCase/PeopleAvatar3.svg"/>
                <atom:Avatar Background="#f56a00" Text="{gallery:AvatarShowCaseLangResource P2ContentK}" />
                <atom:Avatar Background="#87d068" Icon="{antdicons:AntDesignIconProvider UserOutlined}" />
                <atom:Avatar Icon="{antdicons:AntDesignIconProvider AntDesignOutlined}" Background="#1677ff"/>
            </atom:AvatarGroup>
            <atom:Separator/>
            <atom:AvatarGroup MaxDisplayCount="2"
                              FoldInfoAvatarForeground="#f56a00"
                              FoldInfoAvatarBackground="#fde3cf"
                              SizeType="Large"
                              FoldAvatarFlyoutTriggerType="Click">
                <atom:Avatar Source="avares://AtomUIGallery/Assets/AvatarShowCase/PeopleAvatar4.png"/>
                <atom:Avatar Background="#f56a00" Text="{gallery:AvatarShowCaseLangResource P2ContentK}" />
                <atom:Avatar Background="#87d068" Icon="{antdicons:AntDesignIconProvider UserOutlined}" />
                <atom:Avatar Icon="{antdicons:AntDesignIconProvider AntDesignOutlined}" Background="#1677ff"/>
            </atom:AvatarGroup>
            <atom:Separator/>
            <atom:AvatarGroup Shape="Square">
                <atom:Avatar Background="#fde3cf" Text="{gallery:AvatarShowCaseLangResource P2ContentA}" />
                <atom:Avatar Background="#f56a00" Text="{gallery:AvatarShowCaseLangResource P2ContentK}" />
                <atom:Avatar Background="#87d068" Icon="{antdicons:AntDesignIconProvider UserOutlined}" />
                <atom:Avatar Icon="{antdicons:AntDesignIconProvider AntDesignOutlined}" Background="#1677ff"/>
            </atom:AvatarGroup>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
