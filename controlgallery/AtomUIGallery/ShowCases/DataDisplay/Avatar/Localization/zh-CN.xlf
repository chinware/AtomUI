    <unit id="PageDescription">
      <segment>
        <source>Avatar provides compact identity visuals for users, teams, and objects. It supports circle and square shapes, explicit sizes, automatic text scaling, and grouped overflow display.</source>
        <target state="translated">Avatar 用于在紧凑空间中展示身份信息。它支持圆形和方形、显式尺寸、文本自动缩放，以及头像组的折叠展示。</target>
      </segment>
    </unit>
    <unit id="PageSubtitle">
      <segment>
        <source>Represent people or entities with image, icon, or text avatars.</source>
        <target state="translated">使用图片、图标或文本头像表示用户、团队或对象。</target>
      </segment>
    </unit>
