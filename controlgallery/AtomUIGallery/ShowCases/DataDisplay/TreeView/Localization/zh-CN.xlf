  <file id="AtomUIGallery.Localization.TreeViewShowCaseLangResourceKind">
    <unit id="1" name="ComponentCategory">
      <segment>
        <source>Data Display</source>
        <target state="translated">数据展示</target>
      </segment>
    </unit>
    <unit id="2" name="ComponentStatusStable">
      <segment>
        <source>Stable</source>
        <target state="translated">稳定</target>
      </segment>
    </unit>
    <unit id="3" name="PageSubtitle">
      <segment>
        <source>Display hierarchical data with selectable, checkable, searchable, draggable, and async-loaded nodes.</source>
        <target state="translated">展示层级数据，支持选择、勾选、搜索、拖拽和异步加载节点。</target>
      </segment>
    </unit>
    <unit id="4" name="PageDescription">
      <segment>
        <source>TreeView organizes nested data into expandable nodes and supports templated data sources, checkbox selection, filtering, custom switcher icons, context menus, and lazy child loading.</source>
        <target state="translated">TreeView 将嵌套数据组织为可展开节点，并支持模板化数据源、复选选择、过滤、自定义展开图标、上下文菜单和懒加载子节点。</target>
      </segment>
    </unit>
    <unit id="5" name="ScenarioExamples">
      <segment>
        <source>Examples</source>
        <target state="translated">示例</target>
      </segment>
    </unit>
    <unit id="6" name="BasicTitle">
      <segment>
        <source>Basic</source>
        <target state="translated">基础用法</target>
      </segment>
    </unit>
    <unit id="7" name="BasicDescription">
      <segment>
        <source>The most basic usage, tell you how to use checkable, selectable, disabled, defaultExpandKeys, and etc.</source>
        <target state="translated">最基础的用法，展示如何使用 checkable、selectable、disabled、defaultExpandKeys 等属性。</target>
      </segment>
    </unit>
    <unit id="8" name="GenerateByTemplateTitle">
      <segment>
        <source>Generate by template</source>
        <target state="translated">使用模板生成</target>
      </segment>
    </unit>
    <unit id="9" name="GenerateByTemplateDescription">
      <segment>
        <source>You can use the Template mechanism to generate tree nodes</source>
        <target state="translated">可以使用 Template 机制生成树节点。</target>
      </segment>
    </unit>
    <unit id="10" name="SelectionBindingTitle">
      <segment>
        <source>SelectedItem binding</source>
        <target state="translated">SelectedItem 绑定</target>
      </segment>
    </unit>
    <unit id="11" name="SelectionBindingDescription">
      <segment>
        <source>Bind SelectedItem to a node object instance, then click a node or action button to watch the bound value update.</source>
        <target state="translated">将 SelectedItem 绑定到节点对象实例，点击节点或操作按钮即可观察绑定值同步更新。</target>
      </segment>
    </unit>
    <unit id="12" name="SelectionItemsBindingTitle">
      <segment>
        <source>SelectedItems binding</source>
        <target state="translated">SelectedItems 绑定</target>
      </segment>
    </unit>
    <unit id="13" name="SelectionItemsBindingDescription">
      <segment>
        <source>Bind SelectedItems to node object instances, then click nodes or action buttons to watch the selected collection update.</source>
        <target state="translated">将 SelectedItems 绑定到节点对象实例集合，点击节点或操作按钮即可观察选中集合同步更新。</target>
      </segment>
    </unit>
    <unit id="14" name="SelectionBindingValueTitle">
      <segment>
        <source>Bound value</source>
        <target state="translated">绑定值</target>
      </segment>
    </unit>
