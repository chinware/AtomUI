        <target state="translated">自定义空状态</target>
      </segment>
    </unit>
    <unit id="36" name="EmptyIndicatorDescription">
      <segment>
        <source>Use EmptyIndicator to replace the default TreeView empty content.</source>
        <target state="translated">使用 EmptyIndicator 替换 TreeView 的默认空状态内容。</target>
