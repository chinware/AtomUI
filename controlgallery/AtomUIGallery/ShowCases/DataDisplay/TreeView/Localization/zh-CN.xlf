        <source>Context menu</source>
        <target state="translated">上下文菜单</target>
      </segment>
    </unit>
    <unit id="34" name="ContextMenuDescription">
      <segment>
        <source>Right-click any node to open a context menu. Toggle IsSelectOnRightClick to switch between following the right-clicked node (default) and keeping the existing selection untouched.</source>
        <target state="translated">右键任意节点可打开上下文菜单。切换 IsSelectOnRightClick 可在跟随右键节点（默认）和保持现有选择不变之间切换。</target>
      </segment>
    </unit>
    <unit id="35" name="EmptyIndicatorTitle">
