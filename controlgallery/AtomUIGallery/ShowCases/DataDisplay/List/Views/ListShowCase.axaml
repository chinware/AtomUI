<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AtomUIGallery.ShowCases.List"
             x:Class="AtomUIGallery.ShowCases.List.ListShowCase"
             x:DataType="vm:ListViewModel"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <StackPanel Margin="28,24,28,18"
                            Spacing="16">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <atom:TextBlock Text="List"
                                            FontSize="26"
                                            FontWeight="Bold"
                                            VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:ListShowCaseLangResource ComponentCategory}"
                                      TagColor="blue"
                                      VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:ListShowCaseLangResource ComponentStatusStable}"
                                      TagColor="success"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                        <atom:TextBlock Text="{gallery:ListShowCaseLangResource PageSubtitle}"
                                        FontSize="15"
                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                        <atom:TextBlock Text="{gallery:ListShowCaseLangResource PageDescription}"
                                        HorizontalAlignment="Left"
                                        TextWrapping="Wrap"
                                        Foreground="{atom:SharedTokenResource ColorTextTertiary}" />
                    </StackPanel>

                    <Border Background="{atom:SharedTokenResource ColorBgContainer}"
                            BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinHeight="48"
                            Padding="16,8">
                        <Border.Styles>
                            <Style Selector="atom|TextBlock.info-label">
                                <Setter Property="Width" Value="84" />
                            </Style>
                            <Style Selector="atom|TextBlock.info-value">
                                <Setter Property="Width" Value="200" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </Border.Styles>
                        <WrapPanel Orientation="Horizontal"
                                   ItemSpacing="48"
                                   LineSpacing="8"
                                   VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:ListShowCaseLangResource InfoNamespaceLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:ListShowCaseLangResource InfoPackageLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:ListShowCaseLangResource InfoBaseClassLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="ItemsControl"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </gallery:GalleryStickyTabsHost.Header>

            <gallery:GalleryStickyTabsHost.StickyContent>
                <atom:TabStrip Name="ScenarioTabs"
                               SizeType="Large"
                               SelectedIndex="0">
                    <atom:TabStripItem Content="{gallery:ListShowCaseLangResource ScenarioExamples}"
                                       Tag="Examples"
                                       IsSelected="True" />
                    <atom:TabStripItem Content="{gallery:ListShowCaseLangResource ScenarioApi}"
                                       Tag="Api" />
                    <atom:TabStripItem Content="{gallery:ListShowCaseLangResource ScenarioDesignToken}"
                                       Tag="DesignToken" />
                </atom:TabStrip>
            </gallery:GalleryStickyTabsHost.StickyContent>

            <ContentControl Name="ScenarioContentHost">
                <gallery:ShowCasePanel Name="ExamplesContent"
                                       IsScrollEnabled="False"
                                       ContentMargin="28,10,28,28">
                    <gallery:ShowCaseItem
                        Title="{gallery:ListShowCaseLangResource BasicUsageTitle}"
                        Description="{gallery:ListShowCaseLangResource BasicUsageDescription}">
                        <atom:ListView ItemsSource="{Binding ListItems}" />
                    </gallery:ShowCaseItem>

                    <gallery:ShowCaseItem
                        Title="{gallery:ListShowCaseLangResource SelectionTitle}"
                        Description="{gallery:ListShowCaseLangResource SelectionDescription}">
                        <StackPanel Spacing="20">
                            <StackPanel Orientation="Horizontal" Spacing="5" DockPanel.Dock="Top">
                                <atom:TextBlock VerticalAlignment="Center" Text="{gallery:ListShowCaseLangResource P2TextSelectionMode}" />
                                <atom:OptionButtonGroup ButtonStyle="Solid" OptionCheckedChanged="HandleSelectionModeOptionCheckedChanged">
                                    <atom:OptionButton IsChecked="True" Tag="{x:Static SelectionMode.Single}" Content="{gallery:ListShowCaseLangResource P2ContentSingle}" />
                                    <atom:OptionButton Tag="{x:Static SelectionMode.Multiple}" Content="{gallery:ListShowCaseLangResource P2ContentMultiple}" />
                                    <atom:OptionButton Tag="{x:Static SelectionMode.Toggle}" Content="{gallery:ListShowCaseLangResource P2ContentToggle}" />
                                </atom:OptionButtonGroup>
                            </StackPanel>
                            <atom:ListView SelectionMode="{Binding SelectionMode}"
                                           ItemsSource="{Binding SelectionListItems}"
                                           IsShowSelectedIndicator="True" />
                        </StackPanel>
                    </gallery:ShowCaseItem>

                    <gallery:ShowCaseItem
                        Title="{gallery:ListShowCaseLangResource GroupTitle}"
                        Description="{gallery:ListShowCaseLangResource GroupDescription}">
                        <atom:ListView ItemsSource="{Binding GroupListItems}"
                                       IsGroupEnabled="True"
                                       Height="300" />
                    </gallery:ShowCaseItem>

                    <gallery:ShowCaseItem
                        Title="{gallery:ListShowCaseLangResource ItemDisabledTitle}"
                        Description="{gallery:ListShowCaseLangResource ItemDisabledDescription}">
                        <atom:ListView ItemsSource="{Binding ListItemsWidthDisabled}" />
                    </gallery:ShowCaseItem>

                    <gallery:ShowCaseItem
                        Title="{gallery:ListShowCaseLangResource EmptyTitle}"
                        Description="{gallery:ListShowCaseLangResource EmptyDescription}">
                        <StackPanel Spacing="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <atom:Button Content="{gallery:ListShowCaseLangResource P2ContentAddItem}"
                                             Click="HandleAddEmptyItemClicked" />
                                <atom:Button Content="{gallery:ListShowCaseLangResource P2ContentRemoveItem}"
                                             Click="HandleRemoveEmptyItemClicked" />
                            </StackPanel>
                            <atom:ListView
                                ItemsSource="{Binding EmptyDemoItems}"
                                IsShowEmptyIndicator="True"
                                IsGroupEnabled="False" />
                        </StackPanel>
                    </gallery:ShowCaseItem>

                    <gallery:ShowCaseItem
                        Title="{gallery:ListShowCaseLangResource FilterTitle}"
                        Description="{gallery:ListShowCaseLangResource FilterDescription}">
                        <atom:ListView Name="FilteredList"
                                       ItemsSource="{Binding FilteredGroupListItems}"
                                       IsGroupEnabled="False"
                                       Filter="{atom:ValueFilterProvider Contains}"
                                       FilterValue="{gallery:ListShowCaseLangResource P2FilterValue}"/>
                    </gallery:ShowCaseItem>

                    <gallery:ShowCaseItem
                        Title="{gallery:ListShowCaseLangResource OrderedTitle}"
                        Description="{gallery:ListShowCaseLangResource OrderedDescription}">
                        <atom:ListView Name="OrderedList"
                                       ItemsSource="{Binding OrderedGroupListItems}"
                                       IsGroupEnabled="True" />
                    </gallery:ShowCaseItem>

                    <gallery:ShowCaseItem
                        Title="{gallery:ListShowCaseLangResource SimpleListBoxTitle}"
                        Description="{gallery:ListShowCaseLangResource SimpleListBoxDescription}">
                        <atom:ListBox>
                            <atom:ListBoxItem Content="{gallery:ListShowCaseLangResource P2ContentRacingCarSpraysBurningFuelIntoCrowd}" />
                            <atom:ListBoxItem Content="{gallery:ListShowCaseLangResource P2ContentJapanesePrincessToWedCommoner}" />
                            <atom:ListBoxItem Content="{gallery:ListShowCaseLangResource P2ContentAustralianWalksN100kmAfterOutbackCrash}" />
                            <atom:ListBoxItem Content="{gallery:ListShowCaseLangResource P2ContentManChargedOverMissingWeddingGirl}" />
                            <atom:ListBoxItem Content="{gallery:ListShowCaseLangResource P2ContentLosAngelesBattlesHugeWildfires}" />
                        </atom:ListBox>
                    </gallery:ShowCaseItem>

                    <gallery:ShowCaseItem
                        Title="{gallery:ListShowCaseLangResource SimpleListBoxItemsSourceTitle}"
                        Description="{gallery:ListShowCaseLangResource SimpleListBoxItemsSourceDescription}">
                        <atom:ListBox ItemsSource="{Binding BasicListBoxItems}"
                                      IsShowSelectedIndicator="True"/>
                    </gallery:ShowCaseItem>

                    <gallery:ShowCaseItem
                        Title="{gallery:ListShowCaseLangResource SearchableTitle}"
                        Description="{gallery:ListShowCaseLangResource SearchableDescription}">
                        <StackPanel Orientation="Vertical" Spacing="10">
                            <atom:SearchEdit PlaceholderText="{gallery:ListShowCaseLangResource P2PlaceholderTextSearch}"
                                             SearchButtonClick="HandleFilterListBoxClicked"/>
                            <atom:ListBox Name="SearchListBox">
                                <atom:ListBoxItem Content="{gallery:ListShowCaseLangResource P2ContentRacingCarSpraysBurningFuelIntoCrowd}" />
                                <atom:ListBoxItem Content="{gallery:ListShowCaseLangResource P2ContentJapanesePrincessToWedCommoner}" />
                                <atom:ListBoxItem Content="{gallery:ListShowCaseLangResource P2ContentAustralianWalksN100kmAfterOutbackCrash}" />
                                <atom:ListBoxItem Content="{gallery:ListShowCaseLangResource P2ContentManChargedOverMissingWeddingGirl}" />
                                <atom:ListBoxItem Content="{gallery:ListShowCaseLangResource P2ContentLosAngelesBattlesHugeWildfires}" />
                            </atom:ListBox>
                        </StackPanel>
                    </gallery:ShowCaseItem>

                    <gallery:ShowCaseItem
                        Title="{gallery:ListShowCaseLangResource PaginationListTitle}"
                        Description="{gallery:ListShowCaseLangResource PaginationListDescription}">
                        <atom:ListView
                            ItemsSource="{Binding PaginationListItems}"
                            PaginationVisibility="Bottom"
                            SelectionMode="Multiple"
                            Height="400"
                            PageSize="100">
                            <atom:ListView.BottomPagination>
                                <atom:Pagination />
                            </atom:ListView.BottomPagination>
                        </atom:ListView>
                    </gallery:ShowCaseItem>
                </gallery:ShowCasePanel>
            </ContentControl>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
