<atom:SplashWindow
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    xmlns:local="using:AtomUIGallery.ShowCases.Splash"
    x:Class="AtomUIGallery.ShowCases.Splash.GallerySplashWindow"
    x:ClassModifier="internal">
    <atom:SplashWindow.Splash>
        <local:GalleryWindowSplash />
    </atom:SplashWindow.Splash>
</atom:SplashWindow>
