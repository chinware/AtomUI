<atom:Splash
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:atom="https://atomui.net"
    x:Class="AtomUIGallery.ShowCases.Splash.GalleryWindowSplash"
    x:ClassModifier="internal"
    Classes="gallery-window-splash">
    <atom:Splash.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#0B1026" Offset="0" />
            <GradientStop Color="#1D39C4" Offset="0.48" />
            <GradientStop Color="#13C2C2" Offset="1" />
        </LinearGradientBrush>
    </atom:Splash.Background>

    <atom:Splash.Styles>
        <Style Selector="atom|Splash.gallery-window-splash /template/ atom|TextBlock#PART_TitleBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style Selector="atom|Splash.gallery-window-splash:loading /template/ atom|TextBlock#PART_MessageBlock">
            <Setter Property="Foreground" Value="#F5F8FF" />
        </Style>

        <Style Selector="atom|Splash.gallery-window-splash /template/ atom|TextBlock#PART_SubtitleBlock,
                         atom|Splash.gallery-window-splash /template/ atom|TextBlock#PART_DetailBlock">
            <Setter Property="Foreground" Value="#D6E4FF" />
        </Style>
    </atom:Splash.Styles>
</atom:Splash>
