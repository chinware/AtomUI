    </unit>
    <unit id="25" name="P2DetailError">
      <segment>
        <source>Use SetErrorAsync to surface a blocking startup error before closing.</source>
        <target state="translated">可通过 SetErrorAsync 在关闭前呈现阻塞型启动错误。</target>
      </segment>
    </unit>
