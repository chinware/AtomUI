  <file id="AtomUIGallery.Localization.SplashShowCaseLangResourceKind">
    <unit id="1" name="ScenarioExamples">
      <segment>
        <source>Examples</source>
        <target state="translated">示例</target>
      </segment>
    </unit>
    <unit id="2" name="ComponentCategory">
      <segment>
        <source>Other</source>
        <target state="translated">其他</target>
      </segment>
    </unit>
    <unit id="3" name="ComponentStatusPreview">
      <segment>
        <source>Preview</source>
        <target state="translated">预览</target>
      </segment>
    </unit>
    <unit id="4" name="ComponentIntroducedVersion">
      <segment>
        <source>v6.0.7</source>
        <target state="translated">v6.0.7</target>
      </segment>
    </unit>
    <unit id="5" name="PageSubtitle">
      <segment>
        <source>Present desktop startup progress before the main workspace is ready.</source>
        <target state="translated">在主工作区准备完成前呈现桌面启动进度。</target>
      </segment>
    </unit>
    <unit id="6" name="PageDescription">
      <segment>
        <source>Splash combines a compact branded surface, loading indicator, determinate progress, status copy, and optional footer. The service API can host it in a borderless startup window, while the visual control can be previewed directly in Gallery.</source>
        <target state="translated">Splash 组合紧凑的品牌面板、加载指示、确定进度、状态文案和可选页脚。服务 API 可将它托管在无边框启动窗口中，视觉控件也可以直接在 Gallery 中预览。</target>
      </segment>
    </unit>
    <unit id="7" name="BasicTitle">
      <segment>
        <source>Basic</source>
        <target state="translated">基础</target>
      </segment>
    </unit>
    <unit id="8" name="BasicDescription">
      <segment>
        <source>Use the visual Splash control to show startup copy with an indeterminate loading indicator.</source>
        <target state="translated">使用 Splash 视觉控件展示启动文案和不确定加载指示。</target>
      </segment>
    </unit>
    <unit id="9" name="DeterminateTitle">
      <segment>
        <source>Determinate progress</source>
        <target state="translated">确定进度</target>
      </segment>
    </unit>
    <unit id="10" name="DeterminateDescription">
      <segment>
        <source>Set Progress and disable IsIndeterminate when startup has measurable phases.</source>
        <target state="translated">当启动流程有可度量阶段时，设置 Progress 并关闭 IsIndeterminate。</target>
      </segment>
    </unit>
    <unit id="11" name="StatusTitle">
      <segment>
        <source>Status</source>
        <target state="translated">状态</target>
      </segment>
    </unit>
    <unit id="12" name="StatusDescription">
      <segment>
        <source>Switch Status to Success or Error when the startup flow reaches a terminal state.</source>
        <target state="translated">启动流程进入终态后，将 Status 切换为 Success 或 Error。</target>
      </segment>
    </unit>
    <unit id="13" name="ComposedTitle">
      <segment>
        <source>Logo, content and footer</source>
        <target state="translated">Logo、内容与页脚</target>
      </segment>
    </unit>
    <unit id="14" name="ComposedDescription">
      <segment>
        <source>Template the logo and footer when a product needs richer startup metadata.</source>
        <target state="translated">当产品需要更丰富的启动元信息时，可以模板化 Logo 和页脚。</target>
      </segment>
    </unit>
    <unit id="15" name="WindowServiceTitle">
      <segment>
        <source>Window service</source>
        <target state="translated">窗口服务</target>
      </segment>
    </unit>
    <unit id="16" name="WindowServiceDescription">
      <segment>
        <source>Open a real desktop Splash window, run a five-second mock startup flow, then close it automatically.</source>
        <target state="translated">打开真实桌面 Splash 窗口，运行 5 秒模拟启动流程，然后自动关闭。</target>
      </segment>
    </unit>
    <unit id="17" name="P2SubtitleDesktopBoot">
      <segment>
        <source>Desktop boot sequence</source>
        <target state="translated">桌面启动流程</target>
      </segment>
    </unit>
