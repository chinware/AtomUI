    <unit id="21" name="P2DetailProgress">
      <segment>
        <source>Theme, icons and route catalog are ready. Optional packages are being initialized.</source>
        <target state="translated">主题、图标和路由目录已就绪，正在初始化可选包。</target>
      </segment>
    </unit>
    <unit id="22" name="P2MessageReady">
      <segment>
        <source>Workspace ready</source>
        <target state="translated">工作区已就绪</target>
      </segment>
