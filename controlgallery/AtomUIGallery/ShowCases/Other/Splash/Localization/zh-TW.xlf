  <file id="AtomUIGallery.Localization.SplashShowCaseLangResourceKind">
    <unit id="ApiMethodSetProgress">
      <segment>
        <source>Updates progress, message and detail on the splash instance.</source>
        <target state="translated">更新 Splash 實例的進度、訊息和詳情。</target>
      </segment>
    </unit>
    <unit id="ApiOptionMinimumShowDuration">
      <segment>
        <source>Minimum display time before the splash window may close.</source>
        <target state="translated">Splash 視窗允許關閉前的最短展示時間。</target>
      </segment>
    </unit>
    <unit id="ApiServiceShowAsync">
      <segment>
        <source>Instance service API for applications that want dependency-injected startup flow control.</source>
        <target state="translated">實例服務 API，適用於希望透過依賴注入控制啟動流程的應用。</target>
      </segment>
    </unit>
    <unit id="ApiStaticShowAsync">
      <segment>
        <source>Static convenience API that delegates to Splash.DefaultService.</source>
        <target state="translated">靜態便捷 API，委託給 Splash.DefaultService。</target>
      </segment>
    </unit>
    <unit id="BasicDescription">
      <segment>
        <source>Use the visual Splash control to show startup copy with an indeterminate loading indicator.</source>
        <target state="translated">使用 Splash 視覺控件展示啟動文案和不確定載入指示。</target>
      </segment>
    </unit>
