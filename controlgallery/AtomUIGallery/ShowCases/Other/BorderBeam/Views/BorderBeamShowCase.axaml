<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.BorderBeam.BorderBeamShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.BorderBeam"
             x:DataType="vm:BorderBeamViewModel">
    <UserControl.Styles>
        <Style Selector="atom|BorderBeam.show-on-hover">
            <Setter Property="IsMotionEnabled" Value="False" />
        </Style>
        <Style Selector="atom|BorderBeam.show-on-hover:pointerover">
            <Setter Property="IsMotionEnabled" Value="True" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="BorderBeam"
                    Category="{gallery:BorderBeamShowCaseLangResource ComponentCategory}"
                    IntroducedVersion="{gallery:BorderBeamShowCaseLangResource ComponentIntroducedVersion}"
                    Subtitle="{gallery:BorderBeamShowCaseLangResource PageSubtitle}"
                    Description="{gallery:BorderBeamShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="ContentControl"
                    MetadataValueWidth="220" />
            </gallery:GalleryStickyTabsHost.Header>


            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
                <gallery:ShowCaseItem
                    SourceKey="border-beam-basic"
                    Title="{gallery:BorderBeamShowCaseLangResource BasicTitle}"
                    Description="{gallery:BorderBeamShowCaseLangResource BasicDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:BorderBeamViewModel">
                            <atom:BorderBeam Width="360"
                                             HorizontalAlignment="Left">
                                <atom:Card Header="Workspace overview"
                                           BorderThickness="1"
                                           CornerRadius="8">
                                    <Grid ColumnDefinitions="*,*,*"
                                          RowDefinitions="Auto,Auto"
                                          MinHeight="96">
                                        <atom:TextBlock Grid.Column="0"
                                                        Text="Users"
                                                        Foreground="{atom:SharedTokenResource ColorTextTertiary}" />
                                        <atom:TextBlock Grid.Column="1"
                                                        Text="Projects"
                                                        Foreground="{atom:SharedTokenResource ColorTextTertiary}" />
                                        <atom:TextBlock Grid.Column="2"
                                                        Text="Tasks"
                                                        Foreground="{atom:SharedTokenResource ColorTextTertiary}" />
                                        <atom:TextBlock Grid.Row="1"
                                                        Grid.Column="0"
                                                        Text="128"
                                                        FontSize="22"
                                                        FontWeight="Bold" />
                                        <atom:TextBlock Grid.Row="1"
                                                        Grid.Column="1"
                                                        Text="24"
                                                        FontSize="22"
                                                        FontWeight="Bold" />
                                        <atom:TextBlock Grid.Row="1"
                                                        Grid.Column="2"
                                                        Text="86"
                                                        FontSize="22"
                                                        FontWeight="Bold" />
                                    </Grid>
                                </atom:Card>
                            </atom:BorderBeam>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="border-beam-show-on-hover"
                    BadgeText="v6.1.8"
                    Title="{gallery:BorderBeamShowCaseLangResource ShowOnHoverTitle}"
                    Description="{gallery:BorderBeamShowCaseLangResource ShowOnHoverDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:BorderBeamViewModel">
                            <atom:BorderBeam Width="360"
                                             Classes="show-on-hover"
                                             HorizontalAlignment="Left">
                                <atom:Card Header="{gallery:BorderBeamShowCaseLangResource ShowOnHoverCardTitle}"
                                           BorderThickness="1"
                                           CornerRadius="8">
                                    <atom:TextBlock Text="{gallery:BorderBeamShowCaseLangResource ShowOnHoverCardDescription}"
                                                    TextWrapping="Wrap"
                                                    Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                                </atom:Card>
                            </atom:BorderBeam>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="border-beam-multiple-beams"
                    BadgeText="v6.1.8"
                    Title="{gallery:BorderBeamShowCaseLangResource MultipleBeamsTitle}"
                    Description="{gallery:BorderBeamShowCaseLangResource MultipleBeamsDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:BorderBeamViewModel">
                            <StackPanel Orientation="Vertical"
                                        Spacing="12"
                                        HorizontalAlignment="Left">
                                <atom:BorderBeam Width="360"
                                                 Count="3"
                                                 HorizontalAlignment="Left">
                                    <atom:Card Header="{gallery:BorderBeamShowCaseLangResource MultipleBeamsCardTitle}"
                                               BorderThickness="1"
                                               CornerRadius="8">
                                        <atom:TextBlock Text="{gallery:BorderBeamShowCaseLangResource MultipleBeamsCardDescription}"
                                                        TextWrapping="Wrap"
                                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                                    </atom:Card>
                                </atom:BorderBeam>
                                <atom:BorderBeam Width="360"
                                                 Count="2"
                                                 HorizontalAlignment="Left">
                                    <atom:Card Header="{gallery:BorderBeamShowCaseLangResource MultipleBeamsCardTitle}"
                                               BorderThickness="1"
                                               CornerRadius="8">
                                        <atom:TextBlock Text="{gallery:BorderBeamShowCaseLangResource MultipleBeamsCardDescription}"
                                                        TextWrapping="Wrap"
                                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                                    </atom:Card>
                                </atom:BorderBeam>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="border-beam-custom-container"
                    BadgeText="v6.1.8"
                    Title="{gallery:BorderBeamShowCaseLangResource CustomContainerTitle}"
                    Description="{gallery:BorderBeamShowCaseLangResource CustomContainerDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:BorderBeamViewModel">
                            <atom:BorderBeam Width="420"
                                             BorderThickness="1"
                                             CornerRadius="8"
                                             HorizontalAlignment="Left">
                                <Border MinHeight="160"
                                        Padding="24"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                                        Background="{atom:SharedTokenResource ColorBgContainer}">
                                    <atom:TextBlock Text="{gallery:BorderBeamShowCaseLangResource CustomContainerContent}"
                                                    TextWrapping="Wrap"
                                                    Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                                </Border>
                            </atom:BorderBeam>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="border-beam-non-uniform-radius"
                    Title="{gallery:BorderBeamShowCaseLangResource NonUniformRadiusTitle}"
                    Description="{gallery:BorderBeamShowCaseLangResource NonUniformRadiusDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:BorderBeamViewModel">
                            <atom:BorderBeam Width="360"
                                             Outset="0"
                                             BorderThickness="1"
                                             CornerRadius="20,20,0,0"
                                             HorizontalAlignment="Left">
                                <atom:PixelAlignedBorder ClipToBounds="True"
                                                         CornerRadius="20,20,0,0"
                                                         BorderThickness="1"
                                                         BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                                                         Background="{atom:SharedTokenResource ColorBgContainer}"
                                                         Padding="24">
                                    <StackPanel Spacing="8">
                                        <atom:TextBlock Text="Non-uniform radius"
                                                        FontWeight="Bold" />
                                        <atom:TextBlock Text="{gallery:BorderBeamShowCaseLangResource NonUniformRadiusCardDescription}"
                                                        TextWrapping="Wrap"
                                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                                    </StackPanel>
                                </atom:PixelAlignedBorder>
                            </atom:BorderBeam>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="border-beam-customized-color"
                    Title="{gallery:BorderBeamShowCaseLangResource CustomizedColorTitle}"
                    Description="{gallery:BorderBeamShowCaseLangResource CustomizedColorDescription}"
                    IsDeferredContentEnabled="True"
                    IsOccupyEntireRow="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:BorderBeamViewModel">
                            <StackPanel MaxWidth="480"
                                        Spacing="16"
                                        HorizontalAlignment="Stretch">
                                <atom:Segmented ItemsSource="{Binding ColorPresets}"
                                                SelectedItem="{Binding SelectedColorPreset}"
                                                HorizontalAlignment="Stretch" />
                                <atom:BorderBeam ColorStops="{Binding SelectedColorStops}"
                                                 HorizontalAlignment="Stretch">
                                    <atom:Card Header="{Binding SelectedColorPreset.Name}"
                                               BorderThickness="1"
                                               CornerRadius="8">
                                        <atom:Card.Extra>
                                            <atom:Tag Text="{Binding SelectedColorPreset.Usage}"
                                                      Variant="Filled" />
                                        </atom:Card.Extra>
                                        <StackPanel Spacing="16">
                                            <atom:TextBlock Text="{Binding SelectedColorPreset.Description}"
                                                            TextWrapping="Wrap"
                                                            Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                                            <ItemsControl ItemsSource="{Binding SelectedColorPreset.Stops}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel ItemSpacing="8"
                                                                   LineSpacing="8" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:BorderBeamColorPresetStop">
                                                        <atom:Tag TagColor="{Binding Color}"
                                                                  Text="{Binding Label}"
                                                                  Variant="Filled" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <atom:TextBlock Text="{gallery:BorderBeamShowCaseLangResource CustomizedColorCardDescription}"
                                                            TextWrapping="Wrap"
                                                            Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                                        </StackPanel>
                                    </atom:Card>
                                </atom:BorderBeam>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="border-beam-duration"
                    BadgeText="v6.1.8"
                    Title="{gallery:BorderBeamShowCaseLangResource DurationTitle}"
                    Description="{gallery:BorderBeamShowCaseLangResource DurationDescription}"
                    IsDeferredContentEnabled="True"
                    IsOccupyEntireRow="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:BorderBeamViewModel">
                            <WrapPanel MaxWidth="480"
                                       ItemSpacing="16"
                                       LineSpacing="16"
                                       HorizontalAlignment="Left">
                                <atom:BorderBeam Width="220"
                                                 Duration="0:0:3">
                                    <atom:Card Header="{gallery:BorderBeamShowCaseLangResource DurationFastCardTitle}"
                                               BorderThickness="1"
                                               CornerRadius="8">
                                        <atom:Card.Extra>
                                            <atom:Tag Text="3s"
                                                      Variant="Filled" />
                                        </atom:Card.Extra>
                                        <atom:TextBlock Text="{gallery:BorderBeamShowCaseLangResource DurationFastCardDescription}"
                                                        TextWrapping="Wrap"
                                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                                    </atom:Card>
                                </atom:BorderBeam>
                                <atom:BorderBeam Width="220"
                                                 Duration="0:0:6">
                                    <atom:Card Header="{gallery:BorderBeamShowCaseLangResource DurationDefaultCardTitle}"
                                               BorderThickness="1"
                                               CornerRadius="8">
                                        <atom:Card.Extra>
                                            <atom:Tag Text="6s"
                                                      Variant="Filled" />
                                        </atom:Card.Extra>
                                        <atom:TextBlock Text="{gallery:BorderBeamShowCaseLangResource DurationDefaultCardDescription}"
                                                        TextWrapping="Wrap"
                                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                                    </atom:Card>
                                </atom:BorderBeam>
                                <atom:BorderBeam Width="220"
                                                 Duration="0:0:12">
                                    <atom:Card Header="{gallery:BorderBeamShowCaseLangResource DurationSlowCardTitle}"
                                               BorderThickness="1"
                                               CornerRadius="8">
                                        <atom:Card.Extra>
                                            <atom:Tag Text="12s"
                                                      Variant="Filled" />
                                        </atom:Card.Extra>
                                        <atom:TextBlock Text="{gallery:BorderBeamShowCaseLangResource DurationSlowCardDescription}"
                                                        TextWrapping="Wrap"
                                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                                    </atom:Card>
                                </atom:BorderBeam>
                            </WrapPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="border-beam-size"
                    BadgeText="v6.1.8"
                    Title="{gallery:BorderBeamShowCaseLangResource SizeTitle}"
                    Description="{gallery:BorderBeamShowCaseLangResource SizeDescription}"
                    IsDeferredContentEnabled="True"
                    IsOccupyEntireRow="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:BorderBeamViewModel">
                            <Grid MaxWidth="960"
                                  ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="32"
                                  RowSpacing="32"
                                  HorizontalAlignment="Stretch">
                                <atom:BorderBeam Grid.Row="0"
                                                 Grid.Column="0"
                                                 HorizontalAlignment="Stretch">
                                    <atom:Card Header="{gallery:BorderBeamShowCaseLangResource SizeDefaultCardTitle}"
                                               BorderThickness="1"
                                               CornerRadius="8">
                                        <atom:Card.Extra>
                                            <atom:Tag Text="100px"
                                                      Variant="Filled" />
                                        </atom:Card.Extra>
                                        <Grid MinHeight="112">
                                            <atom:TextBlock Text="{gallery:BorderBeamShowCaseLangResource SizeDefaultCardDescription}"
                                                            TextWrapping="Wrap"
                                                            VerticalAlignment="Center"
                                                            Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                                        </Grid>
                                    </atom:Card>
                                </atom:BorderBeam>
                                <atom:BorderBeam Grid.Row="0"
                                                 Grid.Column="1"
                                                 BeamSize="56"
                                                 HorizontalAlignment="Stretch">
                                    <atom:Card Header="{gallery:BorderBeamShowCaseLangResource SizeCompactCardTitle}"
                                               BorderThickness="1"
                                               CornerRadius="8">
                                        <atom:Card.Extra>
                                            <atom:Tag Text="56px"
                                                      Variant="Filled" />
                                        </atom:Card.Extra>
                                        <Grid MinHeight="112">
                                            <atom:TextBlock Text="{gallery:BorderBeamShowCaseLangResource SizeCompactCardDescription}"
                                                            TextWrapping="Wrap"
                                                            VerticalAlignment="Center"
                                                            Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                                        </Grid>
                                    </atom:Card>
                                </atom:BorderBeam>
                                <atom:BorderBeam Grid.Row="1"
                                                 Grid.Column="0"
                                                 Grid.ColumnSpan="2"
                                                 BeamSize="160"
                                                 HorizontalAlignment="Stretch">
                                    <atom:Card Header="{gallery:BorderBeamShowCaseLangResource SizeExtendedCardTitle}"
                                               BorderThickness="1"
                                               CornerRadius="8">
                                        <atom:Card.Extra>
                                            <atom:Tag Text="160px"
                                                      Variant="Filled" />
                                        </atom:Card.Extra>
                                        <Grid MinHeight="192">
                                            <atom:TextBlock Text="{gallery:BorderBeamShowCaseLangResource SizeExtendedCardDescription}"
                                                            TextWrapping="Wrap"
                                                            VerticalAlignment="Center"
                                                            Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                                        </Grid>
                                    </atom:Card>
                                </atom:BorderBeam>
                            </Grid>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    SourceKey="border-beam-line-width"
                    BadgeText="v6.1.8"
                    Title="{gallery:BorderBeamShowCaseLangResource LineWidthTitle}"
                    Description="{gallery:BorderBeamShowCaseLangResource LineWidthDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:BorderBeamViewModel">
                            <atom:BorderBeam Width="360"
                                             BorderThickness="2"
                                             CornerRadius="8"
                                             HorizontalAlignment="Left">
                                <atom:Card Header="{gallery:BorderBeamShowCaseLangResource LineWidthCardTitle}"
                                           BorderThickness="2"
                                           CornerRadius="8">
                                    <atom:TextBlock Text="{gallery:BorderBeamShowCaseLangResource LineWidthCardDescription}"
                                                    TextWrapping="Wrap"
                                                    Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                                </atom:Card>
                            </atom:BorderBeam>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
