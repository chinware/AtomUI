  <file id="AtomUIGallery.Localization.ButtonShowCaseLangResourceKind">
    <unit id="1" name="ScenarioExamples">
      <segment>
        <source>Examples</source>
        <target state="translated">示例</target>
      </segment>
    </unit>
    <unit id="2" name="ComponentCategory">
      <segment>
        <source>General</source>
        <target state="translated">通用</target>
      </segment>
    </unit>
    <unit id="3" name="ComponentStatusStable">
      <segment>
        <source>Stable</source>
        <target state="translated">稳定</target>
      </segment>
    </unit>
    <unit id="4" name="PageSubtitle">
      <segment>
        <source>Trigger actions and express intent with clear visual priority.</source>
        <target state="translated">触发操作，并通过清晰的视觉层级表达操作意图。</target>
      </segment>
    </unit>
    <unit id="5" name="PageDescription">
      <segment>
        <source>Button is the primary action control in AtomUI. Use type, shape, size, icon and loading states to build predictable workflows without losing the Ant Design interaction model.</source>
        <target state="translated">Button 是 AtomUI 中最基础的动作控件。通过类型、形状、尺寸、图标和加载状态，可以构建可预期的操作流程，同时保持 Ant Design 的交互模型。</target>
      </segment>
    </unit>
    <unit id="6" name="ExampleGroupBasicTitle">
      <segment>
        <source>Button type</source>
        <target state="translated">按钮类型</target>
      </segment>
    </unit>
    <unit id="7" name="ExampleGroupBasicDescription">
      <segment>
        <source>Use button type to express action priority in the current region.</source>
        <target state="translated">通过按钮类型表达当前区域内操作的优先级。</target>
      </segment>
    </unit>
    <unit id="8" name="ExampleGroupShapeTitle">
      <segment>
        <source>Shape and icon</source>
        <target state="translated">形状与图标</target>
      </segment>
    </unit>
    <unit id="9" name="ExampleGroupShapeDescription">
      <segment>
        <source>Round, circle and icon buttons keep compact actions easy to recognize.</source>
        <target state="translated">圆角、圆形和图标按钮可以让紧凑操作更容易识别。</target>
      </segment>
    </unit>
    <unit id="10" name="ExampleGroupSizeTitle">
      <segment>
        <source>Size</source>
        <target state="translated">尺寸</target>
      </segment>
    </unit>
    <unit id="11" name="ExampleGroupSizeDescription">
      <segment>
        <source>Switch between large, middle and small sizes to match density requirements.</source>
        <target state="translated">在大号、默认和小号之间切换，以匹配不同信息密度。</target>
      </segment>
    </unit>
    <unit id="12" name="ExampleGroupStateTitle">
      <segment>
        <source>State</source>
        <target state="translated">状态</target>
      </segment>
    </unit>
    <unit id="13" name="ExampleGroupStateDescription">
      <segment>
        <source>Loading, disabled, danger and ghost states communicate availability and risk.</source>
        <target state="translated">加载、禁用、危险和幽灵状态用于表达可用性和风险。</target>
      </segment>
    </unit>
    <unit id="14" name="TypeTitle">
      <segment>
        <source>Type</source>
        <target state="translated">按钮类型</target>
      </segment>
    </unit>
    <unit id="15" name="TypeDescription">
      <segment>
        <source>There are primary button, default button, dashed button, text button and link button in antd.</source>
        <target state="translated">Ant Design 中包含主按钮、默认按钮、虚线按钮、文本按钮和链接按钮。</target>
      </segment>
    </unit>
    <unit id="16" name="ColorVariantTitle">
      <segment>
        <source>Color and variant</source>
        <target state="translated">颜色与变体</target>
      </segment>
    </unit>
    <unit id="17" name="ColorVariantDescription">
      <segment>
        <source>Combine semantic color with visual variant to create primary, danger and preset-color buttons.</source>
        <target state="translated">组合语义颜色和视觉变体，用于创建主要、危险和预设色按钮。</target>
      </segment>
    </unit>
    <unit id="18" name="GradientButtonTitle">
      <segment>
        <source>Gradient Button</source>
        <target state="translated">渐变按钮</target>
      </segment>
    </unit>
    <unit id="19" name="GradientButtonDescription">
      <segment>
        <source>Customize solid buttons with gradient backgrounds through CustomBackground.</source>
        <target state="translated">通过 CustomBackground 为实心按钮自定义渐变背景。</target>
      </segment>
    </unit>
    <unit id="20" name="ButtonShapeTitle">
      <segment>
        <source>Button Shape</source>
        <target state="translated">按钮形状</target>
      </segment>
    </unit>
    <unit id="21" name="ButtonShapeDescription">
      <segment>
        <source>Supported button shape display, such as primary, default, dashed and text, etc.</source>
        <target state="translated">展示支持的按钮形状，例如主按钮、默认按钮、虚线按钮和文本按钮等。</target>
      </segment>
    </unit>
    <unit id="22" name="SizeTitle">
      <segment>
        <source>Size</source>
        <target state="translated">按钮尺寸</target>
      </segment>
    </unit>
    <unit id="23" name="SizeDescription">
      <segment>
        <source>AtomUI supports three sizes of buttons: small, default and large. If a large or small button is desired, set the size property to either large or small respectively. Omit the size property for a button with the default size.</source>
        <target state="translated">AtomUI 支持小号、默认和大号三种按钮尺寸。需要大号或小号按钮时可设置 size 属性；省略 size 属性时使用默认尺寸。</target>
      </segment>
    </unit>
    <unit id="24" name="IconTitle">
      <segment>
        <source>Icon</source>
        <target state="translated">图标</target>
      </segment>
    </unit>
    <unit id="25" name="IconDescription">
      <segment>
        <source>You can add an icon through the Icon property and adjust the position of the icon using IconPlacement.</source>
        <target state="translated">可以通过 Icon 属性添加图标，并使用 IconPlacement 调整图标位置。</target>
      </segment>
    </unit>
    <unit id="26" name="IconPlacementTitle">
      <segment>
        <source>Button icon placement</source>
        <target state="translated">按钮图标位置</target>
      </segment>
    </unit>
    <unit id="27" name="IconPlacementDescription">
      <segment>
        <source>Set IconPlacement to Start or End to place the button icon before or after the content.</source>
        <target state="translated">通过设置 IconPlacement 为 Start 或 End 分别设置按钮图标的位置。</target>
      </segment>
    </unit>
    <unit id="28" name="LoadingTitle">
      <segment>
        <source>Loading</source>
        <target state="translated">加载状态</target>
      </segment>
    </unit>
    <unit id="29" name="LoadingDescription">
      <segment>
        <source>A loading indicator can be added to a button by setting the loading property on the Button.</source>
        <target state="translated">通过设置 Button 的 loading 属性，可以为按钮添加加载指示。</target>
      </segment>
    </unit>
    <unit id="30" name="BlockButtonTitle">
      <segment>
        <source>Block Button</source>
        <target state="translated">通栏按钮</target>
      </segment>
    </unit>
    <unit id="31" name="BlockButtonDescription">
      <segment>
        <source>block property will make the button fit to its parent width.</source>
        <target state="translated">block 属性会让按钮宽度适配父容器。</target>
      </segment>
    </unit>
    <unit id="32" name="DangerButtonsTitle">
      <segment>
        <source>Danger Buttons</source>
        <target state="translated">危险按钮</target>
      </segment>
    </unit>
    <unit id="33" name="DangerButtonsDescription">
      <segment>
        <source>danger is a property of button after antd 4.0.</source>
        <target state="translated">danger 是 Ant Design 4.0 之后提供的按钮属性。</target>
      </segment>
    </unit>
    <unit id="34" name="GhostButtonTitle">
      <segment>
        <source>Ghost Button</source>
        <target state="translated">幽灵按钮</target>
      </segment>
    </unit>
    <unit id="35" name="GhostButtonDescription">
      <segment>
        <source>ghost property will make button's background transparent, it is commonly used in colored background.</source>
        <target state="translated">ghost 属性会让按钮背景透明，通常用于有色背景上。</target>
      </segment>
    </unit>
    <unit id="36" name="DisabledTitle">
      <segment>
        <source>Disabled</source>
        <target state="translated">禁用状态</target>
      </segment>
    </unit>
    <unit id="37" name="DisabledDescription">
      <segment>
        <source>To mark a button as disabled, add the disabled property to the Button.</source>
        <target state="translated">为按钮添加 disabled 属性可以将按钮标记为禁用状态。</target>
      </segment>
    </unit>
