    <unit id="4" name="PageSubtitle">
      <segment>
        <source>Separate content sections with horizontal or vertical rules.</source>
        <target state="translated">用水平或垂直分割线分隔内容区块。</target>
      </segment>
    </unit>
    <unit id="5" name="PageDescription">
      <segment>
        <source>Separator creates visual rhythm between related sections, supports optional title text, plain text styling, vertical rules, line variants, and density sizes.</source>
        <target state="translated">Separator 用于建立内容之间的视觉节奏，支持标题文本、普通文本样式、垂直分割、线型变体和不同间距尺寸。</target>
      </segment>
    </unit>
    <unit id="6" name="HorizontalTitle">
      <segment>
        <source>Horizontal</source>
        <target state="translated">水平分割线</target>
      </segment>
    </unit>
    <unit id="7" name="HorizontalDescription">
      <segment>
        <source>A Separator is horizontal by default. You can add text within Separator.</source>
        <target state="translated">Separator 默认是水平分割线，可以在 Separator 中添加文本。</target>
      </segment>
    </unit>
    <unit id="8" name="DividerWithTitleTitle">
      <segment>
        <source>Divider with title</source>
        <target state="translated">带标题的分割线</target>
      </segment>
    </unit>
    <unit id="9" name="DividerWithTitleDescription">
      <segment>
        <source>Divider with inner title. Set orientation='left/right' to align it.</source>
        <target state="translated">带内部标题的分割线，可设置 orientation='left/right' 来对齐标题。</target>
      </segment>
    </unit>
    <unit id="10" name="PlainTextTitle">
      <segment>
        <source>Text without heading style</source>
        <target state="translated">无标题样式文本</target>
      </segment>
    </unit>
    <unit id="11" name="PlainTextDescription">
      <segment>
        <source>You can use non-heading style of divider text by setting the plain property.</source>
        <target state="translated">通过设置 plain 属性，可以使用非标题样式的分割线文本。</target>
      </segment>
    </unit>
    <unit id="12" name="SpacingSizeTitle">
      <segment>
        <source>Set the spacing size of the divider</source>
        <target state="translated">设置分割线间距</target>
      </segment>
    </unit>
    <unit id="13" name="SpacingSizeDescription">
      <segment>
        <source>The size of the spacing.</source>
        <target state="translated">设置间距大小。</target>
      </segment>
    </unit>
    <unit id="14" name="VerticalTitle">
      <segment>
        <source>Vertical</source>
        <target state="translated">垂直分割线</target>
      </segment>
    </unit>
    <unit id="15" name="VerticalDescription">
      <segment>
        <source>Use type='vertical' to make the divider vertical.</source>
        <target state="translated">使用 type='vertical' 可以让分割线垂直显示。</target>
      </segment>
    </unit>
    <unit id="16" name="VariantTitle">
      <segment>
        <source>Variant</source>
        <target state="translated">线型</target>
      </segment>
    </unit>
    <unit id="17" name="VariantDescription">
      <segment>
        <source>Divider uses the solid variant by default. You can change it to dashed or dotted.</source>
        <target state="translated">分割线默认使用实线样式，也可以改为虚线或点线。</target>
      </segment>
    </unit>
