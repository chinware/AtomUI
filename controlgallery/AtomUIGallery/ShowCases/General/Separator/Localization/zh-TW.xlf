  <file id="AtomUIGallery.Localization.SeparatorShowCaseLangResourceKind">
    <unit id="1" name="ScenarioExamples">
      <segment>
        <source>Examples</source>
        <target state="translated">示例</target>
      </segment>
    </unit>
    <unit id="2" name="ComponentCategory">
      <segment>
        <source>General</source>
        <target state="translated">通用</target>
      </segment>
    </unit>
    <unit id="3" name="ComponentStatusStable">
      <segment>
        <source>.NET 10</source>
        <target state="translated">.NET 10</target>
      </segment>
    </unit>
    <unit id="4" name="PageSubtitle">
      <segment>
        <source>Separate content sections with horizontal or vertical rules.</source>
        <target state="translated">用水平或垂直分割線分隔內容區塊。</target>
      </segment>
    </unit>
    <unit id="5" name="PageDescription">
      <segment>
        <source>Separator creates visual rhythm between related sections, supports optional title text, plain text styling, vertical rules, line variants, and density sizes.</source>
        <target state="translated">Separator 用於建立內容之間的視覺節奏，支持標題文本、普通文本樣式、垂直分割、線型變體和不同間距尺寸。</target>
      </segment>
    </unit>
    <unit id="6" name="HorizontalTitle">
      <segment>
        <source>Horizontal</source>
        <target state="translated">水平分割線</target>
      </segment>
    </unit>
    <unit id="7" name="HorizontalDescription">
      <segment>
        <source>A Separator is horizontal by default. You can add text within Separator.</source>
        <target state="translated">Separator 默認是水平分割線，可以在 Separator 中添加文本。</target>
      </segment>
    </unit>
    <unit id="8" name="DividerWithTitleTitle">
      <segment>
        <source>Divider with title</source>
        <target state="translated">帶標題的分割線</target>
      </segment>
    </unit>
    <unit id="9" name="DividerWithTitleDescription">
      <segment>
        <source>Divider with inner title. Set orientation='left/right' to align it.</source>
        <target state="translated">帶內部標題的分割線，可設置 orientation='left/right' 來對齊標題。</target>
      </segment>
    </unit>
    <unit id="10" name="PlainTextTitle">
      <segment>
        <source>Text without heading style</source>
        <target state="translated">無標題樣式文本</target>
      </segment>
    </unit>
    <unit id="11" name="PlainTextDescription">
      <segment>
        <source>You can use non-heading style of divider text by setting the plain property.</source>
        <target state="translated">通過設置 plain 屬性，可以使用非標題樣式的分割線文本。</target>
      </segment>
    </unit>
    <unit id="12" name="SpacingSizeTitle">
      <segment>
        <source>Set the spacing size of the divider</source>
        <target state="translated">設置分割線間距</target>
      </segment>
    </unit>
    <unit id="13" name="SpacingSizeDescription">
      <segment>
        <source>The size of the spacing.</source>
        <target state="translated">設置間距大小。</target>
      </segment>
    </unit>
    <unit id="14" name="VerticalTitle">
      <segment>
        <source>Vertical</source>
        <target state="translated">垂直分割線</target>
      </segment>
    </unit>
    <unit id="15" name="VerticalDescription">
      <segment>
        <source>Use type='vertical' to make the divider vertical.</source>
        <target state="translated">使用 type='vertical' 可以讓分割線垂直顯示。</target>
      </segment>
    </unit>
    <unit id="16" name="VariantTitle">
      <segment>
        <source>Variant</source>
        <target state="translated">線型</target>
      </segment>
    </unit>
    <unit id="17" name="VariantDescription">
      <segment>
        <source>Divider uses the solid variant by default. You can change it to dashed or dotted.</source>
        <target state="translated">分割線默認使用實線樣式，也可以改為虛線或點線。</target>
      </segment>
    </unit>
