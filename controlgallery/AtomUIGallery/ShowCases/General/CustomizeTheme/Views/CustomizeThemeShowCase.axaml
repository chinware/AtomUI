<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.CustomizeTheme.CustomizeThemeShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.CustomizeTheme"
             x:DataType="vm:CustomizeThemeViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Customize Theme"
                    Category="{gallery:CustomizeThemeShowCaseLangResource ComponentCategory}"
                    Status="{gallery:CustomizeThemeShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:CustomizeThemeShowCaseLangResource PageSubtitle}"
                    Description="{gallery:CustomizeThemeShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Theme"
                    Package="AtomUI.Core"
                    BaseClass="ThemeConfigProvider"
                    MetadataValueWidth="220" />
            </gallery:GalleryStickyTabsHost.Header>


            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
                <gallery:ShowCasePanel.Styles>
                    <Style Selector="atom|Button">
                        <Setter Property="Margin" Value="5" />
                    </Style>
                    <Style Selector="atom|CheckBox">
                        <Setter Property="Margin" Value="0, 0, 5, 0" />
                    </Style>
                </gallery:ShowCasePanel.Styles>
                <gallery:ShowCaseItem
                    Title="{gallery:CustomizeThemeShowCaseLangResource CustomizeDesignTokenTitle}"
                    Description="{gallery:CustomizeThemeShowCaseLangResource CustomizeDesignTokenDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CustomizeThemeViewModel">
        <StackPanel Orientation="Vertical">
            <WrapPanel HorizontalAlignment="Left" Orientation="Horizontal">
                <atom:Button ButtonType="Primary" Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentPrimaryButton}" />
                <atom:Button Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentDefaultButton}" />
                <atom:Button ButtonType="Text" Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentTextButton}" />
                <atom:Button ButtonType="Link" Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentLinkButton}" />
            </WrapPanel>
            <atom:ThemeConfigProvider Config="{Binding GreenThemeConfig}">
                <WrapPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <atom:Button ButtonType="Primary" Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentPrimaryButton}" />
                    <atom:Button Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentDefaultButton}" />
                    <atom:Button ButtonType="Text" Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentTextButton}" />
                    <atom:Button ButtonType="Link" Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentLinkButton}" />
                </WrapPanel>
            </atom:ThemeConfigProvider>
            <atom:ThemeConfigProvider Config="{Binding RedThemeConfig}">
                <WrapPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <atom:Button ButtonType="Primary" Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentPrimaryButton}" />
                    <atom:Button Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentDefaultButton}" />
                    <atom:Button ButtonType="Text" Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentTextButton}" />
                    <atom:Button ButtonType="Link" Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentLinkButton}" />
                </WrapPanel>
            </atom:ThemeConfigProvider>
            <atom:ThemeConfigProvider Config="{Binding PurpleThemeConfig}">
                <StackPanel HorizontalAlignment="Left" Spacing="10" Orientation="Vertical" Margin="5, 10, 0, 0">
                    <WrapPanel Margin="0, 0, 0, 5">
                        <atom:CheckBox IsChecked="True" Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentApple}" />
                        <atom:CheckBox IsChecked="True" Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentPear}" />
                        <atom:CheckBox IsChecked="True" Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentOrange}" />
                    </WrapPanel>
                    <WrapPanel Margin="0, 0, 0, 5">
                        <atom:CheckBox Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentApple}" />
                        <atom:CheckBox IsChecked="True" Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentPear}" />
                        <atom:CheckBox Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentOrange}" />
                    </WrapPanel>
                    <WrapPanel Margin="0, 0, 0, 5">
                        <atom:CheckBox IsChecked="True" IsEnabled="False" Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentApple}" />
                        <atom:CheckBox IsEnabled="False" Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentPear}" />
                        <atom:CheckBox IsEnabled="False" Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentOrange}" />
                    </WrapPanel>
                </StackPanel>
            </atom:ThemeConfigProvider>
        </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
                <gallery:ShowCaseItem
                    Title="{gallery:CustomizeThemeShowCaseLangResource PresetAlgorithmsTitle}"
                    Description="{gallery:CustomizeThemeShowCaseLangResource PresetAlgorithmsDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CustomizeThemeViewModel">
        <atom:ThemeConfigProvider Config="{Binding DarkThemeConfig}">
            <Border Background="#2b2d30" Padding="20">
                <StackPanel Orientation="Horizontal"
                            Spacing="5"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <atom:LineEdit PlaceholderText="{gallery:CustomizeThemeShowCaseLangResource P2PlaceholderTextPleaseInput}"
                                   Width="200"
                                   VerticalAlignment="Center" />
                    <atom:Button ButtonType="Primary"
                                 Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentSubmit}"
                                 VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </atom:ThemeConfigProvider>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:CustomizeThemeShowCaseLangResource RuntimeTokenUpdatesTitle}"
                    Description="{gallery:CustomizeThemeShowCaseLangResource RuntimeTokenUpdatesDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CustomizeThemeViewModel">
        <atom:ThemeConfigProvider Config="{Binding RuntimeThemeConfig}">
            <Border Padding="20">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal"
                                Spacing="5"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                        <atom:LineEdit PlaceholderText="{gallery:CustomizeThemeShowCaseLangResource P2PlaceholderTextPleaseInput}"
                                       Width="200"
                                       VerticalAlignment="Center" />
                        <atom:Button ButtonType="Primary"
                                     Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentSubmit}"
                                     VerticalAlignment="Center" />
                    </StackPanel>
                    <WrapPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <atom:Button SizeType="Small"
                                     Command="{Binding UseRuntimePrimaryBlue}"
                                     Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentUseBlue}" />
                        <atom:Button SizeType="Small"
                                     Command="{Binding UseRuntimePrimaryGreen}"
                                     Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentUseGreen}" />
                        <atom:Button SizeType="Small"
                                     Command="{Binding UseRuntimePrimaryMagenta}"
                                     Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentUseMagenta}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </atom:ThemeConfigProvider>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:CustomizeThemeShowCaseLangResource CustomizeComponentTokenTitle}"
                    Description="{gallery:CustomizeThemeShowCaseLangResource CustomizeComponentTokenDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CustomizeThemeViewModel">

        <Border Padding="20">
            <StackPanel Spacing="10">
                <atom:ThemeConfigProvider Config="{Binding ControlAlgorithmEnabledConfig}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <atom:TextBlock VerticalAlignment="Center" Width="120" Text="{gallery:CustomizeThemeShowCaseLangResource P2TextEnableAlgorithm}" />
                        <atom:LineEdit PlaceholderText="{gallery:CustomizeThemeShowCaseLangResource P2PlaceholderTextPleaseInput}" Width="200" VerticalAlignment="Center" />
                        <atom:Button ButtonType="Primary" VerticalAlignment="Center">
                            <atom:TextBlock Name="ComponentTokenContentIsolationProbe"
                                            Text="{gallery:CustomizeThemeShowCaseLangResource P2ContentSubmit}" />
                        </atom:Button>
                    </StackPanel>
                </atom:ThemeConfigProvider>
                <atom:Separator />
                <atom:ThemeConfigProvider Config="{Binding ControlAlgorithmDisabledConfig}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <atom:TextBlock VerticalAlignment="Center" Width="120" Text="{gallery:CustomizeThemeShowCaseLangResource P2TextDisableAlgorithm}" />
                        <atom:LineEdit PlaceholderText="{gallery:CustomizeThemeShowCaseLangResource P2PlaceholderTextPleaseInput}" Width="200" VerticalAlignment="Center" />
                        <atom:Button ButtonType="Primary" VerticalAlignment="Center" Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentSubmit}" />
                    </StackPanel>
                </atom:ThemeConfigProvider>
            </StackPanel>
        </Border>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:CustomizeThemeShowCaseLangResource NestedThemeTitle}"
                    Description="{gallery:CustomizeThemeShowCaseLangResource NestedThemeDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:CustomizeThemeViewModel">
        <atom:ThemeConfigProvider Config="{Binding NestedBlueThemeConfig}">
            <Border Padding="20">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <atom:Button ButtonType="Primary" VerticalAlignment="Center" Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentThemeN1}" />
                    <atom:ThemeConfigProvider Config="{Binding NestedGreenThemeConfig}">
                        <atom:Button ButtonType="Primary" VerticalAlignment="Center" Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentThemeN2}" />
                    </atom:ThemeConfigProvider>
                    <atom:ThemeConfigProvider Config="{Binding NestedOrangeThemeConfig}">
                        <atom:Button ButtonType="Primary" VerticalAlignment="Center" Content="{gallery:CustomizeThemeShowCaseLangResource P2ContentThemeN3}" />
                    </atom:ThemeConfigProvider>
                </StackPanel>
            </Border>
        </atom:ThemeConfigProvider>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
