<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Icon.IconShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Icon"
             x:DataType="vm:IconViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}"
          RowDefinitions="Auto,Auto,*">
        <StackPanel Grid.Row="0"
                    Margin="28,24,28,18"
                    Spacing="16">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal"
                            Spacing="10"
                            VerticalAlignment="Center">
                    <atom:TextBlock Text="Icon"
                                    FontSize="26"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center" />
                    <atom:Tag Text="{gallery:IconShowCaseLangResource ComponentCategory}"
                              TagColor="blue"
                              VerticalAlignment="Center" />
                    <atom:Tag Text="{gallery:IconShowCaseLangResource ComponentStatusStable}"
                              TagColor="success"
                              VerticalAlignment="Center" />
                </StackPanel>
                <atom:TextBlock Text="{gallery:IconShowCaseLangResource PageSubtitle}"
                                FontSize="15"
                                Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                <atom:TextBlock Text="{gallery:IconShowCaseLangResource PageDescription}"
                                HorizontalAlignment="Left"
                                TextWrapping="Wrap"
                                Foreground="{atom:SharedTokenResource ColorTextTertiary}" />
            </StackPanel>

            <Border Background="{atom:SharedTokenResource ColorBgContainer}"
                    BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                    BorderThickness="1"
                    CornerRadius="6"
                    MinHeight="48"
                    Padding="16,8">
                <Border.Styles>
                    <Style Selector="atom|TextBlock.info-label">
                        <Setter Property="Width" Value="84" />
                    </Style>
                    <Style Selector="atom|TextBlock.info-value">
                        <Setter Property="Width" Value="220" />
                        <Setter Property="TextWrapping" Value="NoWrap" />
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                    </Style>
                </Border.Styles>
                <WrapPanel Orientation="Horizontal"
                           ItemSpacing="48"
                           LineSpacing="8"
                           VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">
                        <atom:TextBlock Classes="info-label"
                                        Text="{gallery:IconShowCaseLangResource InfoNamespaceLabel}"
                                        FontWeight="Bold"
                                        LineHeight="22"
                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                        VerticalAlignment="Center" />
                        <atom:TextBlock Classes="info-value"
                                        Text="AtomUI.Controls"
                                        FontFamily="Consolas"
                                        LineHeight="22"
                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                        VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">
                        <atom:TextBlock Classes="info-label"
                                        Text="{gallery:IconShowCaseLangResource InfoPackageLabel}"
                                        FontWeight="Bold"
                                        LineHeight="22"
                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                        VerticalAlignment="Center" />
                        <atom:TextBlock Classes="info-value"
                                        Text="AtomUI.Icons.AntDesign"
                                        FontFamily="Consolas"
                                        LineHeight="22"
                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                        VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                Spacing="10"
                                VerticalAlignment="Center">
                        <atom:TextBlock Classes="info-label"
                                        Text="{gallery:IconShowCaseLangResource InfoBaseClassLabel}"
                                        FontWeight="Bold"
                                        LineHeight="22"
                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                        VerticalAlignment="Center" />
                        <atom:TextBlock Classes="info-value"
                                        Text="Icon"
                                        FontFamily="Consolas"
                                        LineHeight="22"
                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                        VerticalAlignment="Center" />
                    </StackPanel>
                </WrapPanel>
            </Border>
        </StackPanel>

        <atom:TabStrip Name="ScenarioTabs"
                       Grid.Row="1"
                       Margin="28,0,28,0"
                       SizeType="Large"
                       SelectedIndex="0">
            <atom:TabStripItem Content="{gallery:IconShowCaseLangResource P2HeaderOutlined}"
                               Tag="Outlined"
                               IsSelected="True" />
            <atom:TabStripItem Content="{gallery:IconShowCaseLangResource P2HeaderFilled}"
                               Tag="Filled" />
            <atom:TabStripItem Content="{gallery:IconShowCaseLangResource P2HeaderTwoTone}"
                               Tag="TwoTone" />
        </atom:TabStrip>

        <ContentControl Name="ScenarioContentHost"
                        Grid.Row="2"
                        Margin="28,10,28,28" />
    </Grid>
</UserControl>
