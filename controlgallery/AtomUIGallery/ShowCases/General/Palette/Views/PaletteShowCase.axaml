<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Palette.PaletteShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Palette"
             x:DataType="vm:PaletteViewModel">

    <UserControl.Resources>
        <DataTemplate x:Key="LightPaletteContentTemplate"
                      x:DataType="vm:PaletteViewModel">
            <ItemsControl ItemsSource="{Binding PresetPaletteInfos}"
                          Margin="28,10,28,28"
                          Padding="10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PresetPaletteInfoPair">
                        <UniformGrid Rows="1"
                                     Columns="2">
                            <gallery:ColorListControl Margin="0,0,10,10"
                                                      PaletteMetaInfo="{Binding Left}" />
                            <gallery:ColorListControl Margin="0,0,0,10"
                                                      PaletteMetaInfo="{Binding Right}" />
                        </UniformGrid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="DarkPaletteContentTemplate"
                      x:DataType="vm:PaletteViewModel">
            <Border Background="Black"
                    Margin="28,10,28,28"
                    Padding="10">
                <ItemsControl ItemsSource="{Binding PresetPaletteInfos}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PresetPaletteInfoPair">
                            <UniformGrid Rows="1"
                                         Columns="2">
                                <gallery:ColorListControl Margin="0,0,10,10"
                                                          PaletteMetaInfo="{Binding Left}"
                                                          IsDark="True" />
                                <gallery:ColorListControl Margin="0,0,0,10"
                                                          PaletteMetaInfo="{Binding Right}"
                                                          IsDark="True" />
                            </UniformGrid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Palette"
                    Category="{gallery:PaletteShowCaseLangResource ComponentCategory}"
                    Status="{gallery:PaletteShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:PaletteShowCaseLangResource PageSubtitle}"
                    Description="{gallery:PaletteShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Theme.Palette"
                    Package="AtomUI.Controls"
                    BaseClass="PresetPalettes"
                    MetadataValueWidth="220" />
            </gallery:GalleryStickyTabsHost.Header>

            <gallery:GalleryStickyTabsHost.StickyContent>
                <atom:TabStrip Name="ScenarioTabs"
                               SizeType="Large"
                               SelectedIndex="0">
                    <atom:TabStripItem Content="{gallery:PaletteShowCaseLangResource P2HeaderLight}"
                                       Tag="Light"
                                       IsSelected="True" />
                    <atom:TabStripItem Content="{gallery:PaletteShowCaseLangResource P2HeaderDark}"
                                       Tag="Dark" />
                </atom:TabStrip>
            </gallery:GalleryStickyTabsHost.StickyContent>

            <ContentControl Name="ScenarioContentHost">
            </ContentControl>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
