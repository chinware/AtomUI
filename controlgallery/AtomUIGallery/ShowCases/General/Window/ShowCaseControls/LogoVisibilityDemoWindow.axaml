<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:sc="clr-namespace:AtomUIGallery.ShowCases.Window"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             x:Class="AtomUIGallery.ShowCases.Window.LogoVisibilityDemoWindow"
             x:ClassModifier="internal"
             Title="AtomUI Window"
             Width="680"
             Height="420"
             WindowStartupLocation="CenterOwner">
    <atom:Window.Logo>
        <sc:AtomUiLogoIcon />
    </atom:Window.Logo>
    <StackPanel Margin="24" Spacing="16">
        <atom:TextBlock Text="{gallery:WindowShowCaseLangResource LogoVisibilityHint}" TextWrapping="Wrap" />
        <atom:Segmented SelectionChanged="HandleLogoVisibilitySelectionChanged">
            <atom:SegmentedItem Content="Auto" />
            <atom:SegmentedItem Content="Always" />
            <atom:SegmentedItem Content="Never" />
        </atom:Segmented>
    </StackPanel>
</atom:Window>
