<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:sc="clr-namespace:AtomUIGallery.ShowCases.Window"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             x:Class="AtomUIGallery.ShowCases.Window.TitleBarlessDemoWindow"
             x:ClassModifier="internal"
             Title="AtomUI Demo"
             IsTitleBarVisible="False"
             Width="680"
             Height="420"
             WindowStartupLocation="CenterOwner">
    <DockPanel>
        <atom:WindowTitleBar DockPanel.Dock="Top"
                             Title="AtomUI Demo"
                             LogoVisibility="Always">
            <atom:WindowTitleBar.Logo>
                <sc:AtomUiLogoIcon />
            </atom:WindowTitleBar.Logo>
            <atom:WindowTitleBar.RightAddOn>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <atom:WindowTitleBarButton Icon="{antdicons:AntDesignIconProvider Kind=MinusOutlined}"
                                               Click="HandleMinimizeClick" atom:ToolTip.Tip="Minimize" />
                    <atom:WindowTitleBarButton Icon="{antdicons:AntDesignIconProvider Kind=ArrowsAltOutlined}"
                                               Click="HandleToggleMaximizeClick" atom:ToolTip.Tip="Maximize" />
                    <atom:WindowTitleBarButton Icon="{antdicons:AntDesignIconProvider Kind=CloseOutlined}"
                                               Click="HandleCloseClick" atom:ToolTip.Tip="Close" />
                </StackPanel>
            </atom:WindowTitleBar.RightAddOn>
        </atom:WindowTitleBar>
        <StackPanel Margin="24" Spacing="12" VerticalAlignment="Center">
            <atom:TextBlock Text="{gallery:WindowShowCaseLangResource TitleBarlessTitle}" FontWeight="Bold" />
            <atom:TextBlock Text="{gallery:WindowShowCaseLangResource TitleBarlessHint}" TextWrapping="Wrap" />
        </StackPanel>
    </DockPanel>
</atom:Window>
