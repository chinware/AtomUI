    <unit id="TabStripSizeDescription">
      <segment>
        <source>Large size tabs are usually used in page header, and small size could be used in Modal.</source>
        <target state="translated">大尺寸标签通常用于页头，小尺寸可用于模态框。</target>
      </segment>
    </unit>
    <unit id="TabStripSizeTitle">
