<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.ComboBox.ComboBoxShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.ComboBox"
             x:DataType="vm:ComboBoxViewModel"
             x:CompileBindings="True">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <StackPanel Margin="28,24,28,18"
                            Spacing="16">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <atom:TextBlock Text="ComboBox"
                                            FontSize="26"
                                            FontWeight="Bold"
                                            VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:ComboBoxShowCaseLangResource ComponentCategory}"
                                      TagColor="blue"
                                      VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:ComboBoxShowCaseLangResource ComponentStatusStable}"
                                      TagColor="success"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                        <atom:TextBlock Text="{gallery:ComboBoxShowCaseLangResource PageSubtitle}"
                                        FontSize="15"
                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                        <atom:TextBlock Text="{gallery:ComboBoxShowCaseLangResource PageDescription}"
                                        HorizontalAlignment="Left"
                                        TextWrapping="Wrap"
                                        Foreground="{atom:SharedTokenResource ColorTextTertiary}" />
                    </StackPanel>

                    <Border Background="{atom:SharedTokenResource ColorBgContainer}"
                            BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinHeight="48"
                            Padding="16,8">
                        <Border.Styles>
                            <Style Selector="atom|TextBlock.info-label">
                                <Setter Property="Width" Value="84" />
                            </Style>
                            <Style Selector="atom|TextBlock.info-value">
                                <Setter Property="Width" Value="200" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </Border.Styles>
                        <WrapPanel Orientation="Horizontal"
                                   ItemSpacing="48"
                                   LineSpacing="8"
                                   VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:ComboBoxShowCaseLangResource InfoNamespaceLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:ComboBoxShowCaseLangResource InfoPackageLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:ComboBoxShowCaseLangResource InfoBaseClassLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="ComboBox"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </gallery:GalleryStickyTabsHost.Header>

            <gallery:GalleryStickyTabsHost.StickyContent>
                <atom:TabStrip Name="ScenarioTabs"
                               SizeType="Large"
                               SelectedIndex="0">
                    <atom:TabStripItem Content="{gallery:ComboBoxShowCaseLangResource ScenarioExamples}"
                                       Tag="Examples"
                                       IsSelected="True" />
                    <atom:TabStripItem Content="{gallery:ComboBoxShowCaseLangResource ScenarioApi}"
                                       Tag="Api" />
                    <atom:TabStripItem Content="{gallery:ComboBoxShowCaseLangResource ScenarioDesignToken}"
                                       Tag="DesignToken" />
                </atom:TabStrip>
            </gallery:GalleryStickyTabsHost.StickyContent>

            <ContentControl Name="ScenarioContentHost">
                <gallery:ShowCasePanel Name="ExamplesContent"
                                       IsScrollEnabled="False"
                                       IsDeferredLoadingEnabled="True"
                                       InitialDeferredLoadItemCount="4"
                                       DeferredLoadBatchSize="2"
                                       ContentMargin="28,10,28,28">
        <gallery:ShowCaseItem
            Title="{gallery:ComboBoxShowCaseLangResource BasicTitle}"
            Description="{gallery:ComboBoxShowCaseLangResource BasicDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:ComboBoxViewModel">
            <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300">
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            </atom:ComboBox>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:ComboBoxShowCaseLangResource ItemsSourceTitle}"
            Description="{gallery:ComboBoxShowCaseLangResource ItemsSourceDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:ComboBoxViewModel">
            <atom:ComboBox Name="TplComboBox"
                           PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                           ItemsSource="{Binding ComboBoxItems}">
                <atom:ComboBox.ItemTemplate>
                    <DataTemplate>
                        <atom:TextBlock Text="{Binding Text}" VerticalAlignment="Center"/>
                    </DataTemplate>
                </atom:ComboBox.ItemTemplate>
            </atom:ComboBox>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:ComboBoxShowCaseLangResource DisabledTitle}"
            Description="{gallery:ComboBoxShowCaseLangResource DisabledDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:ComboBoxViewModel">
            <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300" IsEnabled="False">
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
            </atom:ComboBox>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:ComboBoxShowCaseLangResource ThreeSizesTitle}"
            Description="{gallery:ComboBoxShowCaseLangResource ThreeSizesDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:ComboBoxViewModel">
            <StackPanel Orientation="Vertical" Spacing="10" Margin="0, 0, 20, 0">
                <atom:ComboBox SizeType="Large" PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}">
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                </atom:ComboBox>
                <atom:ComboBox SizeType="Middle" PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}">
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                </atom:ComboBox>
                <atom:ComboBox SizeType="Small" PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}">
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                </atom:ComboBox>
            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:ComboBoxShowCaseLangResource VariantsTitle}"
            Description="{gallery:ComboBoxShowCaseLangResource VariantsDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:ComboBoxViewModel">
            <StackPanel Orientation="Vertical" Spacing="10">
                <atom:ComboBox StyleVariant="Outlined" PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300">
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                </atom:ComboBox>

                <atom:ComboBox StyleVariant="Filled" PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300">
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                </atom:ComboBox>

                <atom:ComboBox StyleVariant="Borderless" PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300">
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                </atom:ComboBox>
            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:ComboBoxShowCaseLangResource PrePostTabTitle}"
            Description="{gallery:ComboBoxShowCaseLangResource PrePostTabDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:ComboBoxViewModel">
            <StackPanel Orientation="Vertical" Spacing="10">
                <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                               LeftAddOn="http://"
                               RightAddOn=".com">
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                </atom:ComboBox>

                <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                               RightAddOn="{antdicons:AntDesignIconProvider Kind=SettingOutlined}">
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                </atom:ComboBox>

                <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                               LeftAddOn="http://"
                               ContentRightAddOn=".com">
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                </atom:ComboBox>

            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>


        <gallery:ShowCaseItem
            Title="{gallery:ComboBoxShowCaseLangResource PrefixSuffixTitle}"
            Description="{gallery:ComboBoxShowCaseLangResource PrefixSuffixDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:ComboBoxViewModel">
            <StackPanel Orientation="Vertical" Spacing="10">
                <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                               ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=UserOutlined, FillBrush=#D7D7D7}"
                               ContentRightAddOn="{antdicons:AntDesignIconProvider Kind=InfoCircleOutlined, FillBrush=#8C8C8C}">
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                </atom:ComboBox>

                <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                               ContentLeftAddOn="￥"
                               ContentRightAddOn="RMB">
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                </atom:ComboBox>

                <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                               ContentLeftAddOn="￥"
                               ContentRightAddOn="RMB" IsEnabled="False">
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                </atom:ComboBox>

            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:ComboBoxShowCaseLangResource StatusTitle}"
            Description="{gallery:ComboBoxShowCaseLangResource StatusDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:ComboBoxViewModel">
            <StackPanel Orientation="Vertical" Spacing="10" Margin="0, 0, 20, 0">
                <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                               Status="Error">
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                </atom:ComboBox>

                <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                               Status="Warning">
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                </atom:ComboBox>

                <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                               Status="Error"
                               ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}">
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                </atom:ComboBox>

                <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                               Status="Warning"
                               ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}">
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                </atom:ComboBox>

                <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                               Status="Error"
                               StyleVariant="Filled"
                               ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}">
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                </atom:ComboBox>

                <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                               Status="Warning"
                               StyleVariant="Filled"
                               ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}">
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                </atom:ComboBox>

                <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                               Status="Error"
                               StyleVariant="Borderless"
                               ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}">
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                </atom:ComboBox>

                <atom:ComboBox PlaceholderText="{gallery:ComboBoxShowCaseLangResource P2PlaceholderTextPleaseSelect}" Width="300"
                               Status="Warning"
                               StyleVariant="Borderless"
                               ContentLeftAddOn="{antdicons:AntDesignIconProvider Kind=ClockCircleOutlined}">
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine1}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine2}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine3}" />
                    <atom:ComboBoxItem Content="{gallery:ComboBoxShowCaseLangResource P2ContentPoemLine4}" />
                </atom:ComboBox>

            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

                </gallery:ShowCasePanel>
            </ContentControl>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
