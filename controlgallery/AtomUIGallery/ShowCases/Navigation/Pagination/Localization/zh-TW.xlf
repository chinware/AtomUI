    <unit id="9" name="BindingDescription">
      <segment>
        <source>CurrentPage and PageSize can be bound without an explicit Mode=TwoWay; page clicks and size changes write back to the view model.</source>
        <target state="translated">CurrentPage 和 PageSize 不需要顯式設置 Mode=TwoWay；點擊頁碼和修改頁大小都會寫回 ViewModel。</target>
      </segment>
    </unit>
