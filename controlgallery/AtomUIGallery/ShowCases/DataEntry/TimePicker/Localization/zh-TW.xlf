<?xml version="1.0" encoding="utf-8"?>
<xliff version="2.1" srcLang="en-US" trgLang="zh-TW" xmlns="urn:oasis:names:tc:xliff:document:2.0">
  <file id="AtomUIGallery.Localization.TimePickerShowCaseLangResourceKind">
    <unit id="1" name="BasicTitle">
      <segment>
        <source>Basic</source>
        <target state="translated">基礎用法</target>
      </segment>
    </unit>
    <unit id="2" name="BasicDescription">
      <segment>
        <source>Click TimePicker, and then we could select or input a time in panel.</source>
        <target state="translated">點擊 TimePicker 後，可以在面板中選擇或輸入時間。</target>
      </segment>
    </unit>
    <unit id="3" name="BindingTitle">
      <segment>
        <source>SelectedTime binding</source>
        <target state="translated">SelectedTime 綁定</target>
      </segment>
    </unit>
    <unit id="4" name="BindingDescription">
      <segment>
        <source>SelectedTime, RangeStartSelectedTime, and RangeEndSelectedTime synchronize with the ViewModel without explicitly setting Binding Mode=TwoWay.</source>
        <target state="translated">SelectedTime、RangeStartSelectedTime 與 RangeEndSelectedTime 默認與 ViewModel 雙向同步，無需顯式設置 Binding Mode=TwoWay。</target>
      </segment>
    </unit>
    <unit id="5" name="PickerDisplayTimeTitle">
      <segment>
        <source>Popup display time</source>
        <target state="translated">彈出面板顯示時間</target>
      </segment>
    </unit>
    <unit id="6" name="PickerDisplayTimeDescription">
      <segment>
        <source>Open the popup panel at a specific display time without committing a selected value.</source>
        <target state="translated">打開彈出面板時定位到指定時間，但不提交選中值。</target>
      </segment>
    </unit>
    <unit id="7" name="HourFormatsTitle">
      <segment>
        <source>12-hour and 24-hour formats</source>
        <target state="translated">12 小時和 24 小時格式</target>
      </segment>
    </unit>
    <unit id="8" name="HourFormatsDescription">
      <segment>
        <source>TimePicker supports two time types, 12-hour and 24-hour.</source>
        <target state="translated">TimePicker 支持 12 小時和 24 小時兩種時間格式。</target>
      </segment>
    </unit>
    <unit id="9" name="ThreeSizesTitle">
      <segment>
        <source>Three Sizes</source>
        <target state="translated">三種尺寸</target>
      </segment>
    </unit>
    <unit id="10" name="ThreeSizesDescription">
      <segment>
        <source>The input box comes in three sizes: large, middle and small. Large is used in the form, while the medium size is the default.</source>
        <target state="translated">輸入框提供大號、中號和小號三種尺寸。大號用於表單，中號為默認尺寸。</target>
      </segment>
    </unit>
    <unit id="11" name="DisabledTitle">
      <segment>
        <source>Disabled</source>
        <target state="translated">禁用</target>
      </segment>
    </unit>
    <unit id="12" name="DisabledDescription">
      <segment>
        <source>A disabled state of the TimePicker.</source>
        <target state="translated">TimePicker 的禁用狀態。</target>
      </segment>
    </unit>
    <unit id="13" name="IntervalOptionTitle">
      <segment>
        <source>Interval option</source>
        <target state="translated">間隔選項</target>
      </segment>
    </unit>
    <unit id="14" name="IntervalOptionDescription">
      <segment>
        <source>Show stepped options by MinuteIncrement SecondIncrement.</source>
        <target state="translated">通過 MinuteIncrement 和 SecondIncrement 顯示步進選項。</target>
      </segment>
    </unit>
    <unit id="15" name="TwelveHoursTitle">
      <segment>
        <source>12 hours</source>
        <target state="translated">12 小時制</target>
      </segment>
    </unit>
    <unit id="16" name="TwelveHoursDescription">
      <segment>
        <source>TimePicker of 12 hours format, with default format h:mm:ss a.</source>
        <target state="translated">12 小時格式的 TimePicker，默認格式為 h:mm:ss a。</target>
      </segment>
    </unit>
    <unit id="17" name="VariantsTitle">
      <segment>
        <source>Variants</source>
        <target state="translated">變體</target>
      </segment>
    </unit>
    <unit id="18" name="VariantsDescription">
      <segment>
        <source>Bordered-less style component.</source>
        <target state="translated">無邊框風格組件。</target>
      </segment>
    </unit>
    <unit id="19" name="StatusTitle">
      <segment>
        <source>Status</source>
        <target state="translated">狀態</target>
      </segment>
    </unit>
    <unit id="20" name="StatusDescription">
      <segment>
        <source>Add status to TimePicker with status, which could be error or warning.</source>
        <target state="translated">通過 status 為 TimePicker 添加狀態，可設置為錯誤或警告。</target>
      </segment>
    </unit>
    <unit id="21" name="TimeRangePickerTitle">
      <segment>
        <source>Time Range Picker</source>
        <target state="translated">時間範圍選擇器</target>
      </segment>
    </unit>
    <unit id="22" name="TimeRangePickerDescription">
      <segment>
        <source>Use time range picker with RangeTimePicker.</source>
        <target state="translated">使用 RangeTimePicker 進行時間範圍選擇。</target>
      </segment>
    </unit>
