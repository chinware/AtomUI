    <unit id="15" name="PageSubtitle">
      <segment>
        <source>Single, multiple, searchable, and tag-based option selection.</source>
        <target state="translated">支持單選、多選、搜索和標籤輸入的選項選擇。</target>
      </segment>
    </unit>
    <unit id="16" name="PageDescription">
      <segment>
        <source>Select lets users choose values from option lists with filtering, grouping, async loading, custom rendering, and multiple selection behaviors.</source>
        <target state="translated">Select 用於從選項列表中選擇值，支持篩選、分組、異步加載、自定義渲染和多選行為。</target>
      </segment>
    </unit>
    <unit id="17" name="ComponentCategory">
      <segment>
        <source>Data Entry</source>
        <target state="translated">數據錄入</target>
      </segment>
    </unit>
    <unit id="18" name="ComponentStatusStable">
      <segment>
        <source>Stable</source>
        <target state="translated">穩定</target>
      </segment>
    </unit>
    <unit id="19" name="SearchFieldTitle">
      <segment>
        <source>Select with search field</source>
        <target state="translated">帶搜索框的選擇器</target>
      </segment>
    </unit>
    <unit id="20" name="SearchFieldDescription">
      <segment>
        <source>Search the options while expanded.</source>
        <target state="translated">展開時搜索選項。</target>
      </segment>
    </unit>
    <unit id="21" name="CustomSearchTitle">
      <segment>
        <source>Custom Search</source>
        <target state="translated">自定義搜索</target>
      </segment>
    </unit>
    <unit id="22" name="CustomSearchDescription">
      <segment>
        <source>Customize search using filterOption, Case-sensitive search for Header.</source>
        <target state="translated">使用 filterOption 自定義搜索，對 Header 進行大小寫敏感搜索。</target>
      </segment>
    </unit>
    <unit id="23" name="MultipleSelectionTitle">
      <segment>
        <source>multiple selection</source>
        <target state="translated">多選</target>
      </segment>
    </unit>
    <unit id="24" name="MultipleSelectionDescription">
      <segment>
        <source>Multiple selection, selecting from existing items.</source>
        <target state="translated">多選，從已有項中選擇。</target>
      </segment>
    </unit>
    <unit id="25" name="TagsTitle">
      <segment>
        <source>Tags</source>
        <target state="translated">標籤</target>
      </segment>
    </unit>
    <unit id="26" name="TagsDescription">
      <segment>
        <source>Allow user to select tags from list or input custom tag.</source>
        <target state="translated">允許用戶從列表中選擇標籤或輸入自定義標籤。</target>
      </segment>
    </unit>
    <unit id="27" name="SizesTitle">
      <segment>
        <source>Sizes</source>
        <target state="translated">尺寸</target>
      </segment>
    </unit>
    <unit id="28" name="SizesDescription">
      <segment>
        <source>The height of the input field for the select defaults to 32px. If size is set to large, the height will be 40px, and if set to small, 24px. Custom can use local size properties.</source>
        <target state="translated">選擇器輸入區域默認高度為 32px。size 設置為 large 時高度為 40px，設置為 small 時高度為 24px。Custom 可配合本地尺寸屬性自定義。</target>
      </segment>
    </unit>
    <unit id="29" name="CustomDropdownOptionsTitle">
      <segment>
        <source>Custom dropdown options</source>
        <target state="translated">自定義下拉選項</target>
      </segment>
    </unit>
    <unit id="30" name="CustomDropdownOptionsDescription">
      <segment>
        <source>Use optionRender to customize the rendering dropdown options</source>
        <target state="translated">使用 optionRender 自定義下拉選項渲染。</target>
      </segment>
    </unit>
    <unit id="31" name="OptionGroupTitle">
      <segment>
        <source>Option Group</source>
        <target state="translated">選項分組</target>
      </segment>
    </unit>
    <unit id="32" name="OptionGroupDescription">
      <segment>
        <source>Using OptGroup to group the options.</source>
        <target state="translated">使用 OptGroup 對選項分組。</target>
      </segment>
    </unit>
    <unit id="33" name="VariantsTitle">
      <segment>
        <source>Variants</source>
        <target state="translated">變體</target>
      </segment>
    </unit>
    <unit id="34" name="VariantsDescription">
      <segment>
        <source>Variants of Select, there are four variants: outlined filled borderless and underlined.</source>
        <target state="translated">Select 提供四種變體：描邊、填充、無邊框和下划線。</target>
      </segment>
    </unit>
    <unit id="35" name="HideAlreadySelectedTitle">
      <segment>
        <source>Hide Already Selected</source>
        <target state="translated">隱藏已選項</target>
      </segment>
    </unit>
    <unit id="36" name="HideAlreadySelectedDescription">
      <segment>
        <source>Hide already selected options in the dropdown.</source>
        <target state="translated">在下拉列表中隱藏已經選擇的選項。</target>
      </segment>
    </unit>
    <unit id="37" name="StatusTitle">
      <segment>
        <source>Status</source>
        <target state="translated">狀態</target>
      </segment>
    </unit>
    <unit id="38" name="StatusDescription">
      <segment>
        <source>Add status to Select with status, which could be error or warning.</source>
        <target state="translated">通過 status 為 Select 添加狀態，可設置為錯誤或警告。</target>
      </segment>
    </unit>
    <unit id="39" name="MaxCountTitle">
      <segment>
        <source>Max Count</source>
        <target state="translated">最大數量</target>
      </segment>
    </unit>
    <unit id="40" name="MaxCountDescription">
      <segment>
        <source>You can set the maxCount prop to control the max number of items can be selected. When the limit is exceeded, the options will become disabled.</source>
        <target state="translated">可以設置 maxCount 屬性控制最多可選項數量。超過限制後，選項會變為禁用狀態。</target>
      </segment>
    </unit>
    <unit id="41" name="ResponsiveMaxTagCountTitle">
      <segment>
        <source>Responsive maxTagCount</source>
        <target state="translated">響應式 maxTagCount</target>
      </segment>
    </unit>
    <unit id="42" name="ResponsiveMaxTagCountDescription">
      <segment>
        <source>Auto collapse to tag with responsive case. Not recommend use in large form case since responsive calculation has a perf cost.</source>
        <target state="translated">在響應式場景中自動折疊為標籤。由於響應式計算有性能成本，不建議在大型表單中使用。</target>
      </segment>
    </unit>
