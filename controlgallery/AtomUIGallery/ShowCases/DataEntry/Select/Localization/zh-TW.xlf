    <unit id="4" name="BindingDescription">
      <segment>
        <source>SelectedOption and SelectedOptions synchronize with the ViewModel without explicitly setting Binding Mode=TwoWay.</source>
        <target state="translated">SelectedOption 和 SelectedOptions 默認與 ViewModel 雙向同步，無需顯式設置 Binding Mode=TwoWay。</target>
      </segment>
