<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Upload.UploadShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Upload"
             x:DataType="vm:UploadViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <StackPanel Margin="28,24,28,18"
                            Spacing="16">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <atom:TextBlock Text="Upload"
                                            FontSize="26"
                                            FontWeight="Bold"
                                            VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:UploadShowCaseLangResource ComponentCategory}"
                                      TagColor="blue"
                                      VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:UploadShowCaseLangResource ComponentStatusStable}"
                                      TagColor="success"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                        <atom:TextBlock Text="{gallery:UploadShowCaseLangResource PageSubtitle}"
                                        FontSize="15"
                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                        <atom:TextBlock Text="{gallery:UploadShowCaseLangResource PageDescription}"
                                        HorizontalAlignment="Left"
                                        TextWrapping="Wrap"
                                        Foreground="{atom:SharedTokenResource ColorTextTertiary}" />
                    </StackPanel>

                    <Border Background="{atom:SharedTokenResource ColorBgContainer}"
                            BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinHeight="48"
                            Padding="16,8">
                        <Border.Styles>
                            <Style Selector="atom|TextBlock.info-label">
                                <Setter Property="Width" Value="84" />
                            </Style>
                            <Style Selector="atom|TextBlock.info-value">
                                <Setter Property="Width" Value="200" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </Border.Styles>
                        <WrapPanel Orientation="Horizontal"
                                   ItemSpacing="48"
                                   LineSpacing="8"
                                   VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:UploadShowCaseLangResource InfoNamespaceLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:UploadShowCaseLangResource InfoPackageLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:UploadShowCaseLangResource InfoBaseClassLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="ContentControl"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </gallery:GalleryStickyTabsHost.Header>

            <gallery:GalleryStickyTabsHost.StickyContent>
                <atom:TabStrip Name="ScenarioTabs"
                               SizeType="Large"
                               SelectedIndex="0">
                    <atom:TabStripItem Content="{gallery:UploadShowCaseLangResource ScenarioExamples}"
                                       Tag="Examples"
                                       IsSelected="True" />
                    <atom:TabStripItem Content="{gallery:UploadShowCaseLangResource ScenarioApi}"
                                       Tag="Api" />
                    <atom:TabStripItem Content="{gallery:UploadShowCaseLangResource ScenarioDesignToken}"
                                       Tag="DesignToken" />
                </atom:TabStrip>
            </gallery:GalleryStickyTabsHost.StickyContent>

            <ContentControl Name="ScenarioContentHost">
                <gallery:ShowCasePanel Name="ExamplesContent"
                                       IsScrollEnabled="False"
                                       IsDeferredLoadingEnabled="True"
                                       InitialDeferredLoadItemCount="4"
                                       DeferredLoadBatchSize="2"
                                       ContentMargin="28,10,28,28">
        <gallery:ShowCaseItem
            Title="{gallery:UploadShowCaseLangResource UploadByClickingTitle}"
            IsDeferredContentEnabled="True"
            Description="{gallery:UploadShowCaseLangResource UploadByClickingDescription}">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:UploadViewModel">
            <atom:Upload Name="BasicUpload" UploadTransport="{Binding UploadTransport}" UploadTaskFailed="HandleUploadFailed" UploadTaskCompleted="HandleUploadCompleted">
                <atom:Button Icon="{antdicons:AntDesignIconProvider UploadOutlined}" Content="{gallery:UploadShowCaseLangResource P2ContentClickToUpload}" />
            </atom:Upload>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:UploadShowCaseLangResource AvatarTitle}"
            IsDeferredContentEnabled="True"
            Description="{gallery:UploadShowCaseLangResource AvatarDescription}">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:UploadViewModel">
            <StackPanel Orientation="Horizontal" Spacing="20">
                <atom:Upload Name="AvatarDemoPictureCardUpload" ListType="PictureCard" UploadTransport="{Binding UploadTransport}" UploadTaskFailed="HandleUploadFailed" UploadTaskCompleted="HandleUploadCompleted" UploadTaskAboutToScheduling="HandleImageUploadAboutToScheduling">
                   <StackPanel Orientation="Vertical">
                       <Panel>
                           <antdicons:PlusOutlined IsVisible="{Binding IsTaskRunning ,RelativeSource={RelativeSource AncestorType=atom:Upload}, Converter={x:Static BoolConverters.Not}}"/>
                           <antdicons:LoadingOutlined IsVisible="{Binding IsTaskRunning ,RelativeSource={RelativeSource AncestorType=atom:Upload}}"
                                                      LoadingAnimation="Spin"/>
                       </Panel>
                       <TextBlock Margin="0, 8, 0, 0" Text="{gallery:UploadShowCaseLangResource P2TextUpload}" />
                   </StackPanel>
                </atom:Upload>
                <atom:Upload Name="AvatarDemoPictureCircleUpload" ListType="PictureCircle" UploadTransport="{Binding UploadTransport}" UploadTaskFailed="HandleUploadFailed" UploadTaskCompleted="HandleUploadCompleted" UploadTaskAboutToScheduling="HandleImageUploadAboutToScheduling">
                    <StackPanel Orientation="Vertical">
                        <antdicons:PlusOutlined/>
                        <TextBlock Margin="0, 8, 0, 0" Text="{gallery:UploadShowCaseLangResource P2TextUpload}" />
                    </StackPanel>
                </atom:Upload>
            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:UploadShowCaseLangResource DefaultFilesTitle}"
            IsDeferredContentEnabled="True"
            Description="{gallery:UploadShowCaseLangResource DefaultFilesDescription}"
            IsOccupyEntireRow="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:UploadViewModel">
            <atom:Upload Name="DefaultFileList" UploadTransport="{Binding UploadTransport}" UploadTaskFailed="HandleUploadFailed" UploadTaskCompleted="HandleUploadCompleted"
                         DefaultTaskList="{Binding DefaultTaskList}">
                <atom:Button Icon="{antdicons:AntDesignIconProvider UploadOutlined}" Content="{gallery:UploadShowCaseLangResource P2ContentClickToUpload}" />
            </atom:Upload>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:UploadShowCaseLangResource PicturesWallTitle}"
            IsDeferredContentEnabled="True"
            Description="{gallery:UploadShowCaseLangResource PicturesWallDescription}"
            IsOccupyEntireRow="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:UploadViewModel">
            <atom:Upload Name="PicturesWallUpload" UploadTransport="{Binding UploadTransport}" UploadTaskFailed="HandleUploadFailed" UploadTaskCompleted="HandleUploadCompleted"
                         ListType="PictureCard"
                         DefaultTaskList="{Binding PicturesWallDefaultTaskList}">
                <StackPanel Orientation="Vertical">
                    <antdicons:PlusOutlined/>
                    <TextBlock Margin="0, 8, 0, 0" Text="{gallery:UploadShowCaseLangResource P2TextUpload}" />
                </StackPanel>
            </atom:Upload>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:UploadShowCaseLangResource PictureCircleTypeTitle}"
            IsDeferredContentEnabled="True"
            Description="{gallery:UploadShowCaseLangResource PictureCircleTypeDescription}"
            IsOccupyEntireRow="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:UploadViewModel">
            <atom:Upload Name="PicturesCircleWallUpload" UploadTransport="{Binding UploadTransport}" UploadTaskFailed="HandleUploadFailed" UploadTaskCompleted="HandleUploadCompleted"
                         ListType="PictureCircle"
                         DefaultTaskList="{Binding PicturesWallDefaultTaskList}">
                <StackPanel Orientation="Vertical">
                    <antdicons:PlusOutlined/>
                    <TextBlock Margin="0, 8, 0, 0" Text="{gallery:UploadShowCaseLangResource P2TextUpload}" />
                </StackPanel>
            </atom:Upload>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:UploadShowCaseLangResource DragAndDropTitle}"
            IsDeferredContentEnabled="True"
            Description="{gallery:UploadShowCaseLangResource DragAndDropDescription}"
            IsOccupyEntireRow="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:UploadViewModel">
            <atom:Upload Name="DragAndDropUpload" UploadTransport="{Binding UploadTransport}" UploadTaskFailed="HandleUploadFailed" UploadTaskCompleted="HandleUploadCompleted">
                <atom:UploadDefaultDropArea/>
            </atom:Upload>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:UploadShowCaseLangResource PicturesWithListStyleTitle}"
            IsDeferredContentEnabled="True"
            Description="{gallery:UploadShowCaseLangResource PicturesWithListStyleDescription}">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:UploadViewModel">
            <atom:Upload Name="PictureListUpload" UploadTransport="{Binding UploadTransport}" UploadTaskFailed="HandleUploadFailed" UploadTaskCompleted="HandleUploadCompleted"
                         ListType="Picture"
                         DefaultTaskList="{Binding PictureListStyleDefaultTaskList}">
                <atom:Button Icon="{antdicons:AntDesignIconProvider UploadOutlined}" ButtonType="Primary" Content="{gallery:UploadShowCaseLangResource P2ContentClickToUpload}" />
            </atom:Upload>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:UploadShowCaseLangResource MaxCountTitle}"
            IsDeferredContentEnabled="True"
            Description="{gallery:UploadShowCaseLangResource MaxCountDescription}">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:UploadViewModel">
            <StackPanel Orientation="Vertical" Spacing="20">
                <atom:Upload Name="MaxCount1Upload" MaxCount="1" UploadTransport="{Binding UploadTransport}" UploadTaskFailed="HandleUploadFailed" UploadTaskCompleted="HandleUploadCompleted">
                    <atom:Button Icon="{antdicons:AntDesignIconProvider UploadOutlined}" Content="{gallery:UploadShowCaseLangResource P2ContentUploadMaxN1}" />
                </atom:Upload>

                <atom:Upload Name="MaxCount3Upload" MaxCount="3" IsMultipleEnabled="True" UploadTransport="{Binding UploadTransport}" UploadTaskFailed="HandleUploadFailed" UploadTaskCompleted="HandleUploadCompleted">
                    <atom:Button Icon="{antdicons:AntDesignIconProvider UploadOutlined}" Content="{gallery:UploadShowCaseLangResource P2ContentUploadMaxN3}" />
                </atom:Upload>
            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:UploadShowCaseLangResource UploadDirectoryTitle}"
            IsDeferredContentEnabled="True"
            Description="{gallery:UploadShowCaseLangResource UploadDirectoryDescription}">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:UploadViewModel">
            <atom:Upload Name="DirectoryUpload" IsUploadDirectoryEnabled="True" UploadTransport="{Binding UploadTransport}" UploadTaskFailed="HandleUploadFailed" UploadTaskCompleted="HandleUploadCompleted">
                <atom:Button Icon="{antdicons:AntDesignIconProvider UploadOutlined}" Content="{gallery:UploadShowCaseLangResource P2ContentUploadDirectory}" />
            </atom:Upload>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:UploadShowCaseLangResource UploadPngOnlyTitle}"
            IsDeferredContentEnabled="True"
            Description="{gallery:UploadShowCaseLangResource UploadPngOnlyDescription}">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:UploadViewModel">
            <atom:Upload Name="PngOnlyUpload" Accepts="*.png" UploadTransport="{Binding UploadTransport}" UploadTaskFailed="HandleUploadFailed" UploadTaskCompleted="HandleUploadCompleted" UploadTaskAboutToScheduling="HandlePngUploadAboutToScheduling">
                <atom:Button Icon="{antdicons:AntDesignIconProvider UploadOutlined}" Content="{gallery:UploadShowCaseLangResource P2ContentUploadPngOnly}" />
            </atom:Upload>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>
                </gallery:ShowCasePanel>
            </ContentControl>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
