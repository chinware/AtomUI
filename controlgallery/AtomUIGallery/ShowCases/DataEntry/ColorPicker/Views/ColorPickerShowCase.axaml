<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.ColorPicker.ColorPickerShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.ColorPicker"
             x:DataType="vm:ColorPickerViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <StackPanel Margin="28,24,28,18"
                            Spacing="16">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <atom:TextBlock Text="ColorPicker"
                                            FontSize="26"
                                            FontWeight="Bold"
                                            VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:ColorPickerShowCaseLangResource ComponentCategory}"
                                      TagColor="blue"
                                      VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:ColorPickerShowCaseLangResource ComponentStatusStable}"
                                      TagColor="success"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                        <atom:TextBlock Text="{gallery:ColorPickerShowCaseLangResource PageSubtitle}"
                                        FontSize="15"
                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                        <atom:TextBlock Text="{gallery:ColorPickerShowCaseLangResource PageDescription}"
                                        HorizontalAlignment="Left"
                                        TextWrapping="Wrap"
                                        Foreground="{atom:SharedTokenResource ColorTextTertiary}" />
                    </StackPanel>

                    <Border Background="{atom:SharedTokenResource ColorBgContainer}"
                            BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinHeight="48"
                            Padding="16,8">
                        <Border.Styles>
                            <Style Selector="atom|TextBlock.info-label">
                                <Setter Property="Width" Value="84" />
                            </Style>
                            <Style Selector="atom|TextBlock.info-value">
                                <Setter Property="Width" Value="200" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </Border.Styles>
                        <WrapPanel Orientation="Horizontal"
                                   ItemSpacing="48"
                                   LineSpacing="8"
                                   VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:ColorPickerShowCaseLangResource InfoNamespaceLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:ColorPickerShowCaseLangResource InfoPackageLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls.ColorPicker"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:ColorPickerShowCaseLangResource InfoBaseClassLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AbstractColorPicker"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </gallery:GalleryStickyTabsHost.Header>

            <gallery:GalleryStickyTabsHost.StickyContent>
                <atom:TabStrip Name="ScenarioTabs"
                               SizeType="Large"
                               SelectedIndex="0">
                    <atom:TabStripItem Content="{gallery:ColorPickerShowCaseLangResource ScenarioExamples}"
                                       Tag="Examples"
                                       IsSelected="True" />
                    <atom:TabStripItem Content="{gallery:ColorPickerShowCaseLangResource ScenarioApi}"
                                       Tag="Api" />
                    <atom:TabStripItem Content="{gallery:ColorPickerShowCaseLangResource ScenarioDesignToken}"
                                       Tag="DesignToken" />
                </atom:TabStrip>
            </gallery:GalleryStickyTabsHost.StickyContent>

            <ContentControl Name="ScenarioContentHost">
                <gallery:ShowCasePanel Name="ExamplesContent"
                                       IsScrollEnabled="False"
                                       IsDeferredLoadingEnabled="True"
                                       InitialDeferredLoadItemCount="4"
                                       DeferredLoadBatchSize="2"
                                       ContentMargin="28,10,28,28">
        <gallery:ShowCaseItem
            Title="{gallery:ColorPickerShowCaseLangResource BasicTitle}"
            Description="{gallery:ColorPickerShowCaseLangResource BasicDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:ColorPickerViewModel">
            <atom:ColorPicker DefaultValue="#1677ff"/>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>
        
        <gallery:ShowCaseItem
            Title="{gallery:ColorPickerShowCaseLangResource TriggerSizeTitle}"
            Description="{gallery:ColorPickerShowCaseLangResource TriggerSizeDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:ColorPickerViewModel">
            <StackPanel Orientation="Vertical" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <atom:TextBlock Width="64"
                                    VerticalAlignment="Center"
                                    Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                    Text="{gallery:ColorPickerShowCaseLangResource P2LabelSizeTypeSmall}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <atom:ColorPicker DefaultValue="#1677ff" SizeType="Small"/>
                        <atom:ColorPicker DefaultValue="#1677ff" SizeType="Small" IsTextVisible="True"/>
                    </StackPanel>
                </StackPanel>
        
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <atom:TextBlock Width="64"
                                    VerticalAlignment="Center"
                                    Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                    Text="{gallery:ColorPickerShowCaseLangResource P2LabelSizeTypeMiddle}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <atom:ColorPicker DefaultValue="#1677ff" SizeType="Middle"/>
                        <atom:ColorPicker DefaultValue="#1677ff" SizeType="Middle" IsTextVisible="True"/>
                    </StackPanel>
                </StackPanel>
        
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <atom:TextBlock Width="64"
                                    VerticalAlignment="Center"
                                    Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                    Text="{gallery:ColorPickerShowCaseLangResource P2LabelSizeTypeLarge}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <atom:ColorPicker DefaultValue="#1677ff" SizeType="Large"/>
                        <atom:ColorPicker DefaultValue="#1677ff" SizeType="Large" IsTextVisible="True"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <atom:TextBlock Width="64"
                                    VerticalAlignment="Center"
                                    Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                    Text="{gallery:ColorPickerShowCaseLangResource P2LabelSizeTypeCustom}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <atom:ColorPicker DefaultValue="#1677ff"
                                          SizeType="Custom"
                                          Width="48"
                                          Height="48" />
                        <atom:ColorPicker DefaultValue="#1677ff"
                                          SizeType="Custom"
                                          IsTextVisible="True"
                                          Height="48"
                                          FontSize="18" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>
        
        <gallery:ShowCaseItem
            Title="{gallery:ColorPickerShowCaseLangResource LineGradientTitle}"
            Description="{gallery:ColorPickerShowCaseLangResource LineGradientDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:ColorPickerViewModel">
            <StackPanel Orientation="Vertical" Spacing="10">
                <atom:GradientColorPicker IsTextVisible="True">
                    <atom:GradientColorPicker.DefaultValue>
                        <LinearGradientBrush>
                            <GradientStop Color="#108ee9" Offset="0"/>
                            <GradientStop Color="#87d068" Offset="1"/>
                        </LinearGradientBrush>
                    </atom:GradientColorPicker.DefaultValue>
                </atom:GradientColorPicker>
            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>
        
        <gallery:ShowCaseItem
            Title="{gallery:ColorPickerShowCaseLangResource RenderingTriggerTextTitle}"
            Description="{gallery:ColorPickerShowCaseLangResource RenderingTriggerTextDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:ColorPickerViewModel">
            <StackPanel Orientation="Vertical" Spacing="10">
                <atom:ColorPicker DefaultValue="#1677ff" IsTextVisible="True" IsClearEnabled="True"/>
                <atom:ColorPicker Name="CustomRenderText"
                                  DefaultValue="#1677ff"
                                  IsTextVisible="True"
                                  AttachedToVisualTree="HandleCustomRenderTextAttached" />
            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>
        
        <gallery:ShowCaseItem
            Title="{gallery:ColorPickerShowCaseLangResource DisabledTitle}"
            Description="{gallery:ColorPickerShowCaseLangResource DisabledDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:ColorPickerViewModel">
            <StackPanel Orientation="Vertical" Spacing="10">
                <atom:ColorPicker DefaultValue="#1677ff" IsTextVisible="True" IsEnabled="False"/>
            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>
        <gallery:ShowCaseItem
            Title="{gallery:ColorPickerShowCaseLangResource DisabledAlphaTitle}"
            Description="{gallery:ColorPickerShowCaseLangResource DisabledAlphaDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:ColorPickerViewModel">
            <StackPanel Orientation="Vertical" Spacing="10">
                <atom:ColorPicker DefaultValue="#1677ff" IsAlphaEnabled="False"/>
            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>
        
        <gallery:ShowCaseItem
            Title="{gallery:ColorPickerShowCaseLangResource ClearColorTitle}"
            Description="{gallery:ColorPickerShowCaseLangResource ClearColorDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:ColorPickerViewModel">
            <StackPanel Orientation="Vertical" Spacing="10">
                <atom:ColorPicker DefaultValue="#1677ff" IsTextVisible="True" IsClearEnabled="True"/>
                <atom:GradientColorPicker IsTextVisible="True" IsClearEnabled="True">
                    <atom:GradientColorPicker.DefaultValue>
                        <LinearGradientBrush>
                            <GradientStop Color="#108ee9" Offset="0"/>
                            <GradientStop Color="#87d068" Offset="1"/>
                        </LinearGradientBrush>
                    </atom:GradientColorPicker.DefaultValue>
                </atom:GradientColorPicker>
            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>
        
        <gallery:ShowCaseItem
            Title="{gallery:ColorPickerShowCaseLangResource ControlledModeTitle}"
            Description="{gallery:ColorPickerShowCaseLangResource ControlledModeDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:ColorPickerViewModel">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <atom:ColorPicker DefaultValue="#1677ff"/>
                <atom:ColorPicker DefaultValue="#1677ff" ValueSyncStrategy="OnCompleted"/>
            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>
        
        <gallery:ShowCaseItem
            Title="{gallery:ColorPickerShowCaseLangResource CustomTriggerEventTitle}"
            Description="{gallery:ColorPickerShowCaseLangResource CustomTriggerEventDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:ColorPickerViewModel">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <atom:ColorPicker DefaultValue="#1677ff" TriggerType="Click"/>
                <atom:ColorPicker DefaultValue="#1677ff" TriggerType="Hover"/>
            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>
        
        <gallery:ShowCaseItem
            Title="{gallery:ColorPickerShowCaseLangResource ColorFormatTitle}"
            Description="{gallery:ColorPickerShowCaseLangResource ColorFormatDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:ColorPickerViewModel">
            <StackPanel Orientation="Vertical" Spacing="10">
                <atom:ColorPicker DefaultValue="#1677ff" Format="Hex" IsTextVisible="True"/>
                <atom:ColorPicker DefaultValue="#1677ff" Format="Hsva" IsTextVisible="True"/>
                <atom:ColorPicker DefaultValue="#1677ff" Format="Rgba" IsTextVisible="True"/>
            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>
        
        <gallery:ShowCaseItem
            Title="{gallery:ColorPickerShowCaseLangResource PresetColorsTitle}"
            Description="{gallery:ColorPickerShowCaseLangResource PresetColorsDescription}"
            IsOccupyEntireRow="True"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:ColorPickerViewModel">
            <StackPanel Spacing="10" Orientation="Horizontal">
                <atom:ColorPicker DefaultValue="#1677ff" IsPaletteGroupEnabled="True"/>
                <atom:GradientColorPicker IsPaletteGroupEnabled="True" >
                    <atom:GradientColorPicker.DefaultValue>
                        <LinearGradientBrush>
                            <GradientStop Color="#108ee9" Offset="0"/>
                            <GradientStop Color="#87d068" Offset="1"/>
                        </LinearGradientBrush>
                    </atom:GradientColorPicker.DefaultValue>
                </atom:GradientColorPicker>
            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>
                </gallery:ShowCasePanel>
            </ContentControl>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
