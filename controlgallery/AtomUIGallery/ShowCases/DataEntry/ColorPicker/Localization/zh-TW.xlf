        <source>Disabled</source>
        <target state="translated">禁用</target>
      </segment>
    </unit>
    <unit id="16" name="DisabledDescription">
      <segment>
        <source>Set to disabled state.</source>
        <target state="translated">設置為禁用狀態。</target>
      </segment>
    </unit>
    <unit id="17" name="DisabledAlphaTitle">
      <segment>
        <source>Disabled Alpha</source>
        <target state="translated">禁用透明度</target>
