    <unit id="1" name="BasicTitle">
      <segment>
        <source>Basic</source>
        <target state="translated">基礎用法</target>
      </segment>
    </unit>
    <unit id="2" name="BasicDescription">
      <segment>
        <source>Basic Usage.</source>
        <target state="translated">基礎用法。</target>
      </segment>
    </unit>
    <unit id="3" name="ValueBindingTitle">
      <segment>
        <source>Value binding</source>
        <target state="translated">Value 綁定</target>
      </segment>
    </unit>
    <unit id="4" name="ValueBindingDescription">
      <segment>
        <source>Value now defaults to TwoWay binding for both solid and gradient pickers, so edits update the ViewModel without an explicit binding mode.</source>
        <target state="translated">純色和漸變選擇器的 Value 現在默認雙向綁定，編輯顏色會直接更新 ViewModel，無需顯式設置綁定模式。</target>
      </segment>
    </unit>
    <unit id="5" name="TriggerSizeTitle">
      <segment>
        <source>Trigger size</source>
        <target state="translated">觸發器尺寸</target>
      </segment>
    </unit>
    <unit id="6" name="TriggerSizeDescription">
      <segment>
        <source>Ant Design supports three trigger sizes: small, default and large.If a large or small trigger is desired, set the size property to either large or small.respectively. Omit the size property for a trigger with the default size.</source>
        <target state="translated">Ant Design 支持小號、默認和大號三種觸發器尺寸。需要大號或小號觸發器時分別設置 size 屬性；省略 size 屬性時使用默認尺寸。</target>
      </segment>
    </unit>
    <unit id="7" name="P2LabelSizeTypeSmall">
