    <unit id="21" name="ControlledModeTitle">
      <segment>
        <source>controlled mode</source>
        <target state="translated">受控模式</target>
      </segment>
    </unit>
    <unit id="22" name="ControlledModeDescription">
      <segment>
        <source>Set the component to controlled mode. Will lock the display color if controlled by.</source>
        <target state="translated">將組件設置為受控模式。受控時會鎖定顯示顏色。</target>
      </segment>
    </unit>
    <unit id="23" name="CustomTriggerEventTitle">
      <segment>
        <source>Custom Trigger Event</source>
        <target state="translated">自定義觸發事件</target>
      </segment>
    </unit>
    <unit id="24" name="CustomTriggerEventDescription">
      <segment>
        <source>Triggers event for customizing color panels, provide options click and hover.</source>
        <target state="translated">自定義顏色面板的觸發事件，可選 click 和 hover。</target>
      </segment>
    </unit>
    <unit id="25" name="ColorFormatTitle">
      <segment>
        <source>Color Format</source>
        <target state="translated">顏色格式</target>
      </segment>
    </unit>
    <unit id="26" name="ColorFormatDescription">
      <segment>
        <source>Encoding formats, support HEX, HSB, RGB.</source>
        <target state="translated">編碼格式，支持 HEX、HSB、RGB。</target>
      </segment>
    </unit>
    <unit id="27" name="PresetColorsTitle">
      <segment>
        <source>Preset Colors</source>
        <target state="translated">預設顏色</target>
      </segment>
    </unit>
    <unit id="28" name="PresetColorsDescription">
      <segment>
        <source>Set the presets color of the color picker.</source>
        <target state="translated">設置顏色選擇器的預設顏色。</target>
      </segment>
    </unit>
    <unit id="29" name="PageSubtitle">
      <segment>
        <source>Pick solid colors or gradients from a compact trigger.</source>
        <target state="translated">從緊湊觸發器中選擇純色或漸變色。</target>
      </segment>
    </unit>
    <unit id="30" name="PageDescription">
      <segment>
        <source>ColorPicker supports solid and gradient values, trigger sizing, alpha control, text rendering, value synchronization, hover or click triggers, and preset palettes.</source>
        <target state="translated">ColorPicker 支援純色與漸變值、觸發器尺寸、透明度控制、文字渲染、值同步策略、點擊或懸浮觸發，以及預設調色板。</target>
      </segment>
    </unit>
