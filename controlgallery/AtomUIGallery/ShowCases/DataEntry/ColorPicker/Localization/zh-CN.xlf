    <unit id="12" name="LineGradientDescription">
      <segment>
        <source>Set the color to a single or a gradient color via mode.</source>
        <target state="translated">通过 mode 将颜色设置为单色或渐变色。</target>
      </segment>
    </unit>
    <unit id="13" name="RenderingTriggerTextTitle">
      <segment>
        <source>Rendering Trigger Text</source>
        <target state="translated">渲染触发器文本</target>
      </segment>
    </unit>
    <unit id="14" name="RenderingTriggerTextDescription">
      <segment>
        <source>Renders the default text of the trigger, effective when showText is true. When customizing text, you can use showText as a function to return custom text.</source>
        <target state="translated">当 showText 为 true 时渲染触发器默认文本。自定义文本时，可以将 showText 作为函数返回自定义文本。</target>
      </segment>
    </unit>
