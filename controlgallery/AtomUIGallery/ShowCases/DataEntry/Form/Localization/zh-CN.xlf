    <unit id="1" name="BasicUsageTitle">
      <segment>
        <source>Basic usage</source>
        <target state="translated">基础用法</target>
      </segment>
    </unit>
    <unit id="2" name="BasicUsageDescription">
      <segment>
        <source>Basic Form data control. Includes layout, initial values, validation and submit.</source>
        <target state="translated">基础表单数据控制，包含布局、初始值、校验和提交。</target>
      </segment>
    </unit>
    <unit id="3" name="FormMethodsTitle">
      <segment>
        <source>Form methods</source>
        <target state="translated">表单方法</target>
      </segment>
    </unit>
    <unit id="4" name="FormMethodsDescription">
      <segment>
        <source>Call form method with Form.</source>
        <target state="translated">通过 Form 调用表单方法。</target>
      </segment>
    </unit>
    <unit id="5" name="CustomizedFormControlsTitle">
      <segment>
        <source>Customized Form Controls</source>
        <target state="translated">自定义表单控件</target>
      </segment>
    </unit>
    <unit id="6" name="CustomizedFormControlsDescription">
      <segment>
        <source>Customized or third-party form controls can be used in Form, too. Controls must implement IFormItemAware:</source>
        <target state="translated">Form 中也可以使用自定义或第三方表单控件。控件必须实现 IFormItemAware：</target>
      </segment>
    </unit>
    <unit id="7" name="OtherFormControlsTitle">
      <segment>
        <source>Other Form Controls</source>
        <target state="translated">其他表单控件</target>
      </segment>
    </unit>
    <unit id="8" name="OtherFormControlsDescription">
      <segment>
        <source>Demonstration of validation configuration for form controls which are not shown in the demos above.</source>
        <target state="translated">演示上述示例中未展示的表单控件校验配置。</target>
      </segment>
    </unit>
    <unit id="9" name="DynamicFormItemTitle">
      <segment>
        <source>Dynamic Form Item</source>
        <target state="translated">动态表单项</target>
      </segment>
    </unit>
    <unit id="10" name="DynamicFormItemDescription">
      <segment>
        <source>Add or remove form items dynamically. add function support config initial value.</source>
        <target state="translated">动态添加或移除表单项。add 函数支持配置初始值。</target>
      </segment>
    </unit>
    <unit id="11" name="FormLayoutTitle">
      <segment>
        <source>Form Layout</source>
        <target state="translated">表单布局</target>
      </segment>
    </unit>
    <unit id="12" name="FormLayoutDescription">
      <segment>
        <source>There are three layout for form: horizontal, vertical, inline.</source>
        <target state="translated">表单有三种布局：水平、垂直和行内。</target>
      </segment>
    </unit>
    <unit id="13" name="LabelCanWrapTitle">
      <segment>
        <source>label can wrap</source>
        <target state="translated">标签可换行</target>
      </segment>
    </unit>
    <unit id="14" name="LabelCanWrapDescription">
      <segment>
        <source>Turn on labelWrap to wrap label if text is long.</source>
        <target state="translated">开启 labelWrap 后，标签文本过长时会自动换行。</target>
      </segment>
    </unit>
    <unit id="15" name="InlineLoginFormTitle">
      <segment>
        <source>Inline Login Form</source>
        <target state="translated">行内登录表单</target>
      </segment>
    </unit>
    <unit id="16" name="InlineLoginFormDescription">
      <segment>
        <source>Inline login form is often used in navigation bar.</source>
        <target state="translated">行内登录表单常用于导航栏。</target>
      </segment>
    </unit>
    <unit id="17" name="LoginFormTitle">
      <segment>
        <source>Login Form</source>
        <target state="translated">登录表单</target>
      </segment>
    </unit>
    <unit id="18" name="LoginFormDescription">
      <segment>
        <source>Normal login form which can contain more elements.</source>
        <target state="translated">普通登录表单，可以包含更多元素。</target>
      </segment>
    </unit>
    <unit id="19" name="RegistrationTitle">
      <segment>
        <source>Registration</source>
        <target state="translated">注册</target>
      </segment>
    </unit>
    <unit id="20" name="RegistrationDescription">
      <segment>
        <source>Fill in this form to create a new account for you.</source>
        <target state="translated">填写此表单创建新账号。</target>
      </segment>
    </unit>
    <unit id="21" name="FormVariantsTitle">
      <segment>
        <source>Form variants</source>
        <target state="translated">表单变体</target>
      </segment>
    </unit>
    <unit id="22" name="FormVariantsDescription">
      <segment>
        <source>Change the variant of all components in the form, options include: outlined filled borderless and underlined.</source>
        <target state="translated">改变表单中所有组件的变体，可选描边、填充、无边框和下划线。</target>
      </segment>
    </unit>
    <unit id="23" name="RequiredStyleTitle">
      <segment>
        <source>Required style</source>
        <target state="translated">必填样式</target>
      </segment>
    </unit>
    <unit id="24" name="RequiredStyleDescription">
      <segment>
        <source>Switch required or optional style with requiredMark.</source>
        <target state="translated">通过 requiredMark 切换必填或可选样式。</target>
      </segment>
    </unit>
    <unit id="25" name="NoBlockRuleTitle">
      <segment>
        <source>No block rule</source>
        <target state="translated">非阻塞规则</target>
      </segment>
    </unit>
    <unit id="26" name="NoBlockRuleDescription">
      <segment>
        <source>rule with warningOnly will not block form submit.</source>
        <target state="translated">带 warningOnly 的规则不会阻止表单提交。</target>
      </segment>
    </unit>
    <unit id="27" name="ValidateTriggerTitle">
      <segment>
        <source>Validate Trigger</source>
        <target state="translated">校验触发时机</target>
      </segment>
    </unit>
    <unit id="28" name="ValidateTriggerDescription">
      <segment>
        <source>For the async validation scenario, high frequency of verification will cause backend pressure. You can change the verification timing through validateTrigger, or change the verification frequency through validateDebounce, or set the verification short circuit through validateFirst.</source>
        <target state="translated">在异步校验场景中，高频校验会给后端带来压力。可以通过 validateTrigger 改变校验时机，通过 validateDebounce 改变校验频率，或通过 validateFirst 设置校验短路。</target>
      </segment>
    </unit>
    <unit id="29" name="ValidateOnlyTitle">
      <segment>
        <source>Validate Only</source>
        <target state="translated">仅校验</target>
      </segment>
    </unit>
    <unit id="30" name="ValidateOnlyDescription">
      <segment>
        <source>Dynamic adjust submit button's disabled status by validateOnly of validateFields.</source>
        <target state="translated">通过 validateFields 的 validateOnly 动态调整提交按钮的禁用状态。</target>
      </segment>
    </unit>
    <unit id="31" name="TimeRelatedControlsTitle">
      <segment>
        <source>Time-related Controls</source>
        <target state="translated">时间相关控件</target>
      </segment>
    </unit>
    <unit id="32" name="TimeRelatedControlsDescription">
      <segment>
        <source>The value of time-related components is a dayjs object, which we need to pre-process it before we submit to server.</source>
        <target state="translated">时间相关组件的值是 dayjs 对象，提交到服务端前需要预处理。</target>
      </segment>
    </unit>
    <unit id="33" name="CustomizedValidationTitle">
      <segment>
        <source>Customized Validation</source>
        <target state="translated">自定义校验</target>
      </segment>
    </unit>
    <unit id="34" name="CustomizedValidationDescription">
      <segment>
        <source>We provide properties like validateStatus help hasFeedback to customize your own validate status and message, without using Form.</source>
        <target state="translated">不使用 Form 时，也可以通过 validateStatus、help、hasFeedback 等属性自定义校验状态和信息。</target>
      </segment>
    </unit>
