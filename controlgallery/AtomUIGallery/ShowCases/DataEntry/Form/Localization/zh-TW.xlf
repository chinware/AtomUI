        <source>Customized Validation</source>
        <target state="translated">自定義校驗</target>
      </segment>
    </unit>
    <unit id="34" name="CustomizedValidationDescription">
      <segment>
        <source>We provide properties like validateStatus help hasFeedback to customize your own validate status and message, without using Form.</source>
        <target state="translated">不使用 Form 時，也可以通過 validateStatus、help、hasFeedback 等屬性自定義校驗狀態和信息。</target>
      </segment>
    </unit>
