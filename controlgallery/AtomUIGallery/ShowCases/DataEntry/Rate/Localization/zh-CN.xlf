    <unit id="9" name="TwoWayBindingDescription">
      <segment>
        <source>Value uses TwoWay binding by default, so user selection and ViewModel updates stay synchronized.</source>
        <target state="translated">Value 默认使用 TwoWay 绑定，用户评分和 ViewModel 更新会保持同步。</target>
      </segment>
    </unit>
