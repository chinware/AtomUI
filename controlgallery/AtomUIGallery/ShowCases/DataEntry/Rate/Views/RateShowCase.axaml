<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Rate.RateShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Rate"
             x:DataType="vm:RateViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Rate"
                    Category="{gallery:RateShowCaseLangResource ComponentCategory}"
                    Status="{gallery:RateShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:RateShowCaseLangResource PageSubtitle}"
                    Description="{gallery:RateShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="AbstractRate" />
            </gallery:GalleryStickyTabsHost.Header>

            <gallery:GalleryStickyTabsHost.StickyContent>
                <atom:TabStrip Name="ScenarioTabs"
                               SizeType="Large"
                               SelectedIndex="0">
                    <atom:TabStripItem Content="{gallery:RateShowCaseLangResource ScenarioExamples}"
                                       Tag="Examples"
                                       IsSelected="True" />
                    <atom:TabStripItem Content="{gallery:RateShowCaseLangResource ScenarioApi}"
                                       Tag="Api" />
                    <atom:TabStripItem Content="{gallery:RateShowCaseLangResource ScenarioDesignToken}"
                                       Tag="DesignToken" />
                </atom:TabStrip>
            </gallery:GalleryStickyTabsHost.StickyContent>

            <ContentControl Name="ScenarioContentHost">
                <gallery:ShowCasePanel Name="ExamplesContent"
                                       IsScrollEnabled="False"
                                       IsDeferredLoadingEnabled="True"
                                       InitialDeferredLoadItemCount="4"
                                       DeferredLoadBatchSize="2"
                                       ContentMargin="28,10,28,28">
        <gallery:ShowCaseItem
            Title="{gallery:RateShowCaseLangResource BasicTitle}"
            Description="{gallery:RateShowCaseLangResource BasicDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:RateViewModel">
            <atom:Rate/>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:RateShowCaseLangResource HalfStarTitle}"
            Description="{gallery:RateShowCaseLangResource HalfStarDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:RateViewModel">
            <atom:Rate DefaultValue="3.5" IsAllowHalf="True"/>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:RateShowCaseLangResource ShowCopywritingTitle}"
            Description="{gallery:RateShowCaseLangResource ShowCopywritingDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:RateViewModel">
            <StackPanel Orientation="Vertical" Spacing="10">
                <atom:Rate Name="ToolTipRate"
                           ToolTips="{Binding Tooltips}"
                           ValueChanged="HandleValueChanged"/>
                <TextBlock Text="{Binding ActiveTooltip}"/>
            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:RateShowCaseLangResource ReadOnlyTitle}"
            Description="{gallery:RateShowCaseLangResource ReadOnlyDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:RateViewModel">
            <atom:Rate DefaultValue="2" IsEnabled="False"/>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:RateShowCaseLangResource ClearStarTitle}"
            Description="{gallery:RateShowCaseLangResource ClearStarDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:RateViewModel">
            <StackPanel Spacing="20">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <atom:Rate DefaultValue="3" IsAllowClear="True" />
                    <TextBlock Text="{gallery:RateShowCaseLangResource P2TextIsallowclearTrue}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <atom:Rate DefaultValue="3" IsAllowClear="False" />
                    <TextBlock Text="{gallery:RateShowCaseLangResource P2TextIsallowclearFalse}" />
                </StackPanel>
            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:RateShowCaseLangResource OtherCharacterTitle}"
            Description="{gallery:RateShowCaseLangResource OtherCharacterDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:RateViewModel">
            <StackPanel Orientation="Vertical" Spacing="10">
                <atom:Rate IsAllowHalf="True" IsAllowClear="True" Character="{antdicons:AntDesignIconProvider HeartOutlined}"/>
                <atom:Rate IsAllowHalf="True" IsAllowClear="True" Character="A"/>
                <atom:Rate IsAllowHalf="True" IsAllowClear="True" Character="秦"/>
            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>
                </gallery:ShowCasePanel>
            </ContentControl>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
