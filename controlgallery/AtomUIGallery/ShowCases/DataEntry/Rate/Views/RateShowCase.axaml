<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Rate.RateShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Rate"
             x:DataType="vm:RateViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <StackPanel Margin="28,24,28,18"
                            Spacing="16">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <atom:TextBlock Text="Rate"
                                            FontSize="26"
                                            FontWeight="Bold"
                                            VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:RateShowCaseLangResource ComponentCategory}"
                                      TagColor="blue"
                                      VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:RateShowCaseLangResource ComponentStatusStable}"
                                      TagColor="success"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                        <atom:TextBlock Text="{gallery:RateShowCaseLangResource PageSubtitle}"
                                        FontSize="15"
                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                        <atom:TextBlock Text="{gallery:RateShowCaseLangResource PageDescription}"
                                        HorizontalAlignment="Left"
                                        TextWrapping="Wrap"
                                        Foreground="{atom:SharedTokenResource ColorTextTertiary}" />
                    </StackPanel>

                    <Border Background="{atom:SharedTokenResource ColorBgContainer}"
                            BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinHeight="48"
                            Padding="16,8">
                        <Border.Styles>
                            <Style Selector="atom|TextBlock.info-label">
                                <Setter Property="Width" Value="84" />
                            </Style>
                            <Style Selector="atom|TextBlock.info-value">
                                <Setter Property="Width" Value="200" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </Border.Styles>
                        <WrapPanel Orientation="Horizontal"
                                   ItemSpacing="48"
                                   LineSpacing="8"
                                   VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:RateShowCaseLangResource InfoNamespaceLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:RateShowCaseLangResource InfoPackageLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:RateShowCaseLangResource InfoBaseClassLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AbstractRate"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </gallery:GalleryStickyTabsHost.Header>

            <gallery:GalleryStickyTabsHost.StickyContent>
                <atom:TabStrip Name="ScenarioTabs"
                               SizeType="Large"
                               SelectedIndex="0">
                    <atom:TabStripItem Content="{gallery:RateShowCaseLangResource ScenarioExamples}"
                                       Tag="Examples"
                                       IsSelected="True" />
                    <atom:TabStripItem Content="{gallery:RateShowCaseLangResource ScenarioApi}"
                                       Tag="Api" />
                    <atom:TabStripItem Content="{gallery:RateShowCaseLangResource ScenarioDesignToken}"
                                       Tag="DesignToken" />
                </atom:TabStrip>
            </gallery:GalleryStickyTabsHost.StickyContent>

            <ContentControl Name="ScenarioContentHost">
                <gallery:ShowCasePanel Name="ExamplesContent"
                                       IsScrollEnabled="False"
                                       ContentMargin="28,10,28,28">
        <gallery:ShowCaseItem
            Title="{gallery:RateShowCaseLangResource BasicTitle}"
            Description="{gallery:RateShowCaseLangResource BasicDescription}">
            <atom:Rate/>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:RateShowCaseLangResource HalfStarTitle}"
            Description="{gallery:RateShowCaseLangResource HalfStarDescription}">
            <atom:Rate DefaultValue="3.5" IsAllowHalf="True"/>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:RateShowCaseLangResource ShowCopywritingTitle}"
            Description="{gallery:RateShowCaseLangResource ShowCopywritingDescription}">
            <StackPanel Orientation="Vertical" Spacing="10">
                <atom:Rate Name="ToolTipRate" ValueChanged="HandleValueChanged"/>
                <TextBlock Text="{Binding ActiveTooltip}"/>
            </StackPanel>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:RateShowCaseLangResource ReadOnlyTitle}"
            Description="{gallery:RateShowCaseLangResource ReadOnlyDescription}">
            <atom:Rate DefaultValue="2" IsEnabled="False"/>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:RateShowCaseLangResource ClearStarTitle}"
            Description="{gallery:RateShowCaseLangResource ClearStarDescription}">
            <StackPanel Spacing="20">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <atom:Rate DefaultValue="3" IsAllowClear="True" />
                    <TextBlock Text="{gallery:RateShowCaseLangResource P2TextIsallowclearTrue}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <atom:Rate DefaultValue="3" IsAllowClear="False" />
                    <TextBlock Text="{gallery:RateShowCaseLangResource P2TextIsallowclearFalse}" />
                </StackPanel>
            </StackPanel>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:RateShowCaseLangResource OtherCharacterTitle}"
            Description="{gallery:RateShowCaseLangResource OtherCharacterDescription}">
            <StackPanel Orientation="Vertical" Spacing="10">
                <atom:Rate IsAllowHalf="True" IsAllowClear="True" Character="{antdicons:AntDesignIconProvider HeartOutlined}"/>
                <atom:Rate IsAllowHalf="True" IsAllowClear="True" Character="A"/>
                <atom:Rate IsAllowHalf="True" IsAllowClear="True" Character="秦"/>
            </StackPanel>
        </gallery:ShowCaseItem>
                </gallery:ShowCasePanel>
            </ContentControl>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
