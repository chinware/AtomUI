        <source>Controlled keys</source>
        <target state="translated">受控 key</target>
      </segment>
    </unit>
    <unit id="16" name="ControlledKeysDescription">
      <segment>
        <source>Bind TargetKeys and SelectedKeys to ObservableCollection values. External collection mutations and Transfer interactions stay synchronized.</source>
        <target state="translated">将 TargetKeys 和 SelectedKeys 绑定到 ObservableCollection。外部集合变更和 Transfer 交互会保持同步。</target>
      </segment>
    </unit>
