<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Transfer.TransferShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Transfer"
             xmlns:viewModels="clr-namespace:AtomUIGallery.ShowCases.Transfer"
             x:DataType="vm:TransferViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Transfer"
                    Category="{gallery:TransferShowCaseLangResource ComponentCategory}"
                    Status="{gallery:TransferShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:TransferShowCaseLangResource PageSubtitle}"
                    Description="{gallery:TransferShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="ListTransfer / TreeTransfer"
                    MetadataValueWidth="220" />
            </gallery:GalleryStickyTabsHost.Header>


            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
                <gallery:ShowCaseItem
        Title="{gallery:TransferShowCaseLangResource BasicTitle}"
        IsOccupyEntireRow="True"
        Description="{gallery:TransferShowCaseLangResource BasicDescription}" IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TransferViewModel">
        <atom:ListTransfer Name="BasicListTransfer"
                           SourceTitle="{gallery:TransferShowCaseLangResource P2SourceTitle}"
                           TargetTitle="{gallery:TransferShowCaseLangResource P2TargetTitle}"
                           ItemsSource="{Binding BasicTransferItems}" />
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TransferShowCaseLangResource OneWayTitle}"
        IsOccupyEntireRow="True"
        Description="{gallery:TransferShowCaseLangResource OneWayDescription}" IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TransferViewModel">
        <StackPanel Spacing="20">
            <atom:ListTransfer Name="OneWayTransferList"
                               SourceTitle="{gallery:TransferShowCaseLangResource P2SourceTitle}"
                               TargetTitle="{gallery:TransferShowCaseLangResource P2TargetTitle}"
                               IsOneWay="True"
                               IsEnabled="{Binding OneWayTransferEnabled}"
                               ItemsSource="{Binding OneWayTransferItems}" />
            <atom:ToggleSwitch IsChecked="{Binding OneWayTransferEnabled, Mode=TwoWay}"
                               OnContent="{gallery:TransferShowCaseLangResource P2OnContentDisable}"
                               OffContent="{gallery:TransferShowCaseLangResource P2OffContentEnable}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TransferShowCaseLangResource SearchTitle}"
        IsOccupyEntireRow="True"
        Description="{gallery:TransferShowCaseLangResource SearchDescription}" IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TransferViewModel">
        <StackPanel Spacing="20">
            <atom:ListTransfer Name="SearchTransferList"
                               IsFilterEnabled="True"
                               FilterPlaceholderText="{gallery:TransferShowCaseLangResource P2FilterPlaceholderTextSearchHere}"
                               FilterValueSelector="{Binding TransferFilterValueSelector}"
                               ItemsSource="{Binding SearchTransferItems}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TransferShowCaseLangResource ControlledKeysTitle}"
        IsOccupyEntireRow="True"
        BadgeText="v6.0.8"
        Description="{gallery:TransferShowCaseLangResource ControlledKeysDescription}" IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TransferViewModel">
                <StackPanel Spacing="20">
                    <atom:ListTransfer Name="ControlledTransferList"
                                       SourceTitle="{gallery:TransferShowCaseLangResource P2SourceTitle}"
                                       TargetTitle="{gallery:TransferShowCaseLangResource P2TargetTitle}"
                                       ItemsSource="{Binding ControlledTransferItems}"
                                       TargetKeys="{Binding ControlledTransferTargetKeys}"
                                       SelectedKeys="{Binding ControlledTransferSelectedKeys}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <atom:Button SizeType="Small"
                                     Click="AddControlledTransferTargetKey"
                                     Content="{gallery:TransferShowCaseLangResource P2ContentAddTargetKey}" />
                        <atom:Button SizeType="Small"
                                     Click="ClearControlledTransferTargetKeys"
                                     Content="{gallery:TransferShowCaseLangResource P2ContentClearTargetKeys}" />
                        <atom:Button SizeType="Small"
                                     Click="SelectControlledTransferSourceKey"
                                     Content="{gallery:TransferShowCaseLangResource P2ContentSelectSourceKey}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <atom:TextBlock Text="{gallery:TransferShowCaseLangResource P2TargetKeysCountLabel}" />
                        <atom:TextBlock Text="{Binding ControlledTransferTargetKeys.Count}" />
                        <atom:TextBlock Text="{gallery:TransferShowCaseLangResource P2SelectedKeysCountLabel}" />
                        <atom:TextBlock Text="{Binding ControlledTransferSelectedKeys.Count}" />
                    </StackPanel>
                </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TransferShowCaseLangResource AdvancedTitle}"
        IsOccupyEntireRow="True"
        Description="{gallery:TransferShowCaseLangResource AdvancedDescription}" IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TransferViewModel">
        <atom:ListTransfer ToTargetButtonText="{gallery:TransferShowCaseLangResource P2ToTargetButtonTextToRight}"
                           ToSourceButtonText="{gallery:TransferShowCaseLangResource P2ToSourceButtonTextToLeft}"
                           ListWidth="300"
                           Name="AdvanceTransfer"
                           ItemsSource="{Binding AdvanceTransferItems}"
                           TargetKeys="{Binding AdvanceTransferDefaultTargetKeys, Mode=OneWay}">
            <atom:ListTransfer.SourceViewFooter>
                <atom:Button SizeType="Small" Click="ReloadAdvancedTransferItems" Content="{gallery:TransferShowCaseLangResource P2ContentLeftButtonReload}" />
            </atom:ListTransfer.SourceViewFooter>
            <atom:ListTransfer.TargetViewFooter>
                <atom:Button SizeType="Small" Click="ReloadAdvancedTransferItems" Content="{gallery:TransferShowCaseLangResource P2ContentRightButtonReload}" />
            </atom:ListTransfer.TargetViewFooter>
            <atom:ListTransfer.ItemTemplate>
                <DataTemplate x:DataType="viewModels:SearchCaseItemData">
                    <TextBlock TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Content}" />
                        <Run Text="{gallery:TransferShowCaseLangResource P2TextText}" />
                        <Run Text="{Binding Description}" />
                    </TextBlock>
                </DataTemplate>
            </atom:ListTransfer.ItemTemplate>
        </atom:ListTransfer>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TransferShowCaseLangResource PaginationTitle}"
        IsOccupyEntireRow="True"
        Description="{gallery:TransferShowCaseLangResource PaginationDescription}" IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TransferViewModel">
        <StackPanel Spacing="20">
            <atom:ListTransfer Name="PaginationTransferList"
                               IsOneWay="{Binding PaginationIsOneWay}"
                               PageSize="10"
                               ListHeight="370"
                               ItemsSource="{Binding PaginationTransferItems}" />
            <atom:ToggleSwitch IsChecked="{Binding PaginationIsOneWay, Mode=TwoWay}"
                               OnContent="{gallery:TransferShowCaseLangResource P2OnContentOnyWay}"
                               OffContent="{gallery:TransferShowCaseLangResource P2OffContentOnyWay}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TransferShowCaseLangResource TreeTransferTitle}"
        IsOccupyEntireRow="True"
        Description="{gallery:TransferShowCaseLangResource TreeTransferDescription}" IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TransferViewModel">
        <StackPanel Spacing="20">
            <atom:TreeTransfer Name="TreeTransfer"
                               IsStretchView="True"
                               IsOneWay="{Binding TreeTransferIsOneWay}"
                               ItemsSource="{Binding TransferTreeNodes}">
                <atom:TreeTransfer.SourceView>
                    <atom:TransferTreeView IsDefaultExpandAll="True" />
                </atom:TreeTransfer.SourceView>
            </atom:TreeTransfer>
            <atom:ToggleSwitch IsChecked="{Binding TreeTransferIsOneWay, Mode=TwoWay}"
                               OnContent="{gallery:TransferShowCaseLangResource P2OnContentOnyWay}"
                               OffContent="{gallery:TransferShowCaseLangResource P2OffContentOnyWay}" />
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>

    <gallery:ShowCaseItem
        Title="{gallery:TransferShowCaseLangResource StatusTitle}"
        IsOccupyEntireRow="True"
        Description="{gallery:TransferShowCaseLangResource StatusDescription}" IsDeferredContentEnabled="True">
        <gallery:ShowCaseItem.DeferredContentTemplate>
            <DataTemplate x:DataType="vm:TransferViewModel">
        <StackPanel Spacing="20">
            <atom:ListTransfer Status="Error"/>
            <atom:ListTransfer Status="Warning"/>
        </StackPanel>
            </DataTemplate>
        </gallery:ShowCaseItem.DeferredContentTemplate>
    </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
