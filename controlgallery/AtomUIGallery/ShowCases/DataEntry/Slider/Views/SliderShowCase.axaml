<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Slider.SliderShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Slider"
             x:DataType="vm:SliderViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Slider"
                    Category="{gallery:SliderShowCaseLangResource ComponentCategory}"
                    Status="{gallery:SliderShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:SliderShowCaseLangResource PageSubtitle}"
                    Description="{gallery:SliderShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Desktop.Controls"
                    Package="AtomUI.Desktop.Controls"
                    BaseClass="RangeBase" />
            </gallery:GalleryStickyTabsHost.Header>

            <gallery:ShowCasePanel Name="ExamplesContent"
                                   IsScrollEnabled="False"
                                   IsDeferredLoadingEnabled="True"
                                   InitialDeferredLoadItemCount="4"
                                   DeferredLoadBatchSize="2"
                                   ContentMargin="28,10,28,28">
                <gallery:ShowCaseItem
                    Title="{gallery:SliderShowCaseLangResource BasicTitle}"
                    Description="{gallery:SliderShowCaseLangResource BasicDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SliderViewModel">
                            <StackPanel Orientation="Vertical" Spacing="20">
                                <atom:Slider
                                    Maximum="100"
                                    Minimum="0"
                                    TickFrequency="5"
                                    IsEnabled="{Binding NormalEnabled}"
                                    Value="50" />

                                <atom:Slider
                                    Maximum="100"
                                    Minimum="0"
                                    IsRangeMode="True"
                                    TickFrequency="5"
                                    IsEnabled="{Binding NormalEnabled}"
                                    RangeValues="{Binding DefaultRangeValues, Mode=OneWay}" />
                                <atom:Slider
                                    Name="Slider1"
                                    Marks="{Binding SliderMarks}"
                                    Maximum="100"
                                    Minimum="0"
                                    IsEnabled="{Binding NormalEnabled}"
                                    IsRangeMode="True"
                                    TickFrequency="5"
                                    RangeValues="{Binding DefaultRangeValues, Mode=OneWay}" />

                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <atom:TextBlock VerticalAlignment="Center" Text="{gallery:SliderShowCaseLangResource P2TextEnabled}" />
                                    <atom:ToggleSwitch VerticalAlignment="Center" SizeType="Small" IsChecked="{Binding NormalEnabled, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:SliderShowCaseLangResource MultiHandleTitle}"
                    Description="{gallery:SliderShowCaseLangResource MultiHandleDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SliderViewModel">
                            <Grid MinHeight="160">
                                <atom:Slider
                                    VerticalAlignment="Center"
                                    Maximum="100"
                                    Minimum="0"
                                    IsRangeMode="True"
                                    TrackBarBrush="{x:Null}"
                                    RangeValues="{Binding MultiHandleRangeValues, Mode=OneWay}">
                                    <atom:Slider.TracksBrush>
                                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                            <GradientStop Color="#52C41A" Offset="0" />
                                            <GradientStop Color="#FAAD14" Offset="0.5" />
                                            <GradientStop Color="#FF4D4F" Offset="1" />
                                        </LinearGradientBrush>
                                    </atom:Slider.TracksBrush>
                                </atom:Slider>
                            </Grid>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:SliderShowCaseLangResource DisabledHandleTitle}"
                    Description="{gallery:SliderShowCaseLangResource DisabledHandleDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SliderViewModel">
                            <StackPanel MinHeight="160"
                                        VerticalAlignment="Center"
                                        Spacing="24">
                                <atom:Slider
                                    Maximum="100"
                                    Minimum="0"
                                    IsRangeMode="True"
                                    RangeValues="{Binding DisabledHandleRangeValues, Mode=OneWay}"
                                    DisabledHandles="{Binding DisabledHandles}" />
                                <WrapPanel Orientation="Horizontal"
                                           ItemSpacing="20"
                                           LineSpacing="12">
                                    <atom:CheckBox
                                        Content="{gallery:SliderShowCaseLangResource P2ContentDisabledHandle1}"
                                        IsChecked="{Binding IsHandle1Disabled, Mode=TwoWay}" />
                                    <atom:CheckBox
                                        Content="{gallery:SliderShowCaseLangResource P2ContentDisabledHandle2}"
                                        IsChecked="{Binding IsHandle2Disabled, Mode=TwoWay}" />
                                    <atom:CheckBox
                                        Content="{gallery:SliderShowCaseLangResource P2ContentDisabledHandle3}"
                                        IsChecked="{Binding IsHandle3Disabled, Mode=TwoWay}" />
                                </WrapPanel>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:SliderShowCaseLangResource RangeValuesBindingTitle}"
                    Description="{gallery:SliderShowCaseLangResource RangeValuesBindingDescription}"
                    BadgeText="v6.0.8"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SliderViewModel">
                            <StackPanel Orientation="Vertical" Spacing="12">
                                <atom:Slider
                                    Width="260"
                                    Maximum="100"
                                    Minimum="0"
                                    IsRangeMode="True"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="5"
                                    RangeValues="{Binding BoundRangeValues}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <atom:TextBlock VerticalAlignment="Center"
                                                    Text="{gallery:SliderShowCaseLangResource P2TextBoundRangeValues}" />
                                    <atom:TextBlock VerticalAlignment="Center"
                                                    Text="{Binding BoundRangeValuesText}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <atom:Button SizeType="Small"
                                                 Command="{Binding SetBoundRangeValuesCommand}"
                                                 Content="{gallery:SliderShowCaseLangResource P2ContentSetRange}" />
                                    <atom:Button SizeType="Small"
                                                 Command="{Binding ClearBoundRangeValuesCommand}"
                                                 Content="{gallery:SliderShowCaseLangResource P2ContentClear}" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:SliderShowCaseLangResource CustomizeTooltipTitle}"
                    Description="{gallery:SliderShowCaseLangResource CustomizeTooltipDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SliderViewModel">
                            <StackPanel Orientation="Vertical" Spacing="20">
                                <atom:Slider
                                    Maximum="100"
                                    Minimum="0"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    ValueFormatTemplate="\{0\}%"
                                    Value="20" />
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:SliderShowCaseLangResource VerticalTitle}"
                    Description="{gallery:SliderShowCaseLangResource VerticalDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SliderViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="20" Height="300">
                                <atom:Slider
                                    Maximum="100"
                                    Minimum="0"
                                    Orientation="Vertical"
                                    TickFrequency="1"
                                    Value="20" />
                                <atom:Slider
                                    Maximum="100"
                                    Minimum="0"
                                    Orientation="Vertical"
                                    TickFrequency="5"
                                    IsRangeMode="True"
                                    RangeValues="{Binding DefaultRangeValues, Mode=OneWay}"
                                    IsSnapToTickEnabled="True"
                                    Value="20" />

                                <atom:Slider
                                    Name="Slider2"
                                    Marks="{Binding SliderMarks}"
                                    Maximum="100"
                                    Minimum="0"
                                    Orientation="Vertical"
                                    TickFrequency="1"
                                    Value="20" />

                                <atom:Slider
                                    Name="Slider3"
                                    Marks="{Binding SliderMarks}"
                                    Maximum="100"
                                    Minimum="0"
                                    IsRangeMode="True"
                                    Orientation="Vertical"
                                    TickFrequency="5"
                                    RangeValues="{Binding DefaultRangeValues, Mode=OneWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>

                <gallery:ShowCaseItem
                    Title="{gallery:SliderShowCaseLangResource GraduatedSliderTitle}"
                    Description="{gallery:SliderShowCaseLangResource GraduatedSliderDescription}"
                    IsDeferredContentEnabled="True">
                    <gallery:ShowCaseItem.DeferredContentTemplate>
                        <DataTemplate x:DataType="vm:SliderViewModel">
                            <StackPanel Orientation="Vertical" Spacing="20">
                                <atom:TextBlock FontWeight="Bold" Text="{gallery:SliderShowCaseLangResource P2TextIncludedTrue}" />
                                <atom:Slider
                                    Name="Slider4"
                                    Marks="{Binding SliderMarks}"
                                    Maximum="100"
                                    Minimum="0"
                                    TickFrequency="1"
                                    Value="20" />

                                <atom:Slider
                                    Name="Slider5"
                                    Marks="{Binding SliderMarks}"
                                    Maximum="100"
                                    Minimum="0"
                                    IsRangeMode="True"
                                    TickFrequency="5"
                                    RangeValues="{Binding DefaultRangeValues, Mode=OneWay}" />

                                <atom:TextBlock FontWeight="Bold" Text="{gallery:SliderShowCaseLangResource P2TextIncludedFalse}" />
                                <atom:Slider
                                    Name="Slider6"
                                    Marks="{Binding SliderMarks}"
                                    Maximum="100"
                                    Minimum="0"
                                    TickFrequency="1"
                                    IsIncluded="False"
                                    Value="20" />

                                <atom:Slider
                                    Name="Slider7"
                                    Marks="{Binding SliderMarks}"
                                    Maximum="100"
                                    Minimum="0"
                                    IsRangeMode="True"
                                    TickFrequency="5"
                                    IsIncluded="False"
                                    RangeValues="{Binding DefaultRangeValues, Mode=OneWay}" />
                            </StackPanel>
                        </DataTemplate>
                    </gallery:ShowCaseItem.DeferredContentTemplate>
                </gallery:ShowCaseItem>
            </gallery:ShowCasePanel>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
