<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.ToggleSwitch.ToggleSwitchShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:showCase="clr-namespace:AtomUIGallery.ShowCases.ToggleSwitch"
             xmlns:vm="using:AtomUIGallery.ShowCases.ToggleSwitch"
             x:DataType="vm:ToggleSwitchViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <StackPanel Margin="28,24,28,18"
                            Spacing="16">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <atom:TextBlock Text="ToggleSwitch"
                                            FontSize="26"
                                            FontWeight="Bold"
                                            VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:ToggleSwitchShowCaseLangResource ComponentCategory}"
                                      TagColor="blue"
                                      VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:ToggleSwitchShowCaseLangResource ComponentStatusStable}"
                                      TagColor="success"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                        <atom:TextBlock Text="{gallery:ToggleSwitchShowCaseLangResource PageSubtitle}"
                                        FontSize="15"
                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                        <atom:TextBlock Text="{gallery:ToggleSwitchShowCaseLangResource PageDescription}"
                                        HorizontalAlignment="Left"
                                        TextWrapping="Wrap"
                                        Foreground="{atom:SharedTokenResource ColorTextTertiary}" />
                    </StackPanel>

                    <Border Background="{atom:SharedTokenResource ColorBgContainer}"
                            BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinHeight="48"
                            Padding="16,8">
                        <Border.Styles>
                            <Style Selector="atom|TextBlock.info-label">
                                <Setter Property="Width" Value="84" />
                            </Style>
                            <Style Selector="atom|TextBlock.info-value">
                                <Setter Property="Width" Value="200" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </Border.Styles>
                        <WrapPanel Orientation="Horizontal"
                                   ItemSpacing="48"
                                   LineSpacing="8"
                                   VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:ToggleSwitchShowCaseLangResource InfoNamespaceLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:ToggleSwitchShowCaseLangResource InfoPackageLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:ToggleSwitchShowCaseLangResource InfoBaseClassLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AbstractToggleSwitch"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </gallery:GalleryStickyTabsHost.Header>

            <gallery:GalleryStickyTabsHost.StickyContent>
                <atom:TabStrip Name="ScenarioTabs"
                               SizeType="Large"
                               SelectedIndex="0">
                    <atom:TabStripItem Content="{gallery:ToggleSwitchShowCaseLangResource ScenarioExamples}"
                                       Tag="Examples"
                                       IsSelected="True" />
                    <atom:TabStripItem Content="{gallery:ToggleSwitchShowCaseLangResource ScenarioApi}"
                                       Tag="Api" />
                    <atom:TabStripItem Content="{gallery:ToggleSwitchShowCaseLangResource ScenarioDesignToken}"
                                       Tag="DesignToken" />
                </atom:TabStrip>
            </gallery:GalleryStickyTabsHost.StickyContent>

            <ContentControl Name="ScenarioContentHost">
                <gallery:ShowCasePanel Name="ExamplesContent"
                                       IsScrollEnabled="False"
                                       IsDeferredLoadingEnabled="True"
                                       InitialDeferredLoadItemCount="4"
                                       DeferredLoadBatchSize="2"
                                       ContentMargin="28,10,28,28">
                    <gallery:ShowCaseItem
                        Title="{gallery:ToggleSwitchShowCaseLangResource BasicTitle}"
                        Description="{gallery:ToggleSwitchShowCaseLangResource BasicDescription}"
                        IsDeferredContentEnabled="True">
                        <gallery:ShowCaseItem.DeferredContentTemplate>
                            <DataTemplate x:DataType="vm:ToggleSwitchViewModel">
                        <StackPanel HorizontalAlignment="Left" Spacing="10" Orientation="Horizontal">
                            <atom:ToggleSwitch />
                        </StackPanel>
                            </DataTemplate>
                        </gallery:ShowCaseItem.DeferredContentTemplate>
                    </gallery:ShowCaseItem>
        
                    <gallery:ShowCaseItem
                        Title="{gallery:ToggleSwitchShowCaseLangResource DisabledTitle}"
                        Description="{gallery:ToggleSwitchShowCaseLangResource DisabledDescription}"
                        IsDeferredContentEnabled="True">
                        <gallery:ShowCaseItem.DeferredContentTemplate>
                            <DataTemplate x:DataType="vm:ToggleSwitchViewModel">
                        <StackPanel HorizontalAlignment="Left" Spacing="10" Orientation="Vertical">
                            <atom:ToggleSwitch x:Name="ToggleDisabledSwitch"
                                               IsEnabled="{Binding IsDisabledDemoEnabled}" />
                            <atom:Button ButtonType="Primary"
                                         Click="HandleToggleDisabledButtonClick"
                                         Content="{gallery:ToggleSwitchShowCaseLangResource P2ContentToggleDisabled}" />
                        </StackPanel>
                            </DataTemplate>
                        </gallery:ShowCaseItem.DeferredContentTemplate>
                    </gallery:ShowCaseItem>

                    <gallery:ShowCaseItem
                        Title="{gallery:ToggleSwitchShowCaseLangResource TextAndIconTitle}"
                        Description="{gallery:ToggleSwitchShowCaseLangResource TextAndIconDescription}"
                        IsDeferredContentEnabled="True">
                        <gallery:ShowCaseItem.DeferredContentTemplate>
                            <DataTemplate x:DataType="vm:ToggleSwitchViewModel">
                        <StackPanel HorizontalAlignment="Left" Spacing="10" Orientation="Vertical">
                            <atom:ToggleSwitch
                                OnContent="{gallery:ToggleSwitchShowCaseLangResource P2OnContentOn}"
                                OffContent="{gallery:ToggleSwitchShowCaseLangResource P2OffContentOff}"
                                IsChecked="True" />
                            <atom:ToggleSwitch
                                OnContent="{gallery:ToggleSwitchShowCaseLangResource P2OnContentText}"
                                OffContent="{gallery:ToggleSwitchShowCaseLangResource P2OffContentText}" />
                            <atom:ToggleSwitch
                                OnContent="{antdicons:AntDesignIconProvider Kind=TwitterOutlined}"
                                OffContent="{antdicons:AntDesignIconProvider Kind=WechatOutlined}"/>
                            <atom:ToggleSwitch
                                SizeType="Small"
                                OnContent="{antdicons:AntDesignIconProvider Kind=CheckOutlined}"
                                OffContent="{antdicons:AntDesignIconProvider Kind=WechatOutlined}"/>
                            <atom:ToggleSwitch SizeType="Small">
                                <atom:ToggleSwitch.OnContent>
                                    <antdicons:CheckOutlined/>
                                </atom:ToggleSwitch.OnContent>
                                <atom:ToggleSwitch.OffContent>
                                    <antdicons:CloseOutlined/>
                                </atom:ToggleSwitch.OffContent>
                            </atom:ToggleSwitch>
                        </StackPanel>
                            </DataTemplate>
                        </gallery:ShowCaseItem.DeferredContentTemplate>
                    </gallery:ShowCaseItem>

                    <gallery:ShowCaseItem
                        Title="{gallery:ToggleSwitchShowCaseLangResource TwoSizesTitle}"
                        Description="{gallery:ToggleSwitchShowCaseLangResource TwoSizesDescription}"
                        IsDeferredContentEnabled="True">
                        <gallery:ShowCaseItem.DeferredContentTemplate>
                            <DataTemplate x:DataType="vm:ToggleSwitchViewModel">
                        <StackPanel HorizontalAlignment="Left" Spacing="10" Orientation="Vertical">
                            <atom:ToggleSwitch />
                            <atom:ToggleSwitch SizeType="Small" />
                            <atom:ToggleSwitch Name="CustomSizeTypeToggleSwitch"
                                               SizeType="Custom"
                                               IsChecked="True"
                                               OnContent="{gallery:ToggleSwitchShowCaseLangResource P2ContentCustom}"
                                               OffContent="{gallery:ToggleSwitchShowCaseLangResource P2ContentCustom}" />
                        </StackPanel>
                            </DataTemplate>
                        </gallery:ShowCaseItem.DeferredContentTemplate>
                    </gallery:ShowCaseItem>
        
                    <gallery:ShowCaseItem
                        Title="{gallery:ToggleSwitchShowCaseLangResource LoadingTitle}"
                        Description="{gallery:ToggleSwitchShowCaseLangResource LoadingDescription}"
                        IsDeferredContentEnabled="True">
                        <gallery:ShowCaseItem.DeferredContentTemplate>
                            <DataTemplate x:DataType="vm:ToggleSwitchViewModel">
                        <StackPanel HorizontalAlignment="Left" Spacing="10" Orientation="Vertical">
                            <atom:ToggleSwitch IsLoading="{Binding IsLoadingDemoLoading}" IsChecked="true" x:Name="ToggleSwitchDefault" />
                            <atom:ToggleSwitch SizeType="Small" IsLoading="{Binding IsLoadingDemoLoading}" x:Name="ToggleSwitchSmall" />
                            <atom:Button ButtonType="Primary"
                                         Click="HandleToggleLoadingButtonClick"
                                         Content="{gallery:ToggleSwitchShowCaseLangResource P2ContentToggleLoading}" />
                        </StackPanel>
                            </DataTemplate>
                        </gallery:ShowCaseItem.DeferredContentTemplate>
                    </gallery:ShowCaseItem>
                </gallery:ShowCasePanel>
            </ContentControl>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
