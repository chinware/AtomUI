    </unit>
    <unit id="32" name="VariantsDescription">
      <segment>
        <source>Variants of TreeSelect, there are four variants: outlined filled borderless and underlined.</source>
        <target state="translated">TreeSelect 提供四種變體：描邊、填充、無邊框和下划線。</target>
      </segment>
    </unit>
    <unit id="33" name="StatusTitle">
