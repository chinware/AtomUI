        <target state="translated">狀態</target>
      </segment>
    </unit>
    <unit id="34" name="StatusDescription">
      <segment>
        <source>Add status to TreeSelect with status, which could be error or warning.</source>
        <target state="translated">通過 status 為 TreeSelect 添加狀態，可設置為錯誤或警告。</target>
      </segment>
    </unit>
