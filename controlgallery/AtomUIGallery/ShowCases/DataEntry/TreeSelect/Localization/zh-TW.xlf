    <unit id="12" name="BindingDescription">
      <segment>
        <source>SelectedItem and SelectedItems are two-way bindable by default, including in-place collection changes.</source>
        <target state="translated">SelectedItem 和 SelectedItems 默認支持雙向綁定，也支持集合原地變更同步。</target>
      </segment>
    </unit>
