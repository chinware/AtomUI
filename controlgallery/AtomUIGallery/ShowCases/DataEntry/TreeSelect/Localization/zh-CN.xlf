        <target state="translated">状态</target>
      </segment>
    </unit>
    <unit id="34" name="StatusDescription">
      <segment>
        <source>Add status to TreeSelect with status, which could be error or warning.</source>
        <target state="translated">通过 status 为 TreeSelect 添加状态，可设置为错误或警告。</target>
      </segment>
    </unit>
