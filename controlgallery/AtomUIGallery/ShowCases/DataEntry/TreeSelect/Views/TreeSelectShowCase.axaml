<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.TreeSelect.TreeSelectShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.TreeSelect"
             x:DataType="vm:TreeSelectViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <StackPanel Margin="28,24,28,18"
                            Spacing="16">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <atom:TextBlock Text="TreeSelect"
                                            FontSize="26"
                                            FontWeight="Bold"
                                            VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:TreeSelectShowCaseLangResource ComponentCategory}"
                                      TagColor="blue"
                                      VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:TreeSelectShowCaseLangResource ComponentStatusStable}"
                                      TagColor="success"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                        <atom:TextBlock Text="{gallery:TreeSelectShowCaseLangResource PageSubtitle}"
                                        FontSize="15"
                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                        <atom:TextBlock Text="{gallery:TreeSelectShowCaseLangResource PageDescription}"
                                        HorizontalAlignment="Left"
                                        TextWrapping="Wrap"
                                        Foreground="{atom:SharedTokenResource ColorTextTertiary}" />
                    </StackPanel>

                    <Border Background="{atom:SharedTokenResource ColorBgContainer}"
                            BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinHeight="48"
                            Padding="16,8">
                        <Border.Styles>
                            <Style Selector="atom|TextBlock.info-label">
                                <Setter Property="Width" Value="84" />
                            </Style>
                            <Style Selector="atom|TextBlock.info-value">
                                <Setter Property="Width" Value="220" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </Border.Styles>
                        <WrapPanel Orientation="Horizontal"
                                   ItemSpacing="48"
                                   LineSpacing="8"
                                   VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:TreeSelectShowCaseLangResource InfoNamespaceLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:TreeSelectShowCaseLangResource InfoPackageLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:TreeSelectShowCaseLangResource InfoBaseClassLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="TreeSelect"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </gallery:GalleryStickyTabsHost.Header>

            <gallery:GalleryStickyTabsHost.StickyContent>
                <atom:TabStrip Name="ScenarioTabs"
                               SizeType="Large"
                               SelectedIndex="0">
                    <atom:TabStripItem Content="{gallery:TreeSelectShowCaseLangResource ScenarioExamples}"
                                       Tag="Examples"
                                       IsSelected="True" />
                    <atom:TabStripItem Content="{gallery:TreeSelectShowCaseLangResource ScenarioApi}"
                                       Tag="Api" />
                    <atom:TabStripItem Content="{gallery:TreeSelectShowCaseLangResource ScenarioDesignToken}"
                                       Tag="DesignToken" />
                </atom:TabStrip>
            </gallery:GalleryStickyTabsHost.StickyContent>

            <ContentControl Name="ScenarioContentHost">
                <gallery:ShowCasePanel Name="ExamplesContent"
                                       IsScrollEnabled="False"
                                       IsDeferredLoadingEnabled="True"
                                       InitialDeferredLoadItemCount="4"
                                       DeferredLoadBatchSize="2"
                                       ContentMargin="28,10,28,28">
                    <gallery:ShowCaseItem
            Title="{gallery:TreeSelectShowCaseLangResource BasicTitle}"
            Description="{gallery:TreeSelectShowCaseLangResource BasicDescription}" IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:TreeSelectViewModel">
            <atom:TreeSelect Name="BasicTreeSelect"
                             HorizontalAlignment="Stretch"
                             IsDefaultExpandAll="True"
                             IsAllowClear="True"
                             IsFilterEnabled="True"
                             ItemsSource="{Binding BasicTreeNodes}"
                             PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}" />
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:TreeSelectShowCaseLangResource MultipleSelectionTitle}"
            Description="{gallery:TreeSelectShowCaseLangResource MultipleSelectionDescription}" IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:TreeSelectViewModel">
            <atom:TreeSelect Name="MultiSelectionTreeSelect"
                             HorizontalAlignment="Stretch"
                             IsDefaultExpandAll="True"
                             IsAllowClear="True"
                             IsFilterEnabled="True"
                             IsMultiple="True"
                             ItemsSource="{Binding MultiSelectionTreeNodes}"
                             PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}" />
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:TreeSelectShowCaseLangResource GenerateFromTreeDataTitle}"
            Description="{gallery:TreeSelectShowCaseLangResource GenerateFromTreeDataDescription}" IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:TreeSelectViewModel">
            <atom:TreeSelect Name="ItemsSourceTreeSelect"
                             HorizontalAlignment="Stretch"
                             IsDefaultExpandAll="True"
                             IsAllowClear="True"
                             IsFilterEnabled="True"
                             ItemsSource="{Binding ItemsSourceTreeNodes}"
                             PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}" />
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:TreeSelectShowCaseLangResource CheckableTitle}"
            Description="{gallery:TreeSelectShowCaseLangResource CheckableDescription}" IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:TreeSelectViewModel">
            <atom:TreeSelect Name="CheckableTreeSelect"
                             HorizontalAlignment="Stretch"
                             IsDefaultExpandAll="True"
                             IsAllowClear="True"
                             IsFilterEnabled="True"
                             IsTreeCheckable="True"
                             ItemsSource="{Binding CheckableTreeNodes}"
                             PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                             ShowCheckedStrategy="ShowParent" />
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:TreeSelectShowCaseLangResource AsynchronousLoadingTitle}"
            Description="{gallery:TreeSelectShowCaseLangResource AsynchronousLoadingDescription}" IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:TreeSelectViewModel">
            <atom:TreeSelect Name="AsyncLoadTreeSelect"
                             HorizontalAlignment="Stretch"
                             IsAllowClear="True"
                             ItemsSource="{Binding AsyncLoadTreeNodes}"
                             DataLoader="{Binding AsyncLoadTreeNodeLoader}"
                             PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}" />
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:TreeSelectShowCaseLangResource PlacementTitle}"
            Description="{gallery:TreeSelectShowCaseLangResource PlacementDescription}" IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:TreeSelectViewModel">
            <StackPanel Orientation="Vertical" Spacing="10">
                <atom:TextBlock VerticalAlignment="Center" Text="{gallery:TreeSelectShowCaseLangResource P2TextPlacement}" />
                <atom:OptionButtonGroup ButtonStyle="Outline"
                                        Name="PlacementOptionGroup"
                                        OptionCheckedChanged="HandlePlacementOptionCheckedChanged">
                    <atom:OptionButton IsChecked="True" Content="{gallery:TreeSelectShowCaseLangResource P2ContentTopleft}" />
                    <atom:OptionButton Content="{gallery:TreeSelectShowCaseLangResource P2ContentTopright}" />
                    <atom:OptionButton Content="{gallery:TreeSelectShowCaseLangResource P2ContentBottomleft}" />
                    <atom:OptionButton Content="{gallery:TreeSelectShowCaseLangResource P2ContentBottomright}" />
                </atom:OptionButtonGroup>
                <atom:TreeSelect Name="PlacementTreeSelect"
                                 IsAllowClear="True"
                                 PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                                 IsDefaultExpandAll="True"
                                 IsFilterEnabled="True"
                                 IsPopupMatchSelectWidth="False"
                                 ItemsSource="{Binding PlacementTreeNodes}"
                                 Placement="{Binding Placement}" />
            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:TreeSelectShowCaseLangResource ShowTreeLineTitle}"
            Description="{gallery:TreeSelectShowCaseLangResource ShowTreeLineDescription}" IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:TreeSelectViewModel">
            <StackPanel Orientation="Vertical" Spacing="10">
                <atom:ToggleSwitch OnContent="{gallery:TreeSelectShowCaseLangResource P2OnContentShowIcon}" OffContent="{gallery:TreeSelectShowCaseLangResource P2OffContentShowIcon}" Name="ShowIconSwitch" />
                <atom:ToggleSwitch OnContent="{gallery:TreeSelectShowCaseLangResource P2OnContentTreeLine}" OffContent="{gallery:TreeSelectShowCaseLangResource P2OffContentTreeLine}" IsChecked="True"
                                   Name="ShowTreeLineSwitch" />
                <atom:ToggleSwitch OnContent="{gallery:TreeSelectShowCaseLangResource P2OnContentShowLeafIcon}" OffContent="{gallery:TreeSelectShowCaseLangResource P2OffContentShowLeafIcon}" Name="ShowLeafIconSwitch" />
                <atom:TreeSelect Name="ShowTreeLineTreeSelect"
                                 HorizontalAlignment="Stretch"
                                 IsAllowClear="True"
                                 PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                                 ItemsSource="{Binding ShowTreeLineTreeNodes}"
                                 IsShowIcon="{Binding #ShowIconSwitch.IsChecked}"
                                 IsShowLeafIcon="{Binding #ShowLeafIconSwitch.IsChecked}"
                                 IsShowLine="{Binding #ShowTreeLineSwitch.IsChecked}"
                                 IsSwitcherRotation="{Binding #ShowTreeLineSwitch.IsChecked, Converter={x:Static BoolConverters.Not}}" />
            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:TreeSelectShowCaseLangResource MaxCountTitle}"
            Description="{gallery:TreeSelectShowCaseLangResource MaxCountDescription}" IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:TreeSelectViewModel">
            <StackPanel Orientation="Vertical" Spacing="10">
                <atom:TreeSelect Name="MaxSelectedTreeSelect"
                                 HorizontalAlignment="Stretch"
                                 IsDefaultExpandAll="True"
                                 IsMultiple="True"
                                 IsAllowClear="True"
                                 IsFilterEnabled="True"
                                 PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                                 IsShowMaxCountIndicator="True"
                                 ItemsSource="{Binding MaxSelectedTreeNodes}"
                                 MaxCount="3" />
                <atom:TreeSelect Name="MaxCheckedTreeSelect"
                                 HorizontalAlignment="Stretch"
                                 IsDefaultExpandAll="True"
                                 IsMultiple="True"
                                 IsTreeCheckable="True"
                                 IsAllowClear="True"
                                 IsFilterEnabled="True"
                                 PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                                 IsShowMaxCountIndicator="True"
                                 ItemsSource="{Binding MaxCheckedTreeNodes}"
                                 MaxCount="3" />
            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:TreeSelectShowCaseLangResource VariantsTitle}"
            Description="{gallery:TreeSelectShowCaseLangResource VariantsDescription}" IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:TreeSelectViewModel">
            <StackPanel Orientation="Vertical" Spacing="10">
                <atom:TreeSelect HorizontalAlignment="Stretch"
                                 IsAllowClear="True"
                                 PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                                 StyleVariant="Borderless" />
                <atom:TreeSelect HorizontalAlignment="Stretch"
                                 IsAllowClear="True"
                                 PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                                 StyleVariant="Filled" />
                <atom:TreeSelect HorizontalAlignment="Stretch"
                                 IsAllowClear="True"
                                 PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                                 StyleVariant="Outlined" />
                <atom:TreeSelect HorizontalAlignment="Stretch"
                                 IsAllowClear="True"
                                 PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                                 StyleVariant="Underlined" />
            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:TreeSelectShowCaseLangResource StatusTitle}"
            Description="{gallery:TreeSelectShowCaseLangResource StatusDescription}" IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:TreeSelectViewModel">
            <StackPanel Orientation="Vertical" Spacing="10">
                <atom:TreeSelect HorizontalAlignment="Stretch"
                                 IsAllowClear="True"
                                 PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                                 Status="Error" />
                <atom:TreeSelect HorizontalAlignment="Stretch"
                                 IsAllowClear="True"
                                 PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                                 Status="Warning" />
            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:TreeSelectShowCaseLangResource PrefixAndSuffixTitle}"
            Description="{gallery:TreeSelectShowCaseLangResource PrefixAndSuffixDescription}" IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:TreeSelectViewModel">
            <StackPanel Orientation="Vertical" Spacing="10">
                <atom:TreeSelect Name="LeftAddTreeSelect"
                                 HorizontalAlignment="Stretch"
                                 IsAllowClear="True"
                                 PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                                 IsDefaultExpandAll="True"
                                 LeftAddOn="{gallery:TreeSelectShowCaseLangResource P2AddOnPrefix}"
                                 IsFilterEnabled="True"
                                 ItemsSource="{Binding LeftAddTreeNodes}" />
                <atom:TreeSelect Name="ContentLeftAddTreeSelect"
                                 HorizontalAlignment="Stretch"
                                 IsAllowClear="True"
                                 PlaceholderText="{gallery:TreeSelectShowCaseLangResource P2PlaceholderTextPleaseSelect}"
                                 IsDefaultExpandAll="True"
                                 ContentLeftAddOn="{gallery:TreeSelectShowCaseLangResource P2AddOnPrefix}"
                                 IsFilterEnabled="True"
                                 ItemsSource="{Binding ContentLeftAddTreeNodes}" />
            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>
                </gallery:ShowCasePanel>
            </ContentControl>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
