<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Result.ResultShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Result"
             x:DataType="vm:ResultViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <StackPanel Margin="28,24,28,18"
                            Spacing="16">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <atom:TextBlock Text="Result"
                                            FontSize="26"
                                            FontWeight="Bold"
                                            VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:ResultShowCaseLangResource ComponentCategory}"
                                      TagColor="blue"
                                      VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:ResultShowCaseLangResource ComponentStatusStable}"
                                      TagColor="success"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                        <atom:TextBlock Text="{gallery:ResultShowCaseLangResource PageSubtitle}"
                                        FontSize="15"
                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                        <atom:TextBlock Text="{gallery:ResultShowCaseLangResource PageDescription}"
                                        HorizontalAlignment="Left"
                                        TextWrapping="Wrap"
                                        Foreground="{atom:SharedTokenResource ColorTextTertiary}" />
                    </StackPanel>

                    <Border Background="{atom:SharedTokenResource ColorBgContainer}"
                            BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinHeight="48"
                            Padding="16,8">
                        <Border.Styles>
                            <Style Selector="atom|TextBlock.info-label">
                                <Setter Property="Width" Value="84" />
                            </Style>
                            <Style Selector="atom|TextBlock.info-value">
                                <Setter Property="Width" Value="200" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </Border.Styles>
                        <WrapPanel Orientation="Horizontal"
                                   ItemSpacing="48"
                                   LineSpacing="8"
                                   VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:ResultShowCaseLangResource InfoNamespaceLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:ResultShowCaseLangResource InfoPackageLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:ResultShowCaseLangResource InfoBaseClassLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AbstractResult"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </gallery:GalleryStickyTabsHost.Header>

            <gallery:GalleryStickyTabsHost.StickyContent>
                <atom:TabStrip Name="ScenarioTabs"
                               SizeType="Large"
                               SelectedIndex="0">
                    <atom:TabStripItem Content="{gallery:ResultShowCaseLangResource ScenarioExamples}"
                                       Tag="Examples"
                                       IsSelected="True" />
                    <atom:TabStripItem Content="{gallery:ResultShowCaseLangResource ScenarioApi}"
                                       Tag="Api" />
                    <atom:TabStripItem Content="{gallery:ResultShowCaseLangResource ScenarioDesignToken}"
                                       Tag="DesignToken" />
                </atom:TabStrip>
            </gallery:GalleryStickyTabsHost.StickyContent>

            <ContentControl Name="ScenarioContentHost">
                <gallery:ShowCasePanel Name="ExamplesContent"
                                       IsScrollEnabled="False"
                                       IsDeferredLoadingEnabled="True"
                                       InitialDeferredLoadItemCount="4"
                                       DeferredLoadBatchSize="2"
                                       ContentMargin="28,10,28,28">
        <gallery:ShowCaseItem
            Title="{gallery:ResultShowCaseLangResource SuccessTitle}"
            Description="{gallery:ResultShowCaseLangResource SuccessDescription}"
            IsOccupyEntireRow="True"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:ResultViewModel">
            <atom:Result Status="Success"
                         Header="{gallery:ResultShowCaseLangResource P2HeaderSuccessfullyPurchasedCloudServerEcs}"
                         SubHeader="{gallery:ResultShowCaseLangResource P2SubHeaderOrderNumberCloudServerConfiguration}">
                <atom:Result.Extra>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <atom:Button ButtonType="Primary" Content="{gallery:ResultShowCaseLangResource P2ContentGoConsole}" />
                        <atom:Button Content="{gallery:ResultShowCaseLangResource P2ContentBuyAgain}" />
                    </StackPanel>
                </atom:Result.Extra>
            </atom:Result>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:ResultShowCaseLangResource InfoTitle}"
            Description="{gallery:ResultShowCaseLangResource InfoDescription}"
            IsOccupyEntireRow="True"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:ResultViewModel">
            <atom:Result Status="Info"
                         Header="{gallery:ResultShowCaseLangResource P2HeaderYourOperationHasBeenExecuted}">
                <atom:Result.Extra>
                    <atom:Button ButtonType="Primary" Content="{gallery:ResultShowCaseLangResource P2ContentGoConsole}" />
                </atom:Result.Extra>
            </atom:Result>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:ResultShowCaseLangResource WarningTitle}"
            Description="{gallery:ResultShowCaseLangResource WarningDescription}"
            IsOccupyEntireRow="True"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:ResultViewModel">
            <atom:Result Status="Warning"
                         Header="{gallery:ResultShowCaseLangResource P2HeaderThereAreSomeProblemsWithYourOperation}">
                <atom:Result.Extra>
                    <atom:Button ButtonType="Primary" Content="{gallery:ResultShowCaseLangResource P2ContentGoConsole}" />
                </atom:Result.Extra>
            </atom:Result>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:ResultShowCaseLangResource ForbiddenTitle}"
            Description="{gallery:ResultShowCaseLangResource ForbiddenDescription}"
            IsOccupyEntireRow="True"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:ResultViewModel">
            <atom:Result Status="ErrorCode403"
                         Header="403"
                         SubHeader="{gallery:ResultShowCaseLangResource P2SubHeaderForbidden}">
                <atom:Result.Extra>
                    <atom:Button ButtonType="Primary" Content="{gallery:ResultShowCaseLangResource P2ContentBackHome}" />
                </atom:Result.Extra>
            </atom:Result>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:ResultShowCaseLangResource NotFoundTitle}"
            Description="{gallery:ResultShowCaseLangResource NotFoundDescription}"
            IsOccupyEntireRow="True"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:ResultViewModel">
            <atom:Result Status="ErrorCode404"
                         Header="404"
                         SubHeader="{gallery:ResultShowCaseLangResource P2SubHeaderNotFound}">
                <atom:Result.Extra>
                    <atom:Button ButtonType="Primary" Content="{gallery:ResultShowCaseLangResource P2ContentBackHome}" />
                </atom:Result.Extra>
            </atom:Result>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:ResultShowCaseLangResource ServerErrorTitle}"
            Description="{gallery:ResultShowCaseLangResource ServerErrorDescription}"
            IsOccupyEntireRow="True"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:ResultViewModel">
            <atom:Result Status="ErrorCode500"
                         Header="500"
                         SubHeader="{gallery:ResultShowCaseLangResource P2SubHeaderServerError}">
                <atom:Result.Extra>
                    <atom:Button ButtonType="Primary" Content="{gallery:ResultShowCaseLangResource P2ContentBackHome}" />
                </atom:Result.Extra>
            </atom:Result>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:ResultShowCaseLangResource ErrorTitle}"
            Description="{gallery:ResultShowCaseLangResource ErrorDescription}"
            IsOccupyEntireRow="True"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:ResultViewModel">
            <atom:Result Status="Error"
                         Header="{gallery:ResultShowCaseLangResource P2HeaderSubmissionFailed}"
                         SubHeader="{gallery:ResultShowCaseLangResource P2SubHeaderSubmissionFailed}">
                <atom:Result.Extra>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <atom:Button ButtonType="Primary" Content="{gallery:ResultShowCaseLangResource P2ContentGoConsole}" />
                        <atom:Button Content="{gallery:ResultShowCaseLangResource P2ContentBuyAgain}" />
                    </StackPanel>
                </atom:Result.Extra>
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="Bold" FontSize="16" Text="{gallery:ResultShowCaseLangResource P2TextTheContentYouSubmittedHasTheFollowingError}" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <antdicons:CloseCircleOutlined Foreground="{atom:SharedTokenResource ColorError}"/>
                        <TextBlock Text="{gallery:ResultShowCaseLangResource P2TextYourAccountHasBeenFrozen}" />
                        <TextBlock Foreground="{atom:SharedTokenResource ColorPrimary}" Text="{gallery:ResultShowCaseLangResource P2TextThawImmediately}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <antdicons:CloseCircleOutlined Foreground="{atom:SharedTokenResource ColorError}"/>
                        <TextBlock Text="{gallery:ResultShowCaseLangResource P2TextYourAccountIsNotYetEligibleToApply}" />
                        <TextBlock Foreground="{atom:SharedTokenResource ColorPrimary}" Text="{gallery:ResultShowCaseLangResource P2TextApplyUnlock}" />
                    </StackPanel>
                </StackPanel>
            </atom:Result>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:ResultShowCaseLangResource CustomIconTitle}"
            Description="{gallery:ResultShowCaseLangResource CustomIconDescription}"
            IsOccupyEntireRow="True"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:ResultViewModel">
            <atom:Result Status="Info"
                         Icon="{antdicons:AntDesignIconProvider SmileOutlined}"
                         Header="{gallery:ResultShowCaseLangResource P2HeaderGreatWeHaveDoneAllTheOperations}">
                <atom:Result.Extra>
                    <atom:Button ButtonType="Primary" Content="{gallery:ResultShowCaseLangResource P2ContentNext}" />
                </atom:Result.Extra>
            </atom:Result>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>
                </gallery:ShowCasePanel>
            </ContentControl>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
