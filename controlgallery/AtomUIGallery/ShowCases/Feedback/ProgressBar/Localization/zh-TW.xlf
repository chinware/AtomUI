        <target state="translated">迷你尺寸進度條</target>
      </segment>
    </unit>
    <unit id="9" name="MiniSizeDescription">
      <segment>
        <source>Appropriate for a narrow area.</source>
        <target state="translated">適合較窄區域。</target>
