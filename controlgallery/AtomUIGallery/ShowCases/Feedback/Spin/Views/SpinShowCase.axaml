<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Spin.SpinShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Spin"
             x:DataType="vm:SpinViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <StackPanel Margin="28,24,28,18"
                            Spacing="16">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <atom:TextBlock Text="Spin"
                                            FontSize="26"
                                            FontWeight="Bold"
                                            VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:SpinShowCaseLangResource ComponentCategory}"
                                      TagColor="blue"
                                      VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:SpinShowCaseLangResource ComponentStatusStable}"
                                      TagColor="success"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                        <atom:TextBlock Text="{gallery:SpinShowCaseLangResource PageSubtitle}"
                                        FontSize="15"
                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                        <atom:TextBlock Text="{gallery:SpinShowCaseLangResource PageDescription}"
                                        HorizontalAlignment="Left"
                                        TextWrapping="Wrap"
                                        Foreground="{atom:SharedTokenResource ColorTextTertiary}" />
                    </StackPanel>

                    <Border Background="{atom:SharedTokenResource ColorBgContainer}"
                            BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinHeight="48"
                            Padding="16,8">
                        <Border.Styles>
                            <Style Selector="atom|TextBlock.info-label">
                                <Setter Property="Width" Value="84" />
                            </Style>
                            <Style Selector="atom|TextBlock.info-value">
                                <Setter Property="Width" Value="200" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </Border.Styles>
                        <WrapPanel Orientation="Horizontal"
                                   ItemSpacing="48"
                                   LineSpacing="8"
                                   VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:SpinShowCaseLangResource InfoNamespaceLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:SpinShowCaseLangResource InfoPackageLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:SpinShowCaseLangResource InfoBaseClassLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AbstractSpin"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </gallery:GalleryStickyTabsHost.Header>

            <gallery:GalleryStickyTabsHost.StickyContent>
                <atom:TabStrip Name="ScenarioTabs"
                               SizeType="Large"
                               SelectedIndex="0">
                    <atom:TabStripItem Content="{gallery:SpinShowCaseLangResource ScenarioExamples}"
                                       Tag="Examples"
                                       IsSelected="True" />
                    <atom:TabStripItem Content="{gallery:SpinShowCaseLangResource ScenarioApi}"
                                       Tag="Api" />
                    <atom:TabStripItem Content="{gallery:SpinShowCaseLangResource ScenarioDesignToken}"
                                       Tag="DesignToken" />
                </atom:TabStrip>
            </gallery:GalleryStickyTabsHost.StickyContent>

            <ContentControl Name="ScenarioContentHost">
                <gallery:ShowCasePanel Name="ExamplesContent"
                                       IsScrollEnabled="False"
                                       ContentMargin="28,10,28,28">
        <gallery:ShowCaseItem
            Title="{gallery:SpinShowCaseLangResource BasicUsageTitle}"
            Description="{gallery:SpinShowCaseLangResource BasicUsageDescription}">
            <atom:SpinIndicator />
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:SpinShowCaseLangResource SizeTitle}"
            Description="{gallery:SpinShowCaseLangResource SizeDescription}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <atom:SpinIndicator SizeType="Small" VerticalAlignment="Center" />
                <atom:SpinIndicator SizeType="Middle" VerticalAlignment="Center" />
                <atom:SpinIndicator SizeType="Large" VerticalAlignment="Center" />
            </StackPanel>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:SpinShowCaseLangResource CustomizedDescriptionTitle}"
            Description="{gallery:SpinShowCaseLangResource CustomizedDescriptionDescription}">
            <StackPanel Orientation="Vertical" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <atom:Spin IsSpinning="True" SizeType="Small"
                               IsTipVisible="True"
                               Tip="{gallery:SpinShowCaseLangResource P2TipLoading}">
                        <Border Width="100" Height="100" Background="#0D000000" />
                    </atom:Spin>
                    <atom:Spin IsSpinning="True" SizeType="Middle"
                               IsTipVisible="True"
                               Tip="{gallery:SpinShowCaseLangResource P2TipLoading}">
                        <Border Width="100" Height="100" Background="#0D000000" />
                    </atom:Spin>
                    <atom:Spin IsSpinning="True" SizeType="Large"
                               IsTipVisible="True"
                               Tip="{gallery:SpinShowCaseLangResource P2TipLoading}">
                        <Border Width="100" Height="100" Background="#0D000000" />
                    </atom:Spin>
                </StackPanel>
                <atom:Spin IsSpinning="True"
                           IsTipVisible="True"
                           Tip="{gallery:SpinShowCaseLangResource P2TipLoading}">
                    <atom:Alert Message="{gallery:SpinShowCaseLangResource P2MessageAlertMessageTitle}"
                                Description="{gallery:SpinShowCaseLangResource P2DescriptionFurtherDetailsAboutTheContextOfThisAlert}"
                                Type="Info" />
                </atom:Spin>
            </StackPanel>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:SpinShowCaseLangResource CustomIndicatorTitle}"
            Description="{gallery:SpinShowCaseLangResource CustomIndicatorDescription}">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <atom:SpinIndicator SizeType="Small"
                                    VerticalAlignment="Center"
                                    CustomIndicator="{antdicons:AntDesignIconProvider Kind=LoadingOutlined, StrokeBrush=#1677ff}" />
                <atom:SpinIndicator SizeType="Middle"
                                    VerticalAlignment="Center"
                                    CustomIndicator="{antdicons:AntDesignIconProvider Kind=LoadingOutlined, StrokeBrush=#1677ff}" />
                <atom:SpinIndicator SizeType="Large"
                                    VerticalAlignment="Center"
                                    CustomIndicator="{antdicons:AntDesignIconProvider Kind=LoadingOutlined, StrokeBrush=#1677ff}" />
            </StackPanel>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:SpinShowCaseLangResource EmbeddedModeTitle}"
            Description="{gallery:SpinShowCaseLangResource EmbeddedModeDescription}"
            IsOccupyEntireRow="True">
            <StackPanel Orientation="Vertical" Spacing="10">
                <atom:Spin IsSpinning="{Binding IsLoadingSwitchChecked}"
                           IsTipVisible="True"
                           HorizontalAlignment="Stretch"
                           Tip="{gallery:SpinShowCaseLangResource P2TipLoading}">
                    <atom:Alert Message="{gallery:SpinShowCaseLangResource P2MessageAlertMessageTitle}"
                                Description="{gallery:SpinShowCaseLangResource P2DescriptionFurtherDetailsAboutTheContextOfThisAlert}"
                                Type="Info" />
                </atom:Spin>

                <atom:Spin IsSpinning="{Binding IsLoadingSwitchChecked}"
                           IsTipVisible="True"
                           Tip="{gallery:SpinShowCaseLangResource P2TipLoading}"
                           HorizontalAlignment="Stretch"
                           IsMaskBlurEnabled="True">
                    <atom:Alert Message="{gallery:SpinShowCaseLangResource P2MessageAlertMessageTitle}"
                                Description="{gallery:SpinShowCaseLangResource P2DescriptionFurtherDetailsAboutTheContextOfThisAlert}"
                                Type="Info" />
                </atom:Spin>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <atom:TextBlock Text="{gallery:SpinShowCaseLangResource P2TextLoadingState}" />
                    <atom:ToggleSwitch IsChecked="{Binding IsLoadingSwitchChecked}" />
                </StackPanel>
            </StackPanel>
        </gallery:ShowCaseItem>
                </gallery:ShowCasePanel>
            </ContentControl>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
