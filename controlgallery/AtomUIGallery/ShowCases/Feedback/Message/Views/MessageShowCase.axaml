<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Message.MessageShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Message"
             x:DataType="vm:MessageViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <StackPanel Margin="28,24,28,18"
                            Spacing="16">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <atom:TextBlock Text="Message"
                                            FontSize="26"
                                            FontWeight="Bold"
                                            VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:MessageShowCaseLangResource ComponentCategory}"
                                      TagColor="blue"
                                      VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:MessageShowCaseLangResource ComponentStatusStable}"
                                      TagColor="success"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                        <atom:TextBlock Text="{gallery:MessageShowCaseLangResource PageSubtitle}"
                                        FontSize="15"
                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                        <atom:TextBlock Text="{gallery:MessageShowCaseLangResource PageDescription}"
                                        HorizontalAlignment="Left"
                                        TextWrapping="Wrap"
                                        Foreground="{atom:SharedTokenResource ColorTextTertiary}" />
                    </StackPanel>

                    <Border Background="{atom:SharedTokenResource ColorBgContainer}"
                            BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinHeight="48"
                            Padding="16,8">
                        <Border.Styles>
                            <Style Selector="atom|TextBlock.info-label">
                                <Setter Property="Width" Value="84" />
                            </Style>
                            <Style Selector="atom|TextBlock.info-value">
                                <Setter Property="Width" Value="200" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </Border.Styles>
                        <WrapPanel Orientation="Horizontal"
                                   ItemSpacing="48"
                                   LineSpacing="8"
                                   VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:MessageShowCaseLangResource InfoNamespaceLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:MessageShowCaseLangResource InfoPackageLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:MessageShowCaseLangResource InfoBaseClassLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="WindowMessageManager"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </gallery:GalleryStickyTabsHost.Header>

            <gallery:GalleryStickyTabsHost.StickyContent>
                <atom:TabStrip Name="ScenarioTabs"
                               SizeType="Large"
                               SelectedIndex="0">
                    <atom:TabStripItem Content="{gallery:MessageShowCaseLangResource ScenarioExamples}"
                                       Tag="Examples"
                                       IsSelected="True" />
                    <atom:TabStripItem Content="{gallery:MessageShowCaseLangResource ScenarioApi}"
                                       Tag="Api" />
                    <atom:TabStripItem Content="{gallery:MessageShowCaseLangResource ScenarioDesignToken}"
                                       Tag="DesignToken" />
                </atom:TabStrip>
            </gallery:GalleryStickyTabsHost.StickyContent>

            <ContentControl Name="ScenarioContentHost">
                <gallery:ShowCasePanel Name="ExamplesContent"
                                       IsScrollEnabled="False"
                                       IsDeferredLoadingEnabled="True"
                                       InitialDeferredLoadItemCount="4"
                                       DeferredLoadBatchSize="2"
                                       ContentMargin="28,10,28,28">
                    <gallery:ShowCaseItem
                        Title="{gallery:MessageShowCaseLangResource BasicTitle}"
                        Description="{gallery:MessageShowCaseLangResource BasicDescription}"
                        IsDeferredContentEnabled="True">
                        <gallery:ShowCaseItem.DeferredContentTemplate>
                            <DataTemplate x:DataType="vm:MessageViewModel">
                                <atom:Button ButtonType="Primary" Click="ShowSimpleMessage" Content="{gallery:MessageShowCaseLangResource P2ContentDisplayNormalMessage}" />
                            </DataTemplate>
                        </gallery:ShowCaseItem.DeferredContentTemplate>
                    </gallery:ShowCaseItem>

                    <gallery:ShowCaseItem
                        Title="{gallery:MessageShowCaseLangResource OtherTypesTitle}"
                        Description="{gallery:MessageShowCaseLangResource OtherTypesDescription}"
                        IsDeferredContentEnabled="True">
                        <gallery:ShowCaseItem.DeferredContentTemplate>
                            <DataTemplate x:DataType="vm:MessageViewModel">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <atom:Button ButtonType="Default" Click="ShowSuccessMessage" Content="{gallery:MessageShowCaseLangResource P2ContentSuccess}" />
                                    <atom:Button ButtonType="Default" Click="ShowInfoMessage" Content="{gallery:MessageShowCaseLangResource P2ContentInfo}" />
                                    <atom:Button ButtonType="Default" Click="ShowWarningMessage" Content="{gallery:MessageShowCaseLangResource P2ContentWarning}" />
                                    <atom:Button ButtonType="Default" Click="ShowErrorMessage" Content="{gallery:MessageShowCaseLangResource P2ContentError}" />
                                </StackPanel>
                            </DataTemplate>
                        </gallery:ShowCaseItem.DeferredContentTemplate>
                    </gallery:ShowCaseItem>

                    <gallery:ShowCaseItem Title="{gallery:MessageShowCaseLangResource LoadingIndicatorTitle}"
                                          Description="{gallery:MessageShowCaseLangResource LoadingIndicatorDescription}"
                                          IsDeferredContentEnabled="True">
                        <gallery:ShowCaseItem.DeferredContentTemplate>
                            <DataTemplate x:DataType="vm:MessageViewModel">
                                <atom:Button ButtonType="Default" Click="ShowLoadingMessage" Content="{gallery:MessageShowCaseLangResource P2ContentDisplayALoadingIndicator}" />
                            </DataTemplate>
                        </gallery:ShowCaseItem.DeferredContentTemplate>
                    </gallery:ShowCaseItem>

                    <gallery:ShowCaseItem
                        Title="{gallery:MessageShowCaseLangResource CallbackTitle}"
                        Description="{gallery:MessageShowCaseLangResource CallbackDescription}"
                        IsDeferredContentEnabled="True">
                        <gallery:ShowCaseItem.DeferredContentTemplate>
                            <DataTemplate x:DataType="vm:MessageViewModel">
                                <atom:Button ButtonType="Default" Click="ShowSequentialMessage" Content="{gallery:MessageShowCaseLangResource P2ContentDisplayALoadingIndicator}" />
                            </DataTemplate>
                        </gallery:ShowCaseItem.DeferredContentTemplate>
                    </gallery:ShowCaseItem>
                </gallery:ShowCasePanel>
            </ContentControl>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
