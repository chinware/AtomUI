<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.Watermark.WatermarkShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:vm="using:AtomUIGallery.ShowCases.Watermark"
             x:DataType="vm:WatermarkViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <gallery:GalleryShowCaseHeader
                    Title="Watermark"
                    Category="{gallery:WatermarkShowCaseLangResource ComponentCategory}"
                    Status="{gallery:WatermarkShowCaseLangResource ComponentStatusStable}"
                    Subtitle="{gallery:WatermarkShowCaseLangResource PageSubtitle}"
                    Description="{gallery:WatermarkShowCaseLangResource PageDescription}"
                    Namespace="AtomUI.Controls"
                    Package="AtomUI.Controls"
                    BaseClass="WatermarkGlyph" />
            </gallery:GalleryStickyTabsHost.Header>

            <gallery:GalleryStickyTabsHost.StickyContent>
                <atom:TabStrip Name="ScenarioTabs"
                               SizeType="Large"
                               SelectedIndex="0">
                    <atom:TabStripItem Content="{gallery:WatermarkShowCaseLangResource ScenarioExamples}"
                                       Tag="Examples"
                                       IsSelected="True" />
                    <atom:TabStripItem Content="{gallery:WatermarkShowCaseLangResource ScenarioApi}"
                                       Tag="Api" />
                    <atom:TabStripItem Content="{gallery:WatermarkShowCaseLangResource ScenarioDesignToken}"
                                       Tag="DesignToken" />
                </atom:TabStrip>
            </gallery:GalleryStickyTabsHost.StickyContent>

            <ContentControl Name="ScenarioContentHost">
                <gallery:ShowCasePanel Name="ExamplesContent"
                                       IsScrollEnabled="False"
                                       IsDeferredLoadingEnabled="True"
                                       InitialDeferredLoadItemCount="4"
                                       DeferredLoadBatchSize="2"
                                       ContentMargin="28,10,28,28">

        <gallery:ShowCaseItem Title="{gallery:WatermarkShowCaseLangResource BasicTitle}" Description="{gallery:WatermarkShowCaseLangResource BasicDescription}"
                              IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:WatermarkViewModel">
            <Border Height="300" HorizontalAlignment="Stretch" atom:Watermark.Glyph="{atom:TextGlyph 'AtomUI'}" />
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem Title="{gallery:WatermarkShowCaseLangResource MultiLineTitle}"
                                      Description="{gallery:WatermarkShowCaseLangResource MultiLineDescription}"
                                      IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:WatermarkViewModel">
            <Border Height="200"
                    HorizontalAlignment="Stretch">
                <atom:Watermark.Glyph>
                    <atom:TextGlyph Text="{gallery:WatermarkShowCaseLangResource P2WatermarkMultiLineText}"
                                    FontSize="18"
                                    Foreground="Gray" />
                </atom:Watermark.Glyph>
            </Border>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem Title="{gallery:WatermarkShowCaseLangResource ImageWatermarkTitle}"
                                      Description="{gallery:WatermarkShowCaseLangResource ImageWatermarkDescription}"
                                      IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:WatermarkViewModel">
            <Border Height="400">
                <atom:Watermark.Glyph>
                    <atom:ImageGlyph Source="/Assets/ATOMUI-LOGO.png" />
                </atom:Watermark.Glyph>
            </Border>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem Title="{gallery:WatermarkShowCaseLangResource CustomConfigurationTitle}"
                                      Description="{gallery:WatermarkShowCaseLangResource CustomConfigurationDescription}"
                                      IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="vm:WatermarkViewModel">
            <StackPanel atom:Watermark.Glyph="{atom:TextGlyph 'AtomUI'}">
                <atom:TextBlock TextWrapping="Wrap"
                                Text="{gallery:WatermarkShowCaseLangResource P2TextNaturalInteractionDescription}" />
                <Image Source="/Assets/watermark-sample.png" />
            </StackPanel>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

                </gallery:ShowCasePanel>
            </ContentControl>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
