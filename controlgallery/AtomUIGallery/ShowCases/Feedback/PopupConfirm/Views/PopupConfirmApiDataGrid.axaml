<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.PopupConfirm.PopupConfirmApiDataGrid"
             xmlns:atom="https://atomui.net"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:viewModels="clr-namespace:AtomUIGallery.ShowCases.PopupConfirm">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <atom:DataGrid x:Name="ApiDataGrid"
                       AutoGenerateColumns="False"
                       LeftFrozenColumnCount="1"
                       GridLinesVisibility="Horizontal"
                       IsFrameBorderVisible="True"
                       IsHideOnSinglePage="True"
                       IsReadOnly="True"
                       PaginationVisibility="None"
                       HorizontalScrollBarVisibility="Auto"
                       Margin="28,10,28,28"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Top"
                       x:DataType="viewModels:PopupConfirmApiRow">
            <atom:DataGrid.Columns>
                <atom:DataGridTemplateColumn Header="{gallery:PopupConfirmShowCaseLangResource ApiColumnMember}"
                                             Width="340">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="viewModels:PopupConfirmApiRow">
                            <gallery:GallerySelectableTextBlock Text="{Binding Member}"
                                            FontFamily="Consolas"
                                            VerticalAlignment="Center" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="{gallery:PopupConfirmShowCaseLangResource ApiColumnDescription}"
                                             MinWidth="520"
                                             Width="*">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="viewModels:PopupConfirmApiRow">
                            <gallery:GallerySelectableTextBlock Text="{Binding Description}"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Center" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="{gallery:PopupConfirmShowCaseLangResource ApiColumnType}"
                                             Width="220">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="viewModels:PopupConfirmApiRow">
                            <atom:Tag Text="{Binding Type}"
                                      TagColor="{Binding TypeTagColor}"
                                      VerticalAlignment="Center" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
                <atom:DataGridTemplateColumn Header="{gallery:PopupConfirmShowCaseLangResource ApiColumnDefault}"
                                             Width="160">
                    <atom:DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="viewModels:PopupConfirmApiRow">
                            <gallery:GallerySelectableTextBlock Text="{Binding Default}"
                                            FontFamily="Consolas"
                                            VerticalAlignment="Center" />
                        </DataTemplate>
                    </atom:DataGridTemplateColumn.CellTemplate>
                </atom:DataGridTemplateColumn>
            </atom:DataGrid.Columns>
        </atom:DataGrid>
    </Grid>
</UserControl>
