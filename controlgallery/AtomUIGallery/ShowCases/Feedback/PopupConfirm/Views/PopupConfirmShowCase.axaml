<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AtomUIGallery.ShowCases.PopupConfirm.PopupConfirmShowCase"
             xmlns:atom="https://atomui.net"
             xmlns:antdicons="https://atomui.net/icons/antdesign"
             xmlns:gallery="https://atomui.net/oss-controls/gallery"
             xmlns:viewModels="clr-namespace:AtomUIGallery.ShowCases.PopupConfirm"
             x:DataType="viewModels:PopupConfirmViewModel">
    <Grid Background="{atom:SharedTokenResource ColorBgLayout}">
        <gallery:GalleryStickyTabsHost StickyContentPadding="28,0,28,0">
            <gallery:GalleryStickyTabsHost.Header>
                <StackPanel Margin="28,24,28,18"
                            Spacing="16">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <atom:TextBlock Text="PopupConfirm"
                                            FontSize="26"
                                            FontWeight="Bold"
                                            VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:PopupConfirmShowCaseLangResource ComponentCategory}"
                                      TagColor="blue"
                                      VerticalAlignment="Center" />
                            <atom:Tag Text="{gallery:PopupConfirmShowCaseLangResource ComponentStatusStable}"
                                      TagColor="success"
                                      VerticalAlignment="Center" />
                        </StackPanel>
                        <atom:TextBlock Text="{gallery:PopupConfirmShowCaseLangResource PageSubtitle}"
                                        FontSize="15"
                                        Foreground="{atom:SharedTokenResource ColorTextSecondary}" />
                        <atom:TextBlock Text="{gallery:PopupConfirmShowCaseLangResource PageDescription}"
                                        HorizontalAlignment="Left"
                                        TextWrapping="Wrap"
                                        Foreground="{atom:SharedTokenResource ColorTextTertiary}" />
                    </StackPanel>

                    <Border Background="{atom:SharedTokenResource ColorBgContainer}"
                            BorderBrush="{atom:SharedTokenResource ColorBorderSecondary}"
                            BorderThickness="1"
                            CornerRadius="6"
                            MinHeight="48"
                            Padding="16,8">
                        <Border.Styles>
                            <Style Selector="atom|TextBlock.info-label">
                                <Setter Property="Width" Value="84" />
                            </Style>
                            <Style Selector="atom|TextBlock.info-value">
                                <Setter Property="Width" Value="200" />
                                <Setter Property="TextWrapping" Value="NoWrap" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            </Style>
                        </Border.Styles>
                        <WrapPanel Orientation="Horizontal"
                                   ItemSpacing="48"
                                   LineSpacing="8"
                                   VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:PopupConfirmShowCaseLangResource InfoNamespaceLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:PopupConfirmShowCaseLangResource InfoPackageLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="AtomUI.Desktop.Controls"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                <atom:TextBlock Classes="info-label"
                                                Text="{gallery:PopupConfirmShowCaseLangResource InfoBaseClassLabel}"
                                                FontWeight="Bold"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                                <atom:TextBlock Classes="info-value"
                                                Text="FlyoutHost"
                                                FontFamily="Consolas"
                                                LineHeight="22"
                                                Foreground="{atom:SharedTokenResource ColorTextSecondary}"
                                                VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>
                </StackPanel>
            </gallery:GalleryStickyTabsHost.Header>

            <gallery:GalleryStickyTabsHost.StickyContent>
                <atom:TabStrip Name="ScenarioTabs"
                               SizeType="Large"
                               SelectedIndex="0">
                    <atom:TabStripItem Content="{gallery:PopupConfirmShowCaseLangResource ScenarioExamples}"
                                       Tag="Examples"
                                       IsSelected="True" />
                    <atom:TabStripItem Content="{gallery:PopupConfirmShowCaseLangResource ScenarioApi}"
                                       Tag="Api" />
                    <atom:TabStripItem Content="{gallery:PopupConfirmShowCaseLangResource ScenarioDesignToken}"
                                       Tag="DesignToken" />
                </atom:TabStrip>
            </gallery:GalleryStickyTabsHost.StickyContent>

            <ContentControl Name="ScenarioContentHost">
                <gallery:ShowCasePanel Name="ExamplesContent"
                                       IsScrollEnabled="False"
                                       IsDeferredLoadingEnabled="True"
                                       InitialDeferredLoadItemCount="4"
                                       DeferredLoadBatchSize="2"
                                       ContentMargin="28,10,28,28">
        <gallery:ShowCaseItem
            Title="{gallery:PopupConfirmShowCaseLangResource BasicUsageTitle}"
            Description="{gallery:PopupConfirmShowCaseLangResource BasicUsageDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="viewModels:PopupConfirmViewModel">
            <atom:PopupConfirm
                Title="{gallery:PopupConfirmShowCaseLangResource P2TitleDeleteTheTask}"
                ConfirmContent="{gallery:PopupConfirmShowCaseLangResource P2ConfirmContentAreYouSureToDeleteThisTask}"
                ShouldUseOverlayPopup="False"
                OkText="{gallery:PopupConfirmShowCaseLangResource P2OkTextOk}"
                CancelText="{gallery:PopupConfirmShowCaseLangResource P2CancelTextCancel}"
                Placement="Top"
                IsArrowVisible="True">
                <atom:Button ButtonType="Default" IsDanger="True" Content="{gallery:PopupConfirmShowCaseLangResource P2ContentDelete}" />
            </atom:PopupConfirm>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:PopupConfirmShowCaseLangResource LocaleTextTitle}"
            Description="{gallery:PopupConfirmShowCaseLangResource LocaleTextDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="viewModels:PopupConfirmViewModel">
            <atom:PopupConfirm
                ShouldUseOverlayPopup="False"
                Title="{gallery:PopupConfirmShowCaseLangResource P2TitleDeleteTheTask}"
                ConfirmContent="{gallery:PopupConfirmShowCaseLangResource P2ConfirmContentAreYouSureToDeleteThisTask}">
                <atom:Button ButtonType="Default" IsDanger="True" Content="{gallery:PopupConfirmShowCaseLangResource P2ContentDelete}" />
            </atom:PopupConfirm>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:PopupConfirmShowCaseLangResource PlacementTitle}"
            Description="{gallery:PopupConfirmShowCaseLangResource PlacementDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="viewModels:PopupConfirmViewModel">
            <Grid>
                <Grid.Styles>
                    <Style Selector="atom|Button">
                        <Setter Property="Margin" Value="5" />
                        <Setter Property="Width" Value="80" />
                    </Style>
                </Grid.Styles>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <atom:PopupConfirm
                    Grid.Row="1" Grid.Column="0" Trigger="Click" Placement="LeftEdgeAlignedTop"
                    Title="{gallery:PopupConfirmShowCaseLangResource P2TitleDeleteTheTask}"
                    ConfirmContent="{gallery:PopupConfirmShowCaseLangResource P2ConfirmContentAreYouSureToDeleteThisTask}"
                    OkText="{gallery:PopupConfirmShowCaseLangResource P2OkTextOk}"
                    CancelText="{gallery:PopupConfirmShowCaseLangResource P2CancelTextCancel}">
                    <atom:Button ButtonType="Default" Content="{gallery:PopupConfirmShowCaseLangResource P2ContentLt}" />
                </atom:PopupConfirm>

                <atom:PopupConfirm
                    Grid.Row="2" Grid.Column="0" Trigger="Click" Placement="Left"
                    Title="{gallery:PopupConfirmShowCaseLangResource P2TitleDeleteTheTask}"
                    ConfirmContent="{gallery:PopupConfirmShowCaseLangResource P2ConfirmContentAreYouSureToDeleteThisTask}"
                    OkText="{gallery:PopupConfirmShowCaseLangResource P2OkTextOk}"
                    CancelText="{gallery:PopupConfirmShowCaseLangResource P2CancelTextCancel}">
                    <atom:Button ButtonType="Default" Content="{gallery:PopupConfirmShowCaseLangResource P2ContentLeft}" />
                </atom:PopupConfirm>

                <atom:PopupConfirm
                    Grid.Row="3" Grid.Column="0" Trigger="Click" Placement="LeftEdgeAlignedBottom"
                    Title="{gallery:PopupConfirmShowCaseLangResource P2TitleDeleteTheTask}"
                    ConfirmContent="{gallery:PopupConfirmShowCaseLangResource P2ConfirmContentAreYouSureToDeleteThisTask}"
                    OkText="{gallery:PopupConfirmShowCaseLangResource P2OkTextOk}"
                    CancelText="{gallery:PopupConfirmShowCaseLangResource P2CancelTextCancel}">
                    <atom:Button ButtonType="Default" Content="{gallery:PopupConfirmShowCaseLangResource P2ContentLb}" />
                </atom:PopupConfirm>

                <atom:PopupConfirm
                    Grid.Row="0" Grid.Column="1" Trigger="Click" Placement="TopEdgeAlignedLeft"
                    Title="{gallery:PopupConfirmShowCaseLangResource P2TitleDeleteTheTask}"
                    ConfirmContent="{gallery:PopupConfirmShowCaseLangResource P2ConfirmContentAreYouSureToDeleteThisTask}"
                    OkText="{gallery:PopupConfirmShowCaseLangResource P2OkTextOk}"
                    CancelText="{gallery:PopupConfirmShowCaseLangResource P2CancelTextCancel}">
                    <atom:Button ButtonType="Default" Content="{gallery:PopupConfirmShowCaseLangResource P2ContentTl}" />
                </atom:PopupConfirm>

                <atom:PopupConfirm
                    Grid.Row="0" Grid.Column="2" Trigger="Click" Placement="Top"
                    Title="{gallery:PopupConfirmShowCaseLangResource P2TitleDeleteTheTask}"
                    ConfirmContent="{gallery:PopupConfirmShowCaseLangResource P2ConfirmContentAreYouSureToDeleteThisTask}"
                    OkText="{gallery:PopupConfirmShowCaseLangResource P2OkTextOk}"
                    CancelText="{gallery:PopupConfirmShowCaseLangResource P2CancelTextCancel}">
                    <atom:Button ButtonType="Default" Content="{gallery:PopupConfirmShowCaseLangResource P2ContentTop}" />
                </atom:PopupConfirm>

                <atom:PopupConfirm
                    Grid.Row="0" Grid.Column="3" Trigger="Click" Placement="TopEdgeAlignedRight"
                    Title="{gallery:PopupConfirmShowCaseLangResource P2TitleDeleteTheTask}"
                    ConfirmContent="{gallery:PopupConfirmShowCaseLangResource P2ConfirmContentAreYouSureToDeleteThisTask}"
                    OkText="{gallery:PopupConfirmShowCaseLangResource P2OkTextOk}"
                    CancelText="{gallery:PopupConfirmShowCaseLangResource P2CancelTextCancel}">
                    <atom:Button ButtonType="Default" Content="{gallery:PopupConfirmShowCaseLangResource P2ContentTr}" />
                </atom:PopupConfirm>

                <atom:PopupConfirm
                    Grid.Row="1" Grid.Column="4" Trigger="Click" Placement="RightEdgeAlignedTop"
                    Title="{gallery:PopupConfirmShowCaseLangResource P2TitleDeleteTheTask}"
                    ConfirmContent="{gallery:PopupConfirmShowCaseLangResource P2ConfirmContentAreYouSureToDeleteThisTask}"
                    OkText="{gallery:PopupConfirmShowCaseLangResource P2OkTextOk}"
                    CancelText="{gallery:PopupConfirmShowCaseLangResource P2CancelTextCancel}">
                    <atom:Button ButtonType="Default" Content="{gallery:PopupConfirmShowCaseLangResource P2ContentRt}" />
                </atom:PopupConfirm>

                <atom:PopupConfirm
                    Grid.Row="2" Grid.Column="4" Trigger="Click" Placement="Right"
                    Title="{gallery:PopupConfirmShowCaseLangResource P2TitleDeleteTheTask}"
                    ConfirmContent="{gallery:PopupConfirmShowCaseLangResource P2ConfirmContentAreYouSureToDeleteThisTask}"
                    OkText="{gallery:PopupConfirmShowCaseLangResource P2OkTextOk}"
                    CancelText="{gallery:PopupConfirmShowCaseLangResource P2CancelTextCancel}">
                    <atom:Button ButtonType="Default" Content="{gallery:PopupConfirmShowCaseLangResource P2ContentRight}" />
                </atom:PopupConfirm>

                <atom:PopupConfirm
                    Grid.Row="3" Grid.Column="4" Trigger="Click" Placement="RightEdgeAlignedBottom"
                    Title="{gallery:PopupConfirmShowCaseLangResource P2TitleDeleteTheTask}"
                    ConfirmContent="{gallery:PopupConfirmShowCaseLangResource P2ConfirmContentAreYouSureToDeleteThisTask}"
                    OkText="{gallery:PopupConfirmShowCaseLangResource P2OkTextOk}"
                    CancelText="{gallery:PopupConfirmShowCaseLangResource P2CancelTextCancel}">
                    <atom:Button ButtonType="Default" Content="{gallery:PopupConfirmShowCaseLangResource P2ContentRb}" />
                </atom:PopupConfirm>

                <atom:PopupConfirm
                    Grid.Row="4" Grid.Column="1" Trigger="Click" Placement="BottomEdgeAlignedLeft"
                    Title="{gallery:PopupConfirmShowCaseLangResource P2TitleDeleteTheTask}"
                    ConfirmContent="{gallery:PopupConfirmShowCaseLangResource P2ConfirmContentAreYouSureToDeleteThisTask}"
                    OkText="{gallery:PopupConfirmShowCaseLangResource P2OkTextOk}"
                    CancelText="{gallery:PopupConfirmShowCaseLangResource P2CancelTextCancel}">
                    <atom:Button ButtonType="Default" Content="{gallery:PopupConfirmShowCaseLangResource P2ContentBl}" />
                </atom:PopupConfirm>

                <atom:PopupConfirm
                    Grid.Row="4" Grid.Column="2" Trigger="Click" Placement="Bottom"
                    Title="{gallery:PopupConfirmShowCaseLangResource P2TitleDeleteTheTask}"
                    ConfirmContent="{gallery:PopupConfirmShowCaseLangResource P2ConfirmContentAreYouSureToDeleteThisTask}"
                    OkText="{gallery:PopupConfirmShowCaseLangResource P2OkTextOk}"
                    CancelText="{gallery:PopupConfirmShowCaseLangResource P2CancelTextCancel}">
                    <atom:Button ButtonType="Default" Content="{gallery:PopupConfirmShowCaseLangResource P2ContentBottom}" />
                </atom:PopupConfirm>

                <atom:PopupConfirm
                    Grid.Row="4" Grid.Column="3" Trigger="Click" Placement="BottomEdgeAlignedRight"
                    Title="{gallery:PopupConfirmShowCaseLangResource P2TitleDeleteTheTask}"
                    ConfirmContent="{gallery:PopupConfirmShowCaseLangResource P2ConfirmContentAreYouSureToDeleteThisTask}"
                    OkText="{gallery:PopupConfirmShowCaseLangResource P2OkTextOk}"
                    CancelText="{gallery:PopupConfirmShowCaseLangResource P2CancelTextCancel}">
                    <atom:Button ButtonType="Default" Content="{gallery:PopupConfirmShowCaseLangResource P2ContentBr}" />
                </atom:PopupConfirm>

            </Grid>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>

        <gallery:ShowCaseItem
            Title="{gallery:PopupConfirmShowCaseLangResource CustomizeIconTitle}"
            Description="{gallery:PopupConfirmShowCaseLangResource CustomizeIconDescription}"
            IsDeferredContentEnabled="True">
            <gallery:ShowCaseItem.DeferredContentTemplate>
                <DataTemplate x:DataType="viewModels:PopupConfirmViewModel">
            <atom:PopupConfirm
                Title="{gallery:PopupConfirmShowCaseLangResource P2TitleDeleteTheTask}"
                ConfirmContent="{gallery:PopupConfirmShowCaseLangResource P2ConfirmContentAreYouSureToDeleteThisTask}"
                Icon="{antdicons:AntDesignIconProvider Kind=QuestionCircleOutlined}"
                ConfirmStatus="Error"
                OkText="{gallery:PopupConfirmShowCaseLangResource P2OkTextOk}"
                CancelText="{gallery:PopupConfirmShowCaseLangResource P2CancelTextCancel}">
                <atom:Button ButtonType="Default" IsDanger="True" Content="{gallery:PopupConfirmShowCaseLangResource P2ContentDelete}" />
            </atom:PopupConfirm>
                </DataTemplate>
            </gallery:ShowCaseItem.DeferredContentTemplate>
        </gallery:ShowCaseItem>
                </gallery:ShowCasePanel>
            </ContentControl>
        </gallery:GalleryStickyTabsHost>
    </Grid>
</UserControl>
